[DataContract]
public class AVAInventoryOnHandService
{
    InventTableId inventId;

    [DataMember('1')]
    public void parmInventId(InventTableId _inventId)
    {
        inventId = _inventId;
    }

    public InventTableId parmInventId()
    {
        return inventId;
    }

    /// Business logic: calculate on-hand qty for the item using InventSum
    public Qty inventOnHand()
    {
        InventSum inventSum;
        Qty onHand = 0;

        while select forUpdate inventSum where inventSum.ItemId == inventId
        {
            onHand += inventSum.AvailPhysical;
        }

        return onHand;
    }
}
