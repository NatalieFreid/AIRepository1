    {
        Dialog      dialog = new Dialog("Post sales invoice");
        DialogField df;

        df = dialog.addField(extendedTypeStr(SalesId), "Sales order id");

        if (dialog.run())
        {
            salesId = df.value();
            return true;
        }

        return false;
    }

