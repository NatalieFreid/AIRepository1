						<Source><![CDATA[
        /// <summary>
        /// open form with filter value
        /// </summary>
        void executeQuery()
        {
            QueryBuildDataSource            qbds;
            qbds = NumberSequenceReference_ds.query().dataSourceTable(tableNum(NumberSequenceReference)).addDataSource(tableNum(NumberSequenceDatatype));

            qbds.relations(true);
            qbds.joinMode(JoinMode::ExistsJoin);
            qbds.addRange(fieldNum(NumberSequenceDatatype,Module)).value(enum2Str(NumberSeqModule::AVAMSQ));

            super();
        }

]]></Source>
