		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    ///  find report and design(optional)
    /// </summary>
    public static AVADAIReportMetadata find(AVADAIMetaDataId _metaDataId, boolean _forUpdate = false)
    {
        AVADAIReportMetadata            metadata;

        if (_metaDataId)
        {
            metadata.selectForUpdate(_forUpdate);

            select firstonly metadata
                where metadata.MetaDataId == _metaDataId;
        }

        return metadata;

    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    public static boolean exist(AVADAIMetaDataId _metaDataId)
    {
        return _metaDataId && (select firstOnly RecId from AVADAIReportMetadata where AVADAIReportMetadata.MetaDataId == _metaDataId).RecId != 0;

    }

]]></Source>
			</Method>
		</Methods>
