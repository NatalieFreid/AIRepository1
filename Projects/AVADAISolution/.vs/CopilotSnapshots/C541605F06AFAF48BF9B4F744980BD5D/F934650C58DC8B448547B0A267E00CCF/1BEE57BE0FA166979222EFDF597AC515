			<Method>
				<Name>initializeQuery</Name>
				<Source><![CDATA[
    /// <summary>
    /// Initializes the default query for the data contract
    /// Sets up AVADAIReportExportTable as the primary data source
    /// </summary>
    public void initializeQuery()
    {
        AVADAIReportExportWorkCleanUpDataContract dataContract;
        Query query;
        QueryBuildDataSource qbds;
        
        dataContract = this.getDataContractObject() as AVADAIReportExportWorkCleanUpDataContract;
        
        if (!dataContract.getQuery())
        {
            // Create default query for AVADAIReportExportTable
            query = new Query();
            qbds = query.addDataSource(tableNum(AVADAIReportExportTable));
            qbds.addSelectionField(fieldNum(AVADAIReportExportTable, ExportId));
            qbds.addSelectionField(fieldNum(AVADAIReportExportTable, MetaDataExportDateTime));
            
            // Set default date range (last 30 days)
            qbds.addRange(fieldNum(AVADAIReportExportTable, MetaDataExportDateTime))
                .value(queryRange(DateTimeUtil::addDays(DateTimeUtil::getSystemDateTime(), -30), DateTimeUtil::getSystemDateTime()));
            
            dataContract.setQuery(query);
        }
    }
]]></Source>
