			<Method>
				<Name>validateParameters</Name>
				<Source><![CDATA[
    /// <summary>
    /// Validates the parameters in the data contract
    /// </summary>
    /// <param name="_dataContract">Data contract to validate</param>
    /// <returns>true if valid, false otherwise</returns>
    private boolean validateParameters(AVADAIReportExportWorkCleanUpDataContract _dataContract)
    {
        boolean ret = true;
        Query query;
        
        if (!_dataContract)
        {
            ret = checkFailed("@SYS26332"); // Data contract not found
            return ret;
        }
        
        query = _dataContract.getQuery();
        if (!query)
        {
            ret = checkFailed("@SYS318705"); // Query not found
            return ret;
        }
        
        return ret;
    }
