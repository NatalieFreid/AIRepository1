	<Name>AVADAIReportExportWorkCleanUpController</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// Controller class for AVADAIReportExportWork cleanup batch job
/// Manages the SysOperation framework workflow for cleaning up report data
/// Uses the AOT query AVADAIReportExportWorkCleanUpQuery for date range filtering
/// </summary>
class AVADAIReportExportWorkCleanUpController extends SysOperationServiceController
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>new</Name>
				<Source><![CDATA[
    /// <summary>
    /// Constructor - initializes the controller with service configuration
    /// </summary>
    protected void new()
    {
        super();
        
        this.parmClassName(classStr(AVADAIReportExportWorkCleanUpService));
        this.parmMethodName(methodStr(AVADAIReportExportWorkCleanUpService, runCleanup));
        this.parmDialogCaption("@AVADAI:ReportExportWorkCleanup");
        
        // Enable batch processing
        this.parmExecutionMode(SysOperationExecutionMode::Synchronous);
    }
]]></Source>
			</Method>
			<Method>
				<Name>main</Name>
				<Source><![CDATA[
    /// <summary>
    /// Main entry point for the batch job
    /// Creates and runs the controller instance
    /// </summary>
    /// <param name="_args">Command line arguments</param>
    public static void main(Args _args)
    {
        AVADAIReportExportWorkCleanUpController controller;
        
        controller = new AVADAIReportExportWorkCleanUpController();
        controller.parmArgs(_args);
        controller.startOperation();
    }
]]></Source>
