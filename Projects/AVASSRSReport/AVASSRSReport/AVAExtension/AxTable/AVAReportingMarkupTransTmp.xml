			<Method>
				<Name>setMarkupTrans</Name>
				<Source><![CDATA[
    /// <summary>
    /// set the markupTrans
    /// </summary>
    /// <param name = "_recordDPTmp">report data provider</param>
    /// <param name = "_postRecord">posted record</param>
    /// <param name = "_languageId">_languageId</param>
    /// <param name = "_isProforma">_isProforma</param>
    /// <param name = "_qty">_qty</param>
    /// <param name = "_amount">_amount</param>
    /// <param name = "_intercompanyAmount">_intercompanyAmount</param>
    /// <param name = "_isInclTax">_isInclTax</param>
    public static void setMarkupTrans(common _recordDPTmp, 
                                      common _postRecord, 
                                      LanguageId _languageId = CompanyInfo::languageId(), 
                                      boolean _isProforma=false, 
                                      Qty _qty = 0, 
                                      AmountCur _amount=0, 
                                      AmountCur _intercompanyAmount=0, 
                                      boolean _isInclTax = false)
    {
        MarkupTrans markupTransLocal;

        while select markupTransLocal where markupTransLocal.TransRecId == _postRecord.RecId
                                                && markupTransLocal.TransTableId == _postRecord.TableId
                                                && markupTransLocal.IsDeleted == NoYes::No
        {
            // Filter out ledger to Ledger.
            if (!(markupTransLocal.markuptable().CustType == MarkupType::LedgerAccount &&
                markupTransLocal.markuptable().VendType == MarkupType::LedgerAccount))
            {
                AvaReportingMarkupTransTmp AvaReportingMarkupTransTmp;
                AvaReportingMarkupTransTmp.clear();
                AvaReportingMarkupTransTmp.initValue();
                AvaReportingMarkupTransTmp.setReportDP(_recordDPTmp);
                AvaReportingMarkupTransTmp.avaInitFromMarkupTrans(markupTransLocal,_languageId);

                if(_isProforma)
                {
                    AvaReportingMarkupTransTmp.CalculatedAmount = Markup::calcMarkupAmount(markupTransLocal, _qty, _amount, _intercompanyAmount,_isInclTax);
                }

                if(AvaReportingMarkupTransTmp.validateWrite())
                {
                    AvaReportingMarkupTransTmp.insert();
                }
            }
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>copyMarkupTrans</Name>
				<Source><![CDATA[
    /// <summary>
    /// copy the markuptrans
    /// </summary>
    /// <param name = "_reportDPTableId">_reportDPTableId</param>
    /// <param name = "_reportDPRecid">_reportDPRecid</param>
    /// <param name = "_newReportDPRecid">_newReportDPRecid</param>
    public static void copyMarkupTrans(TableId _reportDPTableId, Recid _reportDPRecid, Recid _newReportDPRecid)
    {
        AvaReportingMarkupTransTmp AvaReportingMarkupTransTmp;

        // Copy report data for SalesInvoiceTmp
        RecordInsertList recordList = new RecordInsertList(tableNum(AvaReportingMarkupTransTmp));

        while select AvaReportingMarkupTransTmp
                where AvaReportingMarkupTransTmp.ReportDPTableId == _reportDPTableId && AvaReportingMarkupTransTmp.ReportDPRecId == _reportDPRecid
        {
            AvaReportingMarkupTransTmp locAvaReportingMarkupTransTmp;

            locAvaReportingMarkupTransTmp.data(AvaReportingMarkupTransTmp);
            locAvaReportingMarkupTransTmp.ReportDPRecId = _newReportDPRecid;
            locAvaReportingMarkupTransTmp.IsCopy = NoYes::Yes;
            recordList.add(locAvaReportingMarkupTransTmp);
        }

        recordList.insertDatabase();
    }

]]></Source>
			</Method>
			<Method>
				<Name>resetIsCopy</Name>
				<Source><![CDATA[
    /// <summary>
    /// reset the IsCopy flag
    /// </summary>
    /// <param name = "_reportDPTableId">_reportDPTableId</param>
    /// <param name = "_reportDPRecid">_reportDPRecid</param>
    /// <param name = "_newRecId">_newRecId</param>
    public static void resetIsCopy(TableId _reportDPTableId, Recid _reportDPRecid, RecId _newRecId)
    {
        AvaReportingMarkupTransTmp AvaReportingMarkupTransTmp;
        update_recordset AvaReportingMarkupTransTmp
            setting IsCopy = NoYes::No, ReportDPRecId = _newRecId
            where AvaReportingMarkupTransTmp.ReportDPRecId == _reportDPRecid
               && AvaReportingMarkupTransTmp.ReportDPTableId == _reportDPTableId
               && AvaReportingMarkupTransTmp.IsCopy == NoYes::Yes;
    }

]]></Source>
			</Method>
			<Method>
				<Name>getAvaReportingMarkupTransTmp</Name>
				<Source><![CDATA[
    /// <summary>
    /// read the AvaReportingMarkupTransTmp of the report temp table
    /// </summary>
    /// <param name = "_reportDPTableid">tableId of the report temp table</param>
    /// <param name = "_reportDPRecid">recid of the report temp record</param>
    /// <returns>AvaReportingMarkupTransTmp</returns>
    public static AvaReportingMarkupTransTmp getAvaReportingMarkupTransTmp(TableId _reportDPTableid, RecId _reportDPRecid)
    {
        AvaReportingMarkupTransTmp AvaReportingMarkupTransTmp;

        select AvaReportingMarkupTransTmp
            where AvaReportingMarkupTransTmp.ReportDPRecId == _reportDPRecid
               && AvaReportingMarkupTransTmp.ReportDPTableId == _reportDPTableId;

        return AvaReportingMarkupTransTmp;
    }

]]></Source>
