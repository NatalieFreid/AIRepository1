			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// Returns whether misc. charges are already attached to this record specified by tableId
    /// and recid.
    /// </summary>
    /// <param name="tableId">
    /// Table number of record to check if charges are attached.
    /// </param>
    /// <param name="recId">
    /// Record number of record to check if charges are attached.
    /// </param>
    /// <returns>
    /// true if misc charge exists for record; otherwise, false.
    /// </returns>
    static boolean exist(TableId   tableId,
                         RecId     recId)
    {
        if (tableId  &&  recId)
        {
            return (select firstonly RecId from AVAReportingMarkupTransTmp
                        where AVAReportingMarkupTransTmp.ReportDPRecId  == tableId
                            && AVAReportingMarkupTransTmp.ReportDPRecId  == recId).RecId != 0;
        }

        return false;
    }

]]></Source>
			</Method>
			<Method>
				<Name>findRecId</Name>
				<Source><![CDATA[
    /// <summary>
    /// findRecId
    /// </summary>
    /// <param name = "_recId">RecId</param>
    /// <param name = "_update">boolean</param>
    /// <returns>AVAReportingMarkupTransTmp</returns>
    public static AVAReportingMarkupTransTmp findRecId(RecId _recId, boolean _update = false)
    {
        AVAReportingMarkupTransTmp  markupTrans;

        if (_recId)
        {
            markupTrans.selectForUpdate(_update);

            select firstonly markupTrans
                   where markupTrans.RecId == _recId;
        }

        return markupTrans;
    }

]]></Source>
