				<Source><![CDATA[
    /// <summary>
    /// AVAReportingMarkupTransTmp
    /// </summary>
    /// <param name = "_markupTrans">MarkupTrans</param>
    /// <param name = "_languageId">_languageId</param>
    public void avaInitFromMarkupTrans(MarkupTrans _markupTrans, LanguageId _languageId)
    {
        this.MarkupTransRecId                        = _markupTrans.RecId;

        this.CalculatedAmount                        = _markupTrans.CalculatedAmount                      ;
        this.CurrencyCode                            = _markupTrans.CurrencyCode                          ;
        this.IsDeleted                               = _markupTrans.IsDeleted                             ;
        this.Keep                                    = _markupTrans.Keep                                  ;
        this.LineNum                                 = _markupTrans.LineNum                               ;
        this.MarkupCategory                          = _markupTrans.MarkupCategory                        ;
        this.MarkupCode                              = _markupTrans.MarkupCode                            ;
        this.MarkupTaxCharge                         = _markupTrans.MarkupTaxCharge                       ;
        this.ModuleCategory                          = _markupTrans.ModuleCategory                        ;
        this.ModuleType                              = _markupTrans.ModuleType                            ;
        this.OrigRecId                               = _markupTrans.OrigRecId                             ;
        this.OrigTableId                             = _markupTrans.OrigTableId                           ;
        this.Position                                = _markupTrans.Position                              ;
        this.SpecificUnitSymbol                      = _markupTrans.SpecificUnitSymbol                    ;
        this.TaxAmount                               = _markupTrans.TaxAmount                             ;
        this.TaxGroup                                = _markupTrans.TaxGroup                              ;
        this.TaxItemGroup                            = _markupTrans.TaxItemGroup                          ;
        this.TaxWriteCode                            = _markupTrans.TaxWriteCode                          ;
        this.Txt                                     = MarkupTable::AVATxt(_markupTrans.ModuleType,_markupTrans.MarkupCode,_languageId);
        this.Value                                   = _markupTrans.Value                                 ;
    }

]]></Source>
