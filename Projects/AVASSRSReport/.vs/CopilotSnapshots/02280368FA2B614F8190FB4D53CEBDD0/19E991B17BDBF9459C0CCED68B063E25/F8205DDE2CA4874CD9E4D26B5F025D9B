    }

]]></Source>
			</Method>
			<Method>
				<Name>processReport</Name>
				<Source><![CDATA[
    /// <summary>
    /// Processes the report by populating temp tables
    /// </summary>
    public void processReport()
    {
        AVARUMCashSalesReportContract   contract;
        AVARUMCashSalesCashVoucher      cashVoucher;
        AVARUMCashSalesDeskBalance      deskBalance;
        TransDate                       reportDate;

        contract   = this.parmDataContract() as AVARUMCashSalesReportContract;
        reportDate = contract.parmTransDate();

        // Populate cash voucher temp table
        while select cashVoucher
            where cashVoucher.CreatedDateTime >= DateTimeUtil::newDateTime(reportDate, 0)
               && cashVoucher.CreatedDateTime < DateTimeUtil::newDateTime(reportDate + 1, 0)
        {
            cashVoucherTmp.data(cashVoucher);
            cashVoucherTmp.insert();
        }

        // Populate desk balance temp table
        while select deskBalance
            where deskBalance.OpenAt >= DateTimeUtil::newDateTime(reportDate, 0)
               && deskBalance.OpenAt < DateTimeUtil::newDateTime(reportDate + 1, 0)
        {
            deskBalanceTmp.data(deskBalance);
            deskBalanceTmp.insert();
        }
    }

]]></Source>
			</Method>
