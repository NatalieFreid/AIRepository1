		<Declaration><![CDATA[
/// <summary>
/// Data provider class for AVARUMCashSalesReport
/// </summary>
[SRSReportParameterAttribute(classStr(AVARUMCashSalesReportContract))]
public class AVARUMCashSalesReportDP extends SrsReportDataProviderBase
{
    AVARUMCashSalesCashVoucherTmp    cashVoucherTmp;
    AVARUMCashSalesDeskBalanceTmp    deskBalanceTmp;

}
]]></Declaration>
		<Methods>
			<Method>
				<Name>getCashVoucherTmp</Name>
				<Source><![CDATA[
    /// <summary>
    /// Gets the cash voucher temp table dataset
    /// </summary>
    /// <returns>Cash voucher temp table</returns>
    [SRSReportDataSetAttribute(tableStr(AVARUMCashSalesCashVoucherTmp))]
    public AVARUMCashSalesCashVoucherTmp getCashVoucherTmp()
    {
        select * from cashVoucherTmp;
        return cashVoucherTmp;
    }

]]></Source>
			</Method>
			<Method>
				<Name>getDeskBalanceTmp</Name>
				<Source><![CDATA[
    /// <summary>
    /// Gets the desk balance temp table dataset
    /// </summary>
    /// <returns>Desk balance temp table</returns>
    [SRSReportDataSetAttribute(tableStr(AVARUMCashSalesDeskBalanceTmp))]
    public AVARUMCashSalesDeskBalanceTmp getDeskBalanceTmp()
    {
        select * from deskBalanceTmp;
