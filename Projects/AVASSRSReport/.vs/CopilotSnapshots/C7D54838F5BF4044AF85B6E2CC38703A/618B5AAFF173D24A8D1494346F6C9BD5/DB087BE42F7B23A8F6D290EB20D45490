        <Source><![CDATA[
    /// <summary>
    /// Pre-run contract modification - applies contract parameters to query ranges
    /// </summary>
    protected void preRunModifyContract()
    {
        AVACashSummaryContract contract;
        Query query;
        QueryBuildDataSource qbdsSalesTable;
        QueryBuildRange qbrCustAccount;
        QueryBuildRange qbrDeliveryDate;

        super();

        contract = this.parmReportContract().parmRdpContract() as AVACashSummaryContract;
        query = this.parmReportContract().parmQueryContracts().lookup(this.getFirstQueryContractKey());

        if (query && contract)
        {
            qbdsSalesTable = query.dataSourceTable(tableNum(SalesTable));

            if (qbdsSalesTable)
            {
                // Apply customer account range
                if (contract.parmCustAccount())
                {
                    qbrCustAccount = SrsReportHelper::addParameterValueRangeToQuery(
                        qbdsSalesTable,
                        fieldNum(SalesTable, CustAccount),
                        SRSReportParameter::typeCustAccount,
                        contract.parmCustAccount());
                }

                // Apply delivery date range
                if (contract.parmDeliveryDateFrom() || contract.parmDeliveryDateTo())
                {
                    str dateRangeValue;
                    
                    if (contract.parmDeliveryDateFrom() && contract.parmDeliveryDateTo())
                    {
                        dateRangeValue = strFmt('%1..%2', 
                            date2StrXpp(contract.parmDeliveryDateFrom()),
                            date2StrXpp(contract.parmDeliveryDateTo()));
                    }
                    else if (contract.parmDeliveryDateFrom())
                    {
                        dateRangeValue = strFmt('%1..', date2StrXpp(contract.parmDeliveryDateFrom()));
                    }
                    else if (contract.parmDeliveryDateTo())
                    {
                        dateRangeValue = strFmt('..%1', date2StrXpp(contract.parmDeliveryDateTo()));
                    }

                    qbrDeliveryDate = qbdsSalesTable.findRange(fieldNum(SalesTable, DeliveryDate));
                    if (!qbrDeliveryDate)
                    {
                        qbrDeliveryDate = qbdsSalesTable.addRange(fieldNum(SalesTable, DeliveryDate));
                    }
                    qbrDeliveryDate.value(dateRangeValue);
                }
            }
        }
    }

]]></Source>
