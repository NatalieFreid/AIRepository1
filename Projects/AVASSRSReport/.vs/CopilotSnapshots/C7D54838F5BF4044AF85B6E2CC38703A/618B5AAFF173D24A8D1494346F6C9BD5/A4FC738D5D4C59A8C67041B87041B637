<?xml version="1.0" encoding="utf-8"?>
<AxClass xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
  <Name>AVACashSummaryContract</Name>
  <SourceCode>
    <Declaration><![CDATA[
/// <summary>
/// Report contract class for AVA Cash Summary Report
/// </summary>
[DataContractAttribute,
 SysOperationContractProcessingAttribute(classStr(AVACashSummaryController))]
public class AVACashSummaryContract extends SRSReportDataContractBase
{
    CustAccount custAccount;
    TransDate deliveryDateFrom;
    TransDate deliveryDateTo;
}
]]></Declaration>
    <Methods>
      <Method>
        <Name>parmCustAccount</Name>
        <Source><![CDATA[
    /// <summary>
    /// Gets or sets the customer account
    /// </summary>
    /// <param name = "_custAccount">Customer account</param>
    /// <returns>Customer account</returns>
    [DataMemberAttribute("CustAccount")]
    public CustAccount parmCustAccount(CustAccount _custAccount = custAccount)
    {
        custAccount = _custAccount;
        return custAccount;
    }

]]></Source>
      </Method>
      <Method>
        <Name>parmDeliveryDateFrom</Name>
        <Source><![CDATA[
    /// <summary>
    /// Gets or sets the delivery date from
    /// </summary>
    /// <param name = "_deliveryDateFrom">Delivery date from</param>
    /// <returns>Delivery date from</returns>
    [DataMemberAttribute("DeliveryDateFrom"),
     SysOperationLabelAttribute(literalStr("@SYS22447")),
     SysOperationDisplayOrderAttribute('1')]
    public TransDate parmDeliveryDateFrom(TransDate _deliveryDateFrom = deliveryDateFrom)
    {
        deliveryDateFrom = _deliveryDateFrom;
        return deliveryDateFrom;
    }

]]></Source>
      </Method>
      <Method>
        <Name>parmDeliveryDateTo</Name>
        <Source><![CDATA[
    /// <summary>
    /// Gets or sets the delivery date to
    /// </summary>
    /// <param name = "_deliveryDateTo">Delivery date to</param>
    /// <returns>Delivery date to</returns>
    [DataMemberAttribute("DeliveryDateTo"),
     SysOperationLabelAttribute(literalStr("@SYS318425")),
     SysOperationDisplayOrderAttribute('2')]
    public TransDate parmDeliveryDateTo(TransDate _deliveryDateTo = deliveryDateTo)
    {
        deliveryDateTo = _deliveryDateTo;
        return deliveryDateTo;
    }

]]></Source>
      </Method>
      <Method>
        <Name>validate</Name>
        <Source><![CDATA[
    /// <summary>
    /// Validates the contract parameters
    /// </summary>
    /// <returns>True if valid, otherwise false</returns>
    public boolean validate()
    {
        boolean ret = true;

        if (deliveryDateFrom > deliveryDateTo && deliveryDateTo != dateNull())
        {
            ret = checkFailed(strFmt("@SYS84811", "@SYS22447", "@SYS318425"));
        }

        return ret;
    }

]]></Source>
      </Method>
    </Methods>
