	<SourceCode>
		<Declaration><![CDATA[
public class AVARUMDSDFeeTable extends common
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>factor</Name>
				<Source><![CDATA[
    display Factor factor()
    {
        return (this.BaseUnit ? this.fee * 100 / this.BaseUnit : 0);
    }

]]></Source>
			</Method>
			<Method>
				<Name>itemName</Name>
				<Source><![CDATA[
    display ItemNameDisplay itemName()
    {
        return InventTable::find(this.ItemId).itemName();
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    static AVARUMDSDFeeTable find
    (
        AVARUMDSDClass _class,
        AVARUMDSDCodeId _codeId,
        RefRecId _invRefId,
        ItemId _itemId,
        boolean _forUpdate = false
    )
    {
        AVARUMDSDFeeTable feeTable;

        if (_codeId && _invRefId && _itemId)
        {
            feeTable.selectForUpdate(_forUpdate);

            select firstonly feeTable
                where feeTable.CodeClass == _class &&
                    feeTable.Code == _codeId &&
                    feeTable.InvRefId == _invRefId &&
                    feeTable.ItemId == _itemId;
        }

        return feeTable;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
