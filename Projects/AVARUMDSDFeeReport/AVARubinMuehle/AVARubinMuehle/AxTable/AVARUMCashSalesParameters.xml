			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Finds the AVARUMCashSalesParameters record. If the record is not found, it creates a new record.
    /// </summary>
    /// <param name="_forUpdate">Indicates if the record should be selected for update.</param>
    /// <param name="_concurrencyModel">Specifies the concurrency model to use.</param>
    /// <returns>The found or newly created AVARUMCashSalesParameters record.</returns>
    public static AVARUMCashSalesParameters find(boolean _forUpdate = false, ConcurrencyModel _concurrencyModel = ConcurrencyModel::Auto)
    {
        AVARUMCashSalesParameters parameters;
        AVARUMCashSalesParameters parametersNew;
        int loopOnce = 0;

        // This method returns the record if it is found, otherwise creates a record and returns it.
        // We need a looping variable because if the record doesn't exist, a new record is created for
        // first time in the while loop and we should loop for one more time to set the selectForUpdate
        // correctly. If record is found first time, then the while loop breaks.
        while (!parameters && loopOnce <=1)
        {
            parameters.selectForUpdate(_forUpdate);

            if (_forUpdate && _concurrencyModel != ConcurrencyModel::Auto)
            {
                parameters.concurrencyModel(_concurrencyModel);
            }

            select firstonly parameters
                where parameters.Key == 0;

            if (!parameters && !parameters.isTmp())
            {
                Company::createParameter(parametersNew);
            }
            else
            {
                break;
            }

            loopOnce++;
        }

        return parameters;
    }

]]></Source>
