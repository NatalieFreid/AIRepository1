			<Method>
				<Name>getPrinterName</Name>
				<Source><![CDATA[
    /// <summary>
    /// Gets the printer name.
    /// </summary>
    /// <returns>The printer name.</returns>
    [SysClientCacheDataMethodAttribute(true)]
    public display PrinterName getPrinterName()
    {
        PrinterName printerName;

        if (this.PrinterRefRecId)
        {                  
            printerName = SysCorpNetPrinters::findByRecId_AVA(this.PrinterRefRecId).PrinterName;
        }

        return printerName;
    }

]]></Source>
