    /// <param name = "_configId">ConfigId</param>
    /// <param name = "_accountnum">Accountnum</param>
    /// <param name = "_forupdate">Forupdate</param>
    /// <returns>Record found</returns>
    static public AVARUMPalletLabels find(ItemId _itemid, EcoResItemConfigurationName _configId, CustAccount _accountnum, boolean _forupdate=false)
    {        
        AVARUMPalletLabels AVARUMPalletLabels;
        if (_forupdate)
        {
            AVARUMPalletLabels.selectForUpdate(true);
        }

        select firstonly * from AVARUMPalletLabels
            where AVARUMPalletLabels.ItemId==_itemid
            && AVARUMPalletLabels.ConfigId==_configId
            && AVARUMPalletLabels.AccountNum==_accountnum;

        return AVARUMPalletLabels;

    }

