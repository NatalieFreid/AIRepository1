            /// <summary>
            /// This method is used to filter the ItemId lookup to only show Service items.
            /// </summary>
            /// <param name = "_formControl">The form control that will display the lookup.</param>
            /// <param name = "_filterStr">The filter string to apply to the lookup.</param>
            public void lookup(FormControl _formControl, str _filterStr)
            {
                Set itemTypes;

                itemTypes = new Set(Types::Enum);
                itemTypes.add(ItemType::Service);

                InventTable::lookupItemIdType(_formControl, _filterStr, itemTypes);
            }

]]></Source>
