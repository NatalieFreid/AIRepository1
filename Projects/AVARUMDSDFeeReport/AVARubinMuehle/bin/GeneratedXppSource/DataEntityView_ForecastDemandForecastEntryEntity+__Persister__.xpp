    {
        InventDim inventDim_ = null;
        
        // Ensuring only fields in the selection list should be accessed for read-only data source.
        inventDim_.checkInvalidFieldAccess(true);
        
        select
            firstOnly
                // Specify explicit field selection for read-only data source.
                InventSiteId, InventLocationId, InventStatusId, configId, InventColorId, InventSizeId, InventStyleId, InventVersionId, inventDimId
            from
                inventDim_
        where
            inventDim_.RecId == _inventDim.RecId
        ;
        
        if (inventDim_)
        {
            return inventDim_;
        }
        
        return inventDim_;
    }

