    private ForecastSales LookForUniqueKeyMatch_DS1(ForecastDemandForecastEntryEntity _forecastDemandForecastEntryEntity, ForecastSales _forecastSales)
    {
        ForecastSales forecastSales_ = null;
        
        select
            forUpdate
            firstOnly
                forecastSales_
        where
            forecastSales_.ForecastEntryNumber == _forecastSales.ForecastEntryNumber
        ;
        
        if (forecastSales_)
        {
            return forecastSales_;
        }
        
        select
            forUpdate
            firstOnly
                forecastSales_
        where
            forecastSales_.ExpandId == _forecastSales.ExpandId && forecastSales_.RecId == _forecastSales.RecId
        ;
        
        if (forecastSales_)
        {
            return forecastSales_;
        }
        
        return forecastSales_;
    }
