    protected void validateConfigurationKeys(DataEntityRuntimeContext _entityCtx)
    {
        // Ensure that the entity configuration key is enabled
        if(!isConfigurationKeyEnabled(configurationKeyName2Id('LogisticsBasic')))
        {
            // Entity configuration key is disabled
            throw error(strfmt("@ApplicationPlatform:DataEntityConfigKeyDisabled",'LogisticsBasic'));
        }
        if(!isConfigurationKeyEnabled(configurationKeyName2Id('WHSandTMS')))
        {
            if(this.isAnyMappedDataSourceFieldSet_DS7(_entityCtx.getEntityRecord(), 'WHSandTMS'))
            {
                // Outer joined data source configuration key is disabled and fields mapped to this data source are set
                throw error(strfmt("@ApplicationPlatform:DataEntityDataSourceConfigKeyDisabled",'TMSSalesTable','WHSandTMS'));
            }
        }
        if(!isConfigurationKeyEnabled(configurationKeyName2Id('LedgerBasic')))
        {
            if(this.isAnyMappedDataSourceFieldSet_DS9(_entityCtx.getEntityRecord(), 'LedgerBasic'))
            {
                // Outer joined data source configuration key is disabled and fields mapped to this data source are set
                throw error(strfmt("@ApplicationPlatform:DataEntityDataSourceConfigKeyDisabled",'CreditNoteReasonTableRef','LedgerBasic'));
            }
        }
        if(!isConfigurationKeyEnabled(configurationKeyName2Id('LedgerBasicSalesTax')))
        {
            if(this.isAnyMappedDataSourceFieldSet_DS10(_entityCtx.getEntityRecord(), 'LedgerBasicSalesTax'))
            {
                // Outer joined data source configuration key is disabled and fields mapped to this data source are set
                throw error(strfmt("@ApplicationPlatform:DataEntityDataSourceConfigKeyDisabled",'ExportSalesOrder','LedgerBasicSalesTax'));
            }
        }
        if(!isConfigurationKeyEnabled(configurationKeyName2Id('WHSandTMS')))
        {
            if(this.isAnyMappedDataSourceFieldSet_DS21(_entityCtx.getEntityRecord(), 'WHSandTMS'))
            {
                // Outer joined data source configuration key is disabled and fields mapped to this data source are set
                throw error(strfmt("@ApplicationPlatform:DataEntityDataSourceConfigKeyDisabled",'FulfillmentPolicy','WHSandTMS'));
            }
        }
        if(!isConfigurationKeyEnabled(configurationKeyName2Id('Retail')))
        {
            if(this.isAnyMappedDataSourceFieldSet_DS22(_entityCtx.getEntityRecord(), 'Retail'))
            {
                // Outer joined data source configuration key is disabled and fields mapped to this data source are set
                throw error(strfmt("@ApplicationPlatform:DataEntityDataSourceConfigKeyDisabled",'RetailSalesTable','Retail'));
            }
        }
        if(!isConfigurationKeyEnabled(configurationKeyName2Id('LedgerBasic')))
        {
            if(this.isAnyMappedDataSourceFieldSet_DS23(_entityCtx.getEntityRecord(), 'LedgerBasic'))
            {
                // Outer joined data source configuration key is disabled and fields mapped to this data source are set
                throw error(strfmt("@ApplicationPlatform:DataEntityDataSourceConfigKeyDisabled",'FinTag','LedgerBasic'));
            }
        }
        if(!isConfigurationKeyEnabled(configurationKeyName2Id('WHSandTMS')))
        {
            if(this.isAnyMappedDataSourceFieldSet_DS25(_entityCtx.getEntityRecord(), 'WHSandTMS'))
            {
                // Outer joined data source configuration key is disabled and fields mapped to this data source are set
                throw error(strfmt("@ApplicationPlatform:DataEntityDataSourceConfigKeyDisabled",'WHSOutboundShipmentProcessingPolicy','WHSandTMS'));
            }
        }
