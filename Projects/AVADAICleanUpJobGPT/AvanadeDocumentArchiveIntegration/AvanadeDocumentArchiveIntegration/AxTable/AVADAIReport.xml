			<Method>
				<Name>getExportFileName</Name>
				<Source><![CDATA[
    /// <summary>
    ///	get the filename with prefix and filetype
    /// </summary>
    public static AVADAIFileName getExportFileName(
		AVADAIReport		_dmsReportConfiguration, 
		Filename			_fileType = '.pdf', 
		AVADAIExecutionId	_executionId = '', 
		AVADAIRefNum		_referenceNumber = '')
    { 
        AVADAIFileName		fileName;

        if (_dmsReportConfiguration.ReportFileNameGeneration == AVADAIFileNameGeneration::ReferenceNumber
			&& _referenceNumber != '')
        {
            fileName = _dmsReportConfiguration.ReportFilePrefix + _referenceNumber + _fileType;
        }
        else
        {
            fileName = _dmsReportConfiguration.ReportFilePrefix + _executionId + _fileType;
        }

        return fileName;
    }

]]></Source>
