			<Method>
				<Name>findByTransfDefId</Name>
				<Source><![CDATA[
    /// <summary>
    /// find by transDefId
    /// </summary>
    public static AVAMSQAzureServiceBusDefinition findByTransfDefId(AVAMSQTransfDefId		 _transDefId, boolean _update = false)
    {
        AVAMSQAzureServiceBusDefinition			azureServiceBusDefinition;
        ;

        azureServiceBusDefinition.selectForUpdate(_update);

        select firstonly azureServiceBusDefinition
            where azureServiceBusDefinition.TransfDefId == _transDefId;

        return azureServiceBusDefinition;
    }

]]></Source>
