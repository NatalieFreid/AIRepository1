		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    ///  find report and design(optional)
    /// </summary>
    public static AVADAIReport find(AVADAIServerId _serverId, AVADAIReportName _report, AVADAIReportDesign _design, boolean _forUpdate = false)
    {
        AVADAIReport            reportSetup;

        if (_serverId && _report)
        {
            reportSetup.selectForUpdate(_forUpdate);

            select firstonly reportSetup
                where reportSetup.ServerId == _serverId
                    && reportSetup.Report   == _report
                    && reportSetup.Design   == _design;
        }

        return reportSetup;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    ///  find report and design(optional)
    /// </summary>
    public static boolean exist(AVADAIServerId _serverId, AVADAIReportName _report, AVADAIReportDesign _design)
    {
        return _serverId && _report && (select firstOnly *
                                            from AVADAIReport
                                                where AVADAIReport.ServerId == _serverId
                                                   && AVADAIReport.Report   == _report
                                                   && AVADAIReport.Design   == _design).RecId != 0;

    }

]]></Source>
			</Method>
			<Method>
				<Name>modifiedFieldValue</Name>
				<Source><![CDATA[
    /// <summary>
    /// Callback when a field has been modified by the user.
    /// </summary>
    /// <param name = "_fieldName">Modified field</param>
    /// <param name = "_arrayIndex">Array index of the field</param>
    public void modifiedFieldValue(FieldName _fieldName, int _arrayIndex = 1)
    {
        super(_fieldName, _arrayIndex);

        switch (_fieldName)
        {
            case fieldStr(AVADAIReport, ExportMetadata):
                if (this.ExportMetadata == NoYes::No)
                {
                    this.PreventDuplicates = NoYes::No;
                }
                break;
        }
    }

]]></Source>
