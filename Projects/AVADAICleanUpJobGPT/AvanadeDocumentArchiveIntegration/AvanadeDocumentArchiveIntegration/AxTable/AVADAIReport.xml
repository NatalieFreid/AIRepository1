			<Method>
				<Name>validateFieldValue</Name>
				<Source><![CDATA[
    /// <summary>
    /// Callback to check whether a field value is valid.
    /// </summary>
    /// <param name = "_fieldName">Changed field</param>
    /// <param name = "_arrayIndex">Array index of the field</param>
    /// <returns>True, if the value is valid; False, if not</returns>
    public boolean validateFieldValue(FieldName _fieldName, int _arrayIndex = 1)
    {
        boolean ret = super(_fieldName, _arrayIndex);

        switch (_fieldName)
        {
            case fieldStr(AVADAIReport, PreventDuplicates):
                if (this.PreventDuplicates == NoYes::Yes && this.ExportMetadata == NoYes::No)
                {
                    ret = checkFailed("@AVADAI:PreventDuplicatesNeedsMetadata") && ret;
                }
                break;
        }
    
        return ret;
    }

]]></Source>
