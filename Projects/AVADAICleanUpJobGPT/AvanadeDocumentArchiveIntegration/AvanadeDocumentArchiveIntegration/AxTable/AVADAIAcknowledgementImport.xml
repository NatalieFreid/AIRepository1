			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// Checks if record exists in table.
    /// </summary>
    /// <param name = "AVADAIImportId">Import Id.</param>
    /// <param name = "AVADAIServerId">Server Id.</param>
    /// <returns>A <c>boolean</c> object.</returns>
    public static boolean exist(AVADAIImportId _avaImportId,AVADAIServerId _avaServerId )
    {
        boolean                         found;
        AVADAIAcknowledgementImport     avaDAIAcknowledgementImport;

        if(_avaImportId && _avaServerId)
        {
            found = (select firstonly RecId from avaDAIAcknowledgementImport where avaDAIAcknowledgementImport.ImportId == _avaImportId
                     && avaDAIAcknowledgementImport.ServerId).RecId != 0;
        }

        return found;
    }

]]></Source>
