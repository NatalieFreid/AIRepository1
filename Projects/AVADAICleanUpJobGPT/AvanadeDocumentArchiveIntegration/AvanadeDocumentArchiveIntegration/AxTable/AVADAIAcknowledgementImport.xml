			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// find in table.
    /// </summary>
    /// <param name = "Recid">recid.</param>
    /// <param name = "boolean">boolean </param>
    /// <returns>A <c>AVADAIAcknowledgementImport</c> table object.</returns>
    public static AVADAIAcknowledgementImport find(RecId _recId, boolean _forUpdate = false)
    {
        AVADAIAcknowledgementImport import;

        if (_recId)
        {
            import.selectForUpdate(_forUpdate);

            select firstonly import
                where import.RecId == _recId;
        }

        return import;
    }

]]></Source>
