				<Source><![CDATA[
    /// <summary>
    /// Checks if record exists in table.
    /// </summary>
    /// <param name = "AVADAIAdhocDoctypeId">AVADAIAdhocDoctypeId.</param>
    /// <param name = "AVADAIDoctypeKey">AVADAIDoctypeKey.</param>
    /// <returns>A <c>boolean</c> object.</returns>
    public static boolean exist(AVADAIAdhocDoctypeId _aVADAIAdhocDoctypeId,AVADAIDoctypeKey _aVADAIDoctypeKey )
    {
        boolean                found;
        AVADAIAdhocDoctypes    avaDAIAdhocDoctypes;

        if(_aVADAIAdhocDoctypeId && _aVADAIDoctypeKey)
        {
            found = (select firstonly RecId from avaDAIAdhocDoctypes where avaDAIAdhocDoctypes.DoctypeId == _aVADAIAdhocDoctypeId
                     && avaDAIAdhocDoctypes.DoctypeKey ==_aVADAIDoctypeKey).RecId != 0;
        }

        return found;
    }

