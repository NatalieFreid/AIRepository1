				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    ///  find doctype setup
    /// </summary>
    public static AVADAIAdhocDoctypes find(AVADAIDoctypeKey _doctypeKey, boolean _forUpdate = false)
    {
        AVADAIAdhocDoctypes doctpyes;

        if (_doctypeKey)
        {
            doctpyes.selectForUpdate(_forUpdate);

            select firstonly doctpyes
                where doctpyes.DoctypeKey   == _doctypeKey;
        }

        return doctpyes;
    }

]]></Source>
