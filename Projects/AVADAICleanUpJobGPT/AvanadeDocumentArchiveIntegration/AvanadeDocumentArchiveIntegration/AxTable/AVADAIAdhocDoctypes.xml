        }

        if (this.CompanyFixed && this.CompanyKey)
        {
            ret = checkFailed(strFmt("@AVADAI:AdhocDocTypeKeyAndFixedSpecified", fieldPName(AVADAIAdhocDoctypes, CompanyFixed), fieldPName(AVADAIAdhocDoctypes, CompanyKey))) && ret;
        }

        if (this.TableNameKey && this.FieldNameFixed)
        {
            ret = checkFailed("@AVADAI:AdhocDocTypeKeyTableKeyAndFieldFixed") && ret;
