	<Name>InventNumGroup.AVA_FixedInventBatch</Name>
	<SourceCode>
		<Methods>
			<Method>
				<Name>AVA_FixedBatch_OnModified</Name>
				<Source><![CDATA[
    /// <summary>
    /// Event handler for Fixed Batch checkbox modification
    /// </summary>
    /// <param name="sender">Form data object</param>
    /// <param name="e">Event arguments</param>
    [FormDataFieldEventHandler(formDataFieldStr(InventNumGroup, AVA_FixedBatch), FormDataFieldEventType::Modified)]
    public static void AVA_FixedBatch_OnModified(FormDataObject sender, FormDataFieldEventArgs e)
    {
        FormDataSource inventNumGroup_ds = sender.datasource();
        InventNumGroup inventNumGroup = inventNumGroup_ds.cursor();
        
        FormStringControl fixedBatchNumberControl = sender.formRun().design().controlName(formControlStr(InventNumGroup, AVA_FixedBatchNumber)) as FormStringControl;
        
        if (fixedBatchNumberControl)
        {
            fixedBatchNumberControl.enabled(inventNumGroup.AVA_FixedBatch == NoYes::Yes);
            
            if (inventNumGroup.AVA_FixedBatch == NoYes::No)
            {
                inventNumGroup.AVA_FixedBatchNumber = '';
                inventNumGroup_ds.refresh();
            }
        }
    }
]]></Source>
			</Method>
			<Method>
				<Name>AVA_FixedBatchNumber_OnGotFocus</Name>
				<Source><![CDATA[
    /// <summary>
    /// Event handler for Fixed Batch Number control focus
    /// </summary>
    /// <param name="sender">Form control</param>
    /// <param name="e">Event arguments</param>
    [FormControlEventHandler(formControlStr(InventNumGroup, AVA_FixedBatchNumber), FormControlEventType::GotFocus)]
    public static void AVA_FixedBatchNumber_OnGotFocus(FormControl sender, FormControlEventArgs e)
    {
        FormStringControl fixedBatchNumberControl = sender as FormStringControl;
        FormDataSource inventNumGroup_ds = fixedBatchNumberControl.dataSource();
        InventNumGroup inventNumGroup = inventNumGroup_ds.cursor();
        
        fixedBatchNumberControl.enabled(inventNumGroup.AVA_FixedBatch == NoYes::Yes);
    }
]]></Source>
			</Method>
			<Method>
				<Name>InventNumGroup_DS_OnValidatedWrite</Name>
				<Source><![CDATA[
    /// <summary>
    /// Event handler for data source validation on write
    /// </summary>
    /// <param name="sender">Form data source</param>
    /// <param name="e">Event arguments</param>
    [FormDataSourceEventHandler(formDataSourceStr(InventNumGroup, InventNumGroup), FormDataSourceEventType::ValidatedWrite)]
    public static void InventNumGroup_DS_OnValidatedWrite(FormDataSource sender, FormDataSourceEventArgs e)
    {
        FormDataSourceEventArgs args = e as FormDataSourceEventArgs;
        InventNumGroup inventNumGroup = sender.cursor();
        
        if (inventNumGroup.AVA_FixedBatch == NoYes::Yes && !inventNumGroup.AVA_FixedBatchNumber)
        {
            error("@AVA_FixedInventBatch:FixedBatchNumberRequired");
            args.result(false);
        }
    }
]]></Source>
			</Method>
