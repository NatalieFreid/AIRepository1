<?xml version="1.0" encoding="utf-8"?>
<AxClass xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
	<Name>AVA_InventNumGroup_Extension</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// Extension class for InventNumGroup table to handle fixed batch validation
/// </summary>
[ExtensionOf(tableStr(InventNumGroup))]
internal final class AVA_InventNumGroup_Extension
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    /// <summary>
    /// Validates that fixed batch number is provided when fixed batch is enabled
    /// </summary>
    /// <returns>True if validation passes, false otherwise</returns>
    public boolean validateWrite()
    {
        boolean ret = next validateWrite();
        
        InventNumGroup inventNumGroup = this;
        
        if (ret && inventNumGroup.AVA_FixedBatch == NoYes::Yes)
        {
            if (!inventNumGroup.AVA_FixedBatchNumber)
            {
                ret = checkFailed("@AVA_FixedInventBatch:FixedBatchNumberRequired");
            }
        }
        
        return ret;
    }
]]></Source>
			</Method>
		</Methods>
	</SourceCode>
</AxClass>
