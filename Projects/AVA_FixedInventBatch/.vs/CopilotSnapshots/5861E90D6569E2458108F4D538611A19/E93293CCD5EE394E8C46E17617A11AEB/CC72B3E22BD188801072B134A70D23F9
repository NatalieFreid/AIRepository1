	<Name>AVA_InventBatch_Extension</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// Extension class for InventBatch table to handle fixed batch creation
/// </summary>
[ExtensionOf(tableStr(InventBatch))]
internal final class AVA_InventBatch_Extension
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>AVA_findOrCreateFixedBatch</Name>
				<Source><![CDATA[
    /// <summary>
    /// Finds or creates a batch record for fixed batch number
    /// </summary>
    /// <param name="_itemId">Item ID</param>
    /// <param name="_batchId">Batch ID</param>
    /// <param name="_forUpdate">Select for update flag</param>
    /// <returns>InventBatch record</returns>
    public static InventBatch AVA_findOrCreateFixedBatch(ItemId _itemId, InventBatchId _batchId, boolean _forUpdate = false)
    {
        InventBatch inventBatch;
        
        if (_forUpdate)
        {
            select forupdate inventBatch
                where inventBatch.ItemId == _itemId
                    && inventBatch.InventBatchId == _batchId;
        }
        else
        {
            select firstonly inventBatch
                where inventBatch.ItemId == _itemId
                    && inventBatch.InventBatchId == _batchId;
        }
        
        if (!inventBatch)
        {
            inventBatch.clear();
            inventBatch.ItemId = _itemId;
            inventBatch.InventBatchId = _batchId;
            inventBatch.insert();
        }
        
        return inventBatch;
    }
]]></Source>
			</Method>
		</Methods>
	</SourceCode>
</AxClass>
