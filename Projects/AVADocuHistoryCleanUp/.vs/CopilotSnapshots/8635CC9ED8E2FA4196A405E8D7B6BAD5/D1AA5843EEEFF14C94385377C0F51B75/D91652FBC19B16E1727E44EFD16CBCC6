	<Name>AVADocuHistoryCleanupContract</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// Data contract class for DocuHistory cleanup batch job parameters.
/// </summary>
[DataContractAttribute]
public class AVADocuHistoryCleanupContract extends SysOperationDataContractBase
{
    TransDateTime cleanupToDateTime;
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>parmCleanupToDateTime</Name>
				<Source><![CDATA[
    /// <summary>
    /// Gets or sets the cleanup date/time parameter.
    /// </summary>
    /// <param name="_cleanupToDateTime">The date/time up to which records should be deleted.</param>
    /// <returns>The cleanup date/time.</returns>
    [DataMemberAttribute('CleanupToDateTime'),
     SysOperationLabelAttribute(literalStr("Cleanup to date/time")),
     SysOperationHelpTextAttribute(literalStr("Delete DocuHistory records created on or before this date/time")),
     SysOperationDisplayOrderAttribute('1')]
    public TransDateTime parmCleanupToDateTime(TransDateTime _cleanupToDateTime = cleanupToDateTime)
    {
        cleanupToDateTime = _cleanupToDateTime;
        return cleanupToDateTime;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validate</Name>
				<Source><![CDATA[
    /// <summary>
    /// Validates the contract parameters.
    /// </summary>
    /// <returns>True if validation passes; otherwise, false.</returns>
    public boolean validate()
    {
        boolean ret = true;

        if (!cleanupToDateTime)
        {
            error("@SYS84431"); // Please enter a value in the %1 field.
            ret = false;
        }

        return ret;
    }

]]></Source>
			</Method>
		</Methods>
