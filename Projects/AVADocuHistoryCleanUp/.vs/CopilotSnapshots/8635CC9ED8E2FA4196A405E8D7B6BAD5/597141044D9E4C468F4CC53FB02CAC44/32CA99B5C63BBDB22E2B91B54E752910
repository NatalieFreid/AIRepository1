<?xml version="1.0" encoding="utf-8"?>
<AxClass xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
	<Name>AVADocuHistoryCleanupContract</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// Data contract class for DocuHistory cleanup batch job parameters.
/// Uses a query to allow users to define cleanup criteria.
/// </summary>
[DataContractAttribute]
public class AVADocuHistoryCleanupContract extends SysOperationDataContractBase
{
    QueryName queryName;
    str packedQuery;
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>getQuery</Name>
				<Source><![CDATA[
    /// <summary>
    /// Gets the query object from the packed query string.
    /// </summary>
    /// <returns>The query object.</returns>
    public Query getQuery()
    {
        Query query;

        if (packedQuery)
        {
            query = new Query(SysOperationHelper::base64Decode(packedQuery));
        }
        else
        {
            query = new Query(queryStr(AVADocuHistoryCleanupQuery));
        }

        return query;
    }

]]></Source>
			</Method>
			<Method>
				<Name>setQuery</Name>
				<Source><![CDATA[
    /// <summary>
    /// Sets the query by packing it into a string.
    /// </summary>
    /// <param name="_query">The query to pack and store.</param>
    public void setQuery(Query _query)
    {
        if (_query)
        {
            packedQuery = SysOperationHelper::base64Encode(_query.pack());
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>parmQueryName</Name>
				<Source><![CDATA[
    /// <summary>
    /// Gets or sets the query name parameter.
    /// </summary>
    /// <param name="_queryName">The query name.</param>
    /// <returns>The query name.</returns>
    [DataMemberAttribute('QueryName'),
     SysOperationLabelAttribute(literalStr("Query")),
     SysOperationHelpTextAttribute(literalStr("Define the query to select DocuHistory records for deletion")),
     SysOperationDisplayOrderAttribute('1')]
    public QueryName parmQueryName(QueryName _queryName = queryName)
    {
        queryName = _queryName;
        return queryName;
    }

]]></Source>
			</Method>
			<Method>
				<Name>parmPackedQuery</Name>
				<Source><![CDATA[
    /// <summary>
    /// Gets or sets the packed query string.
    /// </summary>
    /// <param name="_packedQuery">The packed query string.</param>
    /// <returns>The packed query string.</returns>
    [DataMemberAttribute('PackedQuery')]
    public str parmPackedQuery(str _packedQuery = packedQuery)
    {
        packedQuery = _packedQuery;
        return packedQuery;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validate</Name>
				<Source><![CDATA[
    /// <summary>
    /// Validates the contract parameters.
    /// </summary>
    /// <returns>True if validation passes; otherwise, false.</returns>
    public boolean validate()
    {
        boolean ret = true;
        Query query = this.getQuery();

        if (!query)
        {
            error("@SYS18447"); // Invalid parameters
            ret = false;
        }

        return ret;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
</AxClass>
