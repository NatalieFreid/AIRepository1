<?xml version="1.0" encoding="utf-8"?>
<AxQuery xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
	<Name>AVADocuHistoryCleanupQuery</Name>
	<Label>DocuHistory Cleanup Query</Label>
	<Description>Query to select DocuHistory records for cleanup based on date range</Description>
	<DataSources>
		<AxQuerySimpleRootDataSource>
			<Name>DocuHistory</Name>
			<DynamicFields>Yes</DynamicFields>
			<Table>DocuHistory</Table>
			<Fields>
				<AxQuerySimpleDataSourceField>
					<DataField>RecId</DataField>
				</AxQuerySimpleDataSourceField>
				<AxQuerySimpleDataSourceField>
					<DataField>CreatedDateTime</DataField>
				</AxQuerySimpleDataSourceField>
				<AxQuerySimpleDataSourceField>
					<DataField>RefTableId</DataField>
				</AxQuerySimpleDataSourceField>
				<AxQuerySimpleDataSourceField>
					<DataField>RefRecId</DataField>
				</AxQuerySimpleDataSourceField>
			</Fields>
			<Ranges>
				<AxQuerySimpleDataSourceRange>
					<Name>CreatedDateTime</Name>
					<Field>CreatedDateTime</Field>
					<Label>Created date/time</Label>
					<Status>Open</Status>
				</AxQuerySimpleDataSourceRange>
			</Ranges>
		</AxQuerySimpleRootDataSource>
	</DataSources>
</AxQuery>
