    /// <summary>
    /// Called after the dialog is built.
    /// Can be used to add custom controls or modify dialog behavior.
    /// </summary>
    public void postBuild()
    {
        super();
        
        // Add any custom dialog modifications here
        DialogField dialogField;
        
        // Get the cleanup date field and set default to 30 days ago
        dialogField = this.bindInfo().getDialogField(
            this.dataContractObject(),
            methodStr(AVADocuHistoryCleanupContract, parmCleanupToDateTime));
            
        if (dialogField)
        {
            dialogField.value(DateTimeUtil::addDays(DateTimeUtil::utcNow(), -30));
        }
    }

