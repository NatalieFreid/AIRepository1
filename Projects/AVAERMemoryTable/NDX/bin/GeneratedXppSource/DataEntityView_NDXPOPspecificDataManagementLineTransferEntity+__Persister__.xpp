            {
                return false;
            }
            _dataSourceCtx = _entityCtx.getRuntimeContextByName('NDXPOPspecificDataManagementLineTransfer');
            // deletes data source [NDXPOPspecificDataManagementLineTransfer].
            if(!this.saveDataSource(_entityCtx, _dataSourceCtx))
            {
                // returns from here if the root data source fails to be saved.
                return false;
            }
            this.postSaveDataSource();
            // deletes data sources referenced by [NDXPOPspecificDataManagementLineTransfer].
            {
                // handle datasources which are part of extensions and need to be saved before [NDXPOPspecificDataManagementHeader]
                if(!this.preSaveDataSource(_entityCtx, 'NDXPOPspecificDataManagementHeader'))
                {
                    return false;
                }
                _dataSourceCtx = _entityCtx.getRuntimeContextByName('NDXPOPspecificDataManagementHeader');
                // skips delete operation against read-only data source.
                // marks the read-only data source as 'saved' and skips actual delete operation.
                _dataSourceCtx.setDataSaved(true);
                _dataSourceCtx.setDatabaseOperation(DataEntityDatabaseOperation::None);
                // deletes data source [NDXPOPspecificDataManagementHeader].
                if(!this.saveDataSource(_entityCtx, _dataSourceCtx))
                {
                    // returns from here if an inner joined data source fails to be saved.
                    return false;
                }
                this.postSaveDataSource();
            }
            {
                // handle datasources which are part of extensions and need to be saved before [InventTable]
                if(!this.preSaveDataSource(_entityCtx, 'InventTable'))
                {
                    return false;
                }
                _dataSourceCtx = _entityCtx.getRuntimeContextByName('InventTable');
                // skips delete operation against read-only data source.
                // marks the read-only data source as 'saved' and skips actual delete operation.
                _dataSourceCtx.setDataSaved(true);
                _dataSourceCtx.setDatabaseOperation(DataEntityDatabaseOperation::None);
                // deletes data source [InventTable].
                this.saveDataSource(_entityCtx, _dataSourceCtx);
                this.postSaveDataSource();
            }
        }
        // handle datasources which are part of extensions and need to be saved in last 
        this.preSaveDataSource(_entityCtx, '');
        return rtrn;
    }
