Private class __Persister__
extends SysDataEntityPersister
{
    // Data source ID macros
    #define.NDXRequisitionLine_ID(1)
    #define.RequisitionRelationForeignKey_ID(2)
    
    // Data source buffers
    NDXRequisitionLine m_NDXRequisitionLine;
    NDXRequisition m_RequisitionRelationForeignKey;
    
    protected void mapEntityToDataSources(DataEntityRuntimeContext _entityCtx)
    {
        this.validateFieldFailed = false;
        this.mapEntityToDataSource(_entityCtx, _entityCtx.getRuntimeContextByName('NDXRequisitionLine'));
        this.mapEntityToDataSource(_entityCtx, _entityCtx.getRuntimeContextByName('RequisitionRelationForeignKey'));
        this.mapEntityToDataSourcesExtensions(_entityCtx);
        if(this.validateFieldFailed)
        {
            throw Exception::ViewDataSourceValidation;
        }
    }
    private boolean isAnyFieldSet_DS2(NDXRequisition _requisitionRelationForeignKey, DataEntityDataSourceRuntimeContext _dataSourceCtx, DataEntityRuntimeContext _entityCtx)
    {
        boolean rtrn = false;
        rtrn = this.isAnyFieldSet_Extensions(_entityCtx, _dataSourceCtx, _requisitionRelationForeignKey) ? true : false;
        return rtrn;
    }
    private void foreignKeyPropagation_DS1(DataEntityRuntimeContext _entityCtx, NDXRequisitionLine _nDXRequisitionLine)
    {
        NDXRequisition requisitionRelationForeignKey_ = _entityCtx.getRuntimeContextByName('RequisitionRelationForeignKey').getBuffer();
        // FK propagation of references to an optional read-only PK data source will be done if
        //   1. conflict detection has been invoked against the PK data source, or
        //   2. the PK data source buffer is not null.
        if(_entityCtx.getRuntimeContextByName('RequisitionRelationForeignKey').conflictDetectionInvoked() || requisitionRelationForeignKey_)
        {
            // do not set foreign key values if they are same to make sure validation is not fired unless value changed
            if(_nDXRequisitionLine.RequisitionId != requisitionRelationForeignKey_.RequisitionId)
            {
                _nDXRequisitionLine.RequisitionId = requisitionRelationForeignKey_.RequisitionId;
            }
        }
        
        // foreign key value validation
        boolean validationFailed = false;
        DataEntityDatabaseOperation dataSourceDBOperation = _entityCtx.getRuntimeContextByName('NDXRequisitionLine').getDatabaseOperation();
        NDXRequisitionLineEntity dataEntityRecord = _entityCtx.getEntityRecord();
        
        if(!dataEntityRecord.skipDataSourceValidateField(fieldnum(NDXRequisitionLineEntity, RequisitionId)))
        {
            if(!this.validateDataSourceField(dataSourceDBOperation, 'NDXRequisitionLine.RequisitionId', _nDXRequisitionLine, fieldnum(NDXRequisitionLine, RequisitionId), false/*disallowEditOnCreate*/, false/*disallowEdit*/, false/*callValidateField*/, 1))
            {
                validationFailed = true;
            }
        }
        
        if(validationFailed)
        {
            throw Exception::ViewDataSourceValidation;
        }
    }
    protected boolean saveDataSources(DataEntityRuntimeContext _entityCtx)
    {
        boolean rtrn = true;
        DataEntityDataSourceRuntimeContext _dataSourceCtx = null;
        // save data sources in topological order.
        {
            // save/update data sources referenced by [NDXRequisitionLine].
            {
                // handle datasources which are part of extensions and need to be saved before [RequisitionRelationForeignKey]
                if(!this.preSaveDataSource(_entityCtx, 'RequisitionRelationForeignKey'))
                {
                    return false;
                }
                _dataSourceCtx = _entityCtx.getRuntimeContextByName('RequisitionRelationForeignKey');
                // propagates foreign key values from referenced data sources which are part of extensions.
                this.foreignKeyPropagationExtensions(_entityCtx, _dataSourceCtx);
                if(this.isAnyFieldSet_DS2(_dataSourceCtx.getBuffer(),_dataSourceCtx,_entityCtx))
                {
                    // invoke conflict detection for read-only data source.
                    NDXRequisition resolvedRecord = this.detectConflictForDataSource(_entityCtx, _dataSourceCtx);
                    if(!resolvedRecord)
                    {
                        NDXRequisition requisitionRelationForeignKey_ = _dataSourceCtx.getBuffer();
                        if((requisitionRelationForeignKey_.RequisitionId))
                        {
                            container dataSourceKeys = ["RequisitionId"];
                            container resolvedRecordValues = [resolvedRecord.RequisitionId];
                            container dataSourceConflictingValues = [requisitionRelationForeignKey_.RequisitionId];
                            str errorMessage = "";
                            for(int i = 1; i <= conLen(dataSourceKeys); i++)
                            {
                                if(conPeek(dataSourceConflictingValues, i))
                                {
                                    errorMessage += strfmt("'%1': %2, ", conPeek(dataSourceKeys, i), conPeek(resolvedRecordValues, i));
                                }
                            }
                            errorMessage = strDel(errorMessage, strLen(errorMessage) - 1, 2);
                            checkFailed(strfmt("@ApplicationPlatform:DataEntityReadonlyDataSourceNotFoundWithKey", _dataSourceCtx.name(), errorMessage));
                            throw Exception::ViewDataSourceValidation;
                        }
                    }
                    // marks the read-only data source as 'saved' and skips actual insert/update operation.
                    _dataSourceCtx.setDataSaved(true);
                }
                // in case of update marks the read-only data source as 'saved' and skips actual insert/update operation.
                else if(_dataSourceCtx.getDatabaseOperation() == DataEntityDatabaseOperation::Update)
                {
                    _dataSourceCtx.setDataSaved(true);
                }
                _dataSourceCtx.setDatabaseOperation(DataEntityDatabaseOperation::None);
                // inserts/updates data source [RequisitionRelationForeignKey].
                this.saveDataSource(_entityCtx, _dataSourceCtx);
                this.postSaveDataSource();
            }
            // handle datasources which are part of extensions and need to be saved before [NDXRequisitionLine]
            if(!this.preSaveDataSource(_entityCtx, 'NDXRequisitionLine'))
            {
                return false;
            }
            _dataSourceCtx = _entityCtx.getRuntimeContextByName('NDXRequisitionLine');
            // propagates foreign key values from referenced data sources which are part of extensions.
            this.foreignKeyPropagationExtensions(_entityCtx, _dataSourceCtx);
            // propagates foreign key values from referenced data sources.
            this.foreignKeyPropagation_DS1(_entityCtx, _dataSourceCtx.getBuffer());
            // inserts/updates data source [NDXRequisitionLine].
            if(!this.saveDataSource(_entityCtx, _dataSourceCtx))
            {
                // returns from here if the root data source fails to be saved.
                return false;
            }
            this.postSaveDataSource();
        }
        // handle datasources which are part of extensions and need to be saved in last 
        this.preSaveDataSource(_entityCtx, '');
        return rtrn;
    }
    protected boolean deleteDataSources(DataEntityRuntimeContext _entityCtx)
    {
        boolean rtrn = true;
        DataEntityDataSourceRuntimeContext _dataSourceCtx = null;
        // delete data sources in reverse topological order.
        {
            // handle datasources which are part of extensions and need to be saved before [NDXRequisitionLine]
            if(!this.preSaveDataSource(_entityCtx, 'NDXRequisitionLine'))
            {
                return false;
            }
            _dataSourceCtx = _entityCtx.getRuntimeContextByName('NDXRequisitionLine');
            // deletes data source [NDXRequisitionLine].
            if(!this.saveDataSource(_entityCtx, _dataSourceCtx))
            {
                // returns from here if the root data source fails to be saved.
                return false;
            }
            this.postSaveDataSource();
            // deletes data sources referenced by [NDXRequisitionLine].
            {
                // handle datasources which are part of extensions and need to be saved before [RequisitionRelationForeignKey]
                if(!this.preSaveDataSource(_entityCtx, 'RequisitionRelationForeignKey'))
                {
                    return false;
                }
                _dataSourceCtx = _entityCtx.getRuntimeContextByName('RequisitionRelationForeignKey');
                // skips delete operation against read-only data source.
                // marks the read-only data source as 'saved' and skips actual delete operation.
                _dataSourceCtx.setDataSaved(true);
                _dataSourceCtx.setDatabaseOperation(DataEntityDatabaseOperation::None);
                // deletes data source [RequisitionRelationForeignKey].
                this.saveDataSource(_entityCtx, _dataSourceCtx);
                this.postSaveDataSource();
            }
        }
        // handle datasources which are part of extensions and need to be saved in last 
        this.preSaveDataSource(_entityCtx, '');
        return rtrn;
    }
