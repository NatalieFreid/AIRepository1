                AVAItemSet, ItemId, BOMCalcGroupId, CostGroupId, DefaultOrderType, ItemGroupId, KCS_GoodsId, KCS_HK2GroupId, KCS_HK2Vendor, KCS_ItemUsageId, KCS_KAOItemState, LineDisc, MarkupGroupId, NDX_Filter, NDX_HKGrouping, NDX_ProdPoolIdMaster, NDX_ScrapId, NDX_StockItemIdentifier, NDXMGKGroupRefRecId, NDXModelNumber, NDXProductName1, NDXProductName2, NetWeight, PrimaryVendorId, ProdPoolId, ProductNumber, ProductType, UnitId, LanguageId
            from
                nDXProductsView_
        where
            nDXProductsView_.ItemId == _nDXProductsView.ItemId
        ;
        
        if (nDXProductsView_)
        {
            return nDXProductsView_;
        }
        
        return nDXProductsView_;
    }

}

