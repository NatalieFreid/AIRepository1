    private void foreignKeyPropagation_DS1(DataEntityRuntimeContext _entityCtx, NDXPOPspecificDataManagementLine _nDXPOPspecificDataManagementLine)
    {
        NDXPOPspecificDataManagementHeader nDXPOPspecificDataManagementHeader_ = _entityCtx.getRuntimeContextByName('NDXPOPspecificDataManagementHeader').getBuffer();
        // do not set foreign key values if they are same to make sure validation is not fired unless value changed
        if(_nDXPOPspecificDataManagementLine.NDXPOPspecificDataManagementHeader != nDXPOPspecificDataManagementHeader_.RecId)
        {
            _nDXPOPspecificDataManagementLine.NDXPOPspecificDataManagementHeader = nDXPOPspecificDataManagementHeader_.RecId;
        }
        
        InventTable inventTable_ = _entityCtx.getRuntimeContextByName('InventTable').getBuffer();
        // FK propagation of references to an optional read-only PK data source will be done if
        //   1. conflict detection has been invoked against the PK data source, or
        //   2. the PK data source buffer is not null.
        if(_entityCtx.getRuntimeContextByName('InventTable').conflictDetectionInvoked() || inventTable_)
        {
            // do not set foreign key values if they are same to make sure validation is not fired unless value changed
            if(_nDXPOPspecificDataManagementLine.InventTable != inventTable_.RecId)
            {
                _nDXPOPspecificDataManagementLine.InventTable = inventTable_.RecId;
            }
        }
        
        // foreign key value validation
        boolean validationFailed = false;
        DataEntityDatabaseOperation dataSourceDBOperation = _entityCtx.getRuntimeContextByName('NDXPOPspecificDataManagementLine').getDatabaseOperation();
        NDXPOPspecificDataManagementLineEntity dataEntityRecord = _entityCtx.getEntityRecord();
        
        if(!dataEntityRecord.skipDataSourceValidateField(fieldnum(NDXPOPspecificDataManagementLineEntity, NDXPOPspecificDataManagementHeader)))
        {
            if(!this.validateDataSourceField(dataSourceDBOperation, 'NDXPOPspecificDataManagementLine.NDXPOPspecificDataManagementHeader', _nDXPOPspecificDataManagementLine, fieldnum(NDXPOPspecificDataManagementLine, NDXPOPspecificDataManagementHeader), true/*disallowEditOnCreate*/, true/*disallowEdit*/, false/*callValidateField*/, 1))
            {
                validationFailed = true;
            }
        }
        
        if(!dataEntityRecord.skipDataSourceValidateField(fieldnum(NDXPOPspecificDataManagementLineEntity, InventTable)))
        {
            if(!this.validateDataSourceField(dataSourceDBOperation, 'NDXPOPspecificDataManagementLine.InventTable', _nDXPOPspecificDataManagementLine, fieldnum(NDXPOPspecificDataManagementLine, InventTable), true/*disallowEditOnCreate*/, true/*disallowEdit*/, false/*callValidateField*/, 1))
            {
                validationFailed = true;
            }
        }
        
        if(validationFailed)
        {
            throw Exception::ViewDataSourceValidation;
        }
    }
    protected boolean saveDataSources(DataEntityRuntimeContext _entityCtx)
    {
        boolean rtrn = true;
        DataEntityDataSourceRuntimeContext _dataSourceCtx = null;
        // save data sources in topological order.
        {
            // save/update data sources referenced by [NDXPOPspecificDataManagementLine].
            {
                // handle datasources which are part of extensions and need to be saved before [NDXPOPspecificDataManagementHeader]
                if(!this.preSaveDataSource(_entityCtx, 'NDXPOPspecificDataManagementHeader'))
                {
                    return false;
                }
                _dataSourceCtx = _entityCtx.getRuntimeContextByName('NDXPOPspecificDataManagementHeader');
                // propagates foreign key values from referenced data sources which are part of extensions.
                this.foreignKeyPropagationExtensions(_entityCtx, _dataSourceCtx);
                if(this.isAnyFieldSet_DS2(_dataSourceCtx.getBuffer(),_dataSourceCtx,_entityCtx))
                {
                    // invoke conflict detection for read-only data source.
                    NDXPOPspecificDataManagementHeader resolvedRecord = this.detectConflictForDataSource(_entityCtx, _dataSourceCtx);
                    if(!resolvedRecord)
                    {
                        NDXPOPspecificDataManagementHeader nDXPOPspecificDataManagementHeader_ = _dataSourceCtx.getBuffer();
                        if((nDXPOPspecificDataManagementHeader_.ID))
                        {
                            container dataSourceKeys = ["ID"];
                            container resolvedRecordValues = [resolvedRecord.ID];
                            container dataSourceConflictingValues = [nDXPOPspecificDataManagementHeader_.ID];
                            str errorMessage = "";
                            for(int i = 1; i <= conLen(dataSourceKeys); i++)
                            {
                                if(conPeek(dataSourceConflictingValues, i))
                                {
                                    errorMessage += strfmt("'%1': %2, ", conPeek(dataSourceKeys, i), conPeek(resolvedRecordValues, i));
                                }
                            }
                            errorMessage = strDel(errorMessage, strLen(errorMessage) - 1, 2);
                            checkFailed(strfmt("@ApplicationPlatform:DataEntityReadonlyDataSourceNotFoundWithKey", _dataSourceCtx.name(), errorMessage));
                            throw Exception::ViewDataSourceValidation;
                        }
                    }
                    // marks the read-only data source as 'saved' and skips actual insert/update operation.
                    _dataSourceCtx.setDataSaved(true);
                }
                // in case of update marks the read-only data source as 'saved' and skips actual insert/update operation.
                else if(_dataSourceCtx.getDatabaseOperation() == DataEntityDatabaseOperation::Update)
                {
                    _dataSourceCtx.setDataSaved(true);
                }
                _dataSourceCtx.setDatabaseOperation(DataEntityDatabaseOperation::None);
                // inserts/updates data source [NDXPOPspecificDataManagementHeader].
                if(!this.saveDataSource(_entityCtx, _dataSourceCtx))
                {
                    // returns from here if an inner joined data source fails to be saved.
                    return false;
                }
                this.postSaveDataSource();
            }
            {
                // handle datasources which are part of extensions and need to be saved before [InventTable]
                if(!this.preSaveDataSource(_entityCtx, 'InventTable'))
                {
                    return false;
                }
                _dataSourceCtx = _entityCtx.getRuntimeContextByName('InventTable');
                // propagates foreign key values from referenced data sources which are part of extensions.
                this.foreignKeyPropagationExtensions(_entityCtx, _dataSourceCtx);
                if(this.isAnyFieldSet_DS3(_dataSourceCtx.getBuffer(),_dataSourceCtx,_entityCtx))
                {
                    // invoke conflict detection for read-only data source.
                    InventTable resolvedRecord = this.detectConflictForDataSource(_entityCtx, _dataSourceCtx);
                    if(!resolvedRecord)
                    {
                        InventTable inventTable_ = _dataSourceCtx.getBuffer();
                        if((inventTable_.ItemId) || (inventTable_.Product))
                        {
                            container dataSourceKeys = ["ItemId", "Product"];
                            container resolvedRecordValues = [resolvedRecord.ItemId, resolvedRecord.Product];
                            container dataSourceConflictingValues = [inventTable_.ItemId, inventTable_.Product];
                            str errorMessage = "";
                            for(int i = 1; i <= conLen(dataSourceKeys); i++)
                            {
                                if(conPeek(dataSourceConflictingValues, i))
                                {
                                    errorMessage += strfmt("'%1': %2, ", conPeek(dataSourceKeys, i), conPeek(resolvedRecordValues, i));
                                }
                            }
                            errorMessage = strDel(errorMessage, strLen(errorMessage) - 1, 2);
                            checkFailed(strfmt("@ApplicationPlatform:DataEntityReadonlyDataSourceNotFoundWithKey", _dataSourceCtx.name(), errorMessage));
                            throw Exception::ViewDataSourceValidation;
                        }
                    }
                    // marks the read-only data source as 'saved' and skips actual insert/update operation.
                    _dataSourceCtx.setDataSaved(true);
                }
                // in case of update marks the read-only data source as 'saved' and skips actual insert/update operation.
                else if(_dataSourceCtx.getDatabaseOperation() == DataEntityDatabaseOperation::Update)
                {
                    _dataSourceCtx.setDataSaved(true);
                }
                _dataSourceCtx.setDatabaseOperation(DataEntityDatabaseOperation::None);
                // inserts/updates data source [InventTable].
                this.saveDataSource(_entityCtx, _dataSourceCtx);
                this.postSaveDataSource();
            }
            // handle datasources which are part of extensions and need to be saved before [NDXPOPspecificDataManagementLine]
            if(!this.preSaveDataSource(_entityCtx, 'NDXPOPspecificDataManagementLine'))
            {
                return false;
            }
            _dataSourceCtx = _entityCtx.getRuntimeContextByName('NDXPOPspecificDataManagementLine');
            // propagates foreign key values from referenced data sources which are part of extensions.
            this.foreignKeyPropagationExtensions(_entityCtx, _dataSourceCtx);
            // propagates foreign key values from referenced data sources.
            this.foreignKeyPropagation_DS1(_entityCtx, _dataSourceCtx.getBuffer());
            // inserts/updates data source [NDXPOPspecificDataManagementLine].
            if(!this.saveDataSource(_entityCtx, _dataSourceCtx))
            {
                // returns from here if the root data source fails to be saved.
                return false;
            }
            this.postSaveDataSource();
        }
        // handle datasources which are part of extensions and need to be saved in last 
        this.preSaveDataSource(_entityCtx, '');
        return rtrn;
    }
    protected boolean deleteDataSources(DataEntityRuntimeContext _entityCtx)
    {
        boolean rtrn = true;
        DataEntityDataSourceRuntimeContext _dataSourceCtx = null;
        // delete data sources in reverse topological order.
        {
            // handle datasources which are part of extensions and need to be saved before [NDXPOPspecificDataManagementLine]
            if(!this.preSaveDataSource(_entityCtx, 'NDXPOPspecificDataManagementLine'))
            {
                return false;
            }
            _dataSourceCtx = _entityCtx.getRuntimeContextByName('NDXPOPspecificDataManagementLine');
            // deletes data source [NDXPOPspecificDataManagementLine].
            if(!this.saveDataSource(_entityCtx, _dataSourceCtx))
            {
                // returns from here if the root data source fails to be saved.
                return false;
            }
            this.postSaveDataSource();
            // deletes data sources referenced by [NDXPOPspecificDataManagementLine].
            {
                // handle datasources which are part of extensions and need to be saved before [NDXPOPspecificDataManagementHeader]
                if(!this.preSaveDataSource(_entityCtx, 'NDXPOPspecificDataManagementHeader'))
                {
                    return false;
                }
                _dataSourceCtx = _entityCtx.getRuntimeContextByName('NDXPOPspecificDataManagementHeader');
                // skips delete operation against read-only data source.
                // marks the read-only data source as 'saved' and skips actual delete operation.
                _dataSourceCtx.setDataSaved(true);
                _dataSourceCtx.setDatabaseOperation(DataEntityDatabaseOperation::None);
                // deletes data source [NDXPOPspecificDataManagementHeader].
                if(!this.saveDataSource(_entityCtx, _dataSourceCtx))
                {
                    // returns from here if an inner joined data source fails to be saved.
                    return false;
                }
                this.postSaveDataSource();
            }
            {
                // handle datasources which are part of extensions and need to be saved before [InventTable]
                if(!this.preSaveDataSource(_entityCtx, 'InventTable'))
                {
                    return false;
                }
                _dataSourceCtx = _entityCtx.getRuntimeContextByName('InventTable');
                // skips delete operation against read-only data source.
                // marks the read-only data source as 'saved' and skips actual delete operation.
                _dataSourceCtx.setDataSaved(true);
                _dataSourceCtx.setDatabaseOperation(DataEntityDatabaseOperation::None);
                // deletes data source [InventTable].
                this.saveDataSource(_entityCtx, _dataSourceCtx);
                this.postSaveDataSource();
            }
        }
        // handle datasources which are part of extensions and need to be saved in last 
        this.preSaveDataSource(_entityCtx, '');
        return rtrn;
    }
