    private SalesLine LookForUniqueKeyMatch_DS1(SalesOrderLineV2Entity _salesOrderLineV2Entity, SalesLine _salesLine)
    {
        SalesLine salesLine_ = null;
        
        select
            forUpdate
            firstOnly
                salesLine_
        where
            salesLine_.InventTransId == _salesLine.InventTransId
        ;
        
        if (salesLine_)
        {
            return salesLine_;
        }
        
        select
            forUpdate
            firstOnly
                salesLine_
        where
            salesLine_.SalesId == _salesLine.SalesId && salesLine_.LineCreationSequenceNumber == _salesLine.LineCreationSequenceNumber
        ;
        
        if (salesLine_)
        {
            return salesLine_;
        }
        
        select
            forUpdate
            firstOnly
                salesLine_
        where
            salesLine_.SalesId == _salesLine.SalesId && salesLine_.LineNum == _salesLine.LineNum && salesLine_.RecId == _salesLine.RecId
        ;
        
        if (salesLine_)
        {
            return salesLine_;
        }
        
        select
            forUpdate
            firstOnly
                salesLine_
        where
            salesLine_.ItemId == _salesLine.ItemId && salesLine_.RecId == _salesLine.RecId
        ;
        
        if (salesLine_)
        {
            return salesLine_;
        }
        
        select
            forUpdate
            firstOnly
                salesLine_
        where
            salesLine_.SalesId == _salesLine.SalesId && salesLine_.SalesStatus == _salesLine.SalesStatus && salesLine_.SalesDeliverNow == _salesLine.SalesDeliverNow && salesLine_.InventTransId == _salesLine.InventTransId
        ;
        
        if (salesLine_)
        {
            return salesLine_;
        }
        
        select
            forUpdate
            firstOnly
                salesLine_
        where
            salesLine_.RecId == _salesLine.RecId && salesLine_.SalesQty == _salesLine.SalesQty
        ;
        
        if (salesLine_)
        {
            return salesLine_;
        }
        
        return salesLine_;
    }
    private ReasonTableRef LookForUniqueKeyMatch_DS10(SalesOrderLineV2Entity _salesOrderLineV2Entity, ReasonTableRef _creditNoteReasonTableRef)
    {
        ReasonTableRef reasonTableRef_ = null;
        
        select
            forUpdate
            firstOnly
                reasonTableRef_
        where
            reasonTableRef_.RecId == _creditNoteReasonTableRef.RecId
        ;
        
        if (reasonTableRef_)
        {
            return reasonTableRef_;
        }
        
