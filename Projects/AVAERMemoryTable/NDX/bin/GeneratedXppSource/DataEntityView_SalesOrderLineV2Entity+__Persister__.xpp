    protected void validateConfigurationKeys(DataEntityRuntimeContext _entityCtx)
    {
        // Ensure that the entity configuration key is enabled
        if(!isConfigurationKeyEnabled(configurationKeyName2Id('LogisticsBasic')))
        {
            // Entity configuration key is disabled
            throw error(strfmt("@ApplicationPlatform:DataEntityConfigKeyDisabled",'LogisticsBasic'));
        }
        if(!isConfigurationKeyEnabled(configurationKeyName2Id('LedgerBasic')))
        {
            if(this.isAnyMappedDataSourceFieldSet_DS6(_entityCtx.getEntityRecord(), 'LedgerBasic'))
            {
                // Outer joined data source configuration key is disabled and fields mapped to this data source are set
                throw error(strfmt("@ApplicationPlatform:DataEntityDataSourceConfigKeyDisabled",'InventDim','LedgerBasic'));
            }
        }
        if(!isConfigurationKeyEnabled(configurationKeyName2Id('LedgerBasic')))
        {
            if(this.isAnyMappedDataSourceFieldSet_DS10(_entityCtx.getEntityRecord(), 'LedgerBasic'))
            {
                // Outer joined data source configuration key is disabled and fields mapped to this data source are set
                throw error(strfmt("@ApplicationPlatform:DataEntityDataSourceConfigKeyDisabled",'CreditNoteReasonTableRef','LedgerBasic'));
            }
        }
        if(!isConfigurationKeyEnabled(configurationKeyName2Id('LedgerBasic')))
        {
            if(this.isAnyMappedDataSourceFieldSet_DS11(_entityCtx.getEntityRecord(), 'LedgerBasic'))
            {
                // Outer joined data source configuration key is disabled and fields mapped to this data source are set
                throw error(strfmt("@ApplicationPlatform:DataEntityDataSourceConfigKeyDisabled",'SalesLine_Intrastat','LedgerBasic'));
            }
        }
        if(!isConfigurationKeyEnabled(configurationKeyName2Id('MCRCallCenter')))
        {
            if(this.isAnyMappedDataSourceFieldSet_DS16(_entityCtx.getEntityRecord(), 'MCRCallCenter'))
            {
                // Outer joined data source configuration key is disabled and fields mapped to this data source are set
                throw error(strfmt("@ApplicationPlatform:DataEntityDataSourceConfigKeyDisabled",'MCRSalesLine','MCRCallCenter'));
            }
        }
        if(!isConfigurationKeyEnabled(configurationKeyName2Id('Retail')))
        {
            if(this.isAnyMappedDataSourceFieldSet_DS17(_entityCtx.getEntityRecord(), 'Retail'))
            {
                // Outer joined data source configuration key is disabled and fields mapped to this data source are set
                throw error(strfmt("@ApplicationPlatform:DataEntityDataSourceConfigKeyDisabled",'RetailSalesLine','Retail'));
            }
        }
    }
    protected int getValidTimeStateUpdateModeForDataSource(DataEntityRuntimeContext _entityCtx, int _dataSourceId, str _dataSourceName)
    {
        int validTimeStateUpdate_ = ValidTimeStateUpdate::CreateNewTimePeriod;
        
        // returns ValidTimeStateUpdate value for date effective data sources.
        
        switch (_dataSourceId)
        {
            case #LogisticsPostalAddressBaseEntity_ID:
                validTimeStateUpdate_ = ValidTimeStateUpdate::CreateNewTimePeriod;
                break;
            default : validTimeStateUpdate_ = super(_entityCtx,_dataSourceId,_dataSourceName);
        }
        return validTimeStateUpdate_;
    }
    protected boolean hasDataSourceRecordChanged(int _dataSourceId, common _originalRecord, common _updatedRecord)
    {
        boolean hasDataSourceRecordChanged_ = true;
        
        // The method is called for OCC validation and only upon data sources that have One-to-Many relationships.
        
        switch (_dataSourceId)
        {
            case #EcoResCategory_ID:
                hasDataSourceRecordChanged_ = this.hasDataSourceRecordChanged_DS2(_originalRecord, _updatedRecord);
                break;
            case #InventDim_ID:
                hasDataSourceRecordChanged_ = this.hasDataSourceRecordChanged_DS6(_originalRecord, _updatedRecord);
                break;
            case #LogisticsPostalAddressBaseEntity_ID:
                hasDataSourceRecordChanged_ = this.hasDataSourceRecordChanged_DS7(_originalRecord, _updatedRecord);
                break;
            case #EcoResCategory_IntrastatCommodity_ID:
                hasDataSourceRecordChanged_ = this.hasDataSourceRecordChanged_DS8(_originalRecord, _updatedRecord);
                break;
            case #TaxWithholdItemGroupHeading_TH_ID:
                hasDataSourceRecordChanged_ = this.hasDataSourceRecordChanged_DS9(_originalRecord, _updatedRecord);
                break;
            case #CreditNoteReasonTableRef_ID:
                hasDataSourceRecordChanged_ = this.hasDataSourceRecordChanged_DS10(_originalRecord, _updatedRecord);
                break;
            case #DeliveryCFOPTable_ID:
                hasDataSourceRecordChanged_ = this.hasDataSourceRecordChanged_DS13(_originalRecord, _updatedRecord);
                break;
            case #CFOPTable_BR_ID:
                hasDataSourceRecordChanged_ = this.hasDataSourceRecordChanged_DS14(_originalRecord, _updatedRecord);
                break;
            case #FiscalDocumentType_BR_ID:
                hasDataSourceRecordChanged_ = this.hasDataSourceRecordChanged_DS15(_originalRecord, _updatedRecord);
                break;
        }
        return hasDataSourceRecordChanged_;
    }
