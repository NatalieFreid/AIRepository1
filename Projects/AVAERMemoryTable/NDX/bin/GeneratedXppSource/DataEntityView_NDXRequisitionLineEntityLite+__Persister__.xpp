Private class __Persister__
extends SysDataEntityPersister
{
    // Data source ID macros
    #define.NDXRequisitionLine_ID(1)
    
    // Data source buffers
    NDXRequisitionLine m_NDXRequisitionLine;
    
    protected void mapEntityToDataSources(DataEntityRuntimeContext _entityCtx)
    {
        this.validateFieldFailed = false;
        this.mapEntityToDataSource(_entityCtx, _entityCtx.getRuntimeContextByName('NDXRequisitionLine'));
        this.mapEntityToDataSourcesExtensions(_entityCtx);
        if(this.validateFieldFailed)
        {
            throw Exception::ViewDataSourceValidation;
        }
    }
    protected boolean saveDataSources(DataEntityRuntimeContext _entityCtx)
    {
        boolean rtrn = true;
        DataEntityDataSourceRuntimeContext _dataSourceCtx = null;
        // save data sources in topological order.
        {
            // handle datasources which are part of extensions and need to be saved before [NDXRequisitionLine]
            if(!this.preSaveDataSource(_entityCtx, 'NDXRequisitionLine'))
            {
                return false;
            }
            _dataSourceCtx = _entityCtx.getRuntimeContextByName('NDXRequisitionLine');
            // propagates foreign key values from referenced data sources which are part of extensions.
            this.foreignKeyPropagationExtensions(_entityCtx, _dataSourceCtx);
            // inserts/updates data source [NDXRequisitionLine].
            if(!this.saveDataSource(_entityCtx, _dataSourceCtx))
            {
                // returns from here if the root data source fails to be saved.
                return false;
            }
            this.postSaveDataSource();
        }
        // handle datasources which are part of extensions and need to be saved in last 
        this.preSaveDataSource(_entityCtx, '');
        return rtrn;
    }
    protected boolean deleteDataSources(DataEntityRuntimeContext _entityCtx)
    {
        boolean rtrn = true;
        DataEntityDataSourceRuntimeContext _dataSourceCtx = null;
        // delete data sources in reverse topological order.
        {
            // handle datasources which are part of extensions and need to be saved before [NDXRequisitionLine]
            if(!this.preSaveDataSource(_entityCtx, 'NDXRequisitionLine'))
            {
                return false;
            }
            _dataSourceCtx = _entityCtx.getRuntimeContextByName('NDXRequisitionLine');
            // deletes data source [NDXRequisitionLine].
            if(!this.saveDataSource(_entityCtx, _dataSourceCtx))
            {
                // returns from here if the root data source fails to be saved.
                return false;
            }
            this.postSaveDataSource();
        }
        // handle datasources which are part of extensions and need to be saved in last 
        this.preSaveDataSource(_entityCtx, '');
        return rtrn;
    }
    private void mapToDataSource_DS1(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx, NDXRequisitionLine _nDXRequisitionLine, NDXRequisitionLineEntityLite _nDXRequisitionLineEntityLite)
    {
        this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _nDXRequisitionLineEntityLite, fieldnum(NDXRequisitionLineEntityLite, ItemId), _nDXRequisitionLine, fieldnum(NDXRequisitionLine, ItemId), 1);
        this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _nDXRequisitionLineEntityLite, fieldnum(NDXRequisitionLineEntityLite, Qty01), _nDXRequisitionLine, fieldnum(NDXRequisitionLine, Qty01), 1);
        
        this.mapToDataSourceExtensions(_dataSourceCtx, _nDXRequisitionLine, _nDXRequisitionLineEntityLite);
        _nDXRequisitionLine.trackFieldExternallySet(false);
    }
    protected void doMapEntityToDataSource(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        switch(_dataSourceCtx.id())
        {
            case #NDXRequisitionLine_ID:
                this.mapToDataSource_DS1(_entityCtx, _dataSourceCtx, _dataSourceCtx.getBuffer(), _entityCtx.getEntityRecord());
                break;
            default :
                this.doMapEntityToDataSourceExtensions(_entityCtx, _dataSourceCtx);
                break;
        }
    }
    private void mapFromDataSource_DS1(DataEntityDataSourceRuntimeContext _dataSourceCtx, NDXRequisitionLine _nDXRequisitionLine, NDXRequisitionLineEntityLite _nDXRequisitionLineEntityLite)
    {
        this.mapDataSourceFieldToEntityField(_nDXRequisitionLine, fieldnum(NDXRequisitionLine, ItemId), _nDXRequisitionLineEntityLite, fieldnum(NDXRequisitionLineEntityLite, ItemId), false);
        this.mapDataSourceFieldToEntityField(_nDXRequisitionLine, fieldnum(NDXRequisitionLine, Qty01), _nDXRequisitionLineEntityLite, fieldnum(NDXRequisitionLineEntityLite, Qty01), false);
        this.mapFromDataSourceExtensions(_dataSourceCtx, _nDXRequisitionLine, _nDXRequisitionLineEntityLite);
        // map system fields (e.g. recid and recversion) from data source buffer to view record.
        _nDXRequisitionLineEntityLite.fromViewDataSource(_dataSourceCtx.id(), _nDXRequisitionLine);
    }
    protected void doMapDataSourceToEntity(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        switch(_dataSourceCtx.id())
        {
            case #NDXRequisitionLine_ID:
                this.mapFromDataSource_DS1(_dataSourceCtx, _dataSourceCtx.getBuffer(), _entityCtx.getEntityRecord());
                break;
            default :
                this.doMapDataSourceToEntityExtensions(_entityCtx, _dataSourceCtx);
                break;
        }
    }
    protected Common doFindDataSource(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        Common rtrn = null;
        switch(_dataSourceCtx.id())
        {
            case #NDXRequisitionLine_ID:
                rtrn = this.LookForUniqueKeyMatch_DS1(_entityCtx.getEntityRecord(), _dataSourceCtx.getBuffer());
                break;
            default :
                rtrn = this.doFindDataSourceExtensions(_entityCtx, _dataSourceCtx);
                break;
        }
        return rtrn;
    }
    protected boolean isAnyMappedDataSourceFieldSet_DS1(NDXRequisitionLineEntityLite _nDXRequisitionLineEntityLite, str disabledConfigKey = null)
    {
        boolean rtrn = false;
        if(_nDXRequisitionLineEntityLite.isFieldSet(fieldnum(NDXRequisitionLineEntityLite, ItemId)))
        {
            return true;
        }
        if(_nDXRequisitionLineEntityLite.isFieldSet(fieldnum(NDXRequisitionLineEntityLite, Qty01)))
        {
            return true;
        }
        rtrn = this.isAnyMappedDataSourceExtensionFieldSet(_nDXRequisitionLineEntityLite, 'NDXRequisitionLine', disabledConfigKey);
        return rtrn;
    }
    protected boolean isAnyMappedDataSourceFieldSet(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        boolean rtrn = false;
        switch(_dataSourceCtx.id())
        {
            case #NDXRequisitionLine_ID:
                rtrn = this.isAnyMappedDataSourceFieldSet_DS1(_entityCtx.getEntityRecord());
                break;
            default :
                rtrn = this.isAnyMappedDataSourceFieldSet_DSExtensions(_entityCtx, _dataSourceCtx);
                break;
        }
        return rtrn;
    }
    private boolean validateDataSource_DS1(DataEntityRuntimeContext _entityCtx, NDXRequisitionLineEntityLite _nDXRequisitionLineEntityLite, DataEntityDataSourceRuntimeContext _dataSourceCtx, NDXRequisitionLine _nDXRequisitionLine)
    {
        boolean rtrn = true;
        rtrn = this.validateMappedDataSourceField(_entityCtx, _dataSourceCtx, '', '', conNull(), _nDXRequisitionLineEntityLite, fieldnum(NDXRequisitionLineEntityLite, ItemId), 'NDXRequisitionLineEntityLite.ItemId', _nDXRequisitionLine, fieldnum(NDXRequisitionLine, ItemId), false/*disallowEditOnCreate*/, true/*disallowEdit*/, true/*callValidateField*/, 1) ? rtrn : false;
        rtrn = this.validateMappedDataSourceField(_entityCtx, _dataSourceCtx, '', '', conNull(), _nDXRequisitionLineEntityLite, fieldnum(NDXRequisitionLineEntityLite, Qty01), 'NDXRequisitionLineEntityLite.Qty01', _nDXRequisitionLine, fieldnum(NDXRequisitionLine, Qty01), false/*disallowEditOnCreate*/, false/*disallowEdit*/, true/*callValidateField*/, 1) ? rtrn : false;
        rtrn = this.validateDataSourceExtensions(_entityCtx, _nDXRequisitionLineEntityLite, _dataSourceCtx, _nDXRequisitionLine) ? rtrn : false;
        return rtrn;
    }
    protected boolean validateDataSource(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        boolean rtrn = true;
        switch(_dataSourceCtx.id())
        {
            case #NDXRequisitionLine_ID:
                rtrn = this.validateDataSource_DS1(_entityCtx,_entityCtx.getEntityRecord(),_dataSourceCtx,_dataSourceCtx.getBuffer());
                break;
            default :
                rtrn = this.validateDataSourceExtensions_DSExtensions(_entityCtx, _dataSourceCtx);
                break;
        }
        return rtrn;
    }
    private void mapToMatchingRecord_DS1(DataEntityDataSourceRuntimeContext _dataSourceCtx, NDXRequisitionLine _nDXRequisitionLine, NDXRequisitionLine _matchingRecord)
    {
        // map data changes in bound fields.
        this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _nDXRequisitionLine, fieldnum(NDXRequisitionLine, ItemId), _matchingRecord, fieldnum(NDXRequisitionLine, ItemId), 1);
        this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _nDXRequisitionLine, fieldnum(NDXRequisitionLine, Qty01), _matchingRecord, fieldnum(NDXRequisitionLine, Qty01), 1);
        this.mapToMatchingRecordExtensions(_dataSourceCtx, tablestr(NDXRequisitionLineEntityLite), _nDXRequisitionLine, _matchingRecord);
    }
    protected void mapDataSourceToMatchingRecord(DataEntityDataSourceRuntimeContext _dataSourceCtx, Common _matchingRecord)
    {
        switch(_dataSourceCtx.id())
        {
            case #NDXRequisitionLine_ID:
                this.mapToMatchingRecord_DS1(_dataSourceCtx, _dataSourceCtx.getBuffer(), _matchingRecord);
                break;
            default :
                this.mapDataSourceToMatchingRecordExtensions(_dataSourceCtx, _matchingRecord);
                break;
        }
    }
    protected void validateConfigurationKeys(DataEntityRuntimeContext _entityCtx)
    {
    }
    protected void initializeDataSources(DataEntityRuntimeContext _entityCtx)
    {
        this.initializeDataSource(_entityCtx, 'NDXRequisitionLine', m_NDXRequisitionLine, this.getDataSourceId('NDXRequisitionLine'), this.getDataSourceRuntimeId('NDXRequisitionLine'), false/* optional */, false/* readonly */, false/* oneToMany */, false/* dateEffective */, false/* applyDateFilter */);
        this.initializeDataSourcesExtensions(_entityCtx);
    }
    private NDXRequisitionLine LookForUniqueKeyMatch_DS1(NDXRequisitionLineEntityLite _nDXRequisitionLineEntityLite, NDXRequisitionLine _nDXRequisitionLine)
    {
        NDXRequisitionLine nDXRequisitionLine_ = null;
        
        select
            forUpdate
            firstOnly
                nDXRequisitionLine_
        where
            nDXRequisitionLine_.LevelString == _nDXRequisitionLine.LevelString && nDXRequisitionLine_.RequisitionId == _nDXRequisitionLine.RequisitionId
        ;
        
        if (nDXRequisitionLine_)
        {
            return nDXRequisitionLine_;
        }
        
        return nDXRequisitionLine_;
    }

}

