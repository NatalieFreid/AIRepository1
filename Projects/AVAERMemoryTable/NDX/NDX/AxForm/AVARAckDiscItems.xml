        public void executeQuery()
        {
            QueryBuildDataSource    qbds;

            qbds = this.queryBuildDataSource();
            if (inventTable.RecId)
            {
                SysQuery::findOrCreateRange(qbds, fieldNum(AVARackDiscItems, ItemId)).value(SysQuery::value(inventTable.ItemId));
            }
            else if (custTable.RecId)
            {
                SysQuery::findOrCreateRange(qbds, fieldNum(AVARackDiscItems, CustAccount)).value(SysQuery::value(custTable.AccountNum));
            }
            else if (smmBusRelChainGroup.RecId)
            {
                SysQuery::findOrCreateRange(qbds, fieldNum(AVARackDiscItems, smmChainId)).value(SysQuery::value(smmBusRelChainGroup.ChainId));
            }
           
            super();
        }

]]></Source>
