				<Source><![CDATA[
    /// <summary>
    /// run method
    /// </summary>
    public void run()
    {
        boolean             filterLookup    = false;

        if (callingNameControl && callingNameControl.text() && callingNameControl.hasChanged())
        {
            filterLookup = true;
            purchAgreementHeader_ds.autoSearch(false);
        }

        super();
    }

