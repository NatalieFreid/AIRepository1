				<Source><![CDATA[
    /// <summary>
    /// init method
    /// </summary>
    public void init()
    {
        super();
        if (! element.args() ||
            ! element.args().caller() ||
            element.args().caller().handle() != classNum(FormStringControl))
        {
            throw error("@SYS22539");
        }

        element.selectMode(PurchAgreementHeader_PurchNumberSequence);
    }

]]></Source>
