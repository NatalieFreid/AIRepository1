    /// <summary>
    /// closeSelect method
    /// </summary>
    /// <param name = "p1">selected return string</param>
    public void closeSelect(str p1)
    {
        agreementLine_ds.leaveRecord();

        if (callingIdControl)
        {
            reqPo.AVAAgreementLineRecId = AgreementLine.RecId;
            super(p1);
        }
        else
        {
            super(p1);
        }
    }

