				<Source><![CDATA[
[Form]
public class AVACRLRiscDebtor extends FormRun
{
    CredManCreditLimitId					creditLimitId;
    AVARiscDebtor                           riscDebtor;

}
]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        CredManCreditLimitCustGroup				creditLimitCustGroup;
        CredManCreditLimitCustGroupLine			creditLimitCustGroupLine;
        CustTable								custTableCaller;

        super();
    
        if(element.args() && element.args().record())
        {
            switch(element.args().dataset())
            {
                case tableNum(CredManCreditLimitCustGroup):
                    creditLimitCustGroup = element.args().record();
                    creditLimitId = creditLimitCustGroup.CreditLimitId;
                    riscDebtor = creditLimitCustGroup.AVARiscDebtor;
                    break;
                
                case tableNum(CustTable):
                    custTableCaller = element.args().record();
                    
                    select firstonly creditLimitCustGroupLine
                        where creditLimitCustGroupLine.custAccount == custTableCaller.AccountNum
                           && creditLimitCustGroupLine.company == custTableCaller.DataAreaId
                    join creditLimitCustGroup
                        where creditLimitCustGroup.RecId == creditLimitCustGroupLine.CreditLimitCustGroup;

                    creditLimitId = creditLimitCustGroup.CreditLimitId;
                    riscDebtor = creditLimitCustGroup.AVARiscDebtor;
                    break;
                
                default:
                    throw error(error::missingFormActiveBuffer(element.design().caption()));
            }
    
            if( !creditLimitId)
            {
                throw error("@AVAFCM:CreditLimitError");
            }
        }
        else
        {
            throw error(error::missingFormActiveBuffer(element.design().caption()));
        }

    }

]]></Source>
			</Method>
		</Methods>
