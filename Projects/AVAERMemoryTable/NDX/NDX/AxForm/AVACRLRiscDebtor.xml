						<Name>executeQuery</Name>
						<Source><![CDATA[
        /// <summary>
        /// AVA
        /// </summary>
        public void executeQuery()
        {
            QueryBuildDataSource    qbds;

            qbds = this.queryBuildDataSource();
            if (creditLimitId)
            {
                SysQuery::findOrCreateRange(qbds, fieldNum(AVAcreditLimitGroupValues, CredManCreditLimitId)).value(SysQuery::value(creditLimitId));
            }
           
            super();
        }

]]></Source>
					</Method>
				</Methods>
				<Fields />
			</DataSource>
			<DataSource>
				<Name>AVACreditLimitExceed</Name>
				<Methods>
					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
        /// <summary>
        /// AVA
        /// </summary>
        public void executeQuery()
        {
            QueryBuildDataSource    qbds;

            qbds = this.queryBuildDataSource();
            if (creditLimitId)
            {
                qbds.clearDynalinks();
                SysQuery::findOrCreateRange(qbds, fieldNum(AVACreditLimitExceed,CredManCreditLimitId)).value(SysQuery::value(creditLimitId));
                SysQuery::findOrCreateRange(qbds, fieldNum(AVACreditLimitExceed, CustAccount)).value(SysQuery::value(riscDebtor));
            }
           
            super();
        }

]]></Source>
