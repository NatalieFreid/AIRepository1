						<Source><![CDATA[
        /// <summary>
        ///     AVA <c>modified</c> method.
        /// </summary>
        /// <returns>
        ///     <c>boolean</c> as return value
        /// </returns>
        public boolean modified()
        {
            boolean ret;

            InventSiteId    qValue;
    
            ret = super();
    
            qValue = this.valueStr();

            if (qValue != '')
            {
                SysQuery::findOrCreateRange(SalesTable_DS.queryBuildDataSource(), fieldNum(SalesTable, InventSiteId)).value(queryValue(qValue));
            }
            else
            {
                SysQuery::findOrCreateRange(SalesTable_DS.queryBuildDataSource(), fieldNum(SalesTable, InventSiteId)).value(SysQueryRangeUtil::valueUnlimited());
            }

            SalesTable_DS.executeQuery();
            
            return ret;
        }

]]></Source>
