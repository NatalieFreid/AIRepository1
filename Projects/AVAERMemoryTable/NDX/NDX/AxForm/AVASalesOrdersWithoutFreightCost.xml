        public boolean modified()
        {
            boolean ret;

            NoYes    qValue;
    
            ret = super();
    
            qValue = this.value();

            if (qValue == NoYes::No)
            {
                SysQuery::findOrCreateRange(SalesTable_DS.queryBuildDataSource(), fieldNum (SalesTable, KCS_FreightCosts)).value(queryValue(0));
            }
            else
