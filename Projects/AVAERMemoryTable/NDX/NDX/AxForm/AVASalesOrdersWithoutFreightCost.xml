				<Source><![CDATA[
[Form]
public class AVASalesOrdersWithoutFreightCost extends FormRun
{
    InventSiteId        frmInitialInventSiteId;
    UserId              frmUserId;
    HcmWorkerRecId      frmHcmWorkerRecId;
    HCMWorker           frmHCMWorker;
    AVAWorkerInventSite frmAVAWorkerInventSite;

}
]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    /// <summary>
    ///     AVA <c>init</c> method.
    /// </summary>
    public void init()
    {
        frmUserId               = curUserId();
        frmHcmWorkerRecId       = HcmWorkerLookup::currentWorker();
        frmHCMWorker            = HCMWorker::find(frmHcmWorkerRecId);
        frmAVAWorkerInventSite  = AVAWorkerInventSite::find(frmHCMWorker.PersonnelNumber);

        frmInitialInventSiteId = frmAVAWorkerInventSite.InventSiteId;

        super();

        GridFilterInventSiteId.text(frmInitialInventSiteId);
        
        this.addFilterPaneRanges();

        GridFilterInventSiteId.enabled(true);
    }

]]></Source>
			</Method>
			<Method>
				<Name>addFilterPaneRanges</Name>
				<Source><![CDATA[
    /// <summary>
    ///     AVA <c>addFilterPaneRanges</c> method.
    /// </summary>
    public void addFilterPaneRanges()
    {
        QueryBuildDataSource salesTableQBDS;

        salesTableQBDS = SalesTable_DS.query().dataSourceName(SalesTable_DS.name());
        
        SysQuery::findOrCreateRange(salesTableQBDS, fieldNum(SalesTable, InventSiteId));
    }

]]></Source>
			</Method>
		</Methods>
		<DataSources xmlns="">
			<DataSource>
				<Name>SalesTable</Name>
				<Methods>
					<Method>
						<Name>init</Name>
						<Source><![CDATA[
        /// <summary>
        ///     AVA <c>init</c> method.
        /// </summary>
        public void init()
        {
            Query                   locQuery;
            QueryBuildDataSource    locQbds;
            QueryBuildRange         locQbr;

            super();

            locQuery = this.query();

            locQbds = locQuery.dataSourceTable(tableNum(SalesTable));
            locQbr  = locQbds.addRange(fieldNum (SalesTable, InventSiteId));
            if(frmInitialInventSiteId)
            {
                locQbr.value(queryValue(frmInitialInventSiteId));
            }
            else
            {
                locQbr.value(SysQueryRangeUtil::valueUnlimited());
            }
            locQbr  = locQbds.addRange(fieldNum (SalesTable, KCS_FreightCostStatus));
            locQbr.value(queryValue(KCS_FreightCostStatus::Required));
            locQbr  = locQbds.addRange(fieldNum (SalesTable, KCS_FreightCosts));
            locQbr.value(queryValue(0));
        }

]]></Source>
					</Method>
				</Methods>
