					<Method>
						<Name>avaDisplayHK2PriceDisc</Name>
						<Source><![CDATA[
        /// <summary>
        /// Returns the amount for HK relevant charges with factors
        /// </summary>
        /// <returns>Amount</returns>
        [SysClientCacheDataMethodAttribute(true)]
        display public Amount avaDisplayHK2PriceDisc()
        {
            PriceUnit       priceUnit = priceDiscTable.priceUnit;
            priceUnit = priceUnit != 0 ? priceUnit : 1;
            //return PriceDiscTable.AVAchargeAmountInventUnit(calculationDate.dateValue()) * InventTable.avaGetHK2Factor(calculationDate.dateValue()) * InventTable.avaGetMGKFactor();
            return PriceDiscTable.AVAchargeAmountInventUnit(calculationDate.dateValue()) * InventTable.ndxGetHK2Factor(calculationDate.dateValue()) * InventTable.avaGetMGKFactor();
        }

]]></Source>
