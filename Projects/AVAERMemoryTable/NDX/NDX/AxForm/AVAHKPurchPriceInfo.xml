					<Method>
						<Name>avaDisplayPricePerUnit</Name>
						<Source><![CDATA[
        /// <summary>
        /// Displays the Price per single unit
        /// </summary>
        /// <returns>Amount</returns>
        [SysClientCacheDataMethodAttribute(true)]
        display public Amount avaDisplayPricePerUnit()
        {
          //  PriceUnit       inventTablePriceUnit = InventTable::find(PriceDiscTable.ItemRelation).inventTableModulePurch().PriceUnit;
          //  inventTablePriceUnit = inventTablePriceUnit != 0 ? inventTablePriceUnit : 1;
            return priceDiscTable.avaCalcPricePerUnit(calculationDate.dateValue()) * PriceDiscTable.priceUnit;
        }

]]></Source>
