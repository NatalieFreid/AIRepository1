        /// <summary>
        /// designed from AVA
        /// </summary>
        public void clicked()
        {
            AVASFCFeedback      localSFCFeedback;
            Set                 ndxSfcIdSet = new Set(Types::String);
            SetIterator         ndxSfcIdSetIterator;
            super();

            for (localSFCFeedback = AVASFCFeedback_ds.getFirst(true) ? AVASFCFeedback_ds.getFirst(true) : AVASFCFeedback;
                localSFCFeedback;
                localSFCFeedback = AVASFCFeedback_ds.getNext())
            {
                ndxSfcIdSet.add(localSFCFeedback.NdxSFCId);
            }

            ndxSfcIdSetIterator = new SetIterator(ndxSfcIdSet);

            while (ndxSfcIdSetIterator.more())
            {
                AVASFCFeedbackPost::processFromCallerSFC(ndxSfcIdSetIterator.value());
                ndxSfcIdSetIterator.next();
            }


        }

]]></Source>
