						<Source><![CDATA[
        /// <summary>
        /// AVAZ5A
        /// </summary>
        public void clicked()
        {
            MenuFunction mf;
            Args         args;
            GeneralJournalEntry generalJournalEntry;

            super();

            //BP deviation documented
            select firstOnly generalJournalEntry where generalJournalEntry.SubledgerVoucher == AVAListZ5ADataDetails.Voucher;

            if(generalJournalEntry.RecId)
            {
                args = new args();
                args.record(generalJournalEntry);
                args.caller(this);

                mf = new MenuFunction(menuitemdisplaystr(LedgerTransVoucher),MenuItemType::Display);
                mf.run(args);
            }
            else
            {
                info(strFmt("@NDX:AVAZ5AErrorVoucher",AVAListZ5ADataDetails.Voucher));
            }
        }

]]></Source>
