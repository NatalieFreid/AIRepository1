					<Method>
						<Name>modified</Name>
						<Source><![CDATA[
        public boolean modified()
        {
            boolean ret;

            if (!ContactPerson::find(Grid_editContactPersonName.text()))
            {
                KCS_KBVRelationsToBV.ContactPersonId = ContactPerson::findOrCreateNameParty(KCS_KBVRelationsToBV.DirPartyId, Grid_editContactPersonName.text()).ContactPersonId;
            }
            KCS_KBVRelationsToBV.ContactPersonParty = ContactPerson::find(KCS_KBVRelationsToBV.ContactPersonId).Party;

            ret = super();

            return ret;
        }

