			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        CustQuotationTrans  custQuotationTransLocal;
        TmpFrmVirtual       tmpFrmVirtual;

        super();

        if (!this.args().caller() &&
        this.args().dataset() != tableNum(TmpFrmVirtual))
        {
            throw error("@SYS59200");
        }

        tmpFrmVirtual           = this.args().record();
        custQuotationTransLocal = CustQuotationTrans::findRecId(tmpFrmVirtual.RecordNo);
        salesQuotationTable     = custQuotationTransLocal.custQuotationJour().salesQuotationTable();

        element.design().caption(strfmt('%1: %2', "@SYS5864",  salesQuotationTable.QuotationId));
        StrStaticText.text(strfmt("@NDX:NXAQuotStatusStaticTxt", salesQuotationTable.QuotationId));


    }

]]></Source>
