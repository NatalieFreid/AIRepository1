			<Method>
				<Name>updateQuotationSum</Name>
				<Source><![CDATA[
    /// <summary>
    /// sums AX2009 amount of all existing records in query and sets control with value
    /// </summary>
    public void updateQuotationSum()
    {
        // Copy the query
        Query query = new Query(AVAAX2009Ordered_ds.queryRun().query());
 
        QueryBuildDataSource qbds = query.dataSourceTable(tableNum(AVAAX2009Ordered));
        QueryRun qr;
        AVAAX2009Ordered summedTrans;
 
        // Sum LineAmountMst
        qbds.addSelectionField(fieldNum(AVAAX2009Ordered, AX2009Amount), SelectionField::Sum);
 
        qr = new QueryRun(query);
        // Run the query
        qr.next();
 
        // Get the data
        summedTrans = qr.get(tableNum(AVAAX2009Ordered));
 
        // Set the new sum to the control
        QuotationSum.realValue(summedTrans.AX2009Amount);
    }

]]></Source>
			</Method>
