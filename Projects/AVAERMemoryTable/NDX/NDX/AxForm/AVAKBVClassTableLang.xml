						<Name>clicked</Name>
						<Source><![CDATA[
        void clicked()
        {
            SysTranslationHelper sysTranslationHelper;

            sysTranslationHelper = new SysTranslationHelper(tableNum(KCS_KBVClassTable),
                                                            tableNum(NDX_KBVClassTableLang));

            // this is to show KCS_KBVClassTable.KCS_KBVClassID, which is not a/part of NaturalKey, in the SysTranslation grid form.
            // due to no unique index on KCS_KBVRelations table below line is required.
            // Please note that “setMainTableNaturalKeyFieldId” is a misnomer – it basically allows any (one) given field to be specified to appear in TranslationList form instead of the NaturalKey field
            sysTranslationHelper.setMainTableNaturalKeyFieldId(fieldNum(KCS_KBVClassTable, KCS_KBVClassID));
            //element.addFiltersToEcoResAttributeDS(sysTranslationHelper.parmSystemLanguageBaseTableQuery().dataSourceTable(tableNum(KCS_KBVRelations)));
            sysTranslationHelper.launchTranslationDetailForm(KCS_KBVClassTable.RecId);

            super();

            KCS_KBVClassTable_DS.research(true);
        }

]]></Source>
					</Method>
				</Methods>
			</Control>
