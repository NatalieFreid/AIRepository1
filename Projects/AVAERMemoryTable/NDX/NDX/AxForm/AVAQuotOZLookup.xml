			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        super();

        element.selectMode(KCS_GAEBPos_OZ);
        KCS_GAEBPos_ds.queryBuildDataSource().addSortField(fieldNum(KCS_GAEBPos, RecId),SortOrder::Ascending);
    }

