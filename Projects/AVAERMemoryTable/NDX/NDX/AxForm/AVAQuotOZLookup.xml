				<Methods>
					<Method>
						<Name>init</Name>
						<Source><![CDATA[
        public void init()
        {
            Query                   q = new Query();
            QueryBuildDataSource    qbds;
            QueryBuildRange         qbr;
            SalesQuotationTable     salesQuotationTable;
            SalesQuotationLine      salesQuotationLine;
            num                     lfdNr;

            super();

            salesQuotationTable = element.args().record();

            //select maxof(LfdNr) from localKCS_GAEBPos join salesQuotationLine where
            select maxof(LfdNrInt) from localKCS_GAEBPos join salesQuotationLine where
                                                   salesQuotationLine.KCS_GAEBOZ != '' &&
                                                   salesQuotationLine.KCS_GAEBOZ == localKCS_GAEBPos.OZ &&
                                                   localKCS_GAEBPos.ImportID == salesQuotationTable.KCS_GAEBImportID &&
                                                   salesQuotationLine.QuotationId == salesQuotationTable.QuotationId;


            //lfdNr = int2Str(str2Int(localKCS_GAEBPos.LfdNr) + 1);
            lfdNr = int2Str(localKCS_GAEBPos.LfdNrInt + 1);

            select localKCS_GAEBPos where localKCS_GAEBPos.LfdNr == lfdNr &&
                                  localKCS_GAEBPos.ImportID == salesQuotationTable.KCS_GAEBImportID;


            qbds = q.addDataSource(tablenum(KCS_GAEBPos));
            qbr = qbds.addRange(fieldnum(KCS_GAEBPos, ImportID));
            qbr.value(QueryValue(salesQuotationTable.KCS_GAEBImportID));

            this.query(q);
        }

]]></Source>
					</Method>
					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
        public void executeQuery()
        {
            super();

            //KCS_GAEBPos_DS.findValue(fieldnum(KCS_GAEBPos, LfdNr), QueryValue(localKCS_GAEBPos.LfdNr));
            KCS_GAEBPos_ds.positionToRecordByValue(fieldNum(KCS_GAEBPos, lfdNr), queryvalue(localKCS_GAEBPos.LfdNr));
        }

]]></Source>
