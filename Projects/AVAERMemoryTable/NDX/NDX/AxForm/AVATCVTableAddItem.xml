				<Source><![CDATA[
    public void init()
    {
        //Common                  commonForEmptyTitleDS;
       
        super();

        if (!element.args() ||
            !element.args().caller() ||
            !element.args().record() ||
            !element.args().dataset() ||
            element.args().dataset() != tablenum(KCS_TCVTable))
        {
            throw error(strfmt("@SYS22678",element.name()));
        }

        if (element.args().dataset() == tableNum(KCS_TCVTable))
        {
            //KCS_TCVTable        locTCVTable;
            tcvTable = element.args().record();
            //tcvTableDS = tcvTable.dataSource();
            tcvTableDS = FormDataUtil::getFormDataSource(tcvTable);
            tcvTable.data(element.args().record());
            tcvId   = tcvTable.Id;
        }
        caller = element.args().caller();

        //super();
        //element.args().record(commonForEmptyTitleDS);
    }

]]></Source>
