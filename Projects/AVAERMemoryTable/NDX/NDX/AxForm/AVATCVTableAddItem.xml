			<Method>
				<Name>selectProduct</Name>
				<Source><![CDATA[
    /// <summary>
    ///  Adds the selected <c>inventTable</c> record to the temporary table.
    /// </summary>
    void selectProduct()
    {
        InventTable             selectedInventTable;
        AVATCVQuotationItems    tmpQuotationItems/*, existingQuotationItems*/;

        tmpQuotationItems.setTmp();

        // Are there any marked records?
        for ( selectedInventTable = InventTable_ds.getFirst(1)?InventTable_ds.getFirst(1):Inventtable_ds.cursor();
        selectedInventTable;
        selectedInventTable = InventTable_ds.getNext())
        {
            tmpQuotationItems.setTmpData(SelectedItems);
            select firstonly tmpQuotationItems
                //where tmpQuotationItems.TCVTableId == tcvTable.Id
                where tmpQuotationItems.TCVTableId == tcvId
                    && tmpQuotationItems.ItemId == selectedInventTable.ItemId;

            if (!tmpQuotationItems.RecId)
            {
                tmpQuotationItems.clear();
                tmpQuotationItems.initValue();
                //tmpQuotationItems.TCVTableId            = tcvTable.Id;
                tmpQuotationItems.TCVTableId            = tcvId;
                tmpQuotationItems.ItemId                = selectedInventTable.ItemId;

                tmpQuotationItems.doInsert();
            }
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>updateQuotationItems</Name>
				<Source><![CDATA[
    /// <summary>
    ///  Adds all the records from the temporary table to the <c>AVATCVQuotationItems</c> table.
    /// </summary>
    void updateQuotationItems()
    {
        AVATCVQuotationItems    tmpQuotationItems;
        AVATCVQuotationItems    newQuotationItems;
        int                     nAdded = 0;


        tmpQuotationItems.setTmp();
        tmpQuotationItems.setTmpData(SelectedItems);

        ttsbegin;
        while select * from tmpQuotationItems
        {
            newQuotationItems.clear();
            newQuotationItems.initValue();
            //newQuotationItems.TCVTableId    = tcvTable.Id;
            newQuotationItems.TCVTableId    = tcvId;
            newQuotationItems.ItemId        = tmpQuotationItems.ItemId;
            newQuotationItems.insert();
            nAdded++;
        }
        ttscommit;


        // notify parent FORM to refresh
        //if (nAdded && formHasMethod(caller, identifierStr(refreshQuotationItemsGrid)))
        if (nAdded && SysFormRun::hasMethod(caller, identifierStr(refreshQuotationItemsGrid)))
        {
            caller.refreshQuotationItemsGrid();
        }

    }

]]></Source>
