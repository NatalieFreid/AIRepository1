			<Method>
				<Name>deselectProduct</Name>
				<Source><![CDATA[
    void deselectProduct()
    {
        ttsbegin;

        if (SelectedItems_ds.anyMarked())
        {
            SelectedItems_ds.deleteMarked();
        }
        else if (SelectedItems_ds.getFirst())
        {
            SelectedItems_ds.delete();
        }

        ttscommit;
    }

]]></Source>
