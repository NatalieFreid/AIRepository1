						<Source><![CDATA[
        /// <summary>
        /// executeQuery method
        /// </summary>
        public void executeQuery()
        {
            AVAMarkupTransTmp::createRecordsFromPriceDiscTable(locAVAMarkupTransTmp, priceDiscTable, avaDateControl.dateValue());
            AVAMarkupTransTmp.linkPhysicalTableInstance(locAVAMarkupTransTmp);

            super();
        }

]]></Source>
