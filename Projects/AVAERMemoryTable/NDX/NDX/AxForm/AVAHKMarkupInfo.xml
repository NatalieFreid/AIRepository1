			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    /// <summary>
    /// initMethod
    /// </summary>
    public void init()
    {
        super();

        if(this.args().dataset() == tableNum(PriceDiscTable))
        {
            priceDiscTable = this.args().record() as PriceDiscTable;
            FormRun avaFormRun = this.args().caller();
            avaDateControl = avaFormRun.control(avaFormRun.controlId('avaCalculationDate'));
        }
        else
        {
            Error::wrongUseOfFunction(funcName()); 
        }
    }

]]></Source>
