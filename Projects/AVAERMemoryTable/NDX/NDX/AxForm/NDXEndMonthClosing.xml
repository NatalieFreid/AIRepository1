						<Source><![CDATA[
        /// <summary>
        /// DebuC 07.08.24
        /// </summary>
        public void init()
        {
            Query                   q = new Query();
            QueryBuildDataSource    qbd;
            QueryBuildFieldList     fields;
            ;
            super();

            qbd     = q.addDataSource(tablenum(NDXUmsCust));
            qbd.orderMode(OrderMode::GroupBy);
            qbd.addGroupByField(fieldnum(NDXUmsCust, CompanyId));
            qbd.addGroupByField(fieldnum(NDXUmsCust, Jahr));
            qbd.addGroupByField(fieldnum(NDXUmsCust, Month));

            fields = qbd.fields();
            fields.addField(fieldnum(NDXUmsCust, SalesBalance), SelectionField::Sum);
            fields.addField(fieldnum(NDXUmsCust, SofortBonusWert), SelectionField::Sum);
            fields.addField(fieldnum(NDXUmsCust, sonstigeZuschl), SelectionField::Sum);        
            fields.addField(fieldnum(NDXUmsCust, ohnePosRabGrp), SelectionField::Sum);         

            this.query(q);
        }

]]></Source>
					</Method>
					<Method>
						<Name>inclSBSonstZuschl</Name>
						<Source><![CDATA[
        /// <summary>
        ///  DebuC 07.08.24
        /// </summary>
        /// <param name = "l_NDX_UmsCustMonth">NDXUmsCust</param>
        /// <returns>AmountCur</returns>
        display AmountCur inclSBSonstZuschl(NDXUmsCust l_NDX_UmsCustMonth)
        {
            return l_NDX_UmsCustMonth.SalesBalance + l_NDX_UmsCustMonth.sonstigeZuschl;
        }

]]></Source>
					</Method>
					<Method>
						<Name>SBSonstZuschl</Name>
						<Source><![CDATA[
        /// <summary>
