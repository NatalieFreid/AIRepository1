        public void init()
        {
            super();

            qbrClients_TOSId = this.query().dataSourceTable(tableNum(NDXSNAllianceClients)).addRange(fieldNum(NDXSNAllianceClients, TOSId));
            qbrClients_TOSId.value(queryValue(avaTOSId));
        }

