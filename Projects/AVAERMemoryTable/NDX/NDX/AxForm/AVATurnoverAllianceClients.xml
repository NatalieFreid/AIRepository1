						<Source><![CDATA[
        /// <summary>
        /// active method for formDataSource NDXSNAllianceClients
        /// </summary>
        /// <returns>int</returns>
        public int active()
        {
            int ret;
        
            ret = super();

            if(ndxSNAllianceClients.getClientGroupNameForClient() == '')
            {
                NDXSNAllianceClients_ds.object(fieldNum(NDXSNAllianceClients, ChildMap)).allowEdit(true);
            }
            else
            {
                NDXSNAllianceClients_ds.object(fieldNum(NDXSNAllianceClients, ChildMap)).allowEdit(false);
            }
        
            return ret;
        }

]]></Source>
