}
]]></Source>
			</Method>
			<Method>
				<Name>changeActiveSelectedRecords</Name>
				<Source><![CDATA[
    /// <summary>
    /// activates/deactivates the flag Active for all selected NDXSNAllianceClients records depending on trigger button
    /// </summary>
    /// <param name = "_active">NoYes</param>
    public void changeActiveSelectedRecords(NoYes _active)
    {
        MultiSelectionHelper selection = MultiSelectionHelper::construct();
        NDXSNAllianceClients locAllianceClients;

        selection.parmDatasource(NDXSNAllianceClients_ds);
        locAllianceClients = selection.getFirst();
        locAllianceClients.selectForUpdate(true);

        ttsbegin;

        while (locAllianceClients)
        {
            locAllianceClients.Active = _active;
            locAllianceClients.update();

            locAllianceClients = selection.getNext();
        }

        ttscommit;

        NDXSNAllianceClients_ds.research(true);
    }

]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    /// <summary>
    /// init method
    /// </summary>
    public void init()
    {
        if(this.args().record()
            && this.args().dataset() == tableNum(NDXSNAlliance))
        {
            NDXSNAlliance allianceRecord = this.args().record();
            avaTOSId = allianceRecord.TOSId;
        }
        else
        {
            throw error("@NDX:NXAPassedWrongRecord");
        }
        
        super();
    }

]]></Source>
