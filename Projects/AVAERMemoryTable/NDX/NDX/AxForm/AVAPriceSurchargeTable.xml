        /// <summary>
        ///    AVA <c>Clicked</c> class.
        /// </summary>
        public void Clicked()
        {
            FormRun                 formRun;
            FormDataSource          locFormDataSource;
            AVAPriceSurchargeTable  locAVAPriceSurchargeTable;

            SysTranslationHelper    sysTranslationHelper;

            formRun                     = this.formRun();
            locFormDataSource           = formRun.dataSource('AVAPriceSurchargeTable');
            locAVAPriceSurchargeTable   = element.AVAPriceSurchargeTable;

            sysTranslationHelper    = new SysTranslationHelper( tableNum(AVAPriceSurchargeTable),
                                                                tableNum(AVAPriceSurchargeTranslation)
                                                                );
            /*
            // this is to show smmContactTitleGroup.TitleId, which is not a/part of NaturalKey, in the SysTranslation grid form.
            // due to no unique index on EcoResAttribute table below line is required.
            // Please note that “setMainTableNaturalKeyFieldId” is a misnomer – it basically allows any (one) given field to be specified to appear in TranslationList form instead of the NaturalKey field
            */
            sysTranslationHelper.setMainTableNaturalKeyFieldId(fieldNum(AVAPriceSurchargeTable, AVAPriceSurchargeCode));

            sysTranslationHelper.launchTranslationDetailForm(locAVAPriceSurchargeTable.RecId);

            super();

            locFormDataSource.research(true);
        }

