				<Name>enableUpdateSumBtn</Name>
				<Source><![CDATA[
    private void enableUpdateSumBtn()
    {
        boolean enableButtons;
        enableButtons = !InventClosingExists && (FilterInventLocationId.valueStr() && FilterInventSiteId.valueStr());
        UpdateSumBtn.enabled(enableButtons);
        UpdateValBtn.enabled(enableButtons);
    }

]]></Source>
