						<Name>executeQuery</Name>
						<Source><![CDATA[
        public void executeQuery()
        {
            InventSiteId        inventSiteId;
            InventLocationId    inventLocationId;

            QueryBuildDataSource  queryBuildDataSource;
            queryBuildDataSource = this.query().dataSourceTable(tablenum(AVAInventSumDateTrans));
            queryBuildDataSource.clearRanges();

            SysQuery::findOrCreateRange(queryBuildDataSource, fieldNum(AVAInventSumDateTrans, Type)).value(SysQueryRangeUtil::value(ComboBoxType.selection()));

            inventSiteId = FilterInventSiteId.valueStr();
            if (inventSiteId)
            {
                SysQuery::findOrCreateRange(queryBuildDataSource, fieldNum(AVAInventSumDateTrans, InventSiteId)).value(inventSiteId);
            }

            inventLocationId = FilterInventLocationId.valueStr();
            if (inventLocationId)
            {
                SysQuery::findOrCreateRange(queryBuildDataSource, fieldNum(AVAInventSumDateTrans, InventLocationId)).value(inventLocationId);
            }

            super();
        }

]]></Source>
