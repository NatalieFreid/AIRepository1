			<Method>
				<Name>existsInventClosing</Name>
				<Source><![CDATA[
    private boolean existsInventClosing()
    {
        InventClosing inventClosing;
        AVAInventSumDateTrans   sumDateTrans;
        AVAInventSumType sumType;
        
        sumType = str2Enum(sumType, ComboBoxType.valueStr());
        
        select firstonly sumDateTrans where sumDateTrans.Type == sumType;
        select firstonly inventClosing where inventClosing.Active
            && inventClosing.TransDate == sumDateTrans.TransDate;
        return inventClosing.RecId;
    }

]]></Source>
