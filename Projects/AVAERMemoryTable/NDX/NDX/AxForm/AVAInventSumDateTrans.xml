						<Source><![CDATA[
        public void delete()
        {
            InventClosingExists = element.existsInventClosing();
            if (!InventClosingExists)
            {
                super();
            }
            else
            {
                Error("@NDX:NXAInventClosingExists");
            }
        }

]]></Source>
