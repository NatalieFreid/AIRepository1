    public void updateScreen(AsyncTaskResult _result)
    {
        if (doRefresh.value() == NoYes::Yes)
        {
            if (!element.closed()) //otherwise will be executed even after form close.
            {
                AVATraverseTrans_ds.executeQuery();
                TimeControl.value(DateTimeUtil::getTimeNow(DateTimeUtil::getUserPreferredTimeZone()));
                element.setTimeoutEx(formMethodStr(AVATraverseTrans, updateScreen), conNull(), 60000);
            }
        }
    }

]]></Source>
