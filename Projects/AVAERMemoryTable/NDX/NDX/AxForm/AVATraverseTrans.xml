						<Name>executeQuery</Name>
						<Source><![CDATA[
        public void executeQuery()
        {
            QueryBuildDataSource  queryBuildDataSource;
            QueryBuildRange       qbrTravNum, qbrTravStatus, qbrProdId;
            queryBuildDataSource = this.query().dataSourceTable(tablenum(AVATraverseTrans));
            queryBuildDataSource.clearLinks();
            queryBuildDataSource.clearDynalinks();

            if (FilterTravProdId.valueStr())
            {
                qbrProdId = SysQuery::findOrCreateRange(queryBuildDataSource, fieldNum(AVATraverseTrans, ProdId));
                qbrProdId.value(queryValue(FilterTravProdId.valueStr()));
            }
            else
            {
                qbrProdId = SysQuery::findOrCreateRange(queryBuildDataSource, fieldNum(AVATraverseTrans, ProdId));
                qbrProdId.value(SysQuery::valueUnlimited());
            }

            if (FilterTravNum.valueStr())
            {
                qbrTravNum = SysQuery::findOrCreateRange(queryBuildDataSource, fieldNum(AVATraverseTrans, TravNum));
                qbrTravNum.value(queryValue(FilterTravNum.valueStr()));
            }
            else
            {   
                qbrTravNum = SysQuery::findOrCreateRange(queryBuildDataSource, fieldNum(AVATraverseTrans, TravNum));
                qbrTravNum.value(SysQuery::valueUnlimited());
            }

            if (FilterTravStatus.valueStr() && FilterTravStatus.valueStr() != "@NDX:AVAListZ4AllGroup")
            {
                qbrTravStatus = SysQuery::findOrCreateRange(queryBuildDataSource, fieldNum(AVATraverseTrans, TravStatus));
                qbrTravStatus.value(SysQuery::value(FilterTravStatus.valueStr()));
            }
            else
            {
                qbrTravStatus = SysQuery::findOrCreateRange(queryBuildDataSource, fieldNum(AVATraverseTrans, TravStatus));
                qbrTravStatus.value(SysQuery::valueUnlimited());
            }
            super();
        }

]]></Source>
					</Method>
