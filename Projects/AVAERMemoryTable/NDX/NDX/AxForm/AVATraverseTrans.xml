						<Methods>
							<Method>
								<Name>lookup</Name>
								<Source><![CDATA[
            public void lookup(FormControl _formControl, str _filterStr)
            {
                AVATraverseTrans        traverseTrans;
                SysTableLookup          sysTableLookup = SysTableLookup::newParameters(tableNum(InventTable), _formControl);
                Query                   query = new Query();
                QueryBuildDataSource    qbdsbom, qbdsInvent;
                QueryBuildRange         qbrProdId;
 
                traverseTrans = _formControl.formRun().dataSource(formDataSourceStr(AVATraverseTrans, AVATraverseTrans)).cursor();
                qbdsInvent = query.addDataSource(tableNum(InventTable));
                qbdsbom = qbdsInvent.addDataSource(tableNum(prodbom));
                qbdsbom.relations(true);
                qbrProdId = qbdsbom.addRange(fieldNum(ProdBOM, ProdId));
                qbrProdId.value(queryValue(traverseTrans.ProdId));

                sysTableLookup.addLookupfield(fieldNum(InventTable, ItemId));
                sysTableLookup.addLookupfield(fieldNum(InventTable, NameAlias));
                sysTableLookup.addSelectionField(fieldNum(InventTable, Product));
                sysTableLookup.addLookupMethod(tableMethodStr(InventTable, NDXProductName1));
                sysTableLookup.addLookupMethod(tableMethodStr(InventTable, NDXProductName2));
                sysTableLookup.addLookupfield(fieldNum(InventTable, NDXModelNumber));
                sysTableLookup.addLookupfield(fieldNum(InventTable, ItemType));
                sysTableLookup.addLookupfield(fieldNum(InventTable, KCS_KAOItemState));

                sysTableLookup.parmQuery(query);
                sysTableLookup.performFormLookup();
            }

]]></Source>
