		<DataControls xmlns="">
			<Control>
				<Name>Report</Name>
				<Type>Button</Type>
				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        public void clicked()
        {
            MultiSelectionHelper     selectionHelper = MultiSelectionHelper::construct();
            AVACRLReportResultTable  resultTable;
            CustTrans                custTrans;
            selectionHelper.parmDataSource(AVACRLReportResultTable_ds); 
            resultTable = selectionHelper.getFirst();
            while (resultTable)
            {
                ttsbegin;
                resultTable.selectForUpdate();
                resultTable.ReportDate = DateTimeUtil::getSystemDate(DateTimeUtil::getUserPreferredTimeZone());
                resultTable.update();
                custTrans = CustTrans::find(resultTable.CustTransRecId, true);
                if (reportType == AVACRLReportType::CreditOverrun)
                {
                    custTrans.AVATargetNotDate  = resultTable.ReportDate;
                }
                else
                {
                    custTrans.AVAProtractedNotDate = resultTable.ReportDate;
                }
                custTrans.update();
                ttscommit;
                resultTable = selectionHelper.getNext();
            }
            AVACRLReportResultTable_ds.executeQuery();
        }

]]></Source>
