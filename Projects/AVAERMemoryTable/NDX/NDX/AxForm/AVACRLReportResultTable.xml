    AVACRLReportType    reportType;

}
]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        super();

        reportType = this.args().parmEnum();
        if (reportType == AVACRLReportType::CreditOverrun)
        {
            element.design().caption("@NDX:NXACRLCreditOverrun");
            element.design().controlName(formControlStr(AVACRLReportResultTable,CreateCreditOverrun)).visible(true);
            element.design().controlName(formControlStr(AVACRLReportResultTable, CreateProtractedDefault)).visible(false);
        }
        else
        {
            element.design().caption("@NDX:NXACRLProtractedDefault");
            element.design().controlName(formControlStr(AVACRLReportResultTable,CreateCreditOverrun)).visible(false);
            element.design().controlName(formControlStr(AVACRLReportResultTable, CreateProtractedDefault)).visible(true);
        }
    }

]]></Source>
			</Method>
		</Methods>
