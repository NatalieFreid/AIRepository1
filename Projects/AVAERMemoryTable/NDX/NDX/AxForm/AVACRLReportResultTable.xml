				<Methods>
					<Method>
						<Name>active</Name>
						<Source><![CDATA[
        public int active()
        {
            int ret;
    
            ret = super();

            if (AVACRLReportResultTable.ReportDate != dateNull())
            {
                reportdelete.enabled(true);
            }
            else
            {
                reportdelete.enabled(false);
            }

            return ret;
        }

]]></Source>
					</Method>
					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
        public void executeQuery()
        {
            QueryBuildRange         qbrReportType, qbrReportDate;
            QueryBuildDataSource    qbds = SysQuery::findOrCreateDataSource(this.query(), tableNum(AVACRLReportResultTable));    

            qbrReportType = SysQuery::findOrCreateRange(qbds, fieldNum(AVACRLReportResultTable, ReportType));
            qbrReportType.value(SysQuery::value(reportType));

            qbrReportDate   = SysQuery::findOrCreateRange(qbds, fieldNum(AVACRLReportResultTable, ReportDate));
            qbrReportDate.value(SysQuery::valueEmptyString());

            super();
        }

]]></Source>
					</Method>
