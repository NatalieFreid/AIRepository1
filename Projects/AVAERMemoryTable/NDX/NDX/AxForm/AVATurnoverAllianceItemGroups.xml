public class AVATurnoverAllianceItemGroups extends FormRun
{
    AVATOSId avaTOSId;
    QueryBuildRange qbrClients_TOSId;

}
]]></Source>
			</Method>
			<Method>
				<Name>changeActiveSelectedRecords</Name>
				<Source><![CDATA[
    /// <summary>
    /// activates/deactivates the flag Active for all selected NDX_SNAllianceItemGroups records depending on trigger button
    /// </summary>
    /// <param name = "_active">NoYes</param>
    public void changeActiveSelectedRecords(NoYes _active)
    {
        MultiSelectionHelper selection = MultiSelectionHelper::construct();
        NDXSNAllianceItemGroups locItemGroups;

        selection.parmDatasource(NDXSNAllianceItemGroups_ds);
        locItemGroups = selection.getFirst();
        locItemGroups.selectForUpdate(true);

        ttsbegin;

        while (locItemGroups)
        {
            locItemGroups.Active = _active;
            locItemGroups.update();

            locItemGroups = selection.getNext();
        }

        ttscommit;

        NDXSNAllianceItemGroups_ds.research(true);
    }

]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    /// <summary>
    /// init method
    /// </summary>
    public void init()
    {
        if(this.args().record()
            && this.args().dataset() == tableNum(NDXSNAlliance))
        {
            NDXSNAlliance allianceRecord = this.args().record();
            avaTOSId = allianceRecord.TOSId;
        }
        else
        {
            throw error("@NDX:NXAPassedWrongRecord");
        }

        super();
    }

]]></Source>
