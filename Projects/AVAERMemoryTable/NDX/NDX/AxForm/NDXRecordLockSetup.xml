    void addTable()
    {
        TableId     tableId;

        tableId = pickTable();

        if (tableId)
        {
            NDXRecordLockSetup.Lock_TableID = tableId;
            NDXRecordLockSetup.Lock = NoYes::No;
            NDXRecordLockSetup.insert();
            NDXRecordLockSetup_DS.research();
        }
    }

]]></Source>
