					<Method>
						<Name>active</Name>
						<Source><![CDATA[
        /// <summary>
        /// active method
        /// </summary>
        /// <returns>int</returns>
        public int active()
        {
            int ret;
        
            ret = super();

            if(NDXSNClientGroup2CLient::existsClientGroup(NDXSNClientGroup.RecId))
            {
                NDXSNClientGroup_ds.allowDelete(false);
            }
            else
            {
                NDXSNClientGroup_ds.allowDelete(true);
            }

            AVAAllianceGroupClientsAvailable_ds.executeQuery();
            AVAAllianceGroupClientsSelected_ds.executeQuery();
        
            return ret;
        }

]]></Source>
