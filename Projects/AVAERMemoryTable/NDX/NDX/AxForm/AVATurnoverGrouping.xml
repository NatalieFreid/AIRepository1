			<Method>
				<Name>avaliableClientAddLink</Name>
				<Source><![CDATA[
    /// <summary>
    /// Links formDataSource AVAAllianceGroupClientsAvailable to formDataSource NDXSNClientGroup
    /// </summary>
    public void avaliableClientAddLink()
    {
        QueryBuildDataSource qbds_available = NDXSNClientGroup_ds.query().dataSourceTable(tableNum(NDXSNClientGroup)).addDataSource(tableNum(AVAAllianceGroupClientsAvailable));
        qbds_available.clearLinks();
        qbds_available.clearDynalinks();
        qbds_available.joinMode(FormLinkType::Delayed);
        qbds_available.addLink(fieldNum(NDXSNClientGroup, TOSId), fieldNum(AVAAllianceGroupClientsAvailable, TOSId));
        qbds_available.addLink(fieldNum(NDXSNClientGroup, Companys), fieldNum(AVAAllianceGroupClientsAvailable, Companys));
    }

]]></Source>
