			<Method>
				<Name>removeSelectedClients</Name>
				<Source><![CDATA[
    /// <summary>
    /// removes the NDXSNClientGroup2Client record, that links selected clients to the current group
    /// </summary>
    public void removeSelectedClients()
    {
        AVAAllianceGroupClientsSelected locSelectedClients;
        NDXSNClientGroup2Client locCG2C;

        ttsbegin;


        for(locSelectedClients = AVAAllianceGroupClientsSelected_ds.getFirst(true) ? AVAAllianceGroupClientsSelected_ds.getFirst(true) : AVAAllianceGroupClientsSelected_ds.cursor(); locSelectedClients; locSelectedClients = AVAAllianceGroupClientsSelected_ds.getNext())
        {
            locCG2C = NDXSNClientGroup2Client::find(locSelectedClients.RefRecId_ClientGroup, locSelectedClients.RefRecId_Client);
            locCG2C.selectForUpdate(true);
            locCG2C.delete();
        }

        ttscommit;

        AVAAllianceGroupCLientsSelected_ds.research(true);
        AVAAllianceGroupClientsAvailable_ds.research(true);

    }

]]></Source>
			</Method>
			<Method>
				<Name>addAvailableClients</Name>
				<Source><![CDATA[
    /// <summary>
    /// Adds available clients to the current client group
    /// </summary>
    public void addAvailableClients()
    {
        AVAAllianceGroupClientsAvailable    locAvailableClients;
        NDXSNClientGroup2Client             locCG2C;
        RecordInsertList                    insertList = new RecordInsertList(tableNum(NDXSNClientGroup2Client));
        NDXSNClientGroup                    locClientGroup = NDXSNClientGroup_ds.cursor();

        ttsbegin;

        for(locAvailableClients = AVAAllianceGroupClientsAvailable_ds.getFirst(true) ? AVAAllianceGroupClientsAvailable_ds.getFirst(true) : AVAAllianceGroupClientsAvailable_ds.cursor(); locAvailableClients; locAvailableClients = AVAAllianceGroupClientsAvailable_ds.getNext())
        {
            locCG2C.RefRecId_Client         = locAvailableClients.RecId;
            locCG2C.RefRecId_ClientGroup    = locClientGroup.RecId;
            
            
            insertList.add(locCG2C);
        }

        insertList.insertDatabase();
        
        ttscommit;

        AVAAllianceGroupCLientsSelected_ds.research(true);
        AVAAllianceGroupClientsAvailable_ds.research(true);

    }

]]></Source>
