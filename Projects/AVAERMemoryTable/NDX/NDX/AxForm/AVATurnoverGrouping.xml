				<Name>selectedClientAddLink</Name>
				<Source><![CDATA[
    /// <summary>
    /// Links formDataSource AVAAllianceGroupClientsSelected to formDataSource NDXSNClientGroup
    /// </summary>
    public void selectedClientAddLink()
    {
        QueryBuildDataSource qbds_selected = NDXSNClientGroup_ds.query().dataSourceTable(tableNum(NDXSNClientGroup)).addDataSource(tableNum(AVAAllianceGroupClientsSelected));
