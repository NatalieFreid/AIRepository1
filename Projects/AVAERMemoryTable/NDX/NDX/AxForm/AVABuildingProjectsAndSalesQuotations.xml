			<Method>
				<Name>parmFilter</Name>
				<Source><![CDATA[
    /// <summary>
    ///     AVA <c>parmFilter</c> method.
    /// </summary>
    /// <returns>
    ///     <c>SysIFilter</c> as return value
    /// </returns>
    public SysIFilter parmFilter()
    {
        SysIFilter                      locSysIFilter;
        SysIFilterValue                 locSysIFilterValue;
        HcmWorker                       locHcmWorker;
        SysFilterValueResolutionMethod  locSysFilterValueResolutionMethod;
        
        locSysIFilter                       = SysFilterFactory::createEmptyFilter();
        locSysFilterValueResolutionMethod   = SysFilterValueResolutionMethod::All;

        select locHcmWorker
        where locHcmWorker.RecId == Worker.value();

        //locSysIFilterValue = SysFilterValueFactory::createFilterValueForBuffer(locHcmWorker);
        locSysIFilterValue = SysFilterValueFactory::createFilterValueForInteger(locHcmWorker.RecId,extendedTypeNum(WorkerSalesResponsible));

        if (locHcmWorker)
        {
            locSysFilterValueResolutionMethod = SysFilterValueResolutionMethod::None;
        }

        locSysIFilter.addItem(locSysIFilterValue, SysFilterOperator::Equal, locSysFilterValueResolutionMethod);

        return locSysIFilter;
    }

]]></Source>
			</Method>
