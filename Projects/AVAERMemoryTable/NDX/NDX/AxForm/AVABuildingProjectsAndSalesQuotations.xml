			<Method>
				<Name>initParmDefault</Name>
				<Source><![CDATA[
    /// <summary>
    ///     AVA <c>initParmDefault</c> method.
    /// </summary>
    public void initParmDefault()
    {
        if (!Worker.value())
        {
            HcmWorker     locHcmWorker;
            DirPersonUser locDirPersonUser;

            select firstonly RecId 
            from locHcmWorker
                exists join locDirPersonUser
                where   locHcmWorker.Person     == locDirPersonUser.PersonParty
                    &&  locDirPersonUser.User   == curUserId();

            Worker.value(locHcmWorker.recId);
            frmHCMWorkerRecIdCurrent = locHcmWorker.recId;
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    /// <summary>
    ///     AVA <c>init</c> method.
    /// </summary>
    public void init()
    {
        super();

        SysFilterLastValueHelper::getLastValue(Worker);

        frmChangeEvent = SysFilterChangeEvent::newFromFormControl(Worker);

        this.initParmDefault();

        //IncompleteAsyncOrderCancellationsTabPage.visible(FeatureStateProvider::isFeatureEnabled(RetailAsyncOrderCancellationFeature::instance()));
    }

]]></Source>
