			<Method>
				<Name>getHCMWorkerFilterValue</Name>
				<Source><![CDATA[
    /// <summary>
    ///     AVA <c>getHCMWorkerFilterValue</c> method.
    /// </summary>
    /// <returns>
    ///     <c>HCMWorkerRecId</c> as return value
    /// </returns>
    public HCMWorkerRecId getHCMWorkerFilterValue()
    {
        HCMWorkerRecId  locHCMWorkerRecId;

        locHCMWorkerRecId   = Worker.value();

        if (!locHCMWorkerRecId)
        {
            locHCMWorkerRecId = frmHCMWorkerRecIdCurrent;
        }

        return locHCMWorkerRecId;
    }

]]></Source>
