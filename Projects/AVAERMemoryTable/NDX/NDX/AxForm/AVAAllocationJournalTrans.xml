					<Method>
						<Name>findData</Name>
						<Source><![CDATA[
        public void findData()
        {
            LedgerJournalTrans  allocationJourTrans;
            LedgerJournalTable  jourTable;
            String50            dimStr;

            FromDate    fromDate = FromDateControl.dateValue();
            ToDate      toDate = ToDateControl.dateValue();
            //utcdatetime fromDate = FromDateControl.dateValue();
            //utcdatetime todate = ToDateControl.dateValue();
            LedgerJournalId fromJour = fromJournalNum.valueStr();
            LedgerJournalId toJour = toJournalnum.valueStr();
            
            if (!fromDate)
            {
                fromDate = DateTimeUtil::date(DateTimeUtil::minValue());
            }

            if (!toDate)
            {
                toDate = DateTimeUtil::date(DateTimeUtil::maxValue());
            }

            if (!fromJour)
            {
                select firstonly JournalNum from jourTable order by JournalNum;
                fromjour = jourTable.JournalNum;
            }
            if (!toJour)
            {
                select firstonly JournalNum from jourTable order by JournalNum desc;
                toJour = jourTable.JournalNum;
            }

            delete_from jourTransTmp;

            while select jourTable where jourTable.JournalNum >= fromJour
                                      && jourTable.JournalNum <= toJour
                                      //&& jourTable.CreatedDateTime >= fromDate
                                      //&& jourTable.CreatedDateTime <= toDate
                                      && jourTable.AVACopiedWithDifLayer
            join allocationJourTrans where allocationJourTrans.TransDate >= fromDate
                                                && allocationJourTrans.TransDate <= toDate
                                                && allocationJourTrans.JournalNum == jourTable.JournalNum
            //join allocationJourTrans where allocationJourTrans.JournalNum == jourTable.JournalNum
            {
                jourTransTmp.AmountCurCredit    = allocationJourTrans.AmountCurCredit;
                jourTransTmp.AmountCurDebit     = allocationJourTrans.AmountCurDebit;
                jourTransTmp.SumAmounts         = jourTransTmp.AmountCurDebit - jourTransTmp.AmountCurCredit;
                jourTransTmp.Voucher            = allocationJourTrans.Voucher;
                jourTransTmp.TransDate          = allocationJourTrans.TransDate;
                jourTransTmp.AccountType        = allocationJourTrans.AccountType;
                jourTransTmp.company            = allocationJourTrans.company;
                jourTransTmp.CurrencyCode       = allocationJourTrans.CurrencyCode;
                jourTransTmp.DefaultDimension   = allocationJourTrans.DefaultDimension;
                jourTransTmp.JournalNum         = allocationJourTrans.JournalNum;
                jourTransTmp.CreationDate       = DateTimeUtil::date(jourTable.CreatedDateTime);
                jourTransTmp.LedgerDimension    = allocationJourTrans.LedgerDimension;
                jourTransTmp.Txt                = allocationJourTrans.Txt;
                jourTransTmp.MainAccountNum     = MainAccount::findByLedgerDimension(allocationJourTrans.LedgerDimension).MainAccountId;
                DimStr = DimensionAttributeValueCombination::find(jourTransTmp.LedgerDimension).DisplayValue;
                dimStr = subStr(dimStr, strLen(jourTransTmp.MainAccountNum)+1, strLen(dimStr));
                dimStr = strRem(dimStr, '-');
                jourTransTmp.DimString = dimStr;
               
                jourTransTmp.insert();
            }

        }

]]></Source>
