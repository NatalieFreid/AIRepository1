			<Method>
				<Name>lookupJournal</Name>
				<Source><![CDATA[
    public void lookupJournal(FormControl  _fromFormControl)
    {
        SysTableLookup          sysTableLookup = SysTableLookup::newParameters(tableNum(LedgerJournalTable), _fromFormControl);
        Query                   query = new Query();
        QueryBuildDataSource    queryBuildDataSource;
        QueryBuildRange         queryBuildRange;
 
        queryBuildDataSource = query.addDataSource(tableNum(LedgerJournalTable));
        queryBuildRange = queryBuildDataSource.addRange(fieldNum(LedgerJournalTable, AVACopiedWithDifLayer));
        queryBuildRange.value(queryValue(NoYes::Yes));

        sysTableLookup.addLookupfield(fieldNum(LedgerJournalTable, JournalNum));
        sysTableLookup.addLookupfield(fieldNum(LedgerJournalTable, Name));
        sysTableLookup.addLookupfield(fieldNum(LedgerJournalTable, JournalName));
        sysTableLookup.addLookupfield(fieldNum(LedgerJournalTable, JournalType));
        sysTableLookup.addLookupfield(fieldNum(LedgerJournalTable, Posted));
 
        sysTableLookup.parmQuery(query);
        sysTableLookup.performFormLookup();
    }

]]></Source>
			</Method>
