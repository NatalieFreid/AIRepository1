    int defaultBackground;

    int differenceColor = WinAPI::RGB2int(255, 121, 95);

}
]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        ndxUnitConvert = NDXUnitConvert::constructor();
        super();

        defaultColorScheme  = UnitOfMeasureConversionTmp_NDXWeight.colorScheme();
        defaultBackground = UnitOfMeasureConversionTmp_NDXWidth.backgroundColor();
    }

]]></Source>
			</Method>
			<Method>
				<Name>setColorFields</Name>
				<Source><![CDATA[
    void setColorFields()
    {
        if(UnitOfMeasureConversionTmp.NDXWeight != UnitOfMeasureConversion.NDXWeight)
        {
            UnitOfMeasureConversionTmp_NDXWeight.colorScheme(FormColorScheme::RGB);
            UnitOfMeasureConversionTmp_NDXWeight.backgroundColor(differenceColor);
        }

        if(UnitOfMeasureConversionTmp.NDXHeight != UnitOfMeasureConversion.NDXHeight)
        {
            UnitOfMeasureConversionTmp_NDXHeight.colorScheme(FormColorScheme::RGB);
            UnitOfMeasureConversionTmp_NDXHeight.backgroundColor(differenceColor);
        }

        if(UnitOfMeasureConversionTmp.NDXWidth != UnitOfMeasureConversion.NDXWidth)
        {
            UnitOfMeasureConversionTmp_NDXWidth.colorScheme(FormColorScheme::RGB);
            UnitOfMeasureConversionTmp_NDXWidth.backgroundColor(differenceColor);
        }

        if(UnitOfMeasureConversionTmp.NDXLength != UnitOfMeasureConversion.NDXLength)
        {
            UnitOfMeasureConversionTmp_NDXLength.colorScheme(FormColorScheme::RGB);
            UnitOfMeasureConversionTmp_NDXLength.backgroundColor(differenceColor);
        }

        if(UnitOfMeasureConversionTmp.ndxDispVolume() != UnitOfMeasureConversion.ndxDispVolume())
        {
            UnitOfMeasureConversionTmp_VolumeMethod.colorScheme(FormColorScheme::RGB);
            UnitOfMeasureConversionTmp_VolumeMethod.backgroundColor(differenceColor);
        }
        
    }

]]></Source>
			</Method>
			<Method>
				<Name>resetColorFields</Name>
				<Source><![CDATA[
    void resetColorFields()
    {
        UnitOfMeasureConversionTmp_NDXWeight.colorScheme(defaultColorScheme);
        UnitOfMeasureConversionTmp_NDXWeight.backgroundColor(defaultBackground);
        
        UnitOfMeasureConversionTmp_NDXHeight.colorScheme(defaultColorScheme);
        UnitOfMeasureConversionTmp_NDXHeight.backgroundColor(defaultBackground);
        
        UnitOfMeasureConversionTmp_NDXWidth.colorScheme(defaultColorScheme);
        UnitOfMeasureConversionTmp_NDXWidth.backgroundColor(defaultBackground);
        
        UnitOfMeasureConversionTmp_NDXLength.colorScheme(defaultColorScheme);
        UnitOfMeasureConversionTmp_NDXLength.backgroundColor(defaultBackground);
        
        UnitOfMeasureConversionTmp_VolumeMethod.colorScheme(defaultColorScheme);
        UnitOfMeasureConversionTmp_VolumeMethod.backgroundColor(defaultBackground);
        
    }

]]></Source>
			</Method>
			<Method>
				<Name>checkUnitConvertWeight</Name>
				<Source><![CDATA[
    void checkUnitConvertWeight()
    {
        element.resetColorFields();

        ndxUnitConvert.clearUnitOfMeasureConversionTmp();
        ndxUnitConvert.checkUnitConvertWeight(UnitOfMeasureConversion, false, false);

        if(ndxUnitConvert.parmUnitConvertTmp())
        {
            UnitOfMeasureConversionTmp.setTmpData(ndxUnitConvert.parmUnitConvertTmp());
        }
        else
        {
            buf2Buf(UnitOfMeasureConversion, UnitOfMeasureConversionTmp);
            UnitOfMeasureConversionTmp.insert();
        }

        UnitOfMeasureConversionTmp_DS.research();
        element.setColorFields();
    }

]]></Source>
