    /// <summary>
    ///     AVA <c>showQueryInfo</c> method.
    /// </summary>
    public void showQueryInfo()
    {
        Query                       locQuery;
        QueryRun                    locQueryRun;

        SmmBusRelTable              locsmmBusRelTable;
        KCS_KBVRequestTable         locKCS_KBVRequestTable;
        KCS_KBVBuildingProjectTable locKCS_KBVBuildingProjectTable;
        
        locQuery    = frmQuery;
        locQueryRun = new QueryRun(locQuery);

        while (locQueryRun.next())
        {
            if(locQueryRun.changed(tableNum(smmBusRelTable)))
            {
                locsmmBusRelTable               = locQueryRun.get(tableNum(smmBusRelTable));
                locKCS_KBVRequestTable          = locQueryRun.get(tableNum(KCS_KBVRequestTable));
                locKCS_KBVBuildingProjectTable  = locQueryRun.get(tableNum(KCS_KBVBuildingProjectTable));

                info(strFmt("BusRelAccount: %1 - Request: %2 - BV-Nummer: %3", locsmmBusRelTable.BusRelAccount, locKCS_KBVRequestTable.KCS_KBVRequestID, locKCS_KBVBuildingProjectTable.KCS_KBVBuildingProjectID));
            }
        }
    }

]]></Source>
