        /// <summary>
        ///     AVA <c>init</c> method.
        /// </summary>
        public void init()
        {
            Query                   locQuery;
            str                     locDatasourceName;
            int                     locDataSourceNo;
            QueryBuildDataSource    locFromDS;
            QueryBuildDataSource    locToDS;

            super();

            if(frmQueryReplacement)
            {
                locQuery = this.query();

                for (locDataSourceNo = 1; locDataSourceNo <= frmQuery.dataSourceCount(); locDataSourceNo++)
                {
                    locFromDS = frmQuery.dataSourceNo(locDataSourceNo);
                    locToDS = locQuery.dataSourceTable(locFromDS.table());
                    // clear range in target data source to avoid or values
                    locToDS.clearRanges();
                    // merge data sources  incomming query with query defined on form
                    if (locToDS && frmQuery.hasRangeOrFilter(locFromDS))
                    {
                        SysQuery::mergeRanges(locQuery, frmQuery, locDataSourceNo);
                        SysQuery::mergeFilters(frmQuery, locQuery, locDataSourceNo);
                    }
                }
            }
        }

]]></Source>
