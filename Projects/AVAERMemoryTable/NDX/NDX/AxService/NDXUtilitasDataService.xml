	<ExternalName>NDXUtilitasDataAPIServiceTransfer</ExternalName>
	<ServiceOperations>
		<AxServiceOperation>
			<Name>transferUtilitasDataRecord</Name>
			<Method>transferRecord</Method>
			<SubscriberAccessLevel>
