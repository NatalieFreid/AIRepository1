		<Methods>
			<Method>
				<Name>findRecId</Name>
				<Source><![CDATA[
    /// <summary>
    /// find method with provided RefRecId
    /// </summary>
    /// <param name = "_refRecId">AVAAllianceClientGroupRefRecId</param>
    /// <param name = "_selectForUpdate">boolean</param>
    /// <returns>NDXSNClientGroup</returns>
    public static NDXSNClientGroup findRecId(AVAAllianceClientGroupRefRecId _refRecId, boolean _selectForUpdate = false)
    {
        NDXSNClientGroup clientGroup;

        if(_selectForUpdate)
        {
            clientGroup.selectForUpdate(_selectForUpdate);
        }

        select firstonly clientGroup
            where clientGroup.RecId == _refRecId;

        return clientGroup;
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// find method with provided RefRecId
    /// </summary>
    /// <param name = "_tosId">alliance</param>
    /// <param name = "_companys">company</param>
    /// <param name = "_clientGroupName">client group</param>
    /// <param name = "_selectForUpdate">boolean</param>
    /// <returns>NDXSNClientGroup</returns>
    public static NDXSNClientGroup find(AVATOSId _tosId, NDXCompanys _companys, AVAClientGroupName _clientGroupName, boolean _selectForUpdate = false)
    {
        NDXSNClientGroup clientGroup;

        if(_selectForUpdate)
        {
            clientGroup.selectForUpdate(_selectForUpdate);
        }

        select firstonly clientGroup
            where clientGroup.TOSId == _tosId
                && clientGroup.Companys == _companys
                && clientGroup.ClientGroupName == _clientGroupName;

        return clientGroup;
    }

]]></Source>
			</Method>
