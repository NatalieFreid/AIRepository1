				<Source><![CDATA[
    /// <summary>
    /// Finds a record
    /// </summary>
    /// <param name = "_kcs_QuotationStatusFrom">from statu</param>
    /// <param name = "_kcs_QuotationStatusTo">to status</param>
    /// <param name = "_update">for update</param>
    /// <returns>NDXMEQuotationStatusChange record</returns>
    static NDXMEQuotationStatusChange find(RefRecId _kcs_QuotationStatusFrom, RefRecId _kcs_QuotationStatusTo, boolean _update = false)
    {
        NDXMEQuotationStatusChange lNDXMEQuotationStatusChange;

        lNDXMEQuotationStatusChange.selectForUpdate(_update);

        select firstonly lNDXMEQuotationStatusChange
            where lNDXMEQuotationStatusChange.KCS_QuotationStatusFromRefRecId == _kcs_QuotationStatusFrom
                && lNDXMEQuotationStatusChange.KCS_QuotationStatusToRefRecId == _kcs_QuotationStatusTo;

        return lNDXMEQuotationStatusChange;

    }

]]></Source>
