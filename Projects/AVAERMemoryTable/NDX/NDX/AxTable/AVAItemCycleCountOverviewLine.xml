				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// N.Freidenberger 02.06.2025
    /// </summary>
    /// <param name = "_itemId">_itemId</param>
    /// <param name = "_inventLocationId">_inventLocationId</param>
    /// <param name = "_update">_update</param>
    /// <returns>AVAItemCycleCountOverviewLine</returns>
    public static AVAItemCycleCountOverviewLine find(ItemId     _itemId, InventLocationId   _inventLocationId, boolean     _update = false)
    {
        AVAItemCycleCountOverviewLine       itemCycleCountOverviewLine; 

        itemCycleCountOverviewLine.selectForUpdate(_update);

        select firstonly itemCycleCountOverviewLine
            where itemCycleCountOverviewLine.ItemId == _itemId
            && itemCycleCountOverviewLine.InventLocationId == _inventLocationId;
              

        return itemCycleCountOverviewLine;
    }

]]></Source>
