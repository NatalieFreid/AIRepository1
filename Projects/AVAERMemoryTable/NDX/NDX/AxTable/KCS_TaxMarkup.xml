			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// AVA/WEN 2024/09/06    AVA_012455_TaxMarkupLedgerAccounts
    /// </summary>
    /// <param name = "_id">MarkupCode</param>
    /// <param name = "_taxGroup">TaxGroup</param>
    /// <param name = "_taxType">AVATaxMarkupType</param>
    /// <param name = "_forUpdate">boolean</param>
    /// <returns>KCS_TaxMarkup</returns>
    public static KCS_TaxMarkup find(MarkupCode         _id,
                                 TaxGroup           _taxGroup,
                                 AVATaxMarkupType   _taxType,
                                 boolean            _forUpdate = false)
    {
        KCS_TaxMarkup record;

        record.selectForUpdate(_forUpdate);

        select firstonly record
            index hint MarkupCodeIdx
            where record.MarkupCode     == _id          &&
                  record.TaxMarkupType  == _taxType     &&
                  record.TaxGroup       == _taxGroup;

        return record;
    }

]]></Source>
