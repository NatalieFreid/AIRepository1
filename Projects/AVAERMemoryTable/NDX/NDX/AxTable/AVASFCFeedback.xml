			<Method>
				<Name>parmBDETransactionType</Name>
				<Source><![CDATA[
    public Set parmBDETransactionType()
    {
        AVASFCFeedback         kCS_SFCFeedback;
        Query                   q;
        QueryBuildDataSource    qbds;
        QueryRun                qr;
        Set                     set = new Set(Types::Enum);
        
        q      = new Query();
        qbds   = q.addDataSource(tablenum(AVASFCFeedback));
        qbds.addRange(fieldnum(AVASFCFeedback, NdxSFCId)).value(this.NdxSFCId);        // BDE-Nr.
        qbds.orderMode(OrderMode::GroupBy);
        qbds.addSortField(fieldnum(AVASFCFeedback, TransactionType));                          // Transaktionstyp
        qr = new QueryRun(q);
        while (qr.next())
        {
            kCS_SFCFeedback = qr.get(tablenum(AVASFCFeedback));
            set.add(kCS_SFCFeedback.TransactionType);
        }
        return set;
    }

]]></Source>
			</Method>
			<Method>
				<Name>parmProdRepAmount</Name>
				<Source><![CDATA[
    public ProdReportedGood parmProdRepAmount(boolean _withError = true, boolean _withOrig = true)
    {
        ProdReportedGood        prodRepAmount;
        ;
        prodRepAmount = abs(this.ProdReportedGood);
        if (_withError)
        {
            prodRepAmount += abs(this.ProdReportedError);
        }
        
        if (_withOrig)
        {
            prodRepAmount += abs(this.ProdRepGoodOrig);
            if (_withError)
            {
                prodRepAmount += abs(this.ProdRepErrorOrig);
            }
        }
        return prodRepAmount;
    }

]]></Source>
			</Method>
			<Method>
				<Name>getOprIdFromProdRouteTrans</Name>
				<Source><![CDATA[
    RouteOprId getOprIdFromProdRouteTrans()
    {
        ProdRouteTrans      prodRouteTrans;
        
        if (this.ProdId && this.JmgJobId)
        {
            // selbst wenn meherere DS zur gleichen JobId vorhanden sind,
            // handelt es sich um den gleichen Arbeitsgang
            select firstOnly prodRouteTrans
                where   prodRouteTrans.TransRefId   == this.ProdId
                    && prodRouteTrans.TransRefType == ProdTransRefType::Production
                    &&  prodRouteTrans.JobId    == this.JmgJobId;
                    

        }
        return prodRouteTrans.OprId;
    }

]]></Source>
