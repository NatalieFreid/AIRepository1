			<Method>
				<Name>createClockinClockout</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    static void createClockinClockout(AVANdxSFCId _kcs_NdxSFCId)
    {
        AVASFCFeedback kcs_SFCFeedbackClockIn;
        AVASFCFeedback kcs_SFCFeedbackClockOut;
        AVASFCFeedback kcs_SFCFeedback;
        JmgJobTable     jmgJobTable;
        boolean         overlapping;
        ProdRoute       prodRoute;
        JmgDateTime   clockinTime, clockoutTime;
        ;

        while select * from kcs_SFCFeedback where kcs_SFCFeedback.NdxSFCId == _kcs_NdxSFCId
        {
            if (clockinTime > kcs_SFCFeedback.JmgDateTime || !clockinTime)
            {
                clockinTime = kcs_SFCFeedback.JmgDateTime;
            }
            if (clockoutTime < kcs_SFCFeedback.JmgDateTime || !clockoutTime)
            {
                clockoutTime = kcs_SFCFeedback.JmgDateTime;
            }
        }

        select firstonly1 * from kcs_SFCFeedback where kcs_SFCFeedback.NdxSFCId == _kcs_NdxSFCId;

        if (kcs_SFCFeedback.RecId)
        {
            // ClockIn
            jmgJobTable = JmgJobTable::find(jmgIpcActivity::findSignInJobId());
            if (jmgJobTable)
            {
                kcs_SFCFeedbackClockIn.clear();
                kcs_SFCFeedbackClockIn.InventSiteId         = kcs_SFCFeedback.InventSiteId;
                kcs_SFCFeedbackClockIn.ProdId               = kcs_SFCFeedback.ProdId;
                kcs_SFCFeedbackClockIn.JmgJobId             = jmgJobTable.JobId;
                kcs_SFCFeedbackClockIn.JmgDate              = kcs_SFCFeedback.JmgDate;
                
                kcs_SFCFeedbackClockIn.Worker               = kcs_SFCFeedback.Worker;
                
                kcs_SFCFeedbackClockIn.JmgTermRegType       = JmgTermRegType::ClockIn;
                kcs_SFCFeedbackClockIn.NdxSFCId             = kcs_SFCFeedback.NdxSFCId;
                kcs_SFCFeedbackClockIn.JmgDateTime          = clockinTime;
                kcs_SFCFeedbackClockIn.insert();
            }

            // ClockOut
            jmgJobTable.clear();
            jmgJobTable = JmgJobTable::find(JmgIpcActivity::findSignOutJobId());
            if (jmgJobTable)
            {
                kcs_SFCFeedbackClockOut.clear();
                kcs_SFCFeedbackClockOut.InventSiteId        = kcs_SFCFeedback.InventSiteId;
                kcs_SFCFeedbackClockOut.ProdId              = kcs_SFCFeedback.ProdId;
                kcs_SFCFeedbackClockOut.JmgJobId            = jmgJobTable.JobId;
                kcs_SFCFeedbackClockOut.JmgDate             = kcs_SFCFeedback.JmgDate;
                kcs_SFCFeedbackClockOut.Worker              = kcs_SFCFeedback.Worker;
                kcs_SFCFeedbackClockOut.JmgTermRegType      = JmgTermRegType::ClockOut;
                kcs_SFCFeedbackClockOut.NdxSFCId            = kcs_SFCFeedback.NdxSFCId;
                kcs_SFCFeedbackClockOut.JmgDateTime         = clockoutTime;
                kcs_SFCFeedbackClockOut.insert();
            }

            AVASFCFeedback::setNewLineNums(kcs_SFCFeedbackClockOut.NdxSFCId);
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>setNewLineNums</Name>
				<Source><![CDATA[
    static void setNewLineNums(AVANdxSFCId _kcs_NdxSFCId, boolean _onlyCheckMinuteDiff = false)
    {
        #define.SecPerMin(60)
        AVASFCFeedback kcs_SFCFeedback;
        LineNum         lineNum;
        AVASFCFeedback kcs_SFCFeedbackLast;
        boolean lDiff = false;
        int64 secDiff;
        int diffCounter = 0;

        ttsbegin;
        while select forUpdate * from kcs_SFCFeedback order by JmgDateTime, JmgTermRegType
            where kcs_SFCFeedback.NdxSFCId == _kcs_NdxSFCId
        {
            lineNum++;
            kcs_SFCFeedback.LineNum = LineNum;
            
            if (kcs_SFCFeedbackLast)
            {
                secDiff = DateTimeUtil::getDifference(kcs_SFCFeedback.JmgDateTime, kcs_SFCFeedbackLast.JmgDateTime);
                
                lDiff = (kcs_SFCFeedback.SecondsDiffPosting - secDiff) != 0;
                kcs_SFCFeedback.SecondsDiffPosting = secDiff;
                
                if (lDiff)
                {
                    ++diffCounter;
                }
            }
            
            kcs_SFCFeedbackLast = kcs_SFCFeedback.data();
            
            if (!lDiff && _onlyCheckMinuteDiff)
            {
                continue;
            }
            kcs_SFCFeedback.doupdate();

        }
        ttscommit;
        
        if (_onlyCheckMinuteDiff)
        {
            info(strfmt("@NDX:NDXMinDiffBDE", diffCounter, _kcs_NdxSFCId));     // Anzahl der geänderten Minuten-Differenzen: [ %1 ] zur NDX-BDE-Nr. [ %2 ]
        }
        
    }

]]></Source>
