		<Methods>
			<Method>
				<Name>initFromQuotationJour</Name>
				<Source><![CDATA[
    /// <summary>
    /// designed from AVA
    /// </summary>
    /// <param name = "_custQuotationJour">_custQuotationJour</param>
    /// <param name = "_quotationIdBase">_quotationIdBase</param>
    public void initFromQuotationJour(  CustQuotationJour   _custQuotationJour,
                                        QuotationIdBase     _quotationIdBase    )
    {
        CustQuotationTrans               custQuotationTrans;
        AVASpecialDiscQuotation          specialDiscountQuotation = AVASpecialDiscQuotation::find(_quotationIdBase);
        AmountMST                        quotLineAmount;
        
        this.QuotationJourRefRecId      = _custQuotationJour.RecId;
        this.SpecialDiscountId1         = specialDiscountQuotation.SpecialDiscountId1;
        this.SpecialDiscountId2         = specialDiscountQuotation.SpecialDiscountId2;
        this.SpecialDiscountId3         = specialDiscountQuotation.SpecialDiscountId3;
        this.SpecialDiscountPct1        = specialDiscountQuotation.SpecialDiscountPct1;
        this.SpecialDiscountPct2        = specialDiscountQuotation.SpecialDiscountPct2;
        this.SpecialDiscountPct3        = specialDiscountQuotation.SpecialDiscountPct3;
        this.AllDiscountFactor          = specialDiscountQuotation.AllDiscountFactor;
        /*
        while select LineAmount  from custQuotationTrans
            where custQuotationTrans.QuotationId   == _custQuotationJour.QuotationId
               && custQuotationTrans.QuotationDate == _custQuotationJour.QuotationDate
               && custQuotationTrans.SalesId       == _custQuotationJour.SalesId
        {
            quotLineAmount += custQuotationTrans.LineAmount;
        }
        */
        quotLineAmount = _custQuotationJour.displayAVABaseAmount();
        
        this.SpecialDiscountAmount1     = decRound(quotLineAmount * this.SpecialDiscountPct1 / 100, 2);
        this.SpecialDiscountAmount2     = decRound((quotLineAmount - this.SpecialDiscountAmount1) * this.SpecialDiscountPct2 / 100, 2);
        this.SpecialDiscountAmount3     = decRound((quotLineAmount - this.SpecialDiscountAmount1 - this.SpecialDiscountAmount2) * this.SpecialDiscountPct3 / 100, 2);
    }

]]></Source>
			</Method>
			<Method>
				<Name>findQuotation</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find special discount quotation jour based on provided QuotationRecId
    /// </summary>
    /// <param name = "_quotationRecId">RefRecId</param>
    /// <param name = "_forUpdate">boolean</param>
    /// <returns>AVASpecialDiscQuotationJour</returns>
    public static AVASpecialDiscQuotationJour findQuotation(RefRecId _quotationRecId,
                                  boolean _forUpdate = false)
    {
        AVASpecialDiscQuotationJour discQuotationJour;

        if (_quotationRecId)
        {
            if (_forUpdate)
            {
                discQuotationJour.selectForUpdate (_forUpdate);
            }
            discQuotationJour.selectLocked    (_forUpdate);

            select firstonly discQuotationJour
                where discQuotationJour.QuotationJourRefRecId == _quotationRecId;

        }

        return discQuotationJour;

    }

]]></Source>
			</Method>
			<Method>
				<Name>displaySpecialDiscountAmountSum</Name>
				<Source><![CDATA[
    /// <summary>
    ///     AVA <c>displaySpecialDiscountAmountSum</c> method.
    ///     AVA - Schneider 04.07.2024
    /// </summary>
    /// <returns>
    ///     <c>AmountCur</c> as return value
    /// </returns>
    [SysClientCacheDataMethodAttribute(true)]
    display AmountCur displaySpecialDiscountAmountSum()
    {
        AmountCur  retVal;

        retVal = this.SpecialDiscountAmount1 + this.SpecialDiscountAmount2 + this.SpecialDiscountAmount3;

        return retVal;
    }

]]></Source>
			</Method>
