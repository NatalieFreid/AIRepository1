    /// <summary>
    /// DebuC 06.02.23
    /// </summary>
    /// <param name = "characteristicId">KCS_ProdCharacteristicId</param>
    /// <param name = "update">boolean</param>
    /// <returns>KCS_ProdCharacteristic</returns>
    static public KCS_ProdCharacteristic find(KCS_ProdCharacteristicId characteristicId,
                                                   boolean update = false)
    {
        KCS_ProdCharacteristic prodCharacteristic;
        ;
        prodCharacteristic.selectForUpdate(update);

        select firstonly prodCharacteristic
        where prodCharacteristic.CharacteristicId == characteristicId;

        return prodCharacteristic;
    }

