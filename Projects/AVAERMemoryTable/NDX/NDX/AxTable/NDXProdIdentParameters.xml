				<Source><![CDATA[
    /// <summary>
    /// PaffH 04.05.22
    /// increment RecordId for BT-Table
    /// </summary>
    /// <returns>NDXBTRecordId</returns>
    static NDXBTRecordId nextRecordId()
    {
        NDXProdIdentParameters nDXProdIdentParameters = NDXProdIdentParameters::find(true);
        ttsbegin;
        nDXProdIdentParameters.BTRecordId += 1;
        nDXProdIdentParameters.update();
        ttscommit;

        return nDXProdIdentParameters.BTRecordId;
    }

]]></Source>
