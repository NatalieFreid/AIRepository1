				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// PaffH 04.05.22
    /// </summary>
    /// <param name = "_forUpdate">boolean</param>
    /// <param name = "_concurrencyModel">ConcurrencyModel</param>
    /// <returns>NDXProdIdentParameters</returns>
    public static NDXProdIdentParameters find( boolean _forUpdate = false,
                                        ConcurrencyModel _concurrencyModel = ConcurrencyModel::Auto)
    {
        NDXProdIdentParameters parameters;
        parameters.selectForUpdate(_forUpdate);

        if (_forUpdate && _concurrencyModel != ConcurrencyModel::Auto)
        {
            parameters.concurrencyModel(_concurrencyModel);
        }

        select firstonly parameters
            index Key
            where parameters.Key == 0;

        if (!parameters)
        {
            Company::createParameter(parameters);
        }

        return parameters;
    }

]]></Source>
