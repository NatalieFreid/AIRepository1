			<Method>
				<Name>validateField</Name>
				<Source><![CDATA[
    boolean  validateField(FieldId  _fieldId)
    {
        boolean     ok              = true;
        CompanyId   allowedCompany  = 'NDG';

        ok = super(_fieldId);

        if(ok)
        {
            switch(_fieldId)
            {
                case fieldNum(AVASalesParameters, HKFromSupportTable):
                    if(curExt() != allowedCompany
                        && this.HKFromSupportTable)
                    {
                        ok = ok & checkFailed(strFmt("@NDX:NXAHKFromSupportTableCheckFailed", allowedCompany));
                    }
                    break;

                default:
                    break;
            }
        }

        return ok;
    }

]]></Source>
