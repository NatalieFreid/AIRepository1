			<Method>
				<Name>checkDirectCustomerCreation</Name>
				<Source><![CDATA[
    /// <summary>
    ///    AVA <c>checkDirtectCustomerCreation</c> method.
    /// </summary>
    /// <param name="_showMessage">
    ///    <c>boolean</c> as type
    /// </param>
    /// <returns>
    ///    <c>NoYes</c> as return value
    /// </returns>
    public static NoYes checkDirectCustomerCreation(boolean _showMessage = NoYes::No)
    {
        NoYes retVal;

        retVal = AVASalesParameters::find().DirectCustomerCreation;
        
        if(_showMessage && !retVal)
        {
            warning("@NDX:NXACustomerCreationByTransformingBusinessRelations");
        }

        return   retVal;
    }

]]></Source>
