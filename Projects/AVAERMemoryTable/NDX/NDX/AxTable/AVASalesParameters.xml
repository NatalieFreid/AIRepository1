			<Method>
				<Name>salesQuotExcelReportLookup</Name>
				<Source><![CDATA[
    /// <summary>
    /// designed from AVA
    /// </summary>
    /// <param name = "_formControl">FormControl</param>
    public static  void salesQuotExcelReportLookup(FormControl          _formControl)
    {
        SysTableLookup          sysTableLookup = SysTableLookup::newParameters(tableNum(PrintMgmtReportFormat),_formControl);
        Query                   query = new Query();
        QueryBuildDataSource    printMgmtReportFormatDS;

        sysTableLookup.addLookupfield(fieldNum(PrintMgmtReportFormat,Name),true);
        sysTableLookup.addLookupfield(fieldNum(PrintMgmtReportFormat,Description));

        printMgmtReportFormatDS = query.addDataSource(tableNum(PrintMgmtReportFormat));
        printMgmtReportFormatDS.addRange(fieldNum(PrintMgmtReportFormat,DocumentType)).value(enum2Str(PrintMgmtDocumentType::Quotation));

        sysTableLookup.parmQuery(query);

        sysTableLookup.performFormLookup();

    }

]]></Source>
			</Method>
			<Method>
				<Name>editSalesQuotExcelReport</Name>
				<Source><![CDATA[
    /// <summary>
    /// designed from AVA
    /// </summary>
    /// <param name = "_set">_set</param>
    /// <param name = "_reportName">_reportName</param>
    /// <returns>Description</returns>
    public edit Description editSalesQuotExcelReport(boolean    _set,
                                                     PrintMgmtReportFormatName      _reportName)
    {
        PrintMgmtReportFormat       printMgmtReportFormat;

        if (_set)
        {
            this.SalesQuotationExcelReport = _reportName;
        }

        select firstonly printMgmtReportFormat 
            where printMgmtReportFormat.Name == this.SalesQuotationExcelReport;

        return printMgmtReportFormat.Description;
    }

]]></Source>
