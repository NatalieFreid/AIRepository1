			<Method>
				<Name>avaEmailContent</Name>
				<Source><![CDATA[
    /// <summary>
    /// Returns the EmailContent field in the table and replaces the subString '%Anrede%' with the correct introduction based on LanguageId and gender of provided contact
    /// </summary>
    /// <param name = "_contactId">ContactPersonId</param>
    /// <param name = "_languageId">LanguageId, default = 'de'</param>
    /// <returns>emailContent with introduction</returns>
    public str avaEmailContent(ContactPersonId _contactId, LanguageId _languageId = 'de')
    {
        str avaIntroduction, avaEmailContent;
        str avaReplacementStr = '%Anrede%';
        ContactPerson avaContact = ContactPerson::find(_contactId);
        DirPerson avaPerson = DirPerson::find(avaContact.Party);
        DirPersonName avaPersonName = DirPersonName::find(avaPerson.RecId);

        if(avaPerson.Gender == Gender::Male)
        {
            avaIntroduction = SysLabel::labelId2String(literalStr("@NDX:DearMr"), _languageId) + ' ';

            if(avaPersonName.LastNamePrefix)
            {
                avaIntroduction += avaPersonName.LastNamePrefix + ' ';
            }

            avaIntroduction += avaPersonName.LastName;
        }
        else if(avaPerson.Gender == Gender::Female)
        {
            avaIntroduction = SysLabel::labelId2String(literalStr("@NDX:DearMrs"), _languageId) + ' ';

            if(avaPersonName.LastNamePrefix)
            {
                avaIntroduction += avaPersonName.LastNamePrefix + ' ';
            }

            avaIntroduction += avaPersonName.LastName;
        }
        else    // Gender unkown or unspecified
        {
            avaIntroduction = SysLabel::labelId2String(literalStr("@NDX:DearSirOrMadam"), _languageId);
        }

        avaEmailContent = strReplace(this.EmailContent, avaReplacementStr, avaIntroduction);        

        return avaEmailContent;
    }

]]></Source>
			</Method>
