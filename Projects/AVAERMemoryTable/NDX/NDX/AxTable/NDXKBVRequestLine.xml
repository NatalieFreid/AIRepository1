    /// <param name = "_forUpdate">boolean</param>
    /// <returns>NDXKBVRequestLine</returns>
    public static NDXKBVRequestLine findFromNDXKBVRequestLineRecId(RecId _recIdNDXKBVRequestLine, boolean _forUpdate = false)
    {
        NDXKBVRequestLine nDXKBVRequestLine;
        nDXKBVRequestLine.selectForUpdate(_forUpdate);
        if (_recIdNDXKBVRequestLine)
        {
            select firstonly nDXKBVRequestLine
            where nDXKBVRequestLine.RecId == _recIdNDXKBVRequestLine;
        }
        return nDXKBVRequestLine;
    }

