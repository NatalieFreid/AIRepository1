				<Source><![CDATA[
    /// <summary>
    /// Finds NDXRecIdUnitConvert record 
    /// </summary>
    /// <param name = "_recId">RecId of record</param>
    /// <param name = "_update">for update</param>
    /// <returns>NDXRecIdUnitConvert record</returns>
    static NDXRecIdUnitConvert find(RecId _recId, boolean _update = false)
    {
        NDXRecIdUnitConvert lNDX_RecId;
        ;
        if (_recId)
        {
            lNDX_RecId.selectForUpdate(_update);

            select firstonly lNDX_RecId
            where lNDX_RecId.RefRecId == _recId;
        }
        return lNDX_RecId;
    }

]]></Source>
