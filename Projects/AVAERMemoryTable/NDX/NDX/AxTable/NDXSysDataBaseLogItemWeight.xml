    /// <returns>record</returns>
    static NDXSysDataBaseLogItemWeight find(utcdatetime _dateTimeChanged, RecId _recId, boolean _update = false)
    {
        NDXSysDataBaseLogItemWeight  nDX_SysDataBaseLog;
        nDX_SysDataBaseLog.selectForUpdate(_update);

        select firstonly nDX_SysDataBaseLog
            where nDX_SysDataBaseLog.DateTimeChanged == _dateTimeChanged &&
              nDX_SysDataBaseLog.InventTableRefRecId == _recId;

        return nDX_SysDataBaseLog;
    }

