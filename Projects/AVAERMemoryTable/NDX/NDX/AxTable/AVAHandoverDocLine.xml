			<Method>
				<Name>inventTransType2WorkTransType</Name>
				<Source><![CDATA[
    public static WHSWorkTransType  inventTransType2WorkTransType(InventTransType _inventTransType)
    {
        WHSWorkTransType    workTransType;

        switch (_inventTransType)
        {
            case InventTransType::Sales:
                workTransType = WHSWorkTransType::Sales;
                break;
            case InventTransType::InventTransfer:
                workTransType = WHSWorkTransType::TransferIssue;
                break;
            default:
                throw error(Error::wrongUseOfFunction(funcName()));
        }

        return workTransType;

    }

]]></Source>
			</Method>
			<Method>
				<Name>displayWeight</Name>
				<Source><![CDATA[
    public display Weight displayWeight()
    {
        InventTable     inventTable;
        Weight          weight;

        if (this.ItemId)
        {
            inventTable = this.inventTable();

            if (inventTable)
            {
                switch (this.DataType)
                {
                    case AVAHandoverDocDataType::Picked:
                        weight = this.PickedQty * inventTable.NetWeight;
                    default:
                        weight = this.InventQty * inventTable.NetWeight;
                }
                
            }
        }

        return weight;
    }

]]></Source>
			</Method>
			<Method>
				<Name>displayWeightUnitSymbol</Name>
				<Source><![CDATA[
    public display UnitOfMeasureSymbol displayWeightUnitSymbol()
    {
        UnitOfMeasureSymbol         unitOfMeasureSymbol;
        UnitOfMeasureInternalCode   unitOfMeasureInternalCode;
        UnitOfMeasure               unitOfMeasure;

        select firstonly unitOfMeasure
            exists join unitOfMeasureInternalCode
                where unitOfMeasureInternalCode.UnitOfMeasure == unitOfMeasure.RecId
                   && unitOfMeasureInternalCode.CodeSymbol      ==  UnitOfMeasureCodeSymbol::Kilograms;

        unitOfMeasureSymbol = unitOfMeasure.Symbol;

        return unitOfMeasureSymbol;
    }

]]></Source>
			</Method>
