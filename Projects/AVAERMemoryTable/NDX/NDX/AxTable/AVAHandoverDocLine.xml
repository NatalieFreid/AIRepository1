		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static AVAHandoverDocLine find(AVAHandoverDocTableRefRecId   _handoverDocId,
                                          WHSWorkId                     _workId,
                                          LineNum                       _lineNum,
                                          AVALoadLineRefRecId           _LoadLineRefRecId,
                                          boolean                       _forUpdate = false)
    {
        AVAHandoverDocLine  handoverDocLine;

        if (_forUpdate)
        {
            handoverDocLine.selectForUpdate(_forUpdate);
        }

        select firstonly handoverDocLine
            where handoverDocLine.HandoverDocId     == _handoverDocId
               && handoverDocLine.WorkId            == _workId
               && handoverDocLine.LineNum           == _lineNum
               && handoverDocLine.LoadLineRefRecId  == _LoadLineRefRecId;

        return handoverDocLine;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initFromWorkTable</Name>
				<Source><![CDATA[
    public void initFromWorkTable(WHSWorkTable _workTable)
    {
        this.TargetLicensePlateId   = _workTable.TargetLicensePlateId;
        this.WorkTransType          = _workTable.WorkTransType;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initFromWorkLine</Name>
				<Source><![CDATA[
    public void initFromWorkLine(WHSWorkLine _workLine)
    {
        this.WorkId             = _workLine.WorkId;
        this.LineNum            = _workLine.LineNum;
        this.ItemId             = _workLine.ItemId;
        this.PickedQty          = _workLine.InventQtyWork - _workLine.InventQtyRemain;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initFroLoadLine</Name>
				<Source><![CDATA[
    public void initFroLoadLine(WHSLoadLine _loadLine)
    {
        this.InventTransId      = _loadLine.InventTransId;
        this.InventQty          = _loadLine.InventQty;
        this.ItemId             = _loadLine.ItemId;
        this.LoadId             = _loadLine.LoadId;
        this.LoadLineRefRecId   = _loadLine.RecId;
        this.WorkTransType      = AVAHandoverDocLine::inventTransType2WorkTransType(_loadLine.InventTransType);
        this.OrderNum           = _loadLine.OrderNum;
    }

]]></Source>
			</Method>
