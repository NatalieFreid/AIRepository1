		<Methods>
			<Method>
				<Name>diffWert</Name>
				<Source><![CDATA[
    /// <summary>
    /// DebuC 30.03.23
    /// </summary>
    /// <returns>AmountMST</returns>
    display AmountMST diffWert()
    {
        return this.AmountMST_TaxTrans - this.AmountMST_Intrastat;
    }

]]></Source>
			</Method>
			<Method>
				<Name>diffPercent</Name>
				<Source><![CDATA[
    /// <summary>
    /// DebuC 30.03.23
    /// </summary>
    /// <returns>NDXProzent</returns>
    display NDXProzent diffPercent()
    {
        return 100 - ((this.AmountMST_Intrastat * 100) / (this.AmountMST_TaxTrans == 0 ? 1 : this.AmountMST_TaxTrans));
    }

]]></Source>
			</Method>
			<Method>
				<Name>IntrastatItem_TransferIsAllowed</Name>
				<Source><![CDATA[
    /// <summary>
    /// DebuC 30.03.23
    /// </summary>
    /// <returns>boolean</returns>
    display NDXIntrastatTransferAllowedItem IntrastatItem_TransferIsAllowed()
    {
        Intrastat   intrastat;
        NDXIntrastatTransferAllowedItem     isAllowed;
        ;

        if (this.RefCompanyId)
        {
            intrastat.ItemId = this.ItemId;
            changecompany(this.RefCompanyId)
            {
                if(intrastat.transferIsAllowed())
                {
                    isAllowed = NoYes::Yes;
                }
                else
                {
                    isAllowed = NoYes::No;
                }
            }
        }
        return isAllowed;
    }

]]></Source>
			</Method>
			<Method>
				<Name>CountryRegionIdVendor</Name>
				<Source><![CDATA[
    /// <summary>
    /// DebuC 30.03.23
    /// </summary>
    /// <param name = "buffer">NDXIntrastatDiffLine</param>
    /// <returns>AddressCountryRegionId</returns>
    display AddressCountryRegionId CountryRegionIdVendor(NDXIntrastatDiffLine buffer = this)
    {
        return VendTable::find(buffer.AccountNum).countryRegionId();
    }

]]></Source>
			</Method>
			<Method>
				<Name>Account_TransferIsAllowed</Name>
				<Source><![CDATA[
    //TODO DebuC Issue 7784
    //display NDX_CountryRegionIdVendTrans CountryRegionIdVendTrans(NDXIntrastatDiffLine cursor)
    //{
    //    return NDXIntrastat::vendInvoiceJourFromRecIdVendInvoiceTrans(cursor.RefRecIdVendInvoiceTrans).NDX_CountryRegionIdVendTrans;
    //}
    
    
    
    /// <summary>
    /// DebuC 30.03.23
    /// </summary>
    /// <returns>boolean</returns>
    display NDXIntrastatTransferAllowedAccount Account_TransferIsAllowed()
    {
        PurchTable  purchTable;
        NDXIntrastatTransferDE   intrastatTransfer = NDXIntrastatTransferDE::construct();
        Intrastat   intrastat;
        NDXIntrastatTransferAllowedAccount     isAllowed;
        ;

        if (this.RefCompanyId)
        {
            changecompany(this.RefCompanyId)
            {
                if (this.RefRecIdIntrastat)
                {
                    select firstonly intrastat where intrastat.RecId == this.RefRecIdIntrastat;
                    if(intrastatTransfer.importToBeIncludedPublic(intrastat.AccountNum, this.CountryRegionIdVendPackingSlipTrans))
                    {
                        isAllowed = NoYes::Yes;
                    }
                    else
                    {
                        isAllowed = NoYes::No;
                    }
                }

                else if (this.PurchIdOrig)
                {
                    purchTable = PurchTable::find(this.PurchIdOrig);
                    if(intrastatTransfer.importToBeIncludedPublic(purchTable.InvoiceAccount, this.DestCountryRegionId))
                    {
                        isAllowed = NoYes::Yes;
                    }
                    else
                    {
                        isAllowed = NoYes::No;
                    }
                }
            }
        }
        return isAllowed;
    }

]]></Source>
			</Method>
