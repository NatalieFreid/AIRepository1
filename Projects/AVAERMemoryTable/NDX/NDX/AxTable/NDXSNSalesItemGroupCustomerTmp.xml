			<Method>
				<Name>findClientGroupRecId</Name>
				<Source><![CDATA[
    /// <summary>
    /// find
    /// </summary>
    /// <param name = "_tmpRecord">NDXSNSalesItemGroupCustomerTmp record</param>
    /// <param name = "_company">company</param>
    /// <param name = "_clientGroupRecId">client group recid</param>
    /// <param name = "_artGrp">item group</param>
    /// <param name = "_selectforUpdate">for update</param>
    /// <returns>NDXSNSalesItemGroupCustomerTmp record</returns>
    static NDXSNSalesItemGroupCustomerTmp findClientGroupRecId(NDXSNSalesItemGroupCustomerTmp _tmpRecord,
                            NDXCompanyBE _company,
                            RefRecId _clientGroupRecId,
                            NDXItemGroup _artGrp,
                            boolean _selectforUpdate = false)
    {

        NDXSNSalesItemGroupCustomerTmp tmpRecord = _tmpRecord;
        tmpRecord.selectForUpdate(_selectforUpdate);

        select firstonly tmpRecord
            where tmpRecord.Company == _company
                &&  tmpRecord.NDXSNClientGroupRefRecId == _clientGroupRecId
                &&  tmpRecord.ArtGrp == _artGrp;

        return tmpRecord;
    }

]]></Source>
