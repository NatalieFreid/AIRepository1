			<Method>
				<Name>findLast</Name>
				<Source><![CDATA[
    /// <summary>
    ///     AVA <c>findLast</c> method.
    /// </summary>
    /// <param name="_prodId">
    ///     <c>ProdId</c> as type
    /// </param>
    /// <param name="_update">
    ///     <c>boolean</c> as type
    /// </param>
    /// <returns>
    ///     <c>KCS_ProdDateHistory</c> as return value
    /// </returns>
    public static KCS_ProdDateHistory findLast( ProdId  _prodId,
                                                boolean _update     = false)
    {
        KCS_ProdDateHistory  prodDateHistory;

        if (_prodId)
        {
            prodDateHistory.selectForUpdate(_update);

            select firstonly prodDateHistory 
            order by ModificationDate desc
            where prodDateHistory.ProdId == _prodId;
        }

        return prodDateHistory;
    }

]]></Source>
