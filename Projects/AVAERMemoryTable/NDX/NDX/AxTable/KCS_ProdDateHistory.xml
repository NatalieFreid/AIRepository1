			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    ///     Check existance of record in the <c>KCS_ProdDateHistory</c> table
    /// </summary>
    /// <param name = "_recordId">
    ///     The record ID of the <c>KCS_ProdDateHistory</c> record to check.
    /// </param>
    /// <returns>
    ///     <c>boolean</c> true if record exists
    /// </returns>
    static boolean  exist(RecId _recordId)
    {
        return  _recordId
            &&  (   select  firstonly RecId
                    from    KCS_ProdDateHistory
                    where   KCS_ProdDateHistory.RecId == _recordId).RecId;
    }

]]></Source>
