		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    ///     Finds the specified record in the <c>KCS_ProdDateHistory</c> table.
    /// </summary>
    /// <param name="_recordId">
    ///     The record ID of the <c>KCS_ProdDateHistory</c> record to find.
    /// </param>
    /// <param name="_recordId2">
    ///     The record ID2 of the <c>KCS_ProdDateHistory</c> record to find.
    /// </param>
    /// <param name="_forUpdate">
    ///     A Boolean value that indicates whether to read the record for update; optional.
    /// </param>
    /// <returns>
    ///     A record in the <c>KCS_ProdDateHistory</c> table; otherwise, an empty record.
    /// </returns>
    public static KCS_ProdDateHistory find( ProdId              _recordId,
                                            AVAModificationDate _recordId2,
                                            boolean             _forUpdate = false)
    {
        KCS_ProdDateHistory record;

        if (_recordId)
        {
            record.selectForUpdate(_forUpdate);

            select firstonly record
            index hint ProdDateIdIdx
            where   record.ProdId           == _recordId
                &&  record.ModificationDate == _recordId2;
        }

        return record;
    }

]]></Source>
