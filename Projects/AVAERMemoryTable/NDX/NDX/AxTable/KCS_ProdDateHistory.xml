			<Method>
				<Name>initValue</Name>
				<Source><![CDATA[
    /// <summary>
    ///     AVA <c>initValue</c> method.
    /// </summary>
    /// <param name="_prodId">
    ///     <c>ProdId</c> as type
    /// </param>
    /// <param name="_firstSchedule">
    ///     <c>AVAFirstSchedule</c> as type
    /// </param>
    public void initValue(  ProdId              _prodId         = '', 
                            AVAFirstSchedule    _firstSchedule  = NoYes::No )
    {
        super();

        this.ProdId             = _prodId;
        this.ModificationDate   = DateTimeUtil::getToday(DateTimeUtil::getUserPreferredTimeZone());
        this.FirstSched         = _firstSchedule;
    }

]]></Source>
