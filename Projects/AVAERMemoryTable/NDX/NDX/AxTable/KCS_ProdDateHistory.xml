			<Method>
				<Name>existFirstSched</Name>
				<Source><![CDATA[
    /// <summary>
    ///     AVA <c>existFirstSched</c> method.
    /// </summary>
    /// <param name = "_prodId">
    ///     The record ID of the <c>ProdId</c> record to check.
    /// </param>
    /// <returns>
    ///     <c>boolean</c> true if record exists
    /// </returns>
    public static boolean existFirstSched(ProdId   _prodId)
    {
        return  _prodId 
            &&  (   select  RecId 
                    from    KCS_ProdDateHistory
                    where   KCS_ProdDateHistory.ProdId  == _prodId && KCS_ProdDateHistory.FirstSched    ).RecId != 0;
    }

]]></Source>
