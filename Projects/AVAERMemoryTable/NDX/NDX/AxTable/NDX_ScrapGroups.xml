		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// CD 09.11.2021 Req: 3655 Task: 5401
    /// </summary>
    /// <param name = "_id">NDX_ScrapId</param>
    /// <param name = "_forUpdate">boolean</param>
    /// <returns>NDX_ScrapGroupPrice</returns>
    static NDX_ScrapGroups find(NDX_ScrapId _id, boolean _forUpdate = false)
    {
        NDX_ScrapGroups scrapGroups;

        scrapGroups.selectForUpdate(_forUpdate);

        select firstonly scrapGroups
        where scrapGroups.ScrapId == _id;
        
        return scrapGroups;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// CD 09.11.2021 Req: 3655 Task: 5401
    /// </summary>
    /// <param name = "_id">NDX_ScrapId</param>
    /// <returns>boolean</returns>
    static boolean exist(NDX_ScrapId _id)
    {
        NDX_ScrapGroups scrapGroups;

        select firstonly RecId from scrapGroups
            where scrapGroups.ScrapId == _id;

        return scrapGroups.RecId;
    }

]]></Source>
