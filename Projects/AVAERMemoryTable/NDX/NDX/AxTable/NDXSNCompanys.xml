		<Methods>
			<Method>
				<Name>getSelectedUks</Name>
				<Source><![CDATA[
    static public container getSelectedUks(AVATOSId _tosId)
    {
        NDXSNCompanys ndxSNCompanys;
        container companiesCon = conNull();
        
        int start = 1;

        while select ndxSNCompanys
            where ndxSNCompanys.TOSId == _tosId
        {
            companiesCon = conIns(companiesCon, start, ndxSNCompanys.CompanyId);
            start++;
        }

        return companiesCon;
    }

]]></Source>
