		<Methods>
			<Method>
				<Name>travProcNum</Name>
				<Source><![CDATA[
    [SysClientCacheDataMethodAttribute(true)]    
    display str60 travProcNum()
    {
        if (this.ProcessNum)
        {
            return strFmt("@NDX:NXAProFormaSpacing", this.TravNum,this.ProcessNum);
        }
        else
        {
            return "@NDX:NDXEmptyEntry";
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>findByProdId</Name>
				<Source><![CDATA[
    /// <summary>
    /// AVA/WEN 2024/03/04
    /// </summary>
    /// <param name = "_prodId">ProdId</param>
    /// <param name = "_update">boolean</param>
    /// <returns>AVATraverseTrans</returns>
    public static AVATraverseTrans findByProdId(ProdId _prodId, boolean _update = false)
    {
        AVATraverseTrans travTrans;

        travTrans.selectForUpdate(_update);

        if (_prodId)
        {
            select firstonly travTrans
                where travTrans.ProdId == _prodId
                && travTrans.TravStatus == AVATravStatus::InProcess;
        }
        return travTrans;
    }

]]></Source>
			</Method>
			<Method>
				<Name>insert</Name>
				<Source><![CDATA[
    public void insert()
    {
        if (this.BasketNum)
        {
            this.TravNum = this.BasketNum;
        }

        super();
    }

]]></Source>
			</Method>
			<Method>
				<Name>initValue</Name>
				<Source><![CDATA[
    public void initValue()
    {
        const UnitOfMeasureSymbol PieceUnit = 'St';
        super();

        this.PiecesUnit = PieceUnit; 
    }

]]></Source>
			</Method>
			<Method>
				<Name>modifiedField</Name>
				<Source><![CDATA[
    public void modifiedField(FieldId _fieldId)
    {
        ProdBOM prodBOM;

        super(_fieldId);

        switch (_fieldId)
        {
            case fieldNum(AVATraverseTrans, Qty):
                if (this.ItemId && this.ProdUnit != this.PiecesUnit)
                {
                    select firstonly prodBOM where prodBOM.ProdId == this.ProdId
                        && prodBOM.ItemId == this.ItemId;
                    this.Pieces = EcoResProductUnitConverter::convertForReleasedProduct(this.ItemId, prodBOM.InventDimId, this.Qty, UnitOfMeasure::unitOfMeasureIdBySymbol(this.ProdUnit), UnitOfMeasure::unitOfMeasureIdBySymbol(this.PiecesUnit));
                }
                else
                {
                    this.Pieces = this.Qty;
                }
                break;
            case fieldNum(AVATraverseTrans, Pieces):
                if (this.ItemId && this.ProdUnit != this.PiecesUnit)
                {
                    select firstonly prodBOM where prodBOM.ProdId == this.ProdId
                        && prodBOM.ItemId == this.ItemId;
                    this.Qty = EcoResProductUnitConverter::convertForReleasedProduct(this.ItemId, prodBOM.InventDimId, this.Pieces, UnitOfMeasure::unitOfMeasureIdBySymbol(this.PiecesUnit), UnitOfMeasure::unitOfMeasureIdBySymbol(this.ProdUnit));
                }
                else
                {
                    this.Qty = this.Pieces;
                }
                break;

                
        }

    }

]]></Source>
			</Method>
