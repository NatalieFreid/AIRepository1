				<Source><![CDATA[
    /// <summary>
    ///    Finds the specified record in the <c>KCS_TonnageCalcedData</c> table.
    /// </summary>
    /// <param name="_transDate">
    ///    <c>TransDate</c> as type
    /// </param>
    /// <param name="_inventSiteId">
    ///    <c>InventSiteId</c> as type
    /// </param>
    /// <param name="_forUpdate">
    ///    <c>boolean</c> as type
    /// </param>
    /// <returns>
    ///    A record in the <c>KCS_TonnageCalcedData</c> table; otherwise, an empty record.
    /// </returns>
    static KCS_TonnageCalcedData find(  TransDate       _transDate,
                                        InventSiteId    _inventSiteId,
                                        boolean         _forUpdate = false)
    {
        KCS_TonnageCalcedData    record;

        if(_forUpdate)
        {
            record.selectForUpdate(_forUpdate);
        }

        select firstOnly record 
        where   record.TransDate    == _transDate
            &&  record.InventSiteId == _inventSiteId;

        return record;
    }

]]></Source>
