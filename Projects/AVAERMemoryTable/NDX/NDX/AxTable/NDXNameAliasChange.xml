    public static NDXNameAliasChange findOrCreate(RecId _dirPartyTable, boolean _insert = true)
    {
        NDXNameAliasChange nDXNameAliasChange = NDXNameAliasChange::find(_dirPartyTable, true);
        if (!nDXNameAliasChange)
        {
            nDXNameAliasChange.DirPartyTable = _dirPartyTable;
