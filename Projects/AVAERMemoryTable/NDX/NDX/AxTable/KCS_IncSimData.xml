		<Methods>
			<Method>
				<Name>createFromParameters</Name>
				<Source><![CDATA[
    /// <summary>
    /// designed from AVA
    /// </summary>
    public static  void createFromParameters(SalesQuotationTable       _salesQuotationTable)
    {
        AVASalesParameters      salesParameters = AVASalesParameters::find();

        KCS_IncSimData      incSimData;

        delete_from incSimData where incSimData.KCS_RefQuotationId == _salesQuotationTable.QuotationId;

        incSimData.KCS_RefQuotationId = _salesQuotationTable.QuotationId;
        incSimData.KCS_MaxBonusAmount = _salesQuotationTable.KCS_MaxBonusAmount;
        incSimData.KCS_CashDisc         = salesParameters.CashDisc;
        incSimData.KCS_MiscCosts        = salesParameters.MiscCosts;
        incSimData.KCS_VuV              = salesParameters.VuV;
        incSimData.KCS_Commision        = salesParameters.CommissionRate;
        incSimData.insert();
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// designed from AVA
    /// </summary>
    /// <param name = "_refQuotationId">_refQuotationId</param>
    /// <returns>boolean</returns>
    public static boolean exist(QuotationId       _refQuotationId)
    {
        return _refQuotationId &&
          (select firstonly KCS_IncSimData
               where KCS_IncSimData.KCS_RefQuotationId == _refQuotationId).Recid != 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
   /// <summary>
   /// designed from AVA
   /// </summary>
    /// <param name = "_refQuotationId">_refQuotationId</param>
    /// <returns>KCS_IncSimData</returns>
    public static  KCS_IncSimData find(KCS_RefQuotationId       _refQuotationId)
    {
        KCS_IncSimData      incSimData;

        select firstonly incSimData
            where incSimData.KCS_RefQuotationId == _refQuotationId;

        return incSimData;
    }

]]></Source>
			</Method>
