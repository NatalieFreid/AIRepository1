			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Finds a NDXItemStateTranslation record by RecId of NDXItemStateTable
    /// </summary>
    /// <param name = "_ndxItemStateTableRecId">NDXItemStateTable RecId</param>
    /// <param name = "_languageId">Language Id</param>
    /// <param name = "_forUpdate">true or false</param>
    /// <returns>NDXItemStateTranslation record</returns>
    static public NDXItemStateTranslation find(RecId _ndxItemStateTableRecId, LanguageId _languageId = SystemParameters::getSystemLanguageId(), boolean _forUpdate = false)
    {
        NDXItemStateTranslation lNDXItemStateTranslation;
       
        if(_ndxItemStateTableRecId > 0 && _languageId)
        {
            lNDXItemStateTranslation.selectForUpdate(_forUpdate);

            select firstonly lNDXItemStateTranslation
                where lNDXItemStateTranslation.RefRecIdNDXItemState == _ndxItemStateTableRecId
                && lNDXItemStateTranslation.LanguageId == _languageId;
        }
        
        return lNDXItemStateTranslation;
    }

]]></Source>
