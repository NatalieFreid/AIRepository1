		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// find by item id
    /// </summary>
    /// <param name = "_requisitionId">Requisitionid of requisition</param>
    /// <param name = "_itemId">item id </param>
    /// <param name = "_update">for update</param>
    /// <returns>NDXRequisitionLineGrp record</returns>
    static NDXRequisitionLineGrp find(NDXRequisitionId _requisitionId, ItemId _itemId, boolean _update = false)
    {
        NDXRequisitionLineGrp    nDX_requisition_LineGrp;
        nDX_requisition_LineGrp.selectForUpdate(_update);

        select firstonly nDX_requisition_LineGrp
            where   nDX_requisition_LineGrp.RequisitionId == _requisitionId
            &&  nDX_requisition_LineGrp.ItemId == _itemId;
        return nDX_requisition_LineGrp;
    }

]]></Source>
			</Method>
			<Method>
				<Name>findByItemIDAndModelNumber</Name>
				<Source><![CDATA[
    /// <summary>
    /// find record by Itemid and model number
    /// </summary>
    /// <param name = "_requisitionId">Requisitionid of requisition</param>
    /// <param name = "_itemId">item id</param>
    /// <param name = "_modelNumber">model number</param>
    /// <param name = "_update">for update</param>
    /// <returns>NDXRequisitionLineGrp record</returns>
    static NDXRequisitionLineGrp findByItemIDAndModelNumber(NDXRequisitionId _requisitionId, ItemId _itemId, NDXModelNumber _modelNumber, boolean _update = false)
    {
        NDXRequisitionLineGrp    nDX_requisition_LineGrp;
        nDX_requisition_LineGrp.selectForUpdate(_update);

        select firstonly nDX_requisition_LineGrp
            where   nDX_requisition_LineGrp.RequisitionId  == _requisitionId
                &&  nDX_requisition_LineGrp.ItemId         == _itemId
                &&  nDX_requisition_LineGrp.ModelNumber == _modelNumber;

        return nDX_requisition_LineGrp;
    }

]]></Source>
			</Method>
			<Method>
				<Name>setInventSumValues</Name>
				<Source><![CDATA[
    void setInventSumValues()
    {
        InventSum inventSum = NDXRequisition::getInventSumValues(this.ItemId);
        
        this.InventSum_AvailOrdered     = inventSum.AvailOrdered;
        this.InventSum_AvailPhysical    = inventSum.AvailPhysical;
        this.InventSum_OnOrder          = inventSum.OnOrder;
        this.InventSum_OrderedSum       = inventSum.orderedSum();
        this.InventSum_PhysicalOnHand   = inventSum.PhysicalInvent;
        this.InventSum_ReservOrdered    = inventSum.ReservOrdered;
        this.InventSum_ReservPhysical   = inventSum.ReservPhysical;
    }

]]></Source>
			</Method>
			<Method>
				<Name>deleteLineGrp</Name>
				<Source><![CDATA[
    /// <summary>
    /// Deletes not needed NDXRequisitionLineGrp records
    /// </summary>
    /// <param name = "_ndxRequisitionLine">NDXRequisitionLine record</param>
    static public void deleteLineGrp(NDXRequisitionLine _ndxRequisitionLine)
    {
        NDXRequisitionLine lNDXRequisitionLine;
        NDXRequisitionLineGrp lNDXRequisitionLineGrp;

        select firstonly lNDXRequisitionLine
            where lNDXRequisitionLine.RequisitionId == _ndxRequisitionLine.RequisitionId
                && lNDXRequisitionLine.ItemId == _ndxRequisitionLine.ItemId
            && lNDXRequisitionLine.RecId != _ndxRequisitionLine.RecId;

        if(!lNDXRequisitionLine)
        {
            delete_from lNDXRequisitionLineGrp
                where lNDXRequisitionLineGrp.RequisitionId == _ndxRequisitionLine.RequisitionId
                && lNDXRequisitionLineGrp.ItemId == _ndxRequisitionLine.ItemId;
        }

    }

]]></Source>
