			<Method>
				<Name>updateFromHandoverDocLine</Name>
				<Source><![CDATA[
    public void updateFromHandoverDocLine()
    {
        AVAHandoverDocLine  handoverDocLine;
        WHSLoadId           loadId;
        WHSOrderNum         orderNum;
        WHSWorkTransType    workTransType;

        while select handoverDocLine
            group by LoadId
            where handoverDocLine.HandoverDocId == this.RecId
        {
            if (!loadId)
            {
                loadId = handoverDocLine.LoadId;
            }

            if (loadId != handoverDocLine.LoadId)
            {
                loadId = '';
                break;
            }
        }
        while select handoverDocLine
            group by WorkTransType, OrderNum
            where handoverDocLine.HandoverDocId == this.RecId
        {
            if (!orderNum)
            {
                orderNum = handoverDocLine.OrderNum;
            }

            if (!workTransType)
            {
                workTransType = handoverDocLine.WorkTransType;
            }

            if (orderNum != handoverDocLine.OrderNum)
            {
                orderNum = '';
                break;
            }

            if (workTransType != handoverDocLine.WorkTransType)
            {
                workTransType = WHSWorkTransType::None;
                break;
            }
        }

        this.LoadId         = loadId;
        this.WorkTransType  = workTransType;
        this.OrderNum       = orderNum;
    }

]]></Source>
