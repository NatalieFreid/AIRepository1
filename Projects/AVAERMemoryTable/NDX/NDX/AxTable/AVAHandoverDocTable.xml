		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static AVAHandoverDocTable find(WHSShipmentId    _shipmentId,
                                           InventLocationId _inventLocationId,
                                           WMSlocationId    _wmslocationId,
                                           boolean          _forUpdate = false)
    {
        AVAHandoverDocTable handoverDocTable;

        if (_forUpdate)
        {
            handoverDocTable.selectForUpdate(_forUpdate);
        }

        select firstonly handoverDocTable
            where handoverDocTable.ShipmentId       == _shipmentId
               && handoverDocTable.InventLocationId == _inventLocationId
               && handoverDocTable.WMSLocationId    == _wmslocationId;

        return handoverDocTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>findByRecId</Name>
				<Source><![CDATA[
    public static AVAHandoverDocTable findByRecId(AVAHandoverDocTableRefRecId   _recId,
                                                  boolean                       _forUpdate = false)
    {
        AVAHandoverDocTable handoverDocTable;

        if (_recId)
        {
            if (_forUpdate)
            {
                handoverDocTable.selectForUpdate(_forUpdate);
            }

            select firstonly handoverDocTable
                where handoverDocTable.RecId == _recId;
        }

        return handoverDocTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>displayDlvModeId</Name>
				<Source><![CDATA[
    [
        SysClientCacheDataMethodAttribute(true)
    ]
    public display DlvModeId displayDlvModeId()
    {
        DlvModeId           dlvModeId;
        WHSShipmentTable    shipmentTable;

        if (this.ShipmentId)
        {
            select firstonly AVADlvMode from shipmentTable
                where shipmentTable.ShipmentId == this.ShipmentId;
        }

        dlvModeId = shipmentTable.AVADlvMode;

        return dlvModeId;
    }

]]></Source>
			</Method>
			<Method>
				<Name>displaySalesTableInfoField3</Name>
				<Source><![CDATA[
    [
        SysClientCacheDataMethodAttribute(true)
    ]
    public display AVAHandoverDocNotes displaySalesTableInfoField3()
    {
        KCS_SOCSalesTableInfoFields salesTableInfoFields;
        Notes                       notes;

        switch (this.WorkTransType)
        {
            case WHSWorkTransType::Sales:
                salesTableInfoFields = KCS_SOCSalesTableInfoFields::find(AVATableInfoFieldTypes::Sales, this.OrderNum);
                break;
            case WHSWorkTransType::TransferIssue:
                salesTableInfoFields = KCS_SOCSalesTableInfoFields::find(AVATableInfoFieldTypes::TransferOrderShip, this.OrderNum);
                break;
        }        

        if (salesTableInfoFields)
        {
            notes = salesTableInfoFields.InfoField3;
        }

        return notes;
    }

]]></Source>
			</Method>
			<Method>
				<Name>displayCustName</Name>
				<Source><![CDATA[
    [
        SysClientCacheDataMethodAttribute(true)
    ]
    display AVACustName displayCustName()
    {
        SalesTable  salesTable;
        CustTable   custTable;
        CustName    custName;

        if (this.OrderNum
         && this.WorkTransType == WHSWorkTransType::Sales)
        {
            select firstonly custTable
                exists join salesTable
                    where salesTable.CustAccount    == custTable.AccountNum
                       && salesTable.SalesId        == this.OrderNum;

            if (custTable)
            {
                custName = custTable.name();
            }
        }
        return custName;
    }

]]></Source>
			</Method>
			<Method>
				<Name>packingWorkLocationSetup</Name>
				<Source><![CDATA[
    public WHSPackingWorkLocationSetup packingWorkLocationSetup()
    {
        WHSPackingWorkLocationSetup packingWorkLocationSetup;

        packingWorkLocationSetup =  WHSPackingWorkLocationSetup::avaFind(this.InventLocationId, this.WMSLocationId);

        return packingWorkLocationSetup;
    }

]]></Source>
