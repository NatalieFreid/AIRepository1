		<Methods>
			<Method>
				<Name>findOrCreate</Name>
				<Source><![CDATA[
    /// <summary>
    /// DebuC 16.06.23
    /// </summary>
    /// <param name = "itemScopeHistory">RefRecId</param>
    /// <param name = "inventSiteId">InventSiteId</param>
    /// <param name = "_forUpdate">boolean</param>
    /// <returns>NDX_ItemScopeHistoryInventSite</returns>
    static NDX_ItemScopeHistoryInventSite findOrCreate(RefRecId itemScopeHistory,
                                  InventSiteId inventSiteId,
                                  boolean _forUpdate = false)
    {
        NDX_ItemScopeHistoryInventSite     itemScopeHistoryInventSite;
        ;
        itemScopeHistoryInventSite.selectForUpdate(_forUpdate);

        select firstonly itemScopeHistoryInventSite
            where itemScopeHistoryInventSite.RefRecId       == itemScopeHistory
            && itemScopeHistoryInventSite.InventSiteId   == inventSiteId;

        if (! itemScopeHistoryInventSite)
        {
            itemScopeHistoryInventSite.RefRecId         = itemScopeHistory;
            itemScopeHistoryInventSite.InventSiteId     = inventSiteId;
            itemScopeHistoryInventSite.insert();
        }

        return itemScopeHistoryInventSite;
    }

]]></Source>
