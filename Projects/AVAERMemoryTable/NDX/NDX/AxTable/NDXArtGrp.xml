				<Source><![CDATA[
    /// <summary>
    /// DebuC 21.09.23
    /// </summary>
    /// <param name = "_Gruppe">NDXItemGroup</param>
    /// <param name = "_UGruppe">NDXItemGroup</param>
    /// <param name = "_UGruppe2">NDXItemGroup</param>
    /// <param name = "_update">boolean</param>
    /// <returns>NDXArtGrp</returns>
    public static NDXArtGrp find(
    NDXItemGroup   _Gruppe,
    NDXItemGroup   _UGruppe,
    NDXItemGroup   _UGruppe2,
    boolean             _update = false)
    {
        NDXArtGrp   nDX_ArtGrp;
        ;
        if (_Gruppe)
        {
            nDX_ArtGrp.selectForUpdate(_update);
            select firstonly nDX_ArtGrp
            where   nDX_ArtGrp.GRUPPE   == _Gruppe  &&
                    nDX_ArtGrp.UGRUPPE  == _UGruppe &&
                    nDX_ArtGrp.UGRUPPE2 == _UGruppe2;
        }
        return nDX_ArtGrp;
    }

]]></Source>
