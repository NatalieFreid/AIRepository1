    ///    A record in the <c>AVASalesLineBackOrderTmp</c> table; otherwise, an empty record.
    /// </returns>
    public static AVASalesLineBackOrderTmp findSalesLineRefRecId(   RefRecId    _recordId,
                                                                    boolean     _forUpdate = false)
    {
        AVASalesLineBackOrderTmp record;

        if (_recordId)
        {
            record.selectForUpdate(_forUpdate);

            select firstonly record
            index hint SalesLineRecIdIdx
            where   record.SalesLineRefRecId == _recordId;
        }

        return record;
    }

