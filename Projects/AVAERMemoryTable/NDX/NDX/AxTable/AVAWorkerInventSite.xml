		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// finds a table record for a provded HCMPersonnelNumberId
    /// </summary>
    /// <param name = "_personnelNumber">HCMPersonnelNumberId</param>
    /// <param name = "_forUpdate">forUpdate</param>
    /// <returns>AVAWorkerInventSite record</returns>
    public static AVAWorkerInventSite find( HcmPersonnelNumberId    _personnelNumber,
                                            boolean                 _forUpdate = false)
    {
        AVAWorkerInventSite workerInventSite;

        if(_personnelNumber)
        {
            if(_forUpdate)
            {
                workerInventSite.selectForUpdate(_forUpdate);
            }
            workerInventSite.selectLocked(_forUpdate);

            select firstonly workerInventSite
                where workerInventSite.PersonnelNumber == _personnelNumber;
        }

        return workerInventSite;
    }

]]></Source>
			</Method>
