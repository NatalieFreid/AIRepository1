				<Name>TOSId</Name>
				<Source><![CDATA[
    static AVATOSId TOSId(AccountNum _accountNum)
    {
        CustAccount masterAccount;
        container masterCon = connull();

        NDXVerband verband = NDXVerband::constructor(_accountNum);
        
        [masterAccount, masterCon] = verband.getMaster(_accountNum);

        return masterAccount;
    }

