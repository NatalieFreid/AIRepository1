		<Methods>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    public boolean validateWrite()
    {
        boolean ret;
    
        ret = super();

        if (ret)
        {
            if (strLen(this.CheckCode) < 4)
            {
                ret = checkFailed("@NDX:NXACheckCodeLengthError");
            }
        }
    
        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// AVA/WEN/2025/05/21      AVA_013218_ProdSetupRelease
    /// </summary>
    /// <param name = "_checkCode">AVACheckCode</param>
    /// <param name = "_forupdate">boolean</param>
    /// <returns>AVAProdSetupRelease</returns>
    public static AVAProdSetupRelease find(AVACheckCode _checkCode, boolean _forupdate = false)
    {
        AVAProdSetupRelease prodSetupRelease;

        if (_checkCode)
        {
            if (_forupdate)
            {
                prodSetupRelease.selectForUpdate(_forupdate);
            }
            select firstonly prodSetupRelease
                where prodSetupRelease.CheckCode == _checkCode;
        }
        return prodSetupRelease;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// AVA/WEN/2025/11/11      AVA_013218_ProdSetupRelease
    /// </summary>
    /// <param name = "_checkCode">AVACheckCode</param>
    /// <returns>boolean</returns>
    public static boolean exist(AVACheckCode _checkCode)
    {
        return _checkcode && (select AVAProdSetupRelease
                                where AVAProdSetupRelease.checkCode == _checkCode).recid != 0;
    }

]]></Source>
