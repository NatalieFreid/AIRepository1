				<Name>deleteRecords</Name>
				<Source><![CDATA[
    /// <summary>
    /// DebuC 05.10.23
    /// </summary>
    /// <param name = "_umsSignature">NDXUmsSignature</param>
    /// <param name = "_alliance">CustAccount</param>
    static void deleteRecords(NDXUmsSignature _umsSignature, CustAccount _alliance)
    {
        NDXTmpCSAlliance          table;
        ;

        table.skipDataMethods(true);
        table.skipAosValidation(true);
        table.skipDatabaseLog(true);
        table.skipEvents(true);
        table.skipDeleteActions(true);
        
        if (_alliance)
        {
            delete_from     table
                    where       table.UmsSignature == _umsSignature &&
                                table.Alliance     == _alliance;
        }
        else
        {
            delete_from     table
                    where       table.UmsSignature == _umsSignature;
        }
    }

]]></Source>
