				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// DebuC 05.10.23
    /// </summary>
    /// <param name = "umsSignature">NDXUmsSignature</param>
    /// <param name = "monthYearSignature">NDXMonthYearSignature</param>
    /// <param name = "excl">NoYes</param>
    /// <param name = "company">CompanyId</param>
    /// <param name = "alliance">CustAccount</param>
    /// <param name = "custAccount">CustAccount</param>
    /// <param name = "centralStoreId">NDXCentralStoreId</param>
    /// <param name = "l_forUpdate">boolean</param>
    /// <returns>NDXTmpCSAlliance</returns>
    client server static public NDXTmpCSAlliance find(NDXUmsSignature         umsSignature,
                                                   NDXMonthYearSignature   monthYearSignature,
                                                   NoYes                    excl,
                                                   CompanyId                company,
                                                   CustAccount              alliance,
                                                   CustAccount              custAccount,
                                                   NDXCentralStoreId       centralStoreId,
                                                   boolean                  l_forUpdate = false)
    {
        NDXTmpCSAlliance      record;
        ;
        if (l_forUpdate)
        {
            record.selectForUpdate(l_forUpdate);
        }

        select firstOnly record
        where        record.UmsSignature        == umsSignature    &&
                     record.MonthYearSignature  == monthYearSignature   &&
                     record.Exclude             == excl            &&
                     record.Company             == company         &&
                     record.Alliance            == alliance        &&
                     record.CustAccount         == custAccount     &&
                     record.CentralStoreId      == centralStoreId;

        return record;
    }

]]></Source>
