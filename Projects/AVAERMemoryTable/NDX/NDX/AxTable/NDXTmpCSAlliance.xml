			<Method>
				<Name>updateRecords</Name>
				<Source><![CDATA[
    /// <summary>
    /// DebuC 16.10.23
    /// </summary>
    /// <param name = "_copyTo">NDXUmsSignature</param>
    /// <param name = "_copyToOld">NDXUmsSignature</param>
    /// <param name = "_sic">boolean</param>
    /// <param name = "_copyFromSic">NDXUmsSignature</param>
    /// <param name = "_only4Alliance">CustAccount</param>
    static void updateRecords(NDXUmsSignature _copyTo,NDXUmsSignature _copyToOld,boolean _sic, NDXUmsSignature _copyFromSic, CustAccount _only4Alliance)
    {
        
        // bestehende Daten sichern
        NDXTmpCSAlliance      table;
        Common                      commonCopySic;
        int64                       anzBefore, anzAfter;
        DictTable                   dictTable;

        NDXUmsSignature         l_copyFrom2 = _copyTo;
        NDXUmsSignature         l_copyTo2   = _copyToOld;        
        boolean                 l_lSic      = _sic;

        //--> 1.2: NDX/PAFFH/NDX_TASK1235003370/09.10.2012
        //BP deviation documented
        table.skipDataMethods(true);
        table.skipAosValidation(true);
        table.skipDatabaseLog(true);
        table.skipEvents(true);
        table.skipDeleteActions(true);
        //<-- NDX/PAFFH/NDX_TASK1235003370/09.10.2012

        // Sicherung der CopyFrom-Daten
        if (l_lSic)
        {
            dictTable       = new DictTable(table.TableId);
            commonCopySic   = dictTable.makeRecord();
            ttsbegin;

            // alte Sicherung löschen
            if (_only4Alliance)
            {
                delete_from     table
                    where       table.UmsSignature == _copyFromSic &&
                                table.Alliance     == _only4Alliance;
            }
            else
            {
                delete_from     table
                    where       table.UmsSignature == _copyFromSic;
            }

            // aktuelle Daten sichern
            if (_only4Alliance)
            {
                while select table
                    where    table.UmsSignature    == l_copyFrom2      &&
                                table.Alliance        == _only4Alliance
                {
                    buf2Buf(table, commonCopySic);
                    commonCopySic.(dictTable.fieldname2id(identifierstr(UmsSignature))) = _copyFromSic;
                    commonCopySic.doInsert();
                }
            }
            else
            {
                while select table
                    where    table.UmsSignature == l_copyFrom2
                {
                    buf2Buf(table, commonCopySic);
                    commonCopySic.(dictTable.fieldname2id(identifierstr(UmsSignature))) = _copyFromSic;
                    commonCopySic.doInsert();
                }
            }
            ttscommit;
        }

        if (_only4Alliance)
        {
            anzBefore = (select     count(recid)
                            from    NDXTmpCSAlliance
                            where   NDXTmpCSAlliance.UmsSignature == l_copyTo2 &&
                                    NDXTmpCSAlliance.Alliance     == _only4Alliance).recid;

            update_recordset        table
                setting             UmsSignature = l_copyTo2
                where               table.UmsSignature == l_copyFrom2 &&
                                    table.Alliance     == _only4Alliance;

            anzAfter  = (select     count(recid)
                            from    NDXTmpCSAlliance
                            where   NDXTmpCSAlliance.UmsSignature == l_copyTo2 &&
                                    NDXTmpCSAlliance.Alliance     == _only4Alliance).recid;
        }
        else
        {
            anzBefore = (select     count(recid)
                            from    NDXTmpCSAlliance
                            where   NDXTmpCSAlliance.UmsSignature == l_copyTo2).recid;

            update_recordset        table
                setting             UmsSignature = l_copyTo2
                where               table.UmsSignature == l_copyFrom2;

            anzAfter  = (select     count(recid)
                            from    NDXTmpCSAlliance
                            where   NDXTmpCSAlliance.UmsSignature == l_copyTo2).recid;
        }
        if (_copyToOld)
        {
            info(strfmt("@NDX:NDXRecordsSavedIn", NDXHelperCommon::seconds2Str(DateTimeUtil::getTimeNow(DateTimeUtil::getUserPreferredTimeZone())), anzAfter - anzBefore, tableId2Name(table.TableId), l_copyTo2));       // [%1] [%2] Records in [%3] unter [%4] gesichert
        }
        else
        {
            info(strfmt("@NDX:NDXRecordsTransferedTo", NDXHelperCommon::seconds2Str(DateTimeUtil::getTimeNow(DateTimeUtil::getUserPreferredTimeZone())), anzAfter - anzBefore, tableId2Name(table.TableId), l_copyTo2));       // [%1] [%2] Records in [%3] unter [%4] übertragen
        }

        
    }

]]></Source>
