    /// <returns>NDXInventTablePPP</returns>
    static NDXInventTablePPP find(RefRecId _refRecIdInventTable, boolean _forupdate = false)
    {
        NDXInventTablePPP      ndxInventTablePPP;

        ndxInventTablePPP.selectForUpdate(_forupdate);

        if(_refRecIdInventTable)
        {
            select firstonly ndxInventTablePPP
                where ndxInventTablePPP.RefRecIdInventTable == _refRecIdInventTable;
        }

        return ndxInventTablePPP;
    }

