			<Method>
				<Name>createFromSalesTable</Name>
				<Source><![CDATA[
    /// <summary>
    /// designed from AVA
    /// </summary>
    /// <param name = "_salesTable">_salesTable</param>
    public static void createFromSalesTable(SalesTable    _salesTable)
    {
        AVASpecialDiscSalesOrder     specialDiscOrder, checkSalesOrder;

        select firstonly RecId from checkSalesOrder
            where   checkSalesOrder.SalesId == _salesTable.SalesId;

        if (!checkSalesOrder.RecId)
        {
            specialDiscOrder.SalesId = _salesTable.SalesId;
            specialDiscOrder.initFromSalesParameters();
            specialDiscOrder.insert();
        }
    }

]]></Source>
