			<Method>
				<Name>update</Name>
				<Source><![CDATA[
    /// <summary>
    ///   desigend from AVA
    /// </summary>
    public void update()
    {
        AVASpecialDiscSalesLine             specialDiscSalesLine;
        SalesLine                           salesLine;
        super();

        while select specialDiscSalesLine
            join RecId from  salesLine 
            where salesLine.InventTransId == specialDiscSalesLine.InventTransId
               && salesLine.SalesId       == this.SalesId
        {
            specialDiscSalesLine.initFromSpecDiscSalesTable(this);
            ttsbegin;
            specialDiscSalesLine.selectForUpdate(true);
            specialDiscSalesLine.update();
            ttscommit;
        }
            
    }

]]></Source>
