				<Source><![CDATA[
    /// <summary>
    /// PaffH 02.01.24
    /// </summary>
    /// <param name = "_id">NDXKBVProtID</param>
    /// <param name = "_ProtID2">NDXProtID2</param>
    /// <param name = "_ProtDetail">NDXKBVProtDetail</param>
    /// <param name = "_forUpdate">boolean</param>
    /// <returns>NDX_KBV2RicoProtLine</returns>
    public static NDX_KBV2RicoProtLine find(
        NDXKBVProtIDInt _id,
        NDXProtID2 _ProtID2,
        NDXKBVProtDetail _ProtDetail,
        boolean _forUpdate = false)
    {
        NDX_KBV2RicoProtLine record;

        record.selectForUpdate(_forUpdate);

        if(_id)
        {
            select firstonly record
            index hint KBVProtIdIdx
            where record.KBVProtIDInt == _id &&
                record.ProtID2 == _ProtID2 &&
                record.KBVProtDetail == _ProtDetail;
        }

        return record;
    }

]]></Source>
