				<Name>validateDelete</Name>
				<Source><![CDATA[
    /// <summary>
    /// Checks if HK Group can be deleted.
    /// </summary>
    /// <returns> true or false</returns>
    public boolean validateDelete()
    {
        InventTable lInventTable;
        boolean ret;
    
        ret = super();

        if(this.HKGrouping != '')
        {
            select firstonly lInventTable
                where lInventTable.NDX_HKGrouping == this.HKGrouping;

            if(lInventTable)
            {
                return checkFailed(strFmt("@NDX:NDXHKInUse", lInventTable.ItemId));
            }
        }
    
        return ret;
    }

]]></Source>
