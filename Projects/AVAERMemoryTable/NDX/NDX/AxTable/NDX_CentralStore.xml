			<Method>
				<Name>findConCompany</Name>
				<Source><![CDATA[
    /// <summary>
    /// DebuC 23.02.24
    /// </summary>
    /// <param name = "_NDX_CentralStoreId">NDXCentralStoreId</param>
    /// <param name = "conCompanies">Container</param>
    /// <returns>NDX_CentralStore</returns>
    client server static public NDX_CentralStore findConCompany(NDXCentralStoreId _NDX_CentralStoreId,
                                                            Container          conCompanies = [curExt()])
    {
        NDX_CentralStore      centralStore;
        ;
        select firstOnly crosscompany:conCompanies
                centralStore
        where   centralStore.CentralStoreId     == _NDX_CentralStoreId;

        return centralStore;
    }

]]></Source>
			</Method>
			<Method>
				<Name>dispCustName</Name>
				<Source><![CDATA[
    /// <summary>
    /// Displays customer name alias
    /// </summary>
