			<Method>
				<Name>dispShowMasterAlliance</Name>
				<Source><![CDATA[
    /// <summary>
    /// Displays master alliance
    /// </summary>
    /// <returns>master allience</returns>
    [SysClientCacheDataMethod(true)]
    display CustAccount dispShowMasterAlliance()
    {
        CustAccount master;

        [master]  = NDXVerband::constructor().getMaster(this.CentralStoreId);
        
        return master;
    }

]]></Source>
