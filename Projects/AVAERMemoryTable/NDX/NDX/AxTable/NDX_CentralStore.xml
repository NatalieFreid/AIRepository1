]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// finds NDX_CentralStore record
    /// </summary>
    /// <param name = "_NDX_CentralStoreId">Central store id</param>
    /// <param name = "_forUpdate">for update</param>
    /// <returns>NDX_CentralStore record</returns>
    client server static public NDX_CentralStore find(NDXCentralStoreId _NDX_CentralStoreId, boolean _forUpdate = false)
    {
        NDX_CentralStore      nDX_CentralStore;
       
        if (_forUpdate)
        {
            nDX_CentralStore.selectForUpdate(_forUpdate);
        }

        select firstOnly nDX_CentralStore
            where nDX_CentralStore.CentralStoreId == _NDX_CentralStoreId;

        return nDX_CentralStore;
    }

]]></Source>
