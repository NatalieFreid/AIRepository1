    public static NDXBVEMailRequestState findOrCreate(NDXBVEMailRequestHeader _nDXBVEMailRequestHeader, boolean _insert = false)
    {
        NDXBVEMailRequestState nDXBVEMailRequestState = NDXBVEMailRequestState::find(_nDXBVEMailRequestHeader, true);
        if (!nDXBVEMailRequestState)
        {
            nDXBVEMailRequestState.initValue();
            nDXBVEMailRequestState.OrganisationDataAreaId = _nDXBVEMailRequestHeader.ContactPersonDataAreaId;
            if (_nDXBVEMailRequestHeader.OrganisationCustomerAccount)
            {
                nDXBVEMailRequestState.RoleForBuildingProject = NDXRoleForBuildingProject::Customer;
            }
            else if (_nDXBVEMailRequestHeader.OrganisationProspectProspectId)
            {
                nDXBVEMailRequestState.RoleForBuildingProject = NDXRoleForBuildingProject::BusRel;
            }
            else
            {
                nDXBVEMailRequestState.RoleForBuildingProject = NDXRoleForBuildingProject::WithoutAssignment;
            }
            if (_insert)
            {
                nDXBVEMailRequestState.insert();
                NDXBVEMailRequestStateChangeLog::insertLog(nDXBVEMailRequestState);
            }
        }
        return nDXBVEMailRequestState;
    }

