		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// DebuC 16.10.23
    /// last modified: PaffH 05.02.25
    /// </summary>
    /// <param name = "_nDXTmpVerband">NDXTmpVerband</param>
    /// <param name = "_umsSignature">NDXUmsSignature</param>
    /// <param name = "_Company">CompanyId</param>
    /// <param name = "_CentralStoreId">NDXCentralStoreId</param>
    /// <param name = "_forUpdate">boolean</param>
    /// <returns>NDXTmpVerband</returns>
    static NDXTmpVerband find(
        NDXTmpVerband _nDXTmpVerband,
        NDXUmsSignature _umsSignature,
        CompanyId _Company,
        NDXCentralStoreId _CentralStoreId,
        boolean _forUpdate = false)
    {
        //TODO PaffH: checkpoint NDXTmpVerband
        _nDXTmpVerband.selectForUpdate(_forUpdate);

        if (_CentralStoreId)
        {
            select      _nDXTmpVerband
                where   _nDXTmpVerband.UmsSignature    == _umsSignature    &&
                        _nDXTmpVerband.Company         == _Company         &&
                        _nDXTmpVerband.CentralStoreId  == _CentralStoreId;
        }
        return _nDXTmpVerband;
    }

]]></Source>
			</Method>
			<Method>
				<Name>dispCustName</Name>
				<Source><![CDATA[
    display CustName dispCustName()
    {
        return CustTable::find(this.CentralStoreId).nameAlias();
    }

]]></Source>
