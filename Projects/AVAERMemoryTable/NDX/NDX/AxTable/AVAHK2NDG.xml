		<Methods>
			<Method>
				<Name>findItemId</Name>
				<Source><![CDATA[
    /// <summary>
    /// Finds the first record for a provided ItemId
    /// </summary>
    /// <param name = "_itemId">ItemId</param>
    /// <param name = "_forUpdate">boolean</param>
    /// <returns>AVAHK2NDG</returns>
    public static AVAHK2NDG findItemId(ItemId _itemId, boolean _forUpdate = false)
    {
        AVAHK2NDG avaHk2Ndg;

        if(_forUpdate)
        {
            avaHk2Ndg.selectForUpdate(_forUpdate);
        }

        select firstonly avaHk2Ndg
            where avaHk2Ndg.ItemId == _itemId;

        return avaHk2Ndg;
    }

]]></Source>
			</Method>
			<Method>
				<Name>getHK2p1000</Name>
				<Source><![CDATA[
    /// <summary>
    /// Returns the HK2p1000 value for a specified ItemId
    /// </summary>
    /// <param name = "_itemId">ItemId</param>
    /// <returns>AVAHK2p1000</returns>
    public static AVAHK2p1000 getHK2p1000(ItemId _itemId)
    {
        return AVAHK2NDG::findItemId(_itemId).HK2p1000;
    }

]]></Source>
