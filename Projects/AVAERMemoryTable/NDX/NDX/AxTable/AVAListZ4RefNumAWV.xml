			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Search for record in database.
    /// </summary>
    /// <param name="_refNum">
    /// Ref ID to search for.
    /// </param>
    /// <param name="_update">
    /// True, if record shall be selected for updates; False, if not.
    /// </param>
    /// <returns>
    /// Found or empty record.
    /// </returns>
    public static AVAListZ4RefNumAWV find(AVAListZ4RefNumId _refNum, boolean _update = false)
    {
        AVAListZ4RefNumAWV refNumAWV;

        if (_refNum)
        {
            refNumAWV.selectForUpdate(_update);

            select firstonly refNumAWV
            where refNumAWV.RefNum == _refNum;
        }

        return refNumAWV;
    }

]]></Source>
