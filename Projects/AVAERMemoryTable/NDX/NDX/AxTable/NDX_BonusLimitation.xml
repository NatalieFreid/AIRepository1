				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    ///    Finds the specified record in the <c>NDX_BonusLimitation</c> table.
    /// </summary>
    /// <param name="_id">
    ///    The record ID of the <c>NDX_BonusLimitation</c> record to find.
    /// </param>
    /// <param name="_forUpdate">
    ///    A Boolean value that indicates whether to read the record for update; optional.
    /// </param>
    /// <returns>
    ///    A record in the <c>NDX_BonusLimitation</c> table; otherwise, an empty record.
    /// </returns>
    public static NDX_BonusLimitation find( AVABonusLimitationId    _id,
                                            boolean                 _forUpdate = false)
    {
        NDX_BonusLimitation record;

        record.selectForUpdate(_forUpdate);

        if(_id)
        {
            select firstonly record
            index hint LimitationIdIdx
            where record.LimitationId == _id;
        }

        return record;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    ///    Finds the specified record in the <c>NDX_BonusLimitation</c> table.
    /// </summary>
    /// <param name="_id">
    ///    The record ID of the <c>NDX_BonusLimitation</c> record to find.
    /// </param>
    /// <returns>
    ///    true if record in the <c>NDX_BonusLimitation</c> table exists
    /// </returns>
    public static boolean exist(AVABonusLimitationId _id)
    {
        return      _id
                &&  (   select firstonly NDX_BonusLimitation
                        index hint LimitationIdIdx
                        where NDX_BonusLimitation.LimitationId == _id).Recid != 0;
    }

]]></Source>
