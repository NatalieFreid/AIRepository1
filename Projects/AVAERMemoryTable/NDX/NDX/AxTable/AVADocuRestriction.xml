    /// <summary>
    /// N.Freidenberger 09.08.24
    /// </summary>
    /// <param name = "_num">_num</param>
    /// <param name = "_update">_update</param>
    /// <returns>AVADocuRestriction</returns>
    public static AVADocuRestriction find(AVADocuRestrictionNum  _num, boolean  _update = false)
    {
        AVADocuRestriction          docuRestriction;
        docuRestriction.selectForUpdate(_update);

        select firstonly docuRestriction
            where docuRestriction.Num == _num;

        return docuRestriction;
    }

