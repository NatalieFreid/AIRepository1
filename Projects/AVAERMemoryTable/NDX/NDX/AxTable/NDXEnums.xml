			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// DebuC 21.08.23
    /// </summary>
    /// <param name = "name">NDXEnumName</param>
    /// <param name = "nameElement">NDXEnumNameElement</param>
    /// <param name = "value">NDXEnumValue</param>
    /// <param name = "lUpdate">boolean</param>
    /// <returns>NDXEnums</returns>
    static NDXEnums find(NDXEnumName        name,
                      NDXEnumNameElement    nameElement,
                      NDXEnumValue          value,
                      boolean               lUpdate = false)
    {
        NDXEnums       cursor;
        ;
        cursor.selectForUpdate(lUpdate);
        select firstOnly cursor
        where   cursor.EnumName         == name
            &&  cursor.EnumNameElement  == nameElement
            &&  cursor.EnumValue        == value;
        return cursor;
    }

]]></Source>
