				<Name>avaDisplayDestinationExists</Name>
				<Source><![CDATA[
    public display AVADestinationExists avaDisplayDestinationExists()
    {
        LedgerAllocationRuleDestination     ruleDest;

        select firstonly RecId from ruleDest where ruleDest.RuleID == this.RuleId
            && ruleDest.ToDefaultDimension == this.DimensionAttributeValueSet;
        return ruleDest.RecId > 0;
    }

]]></Source>
