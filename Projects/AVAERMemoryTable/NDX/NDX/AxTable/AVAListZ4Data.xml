			<Method>
				<Name>findRecId</Name>
				<Source><![CDATA[
    /// <summary>
    /// Search for record in database.
    /// </summary>
    /// <param name="_recId">
    /// Record ID to search for.
    /// </param>
    /// <param name="_update">
    /// True, if record shall be selected for updates; False, if not.
    /// </param>
    /// <returns>
    /// Found or empty record.
    /// </returns>
    public static AVAListZ4Data findRecId(RecId _recId, boolean _update = false)
    {
        AVAListZ4Data listZ4Data;

        if (_recId)
        {
            listZ4Data.selectForUpdate(_update);

            select firstonly listZ4Data
            index hint RecId
            where listZ4Data.RecId == _recId;
        }

        return listZ4Data;
    }

