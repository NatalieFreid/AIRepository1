			<Method>
				<Name>findActiveLine</Name>
				<Source><![CDATA[
    /// <summary>
    /// designed from AVA
    /// </summary>
    /// <param name = "_dispatchId">_dispatchId</param>
    /// <param name = "_status">_status</param>
    /// <param name = "_countryRegionId">_countryRegionId</param>
    /// <param name = "_update">_update</param>
    /// <returns>AVAListZ4Data</returns>
    public static AVAListZ4Data findActiveLine(
    AVAListZ4DispatchId            _dispatchId,
    AVAListZ4Status                _status,
    LogisticsAddressCountryRegionId _countryRegionId,
    boolean                         _update = false
    )
    {
        AVAListZ4Data listZ4Data;

        listZ4Data.selectForUpdate(_update);

        select firstOnly listZ4Data
        where   listZ4Data.DispatchId      == _dispatchId
        &&      listZ4Data.Status          == _status
        &&      listZ4Data.CountryRegionId == _countryRegionId
        &&      listZ4Data.PosType         == AVAListZ4PosType::Position;

        return listZ4Data;
    }

]]></Source>
