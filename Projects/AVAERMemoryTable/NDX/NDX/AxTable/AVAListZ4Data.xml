			<Method>
				<Name>updFields</Name>
				<Source><![CDATA[
    private void updFields()
    {
        if (this.Status == AVAListZ4Status::Reported)
        {
            return;
        }

        if (this.RefNumId)
        {
            this.initFromAVAListZ4RefNumAWV(AVAListZ4RefNumAWV::find(this.RefNumId));
        }

        if (!this.CountryRegionName && this.CountryRegionId)
        {
            this.CountryRegionName = LogisticsAddressCountryRegion::name(this.CountryRegionId);
        }

        if (!this.CountryRegionISOCode && this.CountryRegionId)
        {
            this.CountryRegionISOCode = LogisticsAddressCountryRegion::find(this.CountryRegionId).ISOcode;
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>initFromAVAListZ4RefNumAWV</Name>
				<Source><![CDATA[
    public void initFromAVAListZ4RefNumAWV(AVAListZ4RefNumAWV _avaListZ4RefNumAWV)
    {
        if (!this.Description)
        {
            this.Description = _avaListZ4RefNumAWV.Description;
        }

        if (!this.DocType)
        {
            this.DocType = _avaListZ4RefNumAWV.DocumentType;
        }

        if (!this.Movement)
        {
            this.Movement = _avaListZ4RefNumAWV.Movement;
        }
    }

]]></Source>
