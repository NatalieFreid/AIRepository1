			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// Check if record exists in database.
    /// </summary>
    /// <param name="_recId">
    /// Record ID to search for.
    /// </param>
    /// <returns>
    /// True, if record exists in database; False, if not.
    /// </returns>
    public static server boolean exist(RecId _recId)
    {
        return _recId &&
        (select firstonly RecId from AVAListZ4Data
            index hint RecId
            where AVAListZ4Data.RecId == _recId).RecId != 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>existsActiveLine</Name>
				<Source><![CDATA[
    /// <summary>
    /// designed from AVA
    /// </summary>
    /// <param name = "_dispatchId">_dispatchId</param>
    /// <param name = "_status">_status</param>
    /// <param name = "_countryRegionId">_countryRegionId</param>
    /// <param name = "_posType">_posType</param>
    /// <returns>boolean</returns>
    public static boolean existsActiveLine(
    AVAListZ4DispatchId            _dispatchId,
    AVAListZ4Status                _status,
    LogisticsAddressCountryRegionId _countryRegionId,
    AVAListZ4PosType               _posType = AVAListZ4PosType::Position
    )
    {
        AVAListZ4Data listZ4Data;
        ;
        select firstOnly count(RecId) from listZ4Data
        where   listZ4Data.DispatchId      == _dispatchId
        &&      listZ4Data.Status          == _status
        &&      listZ4Data.CountryRegionId == _countryRegionId
        &&      listZ4Data.PosType         == _posType;

        return listZ4Data.RecId != 0;
    }

]]></Source>
