			<Method>
				<Name>findOrCreate</Name>
				<Source><![CDATA[
    /// <summary>
    /// PaffH 25.10.22
    /// AX2009: tables.NDX_PAInfoTable.findOrCreate()
    /// </summary>
    /// <param name = "_prodTable">RefRecId</param>
    /// <param name = "_append">boolean</param>
    /// <returns>NDXPAInfoTable</returns>
    static NDXPAInfoTable findOrCreate(RefRecId _prodTable, boolean _append = false)
    {
        NDXPAInfoTable nDXPAInfoTable = nDXPAInfoTable::find(_prodTable, true);
        if (!nDXPAInfoTable)
        {
            nDXPAInfoTable.ProdTable = _prodTable;
            if (_append)
            {
                nDXPAInfoTable.insert();
            }
        }
        return nDXPAInfoTable;
    }

]]></Source>
