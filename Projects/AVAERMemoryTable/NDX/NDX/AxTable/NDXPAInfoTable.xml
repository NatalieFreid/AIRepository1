				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// PaffH 25.10.22
    /// AX2009: tables.NDX_PAInfoTable.find()
    /// </summary>
    /// <param name = "_prodTable">RefRecId</param>
    /// <param name = "_forUpdate">boolean</param>
    /// <returns>NDXPAInfoTable</returns>
    static NDXPAInfoTable find(RefRecId _prodTable, boolean _forUpdate = false)
    {
        NDXPAInfoTable nDXPAInfoTable;

        nDXPAInfoTable.selectForUpdate(_forUpdate);

        select firstonly nDXPAInfoTable
            where nDXPAInfoTable.ProdTable == _prodTable;

        return nDXPAInfoTable;
    }

]]></Source>
