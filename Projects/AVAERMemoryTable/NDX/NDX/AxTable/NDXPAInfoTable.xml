				<Name>getPAInfo</Name>
				<Source><![CDATA[
    /// <summary>
    /// PaffH 25.10.22
    /// AX2009: tables.NDX_PAInfoTable.getPAInfo()
    /// </summary>
    /// <returns>NDXPAInfo</returns>
    NDXPAInfo getPAInfo()
    {
        return this.PrintPAInfo == NoYes::Yes && this.PAInfo ? this.PAInfo : '';
    }

