        void initialize(NDXJahr _salesYear, NDXMonat _salesMonth, NDXSalesVolumeQuery _salesVolumeQueryType)
    {
        this.clear();
        this.SalesVolumeQueryType = _salesVolumeQueryType;
        this.SalesYear      = _salesYear;
        this.SalesMonth     = _salesMonth;
        this.MonthTaxValue2 = NDXSNParameters::getMonthTaxDate2(_salesYear);
    }

]]></Source>
