			<Method>
				<Name>initFromNDX_TmpKumUmsCust</Name>
				<Source><![CDATA[
    void initFromNDX_TmpKumUmsCust(NDXTmpKumUmsCust _nDX_TmpKumUmsCust)
    {
        int         salesMonth;
        NDXUmsatz  amount;
        
        this.Company = _nDX_TmpKumUmsCust.Company;

        for (salesMonth = 1; salesMonth <= this.SalesMonth; salesMonth++)
        {
            switch (salesMonth)
            {
                case NDXMonthBE::January: 
                    amount = _nDX_TmpKumUmsCust.U01 + _nDX_TmpKumUmsCust.B01;
                    break;
                case NDXMonthBE::February: 
                    amount = _nDX_TmpKumUmsCust.U02 + _nDX_TmpKumUmsCust.B02;
                    break;
                case NDXMonthBE::March:
                    amount = _nDX_TmpKumUmsCust.U03 + _nDX_TmpKumUmsCust.B03;
                    break;
                case NDXMonthBE::April:
                    amount = _nDX_TmpKumUmsCust.U04 + _nDX_TmpKumUmsCust.B04;
                    break;
                case NDXMonthBE::May:
                    amount = _nDX_TmpKumUmsCust.U05 + _nDX_TmpKumUmsCust.B05;
                    break;
                case NDXMonthBE::June:
                    amount = _nDX_TmpKumUmsCust.U06 + _nDX_TmpKumUmsCust.B06;
                    break;
                case NDXMonthBE::July:
                    amount = _nDX_TmpKumUmsCust.U07 + _nDX_TmpKumUmsCust.B07;
                    break;
                case NDXMonthBE::August:
                    amount = _nDX_TmpKumUmsCust.U08 + _nDX_TmpKumUmsCust.B08;
                    break;
                case NDXMonthBE::September:
                    amount = _nDX_TmpKumUmsCust.U09 + _nDX_TmpKumUmsCust.B09;
                    break;
                case NDXMonthBE::October:
                    amount = _nDX_TmpKumUmsCust.U10 + _nDX_TmpKumUmsCust.B10;
                    break;
                case NDXMonthBE::November:
                    amount = _nDX_TmpKumUmsCust.U11 + _nDX_TmpKumUmsCust.B11;
                    break;
                case NDXMonthBE::December:
                    amount = _nDX_TmpKumUmsCust.U12 + _nDX_TmpKumUmsCust.B12;
                    break;
            }
            if (salesMonth == this.SalesMonth)
            {
                this.SalesAmount    = amount;
            }
            this.SalesAmountCum += amount;
            if (this.MonthTaxValue2 && salesMonth >= this.MonthTaxValue2)
            {
                this.SalesAmountCumTaxValue2 += amount;
            }
            else
            {
                this.SalesAmountCumTaxValue1 += amount;
            }
        }
    }

]]></Source>
