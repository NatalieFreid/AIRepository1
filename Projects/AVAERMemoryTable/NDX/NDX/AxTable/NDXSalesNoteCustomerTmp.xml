			<Method>
				<Name>initFromNDX_SNAllianceClients</Name>
				<Source><![CDATA[
    void initFromNDX_SNAllianceClients(NDXSNAllianceClients _nDX_SNAllianceClients)
    {
        NDXSNClientGroup           nDX_SNClientGroup;
        Query   q;
        QueryRun    qr;
        QueryBuildDataSource    qbds, qbds2;
        Counter anz = 0;

        this.Active = _nDX_SNAllianceClients.Active;

        q = new Query();
        qbds = q.addDataSource(tablenum(NDXSNClientGroup2Client));
        qbds.addRange(fieldnum(NDXSNClientGroup2Client, RefRecId_Client)).value(QueryValue(_nDX_SNAllianceClients.RecId));

        qbds2 = qbds.addDataSource(tablenum(NDXSNClientGroup));
        qbds2.relations(true);
        qbds2.fetchMode(QueryFetchMode::One2One);
        qbds2.addRange(fieldnum(NDXSNClientGroup, TOSId)).value(QueryValue(_nDX_SNAllianceClients.TOSId));
        qbds2.addRange(fieldnum(NDXSNClientGroup, Companys)).value(QueryValue(_nDX_SNAllianceClients.Companys));
        qr = new QueryRun(q);

        while (qr.next())
        {
            nDX_SNClientGroup = qr.get(tablenum(NDXSNClientGroup));
            this.MemberOfClientGroup = nDX_SNClientGroup.ClientGroupName;
            this.ClientGroupName2 = nDX_SNClientGroup.ClientGroupName2;
            ++anz;
        }
        this.CounterGroupMemberships    = anz;
        this.ChildMap = _nDX_SNAllianceClients.ChildMap;
        this.ChildMapReport = this.ChildMap ? this.ChildMap : this.ClientGroupName2;
        this.ClientGroupNameReport = this.MemberOfClientGroup ? this.MemberOfClientGroup : this.CustName;
    }

]]></Source>
