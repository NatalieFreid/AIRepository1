		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
/// <summary>
/// designed by AVANADE
/// </summary>
    /// <param name = "_importID">KCS_GAEBImportID</param>
    /// <param name = "update">boolean</param>
    /// <returns>KCS_GAEBImportID</returns>
    static KCS_GAEBImport find(KCS_GAEBImportID _importID, boolean update = false)
    {
        KCS_GAEBImport bImport;

        if (_importID)
        {
            bImport.selectForUpdate(update);

            select firstonly bImport
            where bImport.KCS_GAEBImportID == _importID;
        }
        return bImport;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// designed by AVANADE
    /// </summary>
    /// <param name = "_importID">KCS_GAEBImportID</param>
    /// <returns>boolean</returns>
    static boolean exist(KCS_GAEBImportID _importID)
    {
        return _importID &&
           (select firstonly RecId from KCS_GAEBImport
                where KCS_GAEBImport.KCS_GAEBImportID == _importID).RecId != 0;
    }

]]></Source>
			</Method>
