        this.DlvModeId              = _wmsArrivalOverview.DlvModeId;
        this.InventLocationId       = _wmsArrivalOverview.InventLocationId;
        this.InventQty              = _wmsArrivalOverview.InventQty;
        this.InventSiteId           = _wmsArrivalOverview.InventSiteId;
        this.InventTransRefId       = _wmsArrivalOverview.InventTransRefId;
        this.InventTransType        = _wmsArrivalOverview.InventTransType;
        this.Name                   = _wmsArrivalOverview.Name;
        this.NoOfLines              = _wmsArrivalOverview.NoOfLines;
        this.PdsCWQty               = _wmsArrivalOverview.PdsCWQty;
        this.QuarantineControlled   = _wmsArrivalOverview.QuarantineControlled;
        this.ReceiptStatus          = _wmsArrivalOverview.ReceiptStatus;
        this.ReturnItemNum          = _wmsArrivalOverview.ReturnItemNum;
        this.Selected               = _wmsArrivalOverview.Selected;
        this.VendRef                = _wmsArrivalOverview.VendRef;
