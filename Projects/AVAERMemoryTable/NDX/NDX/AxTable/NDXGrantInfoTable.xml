    /// <param name = "updatedUtcDateTime">NDXUpdatedUTCDateTime</param>
    /// <returns>int</returns>
    static public int deleteNotUpdated(NDXUpdatedUTCDateTime updatedUtcDateTime)
    {
        NDXGrantInfoTable nDXGrantInfoTable;
        delete_from nDXGrantInfoTable
            where nDXGrantInfoTable.UpdatedUTCDateTime != updatedUtcDateTime;
        return int642int(nDXGrantInfoTable.RowCount());
    }

