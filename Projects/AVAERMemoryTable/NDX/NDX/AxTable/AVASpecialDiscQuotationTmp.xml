				<Source><![CDATA[
    /// <summary>
    /// designed from AVA
    /// </summary>
    /// <param name = "_quotationId">_quotationId</param>
    /// <param name = "_update">_update</param>
    /// <returns>AVASpecialDiscQuotation</returns>
    public static  AVASpecialDiscQuotation find(QuotationId       _quotationId, boolean       _update = false)
    {
        AVASpecialDiscQuotation         specialDiscQuotation;
        ;

        specialDiscQuotation.selectForUpdate(_update);
        select firstonly specialDiscQuotation
            where specialDiscQuotation.QuotationId == _quotationId;

        return specialDiscQuotation;
    }

