		<Methods>
			<Method>
				<Name>initFromCustTrans</Name>
				<Source><![CDATA[
    /// <summary>
    /// initFromCustTrans
    /// </summary>
    /// <param name = "_custTrans">CustTrans</param>
    public void initFromCustTrans(CustTrans    _custTrans)
    {
        CustTable               custTable   = CustTable::find(_custTrans.AccountNum);
        ;
        this.CountryRegionId        = custTable.countryRegionId();
        this.CountryRegionISOCode   = LogisticsAddressCountryRegion::find(this.CountryRegionId).ISOcode;
        this.CustVendNum            = _custTrans.AccountNum;
        this.CustVendName           = custTable.name();
        this.CustVendType           = LedgerJournalACType::Cust;
        this.InvoiceId              = _custTrans.Invoice;
        this.Voucher                = _custTrans.Voucher;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initFromVendTrans</Name>
				<Source><![CDATA[
    /// <summary>
    /// initFromVendTrans
    /// </summary>
    /// <param name = "_vendTrans">VendTrans</param>
    void initFromVendTrans(VendTrans    _vendTrans)
    {
        VendTable               vendTable   = vendTable::find(_vendTrans.AccountNum);
        ;
        this.CountryRegionId        = vendTable.countryRegionId();
        this.CountryRegionISOCode   = LogisticsAddressCountryRegion::find(this.CountryRegionId).ISOcode;
        this.CustVendNum            = vendTable.AccountNum;
        this.CustVendName           = vendTable.name();
        this.CustVendType           = LedgerJournalACType::Vend;
        this.InvoiceId              = _vendTrans.Invoice;
        this.Voucher                = _vendTrans.Voucher;
    }

]]></Source>
			</Method>
