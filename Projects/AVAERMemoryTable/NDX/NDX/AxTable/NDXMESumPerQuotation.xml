			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Finds a record by 
    /// </summary>
    /// <param name = "_refRecId_NDX_ME_DataFromExcelTable">NDX_ME_DataFromExcelTable rec id</param>
    /// <param name = "_quotationId">_quotation Id</param>
    /// <param name = "_update">for update</param>
    /// <returns>NDXMESumPerQuotation record</returns>
    static NDXMESumPerQuotation find(RefRecId _refRecId_NDX_ME_DataFromExcelTable, QuotationId _quotationId, boolean _update = false)
    {
        NDXMESumPerQuotation nDX_ME_SumPerQuotation;
        SalesQuotationTable lSalesQuotationTable;
        
        nDX_ME_SumPerQuotation.selectForUpdate(_update);

        if(_quotationId)
        {
            lSalesQuotationTable = SalesQuotationTable::find(_quotationId);
        }

        select firstonly nDX_ME_SumPerQuotation
            where nDX_ME_SumPerQuotation.RefRecId_NDX_ME_DataFromExcelTable == _refRecId_NDX_ME_DataFromExcelTable
                && nDX_ME_SumPerQuotation.SalesQuotationTableRefRecId == lSalesQuotationTable.RecId;

        return nDX_ME_SumPerQuotation;
    }

]]></Source>
			</Method>
			<Method>
				<Name>refreshFromExcelTable</Name>
				<Source><![CDATA[
    /// <summary>
    /// Refresh nDX_ME_SumPerQuotation records
    /// </summary>
    /// <param name = "_refRecIdExcelTable">NDXMEDataFromExcelTable record id</param>
    static void refreshFromExcelTable(RefRecId _refRecIdExcelTable)
    {
        NDXMEDataFromExcelLine  nDX_ME_DataFromExcelLineGrp;
        NDXMESumPerQuotation    nDX_ME_SumPerQuotation;
        SalesQuotationTable     salesQuotationTable;
        KCS_QuotationStatus     kCS_QuotationStatus;

        Query                   q = new Query();
        QueryBuildDataSource    qbds, qbds2, qbds3;
        QueryRun                qr;
        NDX_UpdatedUTC          updatedUTC = DateTimeUtil::utcNow();

        qbds = q.addDataSource(tablenum(NDXMEDataFromExcelLine));
        qbds.addRange(fieldnum(NDXMEDataFromExcelLine, RefRecIdNDXMEDataFromExcelTable)).value(QueryValue(_refRecIdExcelTable));
        
        qbds.addGroupByField(fieldnum(NDXMEDataFromExcelLine, QuotationId));
        qbds.addSelectionField(fieldnum(NDXMEDataFromExcelLine, RecId), SelectionField::Count);
        qbds.addSelectionField(fieldnum(NDXMEDataFromExcelLine, LineAmountBrutto), SelectionField::Sum);
        qbds.addSelectionField(fieldnum(NDXMEDataFromExcelLine, LineAmountNetto), SelectionField::Sum);
        qbds.addSelectionField(fieldnum(NDXMEDataFromExcelLine, PreisAngebotGesamt), SelectionField::Sum);
        qbds.addSelectionField(fieldnum(NDXMEDataFromExcelLine, LineAmountDiff), SelectionField::Sum);

        qbds2 = qbds.addDataSource(tablenum(SalesQuotationTable));
        qbds2.relations(true);
        qbds2.joinMode(JoinMode::OuterJoin);
        qbds2.fetchMode(QueryFetchMode::One2One);
        qbds2.addSelectionField(fieldnum(SalesQuotationTable, KCS_StatusId));
        qbds2.addSelectionField(fieldnum(SalesQuotationTable, KCS_KBVSubject));
        qbds2.addGroupByField(fieldnum(SalesQuotationTable, KCS_StatusId));
        qbds2.addGroupByField(fieldnum(SalesQuotationTable, KCS_KBVSubject));

        qbds3 = qbds2.addDataSource(tablenum(KCS_QuotationStatus));
        qbds3.relations(true);
        qbds3.joinMode(JoinMode::OuterJoin);
        qbds3.fetchMode(QueryFetchMode::One2One);
        qbds3.addGroupByField(fieldnum(KCS_QuotationStatus, KCS_StatusDescription));
        qbds3.addSelectionField(fieldnum(KCS_QuotationStatus, KCS_StatusDescription));

        // reset  counter AnzAngPos
        ttsbegin;
        update_recordset nDX_ME_SumPerQuotation
            setting AnzAngPos = 0
            where   nDX_ME_SumPerQuotation.RefRecId_NDX_ME_DataFromExcelTable == _refRecIdExcelTable;
        ttscommit;

        qr = new QueryRun(q);
        while (qr.next())
        {
            nDX_ME_DataFromExcelLineGrp = qr.get(tablenum(NDXMEDataFromExcelLine));
            salesQuotationTable         = qr.get(tablenum(SalesQuotationTable));
            kCS_QuotationStatus         = qr.get(tablenum(KCS_QuotationStatus));

            nDX_ME_SumPerQuotation = NDXMESumPerQuotation::find(_refRecIdExcelTable, nDX_ME_DataFromExcelLineGrp.QuotationId, true);
                       
            if (!nDX_ME_SumPerQuotation)
            {
                nDX_ME_SumPerQuotation.RefRecId_NDX_ME_DataFromExcelTable = _refRecIdExcelTable;
                nDX_ME_SumPerQuotation.SalesQuotationTableRefRecId = SalesQuotationTable::find(nDX_ME_DataFromExcelLineGrp.QuotationId).RecId;
            }
            
            nDX_ME_SumPerQuotation.AnzAngPos                += int642int(nDX_ME_DataFromExcelLineGrp.RecId);
            nDX_ME_SumPerQuotation.LineAmountBrutto         = nDX_ME_DataFromExcelLineGrp.LineAmountBrutto;
            nDX_ME_SumPerQuotation.LineAmountNetto          = nDX_ME_DataFromExcelLineGrp.LineAmountNetto;
            nDX_ME_SumPerQuotation.Preis_Angebot_Gesamt     = nDX_ME_DataFromExcelLineGrp.PreisAngebotGesamt;
            nDX_ME_SumPerQuotation.LineAmountDiff           = nDX_ME_DataFromExcelLineGrp.LineAmountDiff;
            nDX_ME_SumPerQuotation.StatusIdRefRecId         = KCS_QuotationStatus::find(salesQuotationTable.KCS_StatusId).RecId;
            nDX_ME_SumPerQuotation.KBVSubject               = salesQuotationTable.KCS_KBVSubject;
            nDX_ME_SumPerQuotation.StatusDescription        = kCS_QuotationStatus.KCS_StatusDescription;
            nDX_ME_SumPerQuotation.UpdatedUTC               = updatedUTC;
            ttsbegin;
            nDX_ME_SumPerQuotation.write();
            ttscommit;
        }

        // ungültige Einträge löschen
        delete_from nDX_ME_SumPerQuotation
            where   nDX_ME_SumPerQuotation.RefRecId_NDX_ME_DataFromExcelTable == _refRecIdExcelTable
                && nDX_ME_SumPerQuotation.UpdatedUTC != updatedUTC;

    }

]]></Source>
