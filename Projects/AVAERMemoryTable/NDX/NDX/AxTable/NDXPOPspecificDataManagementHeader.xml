			<Method>
				<Name>refreshCounterUnEdited</Name>
				<Source><![CDATA[
    /// <summary>
    /// PaffH 03.04.25
    /// </summary>
    /// <param name = "_refreshLinesAndEdited">refresh counter Edited and Lines (false)</param>
    /// <returns>counter unEdited</returns>
    public int refreshCounterUnEdited(boolean _refreshLinesAndEdited = false)
    {
        if (_refreshLinesAndEdited)
        {
            this.refreshCounterEdited();
            this.refreshCounterLines();
        }
        this.CounterUnEdited = this.CounterLines - this.CounterEdited;
        return this.CounterUnEdited;
    }

]]></Source>
