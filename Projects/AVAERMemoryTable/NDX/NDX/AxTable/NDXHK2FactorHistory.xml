		<Methods>
			<Method>
				<Name>createByNDXHK1History</Name>
				<Source><![CDATA[
    /// <summary>
    /// Create History by InventTableModule
    /// </summary>
    /// <param name = "_ndxHK1History">NDXHK1History table record</param>
    public static void createByNDXHK1History(NDXHK1History _ndxHK1History)
    {
        InventTable lInventTable;
        InventTableModule lInventTableModule;
        KCS_HK2FactorGroup lKCS_HK2FactorGroup;
        AVAMGKFactors lAVAMGKFactors;

        NDXHK2FactorHistory lNDXHK2FactorHistory;
        lNDXHK2FactorHistory.HK1HistoryRefRecId = _ndxHK1History.RecId;
        
        select firstonly lInventTable
            where lInventTable.RecId == _ndxHK1History.InventTableRefRecId
            join lInventTableModule
                where lInventTableModule.ItemId == lInventTable.ItemId
            &&  lInventTableModule.ModuleType == ModuleInventPurchSales::Invent;
            

        lKCS_HK2FactorGroup = KCS_HK2FactorGroup::findByRecId(lInventTable.NDXHK2GroupRefRecId);
        lAVAMGKFactors = AVAMGKFactors::findByRecId(lInventTableModule.NDXMGKGroupRefRecId);
        
        lNDXHK2FactorHistory.ItemId = lInventTable.ItemId;
        lNDXHK2FactorHistory.InventTableRefRecId = _ndxHK1History.InventTableRefRecId;
        lNDXHK2FactorHistory.HK1 = _ndxHK1History.HK1To;
        
        lNDXHK2FactorHistory.KCS_HK2GroupId = lKCS_HK2FactorGroup.HK2GroupId;
        lNDXHK2FactorHistory.HK2Factor = lKCS_HK2FactorGroup.HK2Factor;
        lNDXHK2FactorHistory.HK2GroupIdFromDate = lKCS_HK2FactorGroup.FromDate;


        lNDXHK2FactorHistory.MGKGroup = lAVAMGKFactors.MGKGroup;
        lNDXHK2FactorHistory.MGKFactor = lAVAMGKFactors.MGKFactor;
        
        lNDXHK2FactorHistory.HK2 = lInventTable.NDX_GetHK2();
        lNDXHK2FactorHistory.insert();
    }

]]></Source>
			</Method>
