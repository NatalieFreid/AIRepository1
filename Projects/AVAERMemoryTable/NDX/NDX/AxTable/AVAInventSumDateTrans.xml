		<Methods>
			<Method>
				<Name>insert</Name>
				<Source><![CDATA[
    public void insert()
    {
        if (this.WMSLocationTxt)
        {
            if (WMSLocation::exist(this.WMSLocationTxt, this.InventLocationId))
            {
                this.WMSLocationId = this.WMSLocationTxt;
            }
        }
        this.ItemGroupId = InventItemGroupItem::findByItemIdLegalEntity(this.ItemId).ItemGroupId;

        super();
    }

]]></Source>
			</Method>
			<Method>
				<Name>displayVal365PerUnit</Name>
				<Source><![CDATA[
    [SysClientCacheDataMethodAttribute(true)]
    display Amount displayVal365PerUnit()
    {
        Amount          valPerUnit;

        valPerUnit = this.D365Qty ? this.D365Value / this.D365Qty : this.D365Value;

        return valPerUnit;
    }

]]></Source>
			</Method>
			<Method>
				<Name>displayVal2009PerUnit</Name>
				<Source><![CDATA[
    [SysClientCacheDataMethodAttribute(true)]
    display Amount displayVal2009PerUnit()
    {
        Amount      valPerUnit;

        valPerUnit = this.PhysQty ? this.PhysValue / this.PhysQty : this.PhysValue;

        return valPerUnit;
    }

]]></Source>
			</Method>
		</Methods>
