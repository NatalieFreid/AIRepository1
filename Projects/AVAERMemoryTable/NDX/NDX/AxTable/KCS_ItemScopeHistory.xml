		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// DebuC 16.06.23
    /// </summary>
    /// <param name = "_itemid">ItemId</param>
    /// <param name = "_year">yr</param>
    /// <param name = "_month">MonthOfYearId</param>
    /// <param name = "_forUpdate">boolean</param>
    /// <returns>KCS_ItemScopeHistory</returns>
    static KCS_ItemScopeHistory find(ItemId         _itemid,
                                 yr             _year,
                                 MonthOfYearId  _month,
                                 boolean          _forUpdate = false)
    {
        KCS_ItemScopeHistory  history;
        ;

        if (_itemid && _year && _month)
        {
            history.selectForUpdate(_forUpdate);

            select firstonly history
            where history.ItemId        == _itemid
               && history.Year          == _year
               && history.MonthOfYear   == _month;
        }

        return history;
    }

]]></Source>
			</Method>
			<Method>
				<Name>ItemMedianPerDate</Name>
				<Source><![CDATA[
    /// <summary>
    /// DebuC 16.06.23
    /// </summary>
    /// <param name = "_itemId">ItemId</param>
    /// <param name = "_date">TransDate</param>
    /// <returns>Qty</returns>
    public static Qty ItemMedianPerDate(ItemId _itemId, TransDate _date = DateTimeUtil::date(DateTimeUtil::getSystemDateTime()))
    {
        KCS_ItemScopeHistory        scopeHistory;
        int                         counter;
        Qty                         qty[], ret;
        TransDate                   minDate;
        ;
        //Median aus Verbräuchen der letzten 13 Monate (aktuellen Monat nicht in Berechnung mit einbeziehen)
        minDate = Global::dateMthFwd(_date,-14);

        while select scopeHistory order by ConsumpSum
                              where scopeHistory.ItemId == _itemId
                                 && scopeHistory.HistoryDate < _date
                                 && scopeHistory.HistoryDate >= minDate
        {
            counter++;
            qty[counter] = scopeHistory.ConsumpSum;
        }

        if (counter)
        {
            //Bei einer Liste mit einer geraden Anzahl von Werten muss der Median erst berechnet werden
            if ((counter mod 2) == 0)
            {
                counter = real2int(decRound(counter / 2,0));
                ret = (qty[counter] + qty[counter + 1]) / 2;
            }
            else
            {
                counter = real2int(decRound(counter / 2 + 1,0));
                ret = qty[counter];
            }
        }
        return ret;
    }

]]></Source>
			</Method>
