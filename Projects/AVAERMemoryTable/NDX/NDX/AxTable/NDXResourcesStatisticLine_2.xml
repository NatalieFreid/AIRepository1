				<Name>dispJournalPos</Name>
				<Source><![CDATA[
    display NDXJournalPos dispJournalPos()
    {
        if (this.LineNum)
        {
            return int2str(real2int(this.LineNum));
        }
        else
        {
            return "";
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>dispSecProdTimeAsMin</Name>
				<Source><![CDATA[
    display NDXTimeMinProdTime dispSecProdTimeAsMin()
    {
        return (int642int(this.TimeSec) / 60);
    }

]]></Source>
			</Method>
			<Method>
				<Name>dispSecProdTimeRefAsMin</Name>
				<Source><![CDATA[
    display NDXTimeMinRefProdTime dispSecProdTimeRefAsMin()
    {
        return (int642int(this.TimeSecRef) / 60);
    }

]]></Source>
			</Method>
