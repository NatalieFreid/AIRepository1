			<Method>
				<Name>findFromNDXKBVRequestLine</Name>
				<Source><![CDATA[
    /// <summary>
    /// PaffH 29.11.25
    /// </summary>
    /// <param name = "_nDXKBVRequestLine">NDXKBVRequestLine</param>
    /// <param name = "_forUpdate">boolean (true)</param>
    /// <returns>NDXBVEMailRequestLine</returns>
    public static NDXBVEMailRequestLine findFromNDXKBVRequestLine(NDXKBVRequestLine _nDXKBVRequestLine, boolean _forUpdate = true)
    {
        NDXBVEMailRequestLine nDXBVEMailRequestLine;
        nDXBVEMailRequestLine.selectForUpdate(_forUpdate);
        select firstonly nDXBVEMailRequestLine
            where nDXBVEMailRequestLine.NDXKBVRequestLine == _nDXKBVRequestLine.RecId;
        return nDXBVEMailRequestLine;
    }

