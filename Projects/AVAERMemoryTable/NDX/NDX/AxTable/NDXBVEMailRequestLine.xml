				<Name>checkItemFromEanCode</Name>
				<Source><![CDATA[
    /// <summary>
    /// PaffH 11.10.25
    /// set itemid from barcode
    /// </summary>
    /// <returns>item found?</returns>
    public boolean checkItemFromEanCode()
    {
        boolean itemFound = false;
        InventTable inventTable = this.findInventTableByBarCode();
        itemFound = inventTable.RecId > 0;
        if (itemFound)
        {
            this.ItemId = inventTable.ItemId;
            this.ItemIdDataAreaId = inventTable.DataAreaId;
        }
        return itemFound;
    }

]]></Source>
