        this.ItemIdDataAreaId = _nDXBVEMailRequestLineItem.SelectItem == NoYes::No ? '' : _nDXBVEMailRequestLineItem.ItemIdDataAreaId;
        this.update(false);
        ttscommit;

        if (fds)
        {
            fds.research(true);
        }
    }

