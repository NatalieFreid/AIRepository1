			<Method>
				<Name>findInventTableByBarCode</Name>
				<Source><![CDATA[
    /// <summary>
    /// PaffH 11.10.25
    /// </summary>
    /// <param name = "_barcodeSetupId">BarcodeSetupId default EAN13</param>
    /// <returns>InventTable</returns>
    public InventTable findInventTableByBarCode(BarcodeSetupId _barcodeSetupId = 'EAN13')
    {
        InventItemBarcode inventItemBarcode;
        InventTable inventTable;

        select firstonly crosscompany inventItemBarcode
            where inventItemBarcode.barcodeSetupId == _barcodeSetupId
            && inventItemBarcode.itemBarCode == this.ItemEANCode;
        if (inventItemBarcode)
        {
            changecompany(inventItemBarcode.DataAreaId)
            {
                inventTable = InventTable::find(inventItemBarcode.itemId);
            }
        }

        return inventTable;
    }

]]></Source>
