		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// find paramter for update
    /// </summary>
    /// <param name = "l_forupdate">for update </param>
    /// <returns>NDXSNParameters record</returns>
    static NDXSNParameters find(boolean l_forupdate = false)
    {
        NDXSNParameters parameter;

        parameter.selectForUpdate(l_forupdate);

        select firstonly parameter
            index Key
            where parameter.key == 0;

        if (!parameter && !parameter.isTmp())
        {
            Company::createParameter(parameter);
        }

        return parameter;
    }

]]></Source>
			</Method>
			<Method>
				<Name>getMonthTaxDate2</Name>
				<Source><![CDATA[
    /// <summary>
    /// gets month of the second VAT date
    /// </summary>
    /// <param name = "salesYear">Year</param>
    /// <returns>month</returns>
    static NDXMonat getMonthTaxDate2(NDXJahr salesYear)
    {
        NDXSNParameters nDX_SNParameters = NDXSNParameters::find();

        if (nDX_SNParameters.TaxDate2 && year(nDX_SNParameters.TaxDate2) == salesYear)
        {
            return mthofyr(nDX_SNParameters.TaxDate2);
        }
        else
        {
            return 0;
        }

    }

]]></Source>
			</Method>
			<Method>
				<Name>showTaxValueTaxDate1</Name>
				<Source><![CDATA[
    /// <summary>
    /// displays tax value
    /// </summary>
    /// <returns>value</returns>
    public display TaxValue showTaxValueTaxDate1()
    {
        TransDate   transDate = this.TaxDate1;
        TaxOnItem   taxOnItem = TaxOnItem::find(TaxItemGroupHeading::findRecId(this.TaxItemGroupRefRecId).TaxItemGroup, TaxTable::findRecId(this.TaxCodeRefRecId).TaxCode);

        return TaxData::percent(taxOnItem.TaxCode, transDate, 0);
    }

]]></Source>
			</Method>
			<Method>
				<Name>showTaxValueTaxDate2</Name>
				<Source><![CDATA[
    /// <summary>
    /// displays second tax value
    /// </summary>
    /// <returns>value</returns>
    public display TaxValue showTaxValueTaxDate2()
    {
        TransDate   transDate = this.TaxDate2 ? this.TaxDate2 : this.TaxDate1;
        TaxOnItem   taxOnItem = TaxOnItem::find(TaxItemGroupHeading::findRecId(this.TaxItemGroupRefRecId).TaxItemGroup, TaxTable::findRecId(this.TaxCodeRefRecId).TaxCode);

        return TaxData::percent(taxOnItem.TaxCode, transDate, 0);
    }

]]></Source>
			</Method>
		</Methods>
