			<Method>
				<Name>ExistsActiveLine</Name>
				<Source><![CDATA[
    /// <summary>
    /// AVAZ5A
    /// </summary>
    /// <param name = "_dispatchId">AVAListZ5ADispatchId</param>
    /// <param name = "_status">AVAListZ5AStatus</param>
    /// <param name = "_type">AVAListZ5AType</param>
    /// <param name = "_countryRegionId">LogisticsAddressCountryRegionId</param>
    /// <param name = "_currencyCode">CurrencyCode</param>
    /// <returns>boolean</returns>
    public static boolean ExistsActiveLine(
                            AVAListZ5ADispatchId           _dispatchId,
                            AVAListZ5AStatus               _status,
                            AVAListZ5AType                 _type,
                            LogisticsAddressCountryRegionId _countryRegionId
                            , CurrencyCode                  _currencyCode
                            )
    {
        AVAListZ5AData listZ5AData;
        ;
        select firstOnly count(RecId) from listZ5AData
            where   listZ5AData.DispatchId      == _dispatchId
            &&      listZ5AData.Status          == _status
            &&      listZ5AData.Type            == _type
            &&      listZ5AData.CountryRegionId == _countryRegionId
            &&      listZ5AData.PosType         == AVAListZ5APosType::Position
            &&      listZ5AData.CurrencyCode    == _currencyCode;
    
        return listZ5AData.RecId != 0;
    }

]]></Source>
