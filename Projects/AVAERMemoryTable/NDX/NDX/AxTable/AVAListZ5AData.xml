			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// Check if record exists in database.
    /// </summary>
    /// <param name="_recId">
    /// Record ID to search for.
    /// </param>
    /// <returns>
    /// True, if record exists in database; False, if not.
    /// </returns>
    public static server boolean exist(RecId _recId)
    {
        return _recId &&
            (select firstonly RecId from AVAListZ5AData
                index hint RecId
                where AVAListZ5AData.RecId == _recId).RecId != 0;
    }

]]></Source>
