			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Search for record in database.
    /// </summary>
    /// <param name="_recId">
    /// Record ID to search for.
    /// </param>
    /// <param name="_update">
    /// True, if record shall be selected for updates; False, if not.
    /// </param>
    /// <returns>
    /// Found or empty record.
    /// </returns>
    public static AVAListZ5AData find(RecId _recId, boolean _update = false)
    {
        AVAListZ5AData listZ5AData;
    
        if (_recId)
        {
            listZ5AData.selectForUpdate(_update);
    
            select firstonly listZ5AData
                index hint RecId
                where listZ5AData.RecId == _recId;
        }
    
        return listZ5AData;
    }

]]></Source>
