    /// <summary>
    /// Finds parameter record
    /// </summary>
    /// <param name = "_forUpdate">for update</param>
    /// <returns>NDXUnitConvertCheckParameters record</returns>
    public static NDXUnitConvertCheckParameters find( boolean _forUpdate = false)
    {
        NDXUnitConvertCheckParameters parameters;

        parameters.selectForUpdate(_forupdate);

        select firstonly parameters
            where parameters.key == 0;

        if (!parameters && !parameters.isTmp())
        {
            parameters.HoldDataDays = 7;
            Company::createParameter(parameters);
        }

        return parameters;
    }

