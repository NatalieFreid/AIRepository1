		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// find a record 
    /// </summary>
    /// <param name = "_requisitionId">RequisitionId of NDXRequisition record</param>
    /// <param name = "_levelString">level string</param>
    /// <param name = "_update">for update yes or no</param>
    /// <returns>NDXRequisitionLine record</returns>
    static NDXRequisitionLine find(NDXRequisitionId _requisitionId, NDXLevelString _levelString, boolean _update = false)
    {
        NDXRequisitionLine    requisitionLine;
        
        requisitionLine.selectForUpdate(_update);

        select firstonly requisitionLine
            where requisitionLine.RequisitionId == _requisitionId
                && requisitionLine.LevelString   == _levelString;

        return requisitionLine;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initFromNDXRequisitionLine</Name>
				<Source><![CDATA[
    /// <summary>
    /// init from original record
    /// </summary>
    /// <param name = "_ndxRequisitionLine">orginal NDXRequisitionLinerecord</param>
    public void initFromNDXRequisitionLine(NDXRequisitionLine _ndxRequisitionLine)
    {
        this.SalesQuotationRefRecId = _ndxRequisitionLine.SalesQuotationRefRecId;
        this.LineNum = _ndxRequisitionLine.LineNum;
        this.KCS_CRMIsAlternativeLine = _ndxRequisitionLine.KCS_CRMIsAlternativeLine;
        this.KCS_QLInternalPosition   = _ndxRequisitionLine.KCS_QLInternalPosition;
        this.KCS_QLLVPosition         = _ndxRequisitionLine.KCS_QLLVPosition;
    }

]]></Source>
			</Method>
			<Method>
				<Name>getMaxLevel</Name>
				<Source><![CDATA[
    /// <summary>
    /// gets max level
    /// </summary>
    /// <param name = "_requisitionId">RequisitionId of NDXRequisition record</param>
    /// <param name = "getNextLevelId">next level id true or false</param>
    /// <returns>level number</returns>
    public static NDXLevel getMaxLevel(NDXRequisitionId _requisitionId, boolean getNextLevelId = true)
    {
        return (select Level from NDXRequisitionLine order by Level desc
                    where NDXRequisitionLine.RequisitionId == _requisitionId).Level + (getNextLevelId ? 1:0);
    }

]]></Source>
			</Method>
			<Method>
				<Name>dispActiveLineGrp</Name>
				<Source><![CDATA[
    /// <summary>
    /// displays active flag of cumulated record
    /// </summary>
    /// <returns>true or false</returns>
    [SysClientCacheDataMethodAttribute(true)]
    display NDXRequisitionActiveLineGrp dispActiveLineGrp()
    {
        NDXRequisitionLineGrp nDX_Requisition_LineGrp;
        nDX_Requisition_LineGrp = NDXRequisitionLineGrp::find(this.RequisitionId, this.ItemId);
       
        return nDX_Requisition_LineGrp.Active;
    }

]]></Source>
			</Method>
			<Method>
				<Name>modifiedField</Name>
				<Source><![CDATA[
    public void modifiedField(FieldId _fieldId)
    {
        NDXRequisitionLineGrp    nDX_Requisition_LineGrp;
        BOMVersion  bOMVersion;
        InventTable inventTable;
        
        super(_fieldId);

        switch (_fieldId)
        {
            case fieldnum(NDXRequisitionLine, Active) :
                break;
            case fieldnum(NDXRequisitionLine, Qty01) :
                if (!this.Qty01Orig)
                {
                    this.Qty01Orig = this.orig().Qty01;
                }
                this.Changed = this.Qty01 == this.Qty01Orig ? NoYes::No : NoYes::Yes;
                
                // fill Qty02
                this.Qty02   = this.Active ? this.Qty01 : 0;
                nDX_Requisition_LineGrp = NDXRequisitionLineGrp::find(this.RequisitionId, this.ItemId);
                if (nDX_Requisition_LineGrp && nDX_Requisition_LineGrp.Active == NoYes::No)
                {
                    this.Qty02 = 0;
                }

                break;
            case fieldnum(NDXRequisitionLine, ItemId) :
                this.RequisitionLineType =  NDXRequisitionLineType::Manual;
                
                bOMVersion      = BOMVersion::findValidActive(this.ItemId);
                this.BOMId      = bOMVersion.BOMId;
                inventTable     = InventTable::find(this.ItemId);
                this.SalesUnit  = inventTable.inventTableModuleInvent().UnitId;
                this.ItemName   = inventTable.Product().productName();
                this.ItemType   = inventTable.ItemType;
                this.PmfProductType = inventTable.PmfProductType;
                this.AVAItemSet = inventTable.AVAItemSet;
                break;
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>initValue</Name>
				<Source><![CDATA[
    public void initValue()
    {
        super();

        this.Level1 = 1;
        this.Multiplier = 1000;
        this.Active = NoYes::Yes;

        this.Level = NDXRequisitionLine::getMaxLevel(this.RequisitionId);
        this.LevelString  = Con2Str([this.Level], '.');
    }

]]></Source>
