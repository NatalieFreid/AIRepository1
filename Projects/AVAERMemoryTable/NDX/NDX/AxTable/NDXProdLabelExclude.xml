		<Methods>
			<Method>
				<Name>exists</Name>
				<Source><![CDATA[
    /// <summary>
    /// PaffH 15.05.24
    /// </summary>
    /// <param name = "_inventLocationId">InventLocationId</param>
    /// <param name = "_prodPoolId">ProdPoolId</param>
    /// <returns>boolean</returns>
    static boolean exists(InventLocationId _inventLocationId, ProdPoolId _prodPoolId)
    {
        NDXProdLabelExclude nDX_ProdLabelExclude;

        select firstOnly nDX_ProdLabelExclude
        where nDX_ProdLabelExclude.InventLocationId == _inventLocationId
            && nDX_ProdLabelExclude.ProdPoolId == _prodPoolId;

        return (nDX_ProdLabelExclude.RecId != 0);
    }

]]></Source>
			</Method>
			<Method>
				<Name>checkProdTable</Name>
				<Source><![CDATA[
    /// <summary>
    /// PaffH 15.05.24
    /// </summary>
    /// <param name = "_prodTable">ProdTable</param>
    /// <returns>boolean</returns>
    public static boolean checkProdTable(ProdTable _prodTable)
    {
        InventDim    inventDim;
        NDXProdLabelExclude    nDX_ProdLabelExclude;

        select firstOnly inventDim
            where inventDim.inventDimId == _prodTable.InventDimId;

        select firstOnly nDX_ProdLabelExclude
        where nDX_ProdLabelExclude.InventLocationId == inventDim.InventLocationId
            && nDX_ProdLabelExclude.ProdPoolId == _prodTable.ProdPoolId;

        return nDX_ProdLabelExclude.RecId == 0;

    }

]]></Source>
