				<Name>inventTable</Name>
				<Source><![CDATA[
    /// <summary>
    /// PaffH 28.02.23
    /// get inventtable 
    /// </summary>
    /// <returns>InventTable</returns>
    public InventTable inventTable()
    {
        InventTable inventTable;
        NDXProdIdentProcedureTable nDXProdIdentProcedureTable;
        NDXProdIdentProcedureLine1 nDXProdIdentProcedureLine1;

        select firstonly nDXProdIdentProcedureLine1
            where nDXProdIdentProcedureLine1.RecId == this.NDXProdIdentProcedureLine1
            join nDXProdIdentProcedureTable
                where nDXProdIdentProcedureTable.RecId == nDXProdIdentProcedureLine1.NDXProdIdentProcedureTable
            join inventTable
                where inventTable.RecId == nDXProdIdentProcedureTable.InventTable;
        
        return inventTable;
    }

]]></Source>
