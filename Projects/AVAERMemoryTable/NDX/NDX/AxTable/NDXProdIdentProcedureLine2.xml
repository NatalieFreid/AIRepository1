			<Method>
				<Name>getProdLabelIdBarcode</Name>
				<Source><![CDATA[
    /// <summary>
    /// PaffH 05.07.22
    /// AX2009: tables.NDX_ProdIdent_ProcedureLine2.getProdLabelIdBarcode()
    /// </summary>
    /// <param name = "prodId">ProdId</param>
    /// <param name = "getBarcodeStr">boolean</param>
    /// <returns>BarCodeString</returns>
    BarCodeString getProdLabelIdBarcode(ProdId prodId, boolean getBarcodeStr = true)
    {
        Barcode             barcode = Barcode::construct(BarcodeType::Interleaved2of5);
        NDXProdLabelId      nDX_ProdLabelId;
        ;
        nDX_ProdLabelId = this.getProdLabelId(prodId);
        if (!barcode.validateBarcode(barcode.string(true, nDX_ProdLabelId)))
        {
            return '';
        }
        return getBarcodeStr ? barcode.barcodeStr() : barcode.barcodeStrHR();

    }

]]></Source>
