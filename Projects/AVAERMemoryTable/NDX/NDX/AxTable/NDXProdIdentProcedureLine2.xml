			<Method>
				<Name>getProdLabelId</Name>
				<Source><![CDATA[
    /// <summary>
    /// PaffH 05.07.22
    /// AX2009: tables.NDX_ProdIdent_ProcedureLine2.getProdLabelId()
    /// </summary>
    /// <param name = "prodId">ProdId</param>
    /// <returns>NDXProdLabelId</returns>
    public NDXProdLabelId getProdLabelId(ProdId prodId)
    {
        #define.StrLenJobId(13)
        NDXProdLabelId  prodLabelId;
        ProdRouteJob    prodRouteJob;
        ;
        // get first "Einzelvorgangsnummer" of the PA
        select firstOnly JobId from prodRouteJob
        order by OprNum, NumType
        where prodRouteJob.ProdId == prodId;

        if (!prodRouteJob.JobId)
        {
            Warning(strfmt("@NDX:NDXNoOperationNumberforProductionOrderDetermined", prodId));
            return prodLabelId;
        }

        // combine JobId with idSort
        prodLabelId = prodRouteJob.JobId + int2str(this.IDSort);

        return prodLabelId;
    }

]]></Source>
