		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// CD 09.11.2021 Req: 3655 Task: 5401
    /// </summary>
    /// <param name = "_id">NDX_ScrapId</param>
    /// <param name = "_date">NDX_Date</param>
    /// <param name = "_forUpdate">boolean</param>
    /// <returns>NDX_ScrapGroupPrice</returns>
    static NDX_ScrapGroupPrice find(NDX_ScrapId _id, NDX_Date _date, boolean _forUpdate = false)
    {
        NDX_ScrapGroupPrice scrapGroupPrice;

        scrapGroupPrice.selectForUpdate(_forUpdate);

        select firstonly scrapGroupPrice
        where scrapGroupPrice.ScrapId == _id
        &&    scrapGroupPrice.ScrapDate == _date;
        
        return scrapGroupPrice;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// CD 09.11.2021 Req: 3655 Task: 5401
    /// </summary>
    /// <param name = "_id">NDX_ScrapId</param>
    /// <param name = "_date">NDX_Date</param>
    /// <returns>boolean</returns>
    static boolean exist(NDX_ScrapId _id, NDX_Date _date)
    {
        NDX_ScrapGroupPrice scrapGroupPrice;

        select firstonly RecId from scrapGroupPrice
            where scrapGroupPrice.ScrapId == _id
            &&    scrapGroupPrice.ScrapDate == _date;

        return scrapGroupPrice.RecId;
    }

]]></Source>
