		<Methods>
			<Method>
				<Name>getLanguageTypeId</Name>
				<Source><![CDATA[
    /// <summary>
    ///    AVA <c>getLanguageTypeId</c> method.
    /// </summary>
    /// <param name="_KCS_KBVRelationID">
    ///    <c>KCS_KBVRelationID</c> as type
    /// </param>
    /// <param name="_languageId">
    ///    <c>LanguageId</c> as type
    /// </param>
    /// <returns>
    ///    <c>NDX_KBVRelationsTypeIdLang</c> as return value
    /// </returns>
    static NDX_KBVRelationsTypeIdLang getLanguageTypeId(KCS_KBVRelationID _KCS_KBVRelationID, LanguageId _languageId)
    {
        NDX_KBVRelationsLang    nDX_KBVRelationsLang;

        select firstonly  TypeIdLang 
        from    nDX_KBVRelationsLang
        where   nDX_KBVRelationsLang.TypeId     == _KCS_KBVRelationID
            &&  nDX_KBVRelationsLang.LanguageId == _languageId;

        return nDX_KBVRelationsLang.TypeIdLang;
    }

]]></Source>
			</Method>
		</Methods>
