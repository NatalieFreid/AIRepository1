				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// finds NDXBOMScrap record
    /// </summary>
    /// <param name = "_bomRecId">RecId of BOM table record</param>
    /// <param name = "_forupdate">for update</param>
    /// <returns>NDXBOMScrap record</returns>
    static public NDXBOMScrap find(RecId _bomRecId, boolean _forupdate = false)
    {
        NDXBOMScrap lNDXBOMScrap;

        lNDXBOMScrap.selectForUpdate(_forupdate);
        if(_bomRecId)
        {
            select lNDXBOMScrap
                where lNDXBOMScrap.RefRecIdBom == _bomRecId;
        }

        return lNDXBOMScrap;
    }

]]></Source>
			</Method>
			<Method>
				<Name>findOrCreate</Name>
				<Source><![CDATA[
    /// <summary>
    /// finds or creates NDXBOMScrap record
    /// </summary>
    /// <param name = "_bomRecId">RecId of BOM table record</param>
    /// <param name = "_forupdate">for update</param>
    /// <returns>NDXBOMScrap record</returns>
    static public NDXBOMScrap findOrCreate(RecId _bomRecId, boolean _forupdate = false)
    {
        NDXBOMScrap lNDXBOMScrap = NDXBOMScrap::find(_bomRecId, _forupdate);

        if(!lNDXBOMScrap)
        {
            lNDXBOMScrap.RefRecIdBom = _bomRecId;
            lNDXBOMScrap.insert();
        }

        return lNDXBOMScrap;
    }

]]></Source>
