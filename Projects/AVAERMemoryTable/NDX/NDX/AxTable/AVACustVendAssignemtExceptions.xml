				<Source><![CDATA[
    /// <summary>
    /// designed from AVA
    /// </summary>
    /// <param name = "_avaMSQCustVendAssignmentRecId">_avaMSQCustVendAssignmentRecId</param>
    /// <param name = "_custAccount">_custAccount</param>
    /// <returns>boolean</returns>
    public static  boolean checkIfExceptionsExist(RefRecId       _avaMSQCustVendAssignmentRecId, CustAccount         _custAccount)
    {
        AVACustVendAssignemtExceptions          custVendAssignmentExceptions;
        boolean                                 ret = false;

        select firstonly custVendAssignmentExceptions
            where custVendAssignmentExceptions.CustVendAssignmentRefRecId == _avaMSQCustVendAssignmentRecId
            && custVendAssignmentExceptions.CustAccount                == _custAccount;

        if (custVendAssignmentExceptions.RecId)
        {
            ret = true;
        }

        return ret;
    }

]]></Source>
