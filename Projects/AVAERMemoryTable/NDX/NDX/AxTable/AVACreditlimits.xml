		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// AVA
    /// </summary>
    /// <param name = "_groupId">CredManCreditLimitId</param>
    /// <param name = "_custAccount">CustAccount</param>
    /// <param name = "_forUpdate">boolean</param>
    /// <returns>AVACreditlimits</returns>
    public static AVACreditlimits find(CredManCreditLimitId _groupId, CustAccount _custAccount, boolean _forUpdate)
    {
        AVACreditlimits creditLimits;

        if (_forUpdate)
        {
            creditLimits.selectForUpdate(true);
        }

        if (_groupId)
        {
            select firstonly creditLimits where creditLimits.CredManCreditLimitId == _groupId;
        }
        else if (_custAccount)
        {
            select firstonly creditLimits where creditLimits.CustAccount == _custAccount;
        }

        return creditLimits;
    }

]]></Source>
			</Method>
