		<Methods>
			<Method>
				<Name>findAbrufID</Name>
				<Source><![CDATA[
    /// <summary>
    /// PaffH 01.02.24
    /// </summary>
    /// <param name = "_AbrufID">NDXRicoAbrufId</param>
    /// <param name = "_lOldValue">NoYes</param>
    /// <param name = "lUpdate">boolean</param>
    /// <returns>NDX_KBV2RicoKalkQuotation</returns>
    public static NDX_KBV2RicoKalkQuotation findAbrufID(NDXRicoAbrufId _AbrufID, NoYes _lOldValue = NoYes::No, boolean lUpdate = false)
    {
        NDX_KBV2RicoKalkQuotation  kBV2RicoKalkQuotation;
    
        if (_AbrufID)
        {
            kBV2RicoKalkQuotation.selectForUpdate(lUpdate);

            select firstonly kBV2RicoKalkQuotation
                where kBV2RicoKalkQuotation.AbrufID == _AbrufID &&
                kBV2RicoKalkQuotation.OldValue == _lOldValue;
        }
        return kBV2RicoKalkQuotation;
    }

]]></Source>
			</Method>
			<Method>
				<Name>findPossibleDeletedRecord</Name>
				<Source><![CDATA[
    /// <summary>
    /// PaffH 01.02.24
    /// </summary>
    /// <param name = "_currentRecord">NDX_KBV2RicoKalkQuotation</param>
    /// <param name = "lUpdate">boolean</param>
    /// <returns>NDX_KBV2RicoKalkQuotation</returns>
    public static NDX_KBV2RicoKalkQuotation findPossibleDeletedRecord(NDX_KBV2RicoKalkQuotation _currentRecord, boolean lUpdate = false)
    {
        NDX_KBV2RicoKalkQuotation  kBV2RicoKalkQuotation;

        if (_currentRecord)
        {
            kBV2RicoKalkQuotation.selectForUpdate(lUpdate);

            select firstonly    kBV2RicoKalkQuotation
            where           kBV2RicoKalkQuotation.Abruf   == _currentRecord.Abruf &&
                            kBV2RicoKalkQuotation.KBVBuildingProjectID == _currentRecord.KBVBuildingProjectID &&
                            kBV2RicoKalkQuotation.AbrufID   != _currentRecord.AbrufID &&
                            kBV2RicoKalkQuotation.OldValue  == NoYes::No;
        }

        return kBV2RicoKalkQuotation;
    }

]]></Source>
