		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// DebuC 16.10.23
    /// </summary>
    /// <param name = "companyId">CompanyId</param>
    /// <param name = "invoiceId">InvoiceId</param>
    /// <param name = "refRecId">recId</param>
    /// <param name = "l_forUpdate">boolean</param>
    /// <returns>NDXUmsCust</returns>
    static NDXUmsCust find(CompanyId   companyId,
                        InvoiceId   invoiceId,
                        recId       refRecId,
                        boolean     l_forUpdate = false)
    {
        NDXUmsCust umsatz;
        ;
        umsatz.selectForUpdate(l_forUpdate);

        select      umsatz
        where   umsatz.CompanyId    == companyId    &&
                umsatz.InvoiceId    == invoiceId    &&
                umsatz.RefRecId     == refRecId;

        return umsatz;
    }

]]></Source>
			</Method>
			<Method>
				<Name>costAmount</Name>
				<Source><![CDATA[
    /// <summary>
    /// DebuC 16.10.23
    /// </summary>
    /// <returns>NDXCostAmount</returns>
    NDXCostAmount costAmount()
    {
        return (this.CostAmountPosted + this.CostAmountAdjusted) * -1;
    }

]]></Source>
			</Method>
		</Methods>
