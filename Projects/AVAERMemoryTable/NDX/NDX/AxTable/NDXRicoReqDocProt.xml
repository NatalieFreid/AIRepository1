			<Method>
				<Name>needsTransfer</Name>
				<Source><![CDATA[
    /// <summary>
    /// Checks if a transfer is needed for DocuRef
    /// </summary>
    /// <param name = "_docuRefRecId">Docuref recid</param>
    /// <returns>true or false</returns>
    static public boolean needsTransfer(DocuRefRecId _docuRefRecId)
    {
        NDXRicoReqDocProt lNDXRicoReqDocProt;
        
        select firstonly lNDXRicoReqDocProt order by lNDXRicoReqDocProt.CreatedDateTime desc
            where lNDXRicoReqDocProt.DocuRefRecId == _docuRefRecId
                && lNDXRicoReqDocProt.TransferedToRico == false;
            
        return !lNDXRicoReqDocProt;
    }

]]></Source>
