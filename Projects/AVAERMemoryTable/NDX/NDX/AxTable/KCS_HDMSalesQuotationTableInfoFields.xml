		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find()
    /// </summary>
    /// <param name = "_quotationId">QuotationIdBase</param>
    /// <param name = "_forupdate">Boolean</param>
    /// <returns>KCS_HDMSalesQoutationTableInfoFields</returns>
    public static KCS_HDMSalesQuotationTableInfoFields find(QuotationIdBase _quotationId, Boolean _forupdate = false)
    {
        KCS_HDMSalesQuotationTableInfoFields   salesQuotationTableInfoFields;
       
        salesQuotationTableInfoFields.selectForUpdate(_forupdate);

        select firstonly salesQuotationTableInfoFields
        where salesQuotationTableInfoFields.QuotationId == _quotationId;

        return salesQuotationTableInfoFields;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// exist()
    /// </summary>
    /// <param name = "_quotationId">QuotationIdBase</param>
    /// <returns>KCS_HDMSalesQuotationTableInfoFields</returns>
    public static boolean exist(QuotationIdBase _quotationId)
    {
        KCS_HDMSalesQuotationTableInfoFields   salesQuotationTableInfoFields;

        select firstonly Recid from salesQuotationTableInfoFields
                    where salesQuotationTableInfoFields.QuotationId == _quotationId;

        return salesQuotationTableInfoFields.RecId != 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initInfoFields</Name>
				<Source><![CDATA[
    /// <summary>
    /// initInfoFields
    /// </summary>
    /// <param name = "_fromParty">DirPartyRecId</param>
    /// <param name = "_quotationId">QuotationIdBase</param>
    public static void initInfoFields(DirPartyRecId    _fromParty, QuotationIdBase _quotationId)
    {
        AVASalesInfoFields                      salesInfoFields = AVASalesInfoFields::find(_fromParty);
        KCS_HDMSalesQuotationTableInfoFields    quotationInfoFields;

        quotationInfoFields = KCS_HDMSalesQuotationTableInfoFields::find(_quotationId, true);
        
        // 20231117 - FINTHI - 10818 Resetting fields on CustAccount change
        quotationInfoFields.InfoField2Finished = NoYes::No;
        quotationInfoFields.InfoField2FinishedDateTime = dateNull();
        quotationInfoFields.InfoField2FinishedUser = '';       
            
        quotationInfoFields.InfoField1 = salesInfoFields.InfoField1;
        quotationInfoFields.InfoField2 = salesInfoFields.InfoField2;
        quotationInfoFields.InfoField3 = salesInfoFields.InfoField3;
        if (quotationInfoFields.RecId)
        {
            ttsbegin;
            quotationInfoFields.selectForUpdate();
            quotationInfoFields.update();
            ttscommit;
        }
        else
        {
            quotationInfoFields.QuotationId = _quotationId;
            quotationInfoFields.insert();
        }

    }

]]></Source>
			</Method>
			<Method>
				<Name>modifiedField</Name>
				<Source><![CDATA[
    /// <summary>
    /// modifiedField
    /// </summary>
    /// <param name = "_fieldId">FieldId</param>
    public void modifiedField(FieldId _fieldId)
    {
        super(_fieldId);

        switch (_fieldId)
        {
            case fieldNum(KCS_HDMSalesQuotationTableInfoFields, InfoField2Finished):
                this.InfoField2FinishedUser         = curUserId();
                this.InfoField2FinishedDateTime     = DateTimeUtil::getSystemDateTime();
                break;
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>copyQuotInfoField</Name>
				<Source><![CDATA[
    /// <summary>
    /// designed by AVANADE WEN
    /// </summary>
    /// <param name = "_fromSalesQuotationTable">SalesQuotationTable</param>
    /// <param name = "_toSalesQuotationTable">SalesQuotationTable</param>
    public static void copyQuotInfoField(SalesQuotationTable _fromSalesQuotationTable, SalesQuotationTable _toSalesQuotationTable)
    {
        KCS_HDMSalesQuotationTableInfoFields fromInfo, toInfo;

        ttsbegin;
        fromInfo    = KCS_HDMSalesQuotationTableInfoFields::find(_fromSalesQuotationTable.QuotationId);
        toInfo      = KCS_HDMSalesQuotationTableInfoFields::find(_toSalesQuotationTable.QuotationId, true);
        toInfo.InfoField4 = fromInfo.InfoField4;
        if (toInfo)
        {
            toInfo.update();
        }
        ttscommit;
    }

]]></Source>
