		<Methods>
			<Method>
				<Name>initialize</Name>
				<Source><![CDATA[
    void initialize(NDXJahr _salesYear, NDXMonat _salesMonth, NDXSalesVolumeQuery _salesVolumeQueryType)
    {
        this.clear();
        this.SalesVolumeQueryType = _salesVolumeQueryType;
        this.SalesYear      = _salesYear;
        this.SalesMonth     = _salesMonth;
        this.MonthTaxValue2 = NDXSNParameters::getMonthTaxDate2(_salesYear);
    }

]]></Source>
			</Method>
			<Method>
				<Name>initFromNDX_TmpKumUmsCustArtGrp</Name>
				<Source><![CDATA[
    void initFromNDX_TmpKumUmsCustArtGrp(NDXTmpKumUmsCustArtGrp _nDX_TmpKumUmsCustArtGrp)
    {
        int salesMonth;
        NDXUmsatz  amount;

        this.ArtGrp         = _nDX_TmpKumUmsCustArtGrp.ItemGroup;
        this.Name           = PriceDiscGroup::find(ModuleInventCustVend::Invent, PriceGroupType::LineDiscGroup, this.ArtGrp).Name;
        
        if (!this.Name)
        {
            this.Name       = _nDX_TmpKumUmsCustArtGrp.Name;
        }
        
        this.AccountNum     = _nDX_TmpKumUmsCustArtGrp.Child;
        this.Company        = _nDX_TmpKumUmsCustArtGrp.Company;
        this.PartyRefRecId  = _nDX_TmpKumUmsCustArtGrp.Party;
        this.PartyChildRefRecId   = _nDX_TmpKumUmsCustArtGrp.PartyChild;
        this.Alliance       = _nDX_TmpKumUmsCustArtGrp.Alliance;

        for (salesMonth = 1; salesMonth <= this.SalesMonth; salesMonth++)
        {
            switch (salesMonth)
            {
                case NDXMonthBE::January:
                    amount = _nDX_TmpKumUmsCustArtGrp.U01; 
                    break;
                case NDXMonthBE::February:
                    amount = _nDX_TmpKumUmsCustArtGrp.U02; 
                    break;
                case NDXMonthBE::March:
                    amount = _nDX_TmpKumUmsCustArtGrp.U03; 
                    break;
                case NDXMonthBE::April:
                    amount = _nDX_TmpKumUmsCustArtGrp.U04; 
                    break;
                case NDXMonthBE::May:
                    amount = _nDX_TmpKumUmsCustArtGrp.U05;
                    break;
                case NDXMonthBE::June:
                    amount = _nDX_TmpKumUmsCustArtGrp.U06;
                    break;
                case NDXMonthBE::July:
                    amount = _nDX_TmpKumUmsCustArtGrp.U07;
                    break;
                case NDXMonthBE::August:
                    amount = _nDX_TmpKumUmsCustArtGrp.U08;
                    break;
                case NDXMonthBE::September:
                    amount = _nDX_TmpKumUmsCustArtGrp.U09;
                    break;
                case NDXMonthBE::October:
                    amount = _nDX_TmpKumUmsCustArtGrp.U10;
                    break;
                case NDXMonthBE::November:
                    amount = _nDX_TmpKumUmsCustArtGrp.U11;
                    break;
                case NDXMonthBE::December:
                    amount = _nDX_TmpKumUmsCustArtGrp.U12;
                    break;
            }
            if (salesMonth == this.SalesMonth)
            {
                this.SalesAmount    = amount;
            }
            this.SalesAmountCum += amount;
            if (this.MonthTaxValue2 && salesMonth >= this.MonthTaxValue2)
            {
                this.SalesAmountCumTaxValue2 += amount;
            }
            else
            {
                this.SalesAmountCumTaxValue1 += amount;
            }
        }


    }

]]></Source>
			</Method>
