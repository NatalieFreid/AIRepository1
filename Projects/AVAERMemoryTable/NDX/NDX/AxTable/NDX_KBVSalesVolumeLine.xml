]]></Declaration>
		<Methods>
			<Method>
				<Name>salesQuotationId</Name>
				<Source><![CDATA[
    display SalesQuotationId salesQuotationId()
    {
        SalesQuotationTable locSalesQuotationTable;

        changecompany(this.UK)
        {
            select firstonly  locSalesQuotationTable 
            where   locSalesQuotationTable.RecId == this.SalesQuotationTable;
        }
        return locSalesQuotationTable.QuotationId;
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    static NDX_KBVSalesVolumeLine find( RefRecId                _kBVSalesVolumeTable,
                                        KCS_DirProductGroupID   _productGroupId,
                                        DataAreaId              _uk,
                                        boolean                 update = false)
    {
        NDX_KBVSalesVolumeLine  record;

        record.selectForUpdate(update);

        select firstonly record
        where   record.NDX_KBVSalesVolumeTable  == _kBVSalesVolumeTable
            &&  record.ProductGroupId           == _productGroupId
            &&  record.UK                       == _uk;

        return record;
    }

]]></Source>
			</Method>
			<Method>
				<Name>findOrCreate</Name>
				<Source><![CDATA[
    /// <summary>
    /// designed from AVA
    /// </summary>
    /// <param name = "_kBVSalesVolumeTable">_kBVSalesVolumeTable</param>
    /// <param name = "_productGroupId">_productGroupId</param>
    /// <param name = "_uk">_uk</param>
    /// <param name = "insert">insert</param>
    /// <returns>NDX_KBVSalesVolumeLine</returns>
    static NDX_KBVSalesVolumeLine findOrCreate( RefRecId                _kBVSalesVolumeTable,
                                                KCS_DirProductGroupID   _productGroupId,
                                                DataAreaId              _uk,
                                                boolean                 insert = true)
    {
        NDX_KBVSalesVolumeLine record;

        record  = NDX_KBVSalesVolumeLine::find( _kBVSalesVolumeTable,
                                                _productGroupId, 
                                                _uk, 
                                                true);
        if (!record)
        {
            record.NDX_KBVSalesVolumeTable  = _kBVSalesVolumeTable;
            record.ProductGroupId           = _productGroupId;
            record.UK                       = _uk;
            
            if (insert)
            {
                record.insert();
            }
        }

        return record;
    }

]]></Source>
			</Method>
