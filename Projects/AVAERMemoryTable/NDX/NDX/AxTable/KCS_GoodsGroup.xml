		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// DebuC 07.10.2021 Rrq: 3653 Task: 3765
    /// </summary>
    /// <param name = "_goodsId">KCS_GoodsId</param>
    /// <param name = "_forupdate">boolean</param>
    /// <returns>KCS_GoodsGroup</returns>
    static KCS_GoodsGroup find(KCS_GoodsId _goodsId, boolean _forupdate = false)
    {
        KCS_GoodsGroup      goodsGroup;
        ;

        if(_goodsId)
        {
            goodsGroup.selectForUpdate(_forupdate);

            select goodsGroup
                where goodsGroup.KCS_GoodsId == _goodsId;
        }

        return goodsGroup;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// DebuC 07.10.2021 Rrq: 3653 Task: 3765
    /// </summary>
    /// <param name = "_goodsId">KCS_GoodsId</param>
    /// <returns>boolean</returns>
    static boolean exist(KCS_GoodsId _goodsId)
    {
        KCS_GoodsGroup      goodsGroup;
        ;

        select firstonly RecId from goodsGroup
            where goodsGroup.KCS_GoodsId == _goodsId;

        return goodsGroup.RecId;
    }

]]></Source>
			</Method>
