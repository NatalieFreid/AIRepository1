		<Methods>
			<Method>
				<Name>initFromCustInvoiceLine</Name>
				<Source><![CDATA[
    void initFromCustInvoiceLine(CustInvoiceLine custInvoiceLine)
    {
        this.AVABonusLimitationId     = custInvoiceLine.AVABonusLimitationId;
        this.AVABonusSalesbasis       = custInvoiceLine.AVABonusSalesbasis;
        this.AVABonusCustAccount      = custInvoiceLine.AVABonusCustAccount;
        this.AVASettlementToDate      = custInvoiceLine.AVASettlementToDate;
        this.AVASettlementFromDate    = custInvoiceLine.AVASettlementFromDate;
        this.AVABonusAlliance         = custInvoiceLine.AVABonusAlliance;
        this.AVABonusAllocationBase   = custInvoiceLine.AVABonusAllocationBase;
        this.RefRecIdCustInvoiceLine  = custInvoiceLine.RecId;
        this.RefRecIdCustInvoiceTable = custInvoiceLine.custInvoiceTable().RecId;
        this.ID                       = this.nextId();
    }

]]></Source>
			</Method>
			<Method>
				<Name>nextId</Name>
				<Source><![CDATA[
    int nextId()
    {
        AVACustInvoiceLineAdjust   lNDX_CustInvoiceLineAdjust;

        if (this.RefRecIdCustInvoiceLine)
        {
            select firstOnly ID
                from lNDX_CustInvoiceLineAdjust
                order by id desc
                where lNDX_CustInvoiceLineAdjust.RefRecIdCustInvoiceLine == this.RefRecIdCustInvoiceLine;

            return lNDX_CustInvoiceLineAdjust.ID + 1;
        }
        else
        {
            return 1;
        }
    }

]]></Source>
			</Method>
