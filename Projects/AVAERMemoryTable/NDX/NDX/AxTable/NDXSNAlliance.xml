				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// finds records
    /// </summary>
    /// <param name = "_accountNum">Alliance number</param>
    /// <param name = "_update">for update</param>
    /// <returns>NDXSNAlliance record</returns>
    static NDXSNAlliance find(CustAccount _accountNum, boolean _update = false)
    {
        NDXSNAlliance nDX_SNAlliance;
        
        nDX_SNAlliance.selectForUpdate(_update);

        select firstonly nDX_SNAlliance where nDX_SNAlliance.TOSId == _accountNum;

        return nDX_SNAlliance;
    }

