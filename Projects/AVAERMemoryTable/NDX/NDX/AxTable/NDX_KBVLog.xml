		<Methods>
			<Method>
				<Name>startLog</Name>
				<Source><![CDATA[
    /// <summary>
    ///    AVA <c>startLog</c> method.
    /// </summary>
    /// <param name="headerRecId">
    ///    <c>RefRecId</c> as type
    /// </param>
    /// <param name="buildingProjectId">
    ///    <c>KCS_KBVBuildingProjectID</c> as type
    /// </param>
    /// <returns>
    ///    <c>NDX_KBVLog</c> as return value
    /// </returns>
    static NDX_KBVLog startLog(RefRecId headerRecId, KCS_KBVBuildingProjectID buildingProjectId)
    {
        NDX_KBVLog    kbvLog;

        kbvLog.HeaderRefRecId       = headerRecId;
        kbvLog.KBVBuildingProjectID = buildingProjectId;
        kbvLog.insert();

        return kbvLog;
    }

]]></Source>
			</Method>
			<Method>
				<Name>endLog</Name>
				<Source><![CDATA[
    /// <summary>
    ///    AVA <c>endLog</c> method.
    /// </summary>
    /// <param name="_startline">
    ///    <c>int</c> as type
    /// </param>
    /// <returns>
    ///    <c>AVAException</c> as return value
    /// </returns>
    AVAException endLog(int _startline)
    {
        int     startLine = _startline;
        
        ttsbegin;
        this.selectForUpdate(true);

        startline = startline > 0 ? startline : 1;

        this.Log = infolog.cut(startline, infologline());
        
        if(AVAHelperClass::infoCheckError(startline, infologLine(), NoYes::Yes))
        {
            this.Exception  = AVAHelperClass::getAVAException(Exception::Error);
        }
        else if(AVAHelperClass::infoCheckError(startline, infologLine(), NoYes::No, NoYes::Yes))
        {
            this.Exception  = AVAHelperClass::getAVAException(Exception::Warning);
        }
        else
        {
            this.Exception  = AVAHelperClass::getAVAException(Exception::Info);
        }

        //ToDo: this.KBVErrors = NDX_KBVErrorTypes::checkErrorType(startline);
        this.update();
        ttscommit;

        return this.Exception;
    }

]]></Source>
			</Method>
		</Methods>
