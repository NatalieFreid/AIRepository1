			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    static NDXResourcesStatistic find(TransDate _prodDate, NDXCostUnit _nDX_CostUnit, WrkCtrId _wrkCtrId, HcmPersonnelNumberId _perssonelNumber, ResResourceType _resourceType = ResResourceType::Machine, boolean _update = false)
    {
        NDXResourcesStatistic   cursor;
        
        cursor.selectForUpdate(_update);

        select  cursor
            where   cursor.ResourceType == _resourceType
                &&  cursor.ProdDate     == _prodDate
                &&  cursor.Dimension[2] == _nDX_CostUnit
                &&  cursor.WrkCtrId     == _wrkCtrId
                &&  cursor.PersonnelNumber == _perssonelNumber;

        return cursor;
    }

]]></Source>
			</Method>
			<Method>
				<Name>findOrCreate</Name>
				<Source><![CDATA[
    static NDXResourcesStatistic findOrCreate(TransDate _prodDate, NDXCostUnit _nDX_CostUnit, WrkCtrId _wrkCtrId, HcmPersonnelNumberId _perssonelNumber, ResResourceType _resourceType = ResResourceType::Machine, boolean _init = false)
    {
        NDXResourcesStatistic cursor;
        
        cursor = NDXResourcesStatistic::find(_prodDate, _nDX_CostUnit, _wrkCtrId, _perssonelNumber, _resourceType, true);

        if (!cursor)
        {
            ttsbegin;
            cursor.ProdDate     = _prodDate;
            cursor.Dimension[2] = _nDX_CostUnit;
            cursor.WrkCtrId     = _wrkCtrId;
            cursor.PersonnelNumber = _perssonelNumber;
            cursor.ResourceType = _resourceType;
            
            if (cursor.validateWrite())
            {
                cursor.insert();
            }
            ttscommit;
        }

        if (cursor && _init)
        {
            ttsbegin;
            cursor.initValues();
            
            if (cursor.validateWrite())
            {
                cursor.update();
            }
            ttscommit;
        }

        return cursor;
    }

]]></Source>
