    static boolean exist(NDXInventProdRespons _inventProdRespons)
    {
        NDX_InventProdResponsibility    inventProdResponsibility;
        ;

        select firstonly RecId from inventProdResponsibility
            where inventProdResponsibility.NDX_InventProdRespons == _inventProdRespons;

        return inventProdResponsibility.RecId;
