    /// <returns>NDX_InventProdResponsibility</returns>
    static NDX_InventProdResponsibility find(NDXInventProdRespons _inventProdRespons, boolean _forUpdate = false)
    {
        NDX_InventProdResponsibility inventProdResponsibility;
        ;

        if(_inventProdRespons)
        {
            inventProdResponsibility.selectForUpdate(_forUpdate);

            select firstonly inventProdResponsibility
                where inventProdResponsibility.NDX_InventProdRespons == _inventProdRespons;
        }

        return inventProdResponsibility;
    }

]]></Source>
