		<Methods>
			<Method>
				<Name>clearBDE</Name>
				<Source><![CDATA[
    void clearBDE()
    {
        this.FoundInKCS_SFCFeedback = NoYes::No;
        this.SecDisruptionBDE       = 0;
        this.SecProcessingBDE       = 0;
        this.SecSettingsBDE         = 0;
        this.SecWithoutResourceBDE  = 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    static NDXProdTable find(TransDate _prodDate, ProdId _prodId, ResResourceType  _resourceType, boolean _update = false)
    {
        NDXProdTable cursor;
        
        cursor.selectForUpdate(_update);

        select cursor
            where cursor.ResResourceType == _resourceType
                && cursor.ProdDate == _prodDate
                && cursor.ProdId == _prodId;

        return cursor;
    }

]]></Source>
			</Method>
