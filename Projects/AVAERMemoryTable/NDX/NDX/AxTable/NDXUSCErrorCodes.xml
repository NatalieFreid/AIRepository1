		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find first record for provided error code
    /// </summary>
    /// <param name = "_errorCode">int</param>
    /// <param name = "_forUpdate">boolean</param>
    /// <returns>NDXUSCErrorCodes</returns>
    static NDXUSCErrorCodes find(int _errorCode,boolean _forUpdate = false)
    {
        NDXUSCErrorCodes record;
        record.selectForUpdate(_forUpdate);

        if(_errorCode)
        {
            select firstonly record
                index hint ErrorCodeIdx
                where record.ErrorCode == _errorCode;
        }

        return record;
    }

]]></Source>
