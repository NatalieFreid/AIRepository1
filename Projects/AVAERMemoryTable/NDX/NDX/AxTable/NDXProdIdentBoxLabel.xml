				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// PaffH 01.02.23
    /// </summary>
    /// <param name = "_itemIdBox">ItemId</param>
    /// <param name = "_itemIdWithBox">ItemId</param>
    /// <param name = "_update">boolean</param>
    /// <returns>NDXProdIdentBoxLabel</returns>
    static NDXProdIdentBoxLabel find(ItemId _itemIdBox,
                                  ItemId _itemIdWithBox,
                                  boolean _update = false)
    {
        NDXProdIdentBoxLabel nDX_ProdIdentBoxLabel;
        nDX_ProdIdentBoxLabel.selectForUpdate(_update);

        select firstonly nDX_ProdIdentBoxLabel
            where nDX_ProdIdentBoxLabel.InventTableBox == InventTable::find(_itemIdBox).RecId &&
            nDX_ProdIdentBoxLabel.InventTableWithBox == InventTable::find(_itemIdWithBox).RecId;
        return nDX_ProdIdentBoxLabel;
    }

]]></Source>
