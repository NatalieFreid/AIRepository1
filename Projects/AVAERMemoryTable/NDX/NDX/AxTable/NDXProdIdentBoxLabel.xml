    /// <returns>NDXProdIdentBoxLabel</returns>
    static NDXProdIdentBoxLabel findOrCreate(ItemId _itemIdBox,
                                  ItemId _itemIdWithBox,
                                  boolean _doInsert = true)
    {
        NDXProdIdentBoxLabel nDX_ProdIdentBoxLabel;
        RefRecId inventTableBox = InventTable::find(_itemIdBox).RecId;
        RefRecId inventTableWithBox = InventTable::find(_itemIdWithBox).RecId;
        ;
        nDX_ProdIdentBoxLabel = NDXProdIdentBoxLabel::findRecId(inventTableBox, inventTableWithBox, true);
        if (!nDX_ProdIdentBoxLabel)
        {
            nDX_ProdIdentBoxLabel.InventTableBox = inventTableBox;
            nDX_ProdIdentBoxLabel.InventTableWithBox = inventTableWithBox;
            if (_doInsert)
            {
                nDX_ProdIdentBoxLabel.insert();
            }
        }

        return nDX_ProdIdentBoxLabel;
    }

