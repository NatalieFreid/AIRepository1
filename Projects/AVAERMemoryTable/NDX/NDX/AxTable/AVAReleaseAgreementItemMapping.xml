		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// find record for provided release item and agreement item
    /// </summary>
    /// <param name = "_releaseItem">ItemId</param>
    /// <param name = "_agreementItem">ItemId</param>
    /// <param name = "_update">boolean</param>
    /// <returns>AVAReleaseAgreementItemMapping</returns>
    public static AVAReleaseAgreementItemMapping find(ItemId _releaseItem,
        ItemId _agreementItem,
        boolean _update = false)
    {
        AVAReleaseAgreementItemMapping  releaseAgreementItem;

        releaseAgreementItem.selectForUpdate(_update);

        if (_releaseItem
            && _agreementItem)
        {
            select firstonly releaseAgreementItem
                where releaseAgreementItem.ReleaseItem == _releaseItem
                && releaseAgreementItem.AgreementItem == _agreementItem;
        }

        return releaseAgreementItem;
    }

]]></Source>
