				<Source><![CDATA[
    /// <summary>
    /// PaffH 27.11.25
    /// </summary>
    /// <returns>next IdentifierLine</returns>
    public Line nextIdentifierLine()
    {
        return (select firstonly IdentifierLine from NDXBVEMailRequestADA
            order by IdentifierLine desc
            where NDXBVEMailRequestADA.IdentifierGUID == this.IdentifierGUID).IdentifierLine + 1;
    }

