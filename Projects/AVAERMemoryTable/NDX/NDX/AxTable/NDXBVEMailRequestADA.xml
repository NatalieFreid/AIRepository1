				<Source><![CDATA[
    /// <summary>
    /// PaffH 24.10.25
    /// </summary>
    /// <param name = "_recId">RecId</param>
    /// <returns>rec exists</returns>
    public static boolean exists(RecId _recId)
    {
        return _recId > 0 &&
            (select firstonly RecId from NDXBVEMailRequestADA where NDXBVEMailRequestADA.RecId == _recId).RecId > 0;
    }

]]></Source>
