    public void mapEntityToDataSource(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        NDXRequisitionId requisitionId = conPeek(NDXExcelDMFImportParameters::findBySassionId(NDXHelperUserInfo::getCurrentUserSessionId()).Parameters,1);
        
        super(_entityCtx, _dataSourceCtx);

        if (_entityCtx.getDatabaseOperation() == DataEntityDatabaseOperation::Insert || _entityCtx.getDatabaseOperation() == DataEntityDatabaseOperation::Update)
        {
            if (_dataSourceCtx.name() == "NDXRequisitionLine")
            {
                NDXRequisitionLine ndxRequisitionLine = _dataSourceCtx.getBuffer();
                ndxRequisitionLine.Level = NDXRequisitionLine::getMaxLevel(requisitionId);
                ndxRequisitionLine.LevelString = Con2Str([ndxRequisitionLine.Level], '.');
                ndxRequisitionLine.RequisitionId = requisitionId;

                ndxRequisitionLine.modifiedField(fieldNum(NDXRequisitionLine, ItemId));
            }
        }
    }

