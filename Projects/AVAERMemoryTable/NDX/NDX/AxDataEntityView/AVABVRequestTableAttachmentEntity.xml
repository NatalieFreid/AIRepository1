		<Methods>
			<Method>
				<Name>postLoad</Name>
				<Source><![CDATA[
    /// <summary>
    /// N.Freidenberger 14.03.2025
    /// </summary>
    public void postLoad()
    {
        super();

        // Virtual fields are not auto-populated from the base entity, so an extra select is necessary.
        if (this.RecId && this.DocumentId != emptyGuid())
        {

            DocuRefEntity baseEntity;
            select firstonly baseEntity where baseEntity.DocumentId == this.DocumentId;
            this.Attachment = baseEntity.FileContents;
            this.fieldExternallySet(fieldNum(AVABVRequestTableAttachmentEntity, Attachment), false);
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>insertEntityDataSource</Name>
				<Source><![CDATA[
    /// <summary>
    ///  N.Freidenberger 02.04.2025
    /// </summary>
    /// <param name = "_entityCtx">_entityCtx</param>
    /// <param name = "_dataSourceCtx">_dataSourceCtx</param>
    /// <returns>boolean</returns>
    public boolean insertEntityDataSource(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        boolean ret;
        AVADocuRestriction              docuRestriction;
        AVADocuRestrictionReference     docuRestrictionReference;
    
        ret = super(_entityCtx, _dataSourceCtx);
        if (_dataSourceCtx.name() == dataEntityDataSourceStr(AVABVRequestTableAttachmentEntity,DocuRefEntity))
        {
            DocuRefEntity     docuRefEntity = _dataSourceCtx.getBuffer();
            if (docuRefEntity.RecId)
            {
                docuRestriction = AVADocuRestriction::find(this.AVADocuRestriction);  
                if (docuRestriction)
                {
                    select firstonly docuRestrictionReference
                        where docuRestrictionReference.DocuRefRecId == docuRefEntity.RecId ;
                    if (docuRestrictionReference)
                    {
                        docuRestrictionReference.selectForUpdate(true);
                        ttsbegin;
                        docuRestrictionReference.DocuRestrictionNum = docuRestriction.Num;
                        docuRestrictionReference.doUpdate();
                        ttscommit;
                    }
                    else
                    {
                        docuRestrictionReference.DocuRefRecId       = docuRefEntity.RecId;
                        docuRestrictionReference.DocuRestrictionNum = docuRestriction.Num;
                        docuRestrictionReference.insert();
                    }
                }
     
            }
        }
    
        return ret;
    }

]]></Source>
			</Method>
