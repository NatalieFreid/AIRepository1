		<Methods>
			<Method>
				<Name>postLoad</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    public void postLoad()
    {
        super();

        EcoResProduct product = EcoResProduct::findByDisplayProductNumber(this.ProductNumber);
        InventTableModule invent = InventTableModule::find(this.ItemId, ModuleInventPurchSales::Invent);
        InventTableModule purch = InventTableModule::find(this.ItemId, ModuleInventPurchSales::Purch);

        if (product)
        {
            this.ProductSubType = product.productSubtype(); 
        }
        else
        {
            this.ProductSubType = EcoResProductSubtype::Product; 
        }
        if(invent)
        {
            this.HK2Current = invent.dispHK2current();
            this.HK1Current = invent.dispHK1current();
        }
        if(purch)
        {
            this.HK2PriceDisc = purch.NDX_showHK2PriceDisc();
        }
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
