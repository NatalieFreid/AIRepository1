			<Method>
				<Name>avaToggleFields</Name>
				<Source><![CDATA[
    /// <summary>
    /// avaToggleFields
    /// </summary>
    private void avaToggleFields()
    {
        WHSRFMenuItemTable_ds.object(fieldNum(WHSRFMenuItemTable, AVAAllowReportFinishedQtyError)).visible(WHSRFMenuItemTable.avaIsFieldVisibleAllowReportFinishedQtyError());
        WHSRFMenuItemTable_ds.object(fieldNum(WHSRFMenuItemTable, AVANoReportFinishedProposalQty)).visible(WHSRFMenuItemTable.avaIsFieldVisibleNoReportFinishedProposalQty());
        WHSRFMenuItemTable_ds.object(fieldNum(WHSRFMenuItemTable, AVAPreferredInputType)).visible(WHSRFMenuItemTable.avaIsFieldVisiblePreferredInput());
        WHSRFMenuItemTable_ds.object(fieldNum(WHSRFMenuItemTable, AVAWorkFullLockMode)).visible(WHSRFMenuItemTable.avaIsFieldVisibleWorkFullLockMode());
        WHSRFMenuItemTable_ds.object(fieldNum(WHSRFMenuItemTable, AVADisplayWHSWorkTransType)).visible(WHSRFMenuItemTable.avaIsFieldVisibleWHSWorkTransType());
        WHSRFMenuItemTable_ds.object(fieldNum(WHSRFMenuItemTable, AVADisplayWHSOrderNum)).visible(WHSRFMenuItemTable.avaIsFieldVisibleWHSOrderNum());
        WHSRFMenuItemTable_ds.object(fieldNum(WHSRFMenuItemTable, AVAAllowPostAdjustment)).visible(WHSRFMenuItemTable.avaIsFieldVisibleAllowPostAdjustment());

        WHSRFMenuItemTable_ds.object(fieldNum(WHSRFMenuItemTable, AVAAutoConfirmLoad)).visible(WHSRFMenuItemTable.AVAisOutboundSorting());
        WHSRFMenuItemTable_ds.formRun().design().controlName(formControlStr(WHSRFMenuItem, AVAPrinterSetupButtonGroup)).visible(WHSRFMenuItemTable.AVAisOutboundSorting());
        
        WHSRFMenuItemTable_ds.object(fieldNum(WHSRFMenuItemTable, AVAWMSLocationReceivingSO)).visible(WHSRFMenuItemTable.AVAIsWHSreceivingSO());
        WHSRFMenuItemTable_ds.object(fieldNum(WHSRFMenuItemTable, GenerateLP)).visible(!WHSRFMenuItemTable.AVAIsWHSreceivingSO());
        WHSRFMenuItemTable_ds.object(fieldNum(WHSRFMenuItemTable, GS1PolicyName)).visible(!WHSRFMenuItemTable.AVAIsWHSreceivingSO());
        WHSRFMenuItemTable_ds.formRun().design().controlName(formControlStr(WHSRFMenuItem, WHSRFMenuItemTable_ProcessGuideUseFramework)).visible(!WHSRFMenuItemTable.AVAIsWHSreceivingSO());
    }

]]></Source>
