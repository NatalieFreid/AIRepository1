		<Methods>
			<Method>
				<Name>populate</Name>
				<Source><![CDATA[
    public void populate()
    {
        NDXP01A lNDXP01A;
        NDXP01AItemmasterView lNDXP01AItemmasterView;

        delete_from lNDXP01A where lNDXP01A.CSTR == curExt();

        insert_recordset lNDXP01A
            (CSTR, CART, RART, CFAM, CUDMP)
        select
            DataAreaId, ItemId, ItemDescription, ItemGroupId, UnitId
        from lNDXP01AItemmasterView;
    }

]]></Source>
			</Method>
			<Method>
				<Name>getItemDescription</Name>
				<Source><![CDATA[
    public static server str getItemDescription()
    {
        str itemDescription;
        LanguageId languageId = currentUserLanguage();

        str product = SysComputedColumn::returnField(viewStr(NDXP01AItemmasterView), identifierStr(InventTable), fieldStr(InventTable, Product));
        
        itemDescription = strFmt("SELECT TOP 1 concat(EcoResProductTranslation.NDXProductName1," 
            + "' ', EcoResProductTranslation.NDXProductName2) FROM EcoResProductTranslation WHERE EcoResProductTranslation.Product = %1", product);

        return itemDescription;
    }

]]></Source>
			</Method>
