				<Source><![CDATA[
  /// <summary>
  /// designed from AVA
  /// </summary>
    /// <param name = "_branchNum">_branchNum</param>
  /// <returns>str</returns>
    private static server str getCustVendId(int     _branchNum)
    {
        str ret;


        if (_branchNum == 1)
        {
            ret = '\'' + "@NDX:NXAGLNCustId" + '\'';
        }
        else
        {
            ret = '\'' + "@NDX:NXAGLNVendId" + '\'';
        }


        return ret;
    }

]]></Source>
