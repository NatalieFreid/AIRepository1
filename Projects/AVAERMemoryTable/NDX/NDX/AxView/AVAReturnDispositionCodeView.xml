    public static AVAReturnDispositionCodeView find(WHSDispositionCode _whsDispositionCode)
    {
        AVAReturnDispositionCodeView    returnDispositionCodeView;

        if (_whsDispositionCode)
        {

            select firstonly returnDispositionCodeView
                where returnDispositionCodeView.DispositionCode == _whsDispositionCode;
        }

        return returnDispositionCodeView;
    }

