				<Source><![CDATA[
    public void populate()
    {
        NDXC02A lNDXC02A;
        NDXC02AToolmasterView lNDXC02AToolmasterView;

        delete_from lNDXC02A where lNDXC02A.CSTR == curExt();

        insert_recordset lNDXC02A
            (CSTR, CATT, RATT)
        select
            DataAreaId, WrkCtrId, Name
        from lNDXC02AToolmasterView;
    }

]]></Source>
			</Method>
			<Method>
				<Name>internalExternal</Name>
				<Source><![CDATA[
    public static str internalExternal()
    {
        str vendIdField = SysComputedColumn::comparisonField(viewstr(NDXC02AToolmasterView),
                tableStr(WrkCtrTable), fieldStr(WrkCtrTable, VendId));

        return SysComputedColumn::if(SysComputedColumn::equalExpression(vendIdField, SysComputedColumn::comparisonLiteral('')),
            SysComputedColumn::returnint(),
            SysComputedColumn::returnLiteral(0));
    }

]]></Source>
