		<Methods>
			<Method>
				<Name>dispAllianceID</Name>
				<Source><![CDATA[
    [SysClientCacheDataMethodAttribute(true)]
    display AVATOSId dispAllianceID()
    {
        CustAccount masterAccount;
        container masterCon = connull();
        NDXVerband verband = NDXVerband::constructor(this.AccountNum);

        [masterAccount, masterCon] = verband.getMaster(this.AccountNum);

        return masterAccount;
    }

]]></Source>
			</Method>
			<Method>
				<Name>dispTOSName</Name>
				<Source><![CDATA[
    [SysClientCacheDataMethodAttribute(true)]
    display Name dispTOSName()
    {
        KCS_TOSTable lKCS_TOSTable = KCS_TOSTable::find(this.dispAllianceID());
        return lKCS_TOSTable.Description;
    }

]]></Source>
			</Method>
			<Method>
				<Name>populate</Name>
				<Source><![CDATA[
    public void populate()
    {
        NDXO03A lNDXO03A;
        NDXO03ACustomermasterView lNDXO03ACustomermasterView;

        delete_from lNDXO03A where lNDXO03A.CSTR == curExt();

        insert_recordset lNDXO03A
            (CSTR, CCLI, RCLI, CGRP)
        select
            DataAreaId, AccountNum, Name, CompanyChainId
        from lNDXO03ACustomermasterView;
    }

]]></Source>
