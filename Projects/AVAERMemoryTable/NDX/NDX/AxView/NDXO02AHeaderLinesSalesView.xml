				<Name>populate</Name>
				<Source><![CDATA[
    public void populate()
    {
        NDXO02A lNDXO02A;
        NDXO02AHeaderLinesSalesView lNDXO02AHeaderLinesSalesView;

        delete_from lNDXO02A where lNDXO02A.CSTR == curExt();

        insert_recordset lNDXO02A
            (CSTR, CCLIH, CCLIR, CCLI, XRIFCLI, CART, QCORD, DCRICH, DCCONF)
        select
            DataAreaId, SalesId, LineNumStr, CustAccount, PurchOrderFormNum, ItemId, RemainInventPhysical, AVAShippingDateRequested, ShippingDateConfirmed
        from lNDXO02AHeaderLinesSalesView;
        

        update_recordset lNDXO02A
            setting CMAG = 'Versand', FLGSTA = 'OPEN';
    }

]]></Source>
			</Method>
			<Method>
				<Name>castLineNum</Name>
				<Source><![CDATA[
    public static str castLineNum()
    {
        str lineNumField = SysComputedColumn::returnField(viewstr(NDXO02AHeaderLinesSalesView),
                tableStr(SalesLine), fieldStr(SalesLine, LineNum));

        return SysComputedColumn::cast(lineNumField, 'nvarchar(20)');
    }

]]></Source>
