		<Methods>
			<Method>
				<Name>populate</Name>
				<Source><![CDATA[
    public void populate()
    {
        NDXO04A lNDXO04A;
        NDXO04APurchaseOrdersHeaderLinesView lNDXO04APurchaseOrdersHeaderLinesView;

        delete_from lNDXO04A where lNDXO04A.CSTR == curExt();

        insert_recordset lNDXO04A
            (CSTR, CMAG, CACQH, CACQR, CFORN, CART, QAORD, QARIC, DARICH, DACONF)
        select
            DataAreaId, InventSiteId, PurchId, LineNumberStr, VendAccount, ItemId, QtyOrdered, RemainInventPhysical, DeliveryDate, DueDate
        from lNDXO04APurchaseOrdersHeaderLinesView;
        
    }

]]></Source>
			</Method>
			<Method>
				<Name>getDueDate</Name>
				<Source><![CDATA[
    public static str getDueDate()
    {
        str ConfirmedDlvField = SysComputedColumn::comparisonField(viewstr(NDXO04APurchaseOrdersHeaderLinesView), tableStr(PurchLine), fieldStr(PurchLine, ConfirmedDlv));

        str isConfirmedNull = SysComputedColumn::equalExpression(ConfirmedDlvField, SysComputedColumn::comparisonLiteral(dateNull()));
        
        return SysComputedColumn::if(isConfirmedNull,
            SysComputedColumn::returnField(viewstr(NDXO04APurchaseOrdersHeaderLinesView),tableStr(PurchLine), fieldStr(PurchLine, DeliveryDate)),
            SysComputedColumn::returnField(viewstr(NDXO04APurchaseOrdersHeaderLinesView),tableStr(PurchLine), fieldStr(PurchLine, ConfirmedDlv)));
    }

]]></Source>
			</Method>
			<Method>
				<Name>castLineNum</Name>
				<Source><![CDATA[
    public static str castLineNum()
    {
        str lineNumField = SysComputedColumn::returnField(viewstr(NDXO04APurchaseOrdersHeaderLinesView),
                tableStr(PurchLine), fieldStr(PurchLine, LineNumber));

        return SysComputedColumn::cast(lineNumField, 'nvarchar(15)');
    }

]]></Source>
			</Method>
