	<Name>AVAERReportCleanupUIBuilder</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// UI Builder class for AVAER Report Memory Cleanup batch job
/// Customizes the dialog layout and validation
/// </summary>
internal final class AVAERReportCleanupUIBuilder extends SysOperationAutomaticUIBuilder
{
    DialogField                     queryField;
    AVAERReportCleanupContract      dataContract;
    
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>build</Name>
				<Source><![CDATA[
    /// <summary>
    /// Builds the dialog UI
    /// </summary>
    public void build()
    {
        super();
        
        dataContract = this.dataContractObject() as AVAERReportCleanupContract;
        
        if (dataContract)
        {
            // Add custom help text for the query field
            queryField = this.bindInfo().getDialogField(dataContract, 
                                                       methodStr(AVAERReportCleanupContract, parmQuery));
            
            if (queryField)
            {
                queryField.helpText("Select date range for quotations to clean up");
                queryField.label("Quotation Date Range");
            }
        }
    }
]]></Source>
			</Method>
			<Method>
				<Name>getFromDialog</Name>
				<Source><![CDATA[
    /// <summary>
    /// Retrieves values from dialog before execution
    /// </summary>
    public void getFromDialog()
    {
        super();
        
        // Additional validation can be added here
        this.validateDateRange();
    }
]]></Source>
			</Method>
			<Method>
				<Name>validateDateRange</Name>
				<Source><![CDATA[
    /// <summary>
    /// Validates the date range in the query
    /// </summary>
    private void validateDateRange()
    {
        Query                   query;
        QueryBuildDataSource    qbds;
        QueryBuildRange         qbr;
        TransDate              fromDate, toDate;
        
        if (dataContract)
        {
            query = dataContract.parmQuery();
            
            if (query)
            {
                qbds = query.dataSourceNo(1);
                
                if (qbds)
                {
                    qbr = qbds.findRange(fieldNum(CustQuotationTable, QuotationDate));
                    
                    if (qbr && qbr.value() != '')
                    {
                        // Add validation logic for date range if needed
                        // For example, warn if date range is too broad
                        info("Date range specified for AVAER report cleanup");
                    }
                    else
                    {
                        warning("No date range specified - all quotations will be processed");
                    }
                }
            }
        }
    }
]]></Source>
			</Method>
			<Method>
				<Name>postBuild</Name>
				<Source><![CDATA[
    /// <summary>
    /// Post-build setup for additional customizations
    /// </summary>
    public void postBuild()
    {
        super();
        
        // Add any additional customizations after the dialog is built
        if (this.dialog())
        {
            this.dialog().caption("AVAER Report Cleanup");
        }
    }
]]></Source>
			</Method>
