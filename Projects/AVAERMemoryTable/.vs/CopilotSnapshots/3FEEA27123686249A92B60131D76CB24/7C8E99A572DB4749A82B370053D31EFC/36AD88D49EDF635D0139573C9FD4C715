/// <summary>
/// Data contract class for AVAER Report Memory Cleanup batch job
/// </summary>
[DataContractAttribute]
internal final class AVAERReportCleanupContract extends SysOperationDataContractBase
{
    private Query query;
    
    /// <summary>
    /// Gets the query for the cleanup operation
    /// </summary>
    /// <returns>The Query object for CustQuotationTable</returns>
    [DataMemberAttribute]
    public Query getQuery()
    {
        return this.query;
    }

    /// <summary>
    /// Sets the query for the cleanup operation
    /// </summary>
    /// <param name = "_query">The Query object to set</param>
    [DataMemberAttribute]
    public void setQuery(Query _query)
    {
        this.query = _query;
    }

    /// <summary>
    /// Parameter method for the query
    /// </summary>
    /// <param name = "_query">The Query object</param>
    /// <returns>The current or new Query object</returns>
    [DataMemberAttribute, 
     AifQueryTypeAttribute('AVAERReportCleanupQuery')]
    public Query parmQuery(Query _query = this.query)
    {
        this.query = _query;
        return this.query;
    }
}
