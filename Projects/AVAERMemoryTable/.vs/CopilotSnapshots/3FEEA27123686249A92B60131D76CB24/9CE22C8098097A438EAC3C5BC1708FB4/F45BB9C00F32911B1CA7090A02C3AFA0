		<Declaration><![CDATA[
/// <summary>
/// Controller class for AVAER Report Memory Cleanup batch job
/// Manages the execution and UI for the cleanup process
/// </summary>
internal final class AVAERReportCleanupController extends SysOperationServiceController
{
    
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>new</Name>
				<Source><![CDATA[
    /// <summary>
    /// Constructor for the controller
    /// </summary>
    public void new()
    {
        super();
        
        // Set up the service and method to call
        this.parmClassName(classStr(AVAERReportCleanupService));
        this.parmMethodName(methodStr(AVAERReportCleanupService, cleanupReportData));
        
        // Set dialog caption and description
        this.parmDialogCaption("@NDX:AVAERReportCleanupTitle");
        this.parmOperationDescription("@NDX:AVAERReportCleanupDescription");
        
        // Enable batch execution
        this.parmExecutionMode(SysOperationExecutionMode::Batch);
        this.parmLoadFromSysLastValue(false);
        
        // Initialize the query
        this.initializeQuery();
    }
]]></Source>
			</Method>
			<Method>
				<Name>main</Name>
				<Source><![CDATA[
    /// <summary>
    /// Main entry point for the batch job
    /// </summary>
    /// <param name = "_args">Arguments passed to the job</param>
    public static void main(Args _args)
    {
        AVAERReportCleanupController controller;
        
        controller = new AVAERReportCleanupController();
        
        if (controller)
        {
            controller.startOperation();
        }
    }
]]></Source>
			</Method>
			<Method>
				<Name>initializeQuery</Name>
				<Source><![CDATA[
    /// <summary>
    /// Initializes the query from AOT
    /// </summary>
    private void initializeQuery()
    {
        Query                       query;
        QueryRun                    queryRun;
        AVAERReportCleanupContract  contract;
        
        try
        {
            // Load the query from AOT
            query = new Query(queryStr(AVAERReportCleanupQuery));
            
            if (query)
            {
                queryRun = new QueryRun(query);
                
                // Get the data contract and set the query
                contract = this.getDataContractObject() as AVAERReportCleanupContract;
                if (contract)
                {
                    contract.parmQuery(queryRun);
                }
            }
        }
        catch (Exception::Error)
        {
            error("@NDX:AVAERReportCleanupQueryInitError");
        }
    }
]]></Source>
