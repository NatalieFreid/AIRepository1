<?xml version="1.0" encoding="utf-8"?>
<AxQuery xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
	<Name>AVAERReportCleanupQuery</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// Query for AVAER Report Memory Cleanup batch job
/// Selects quotations based on date range for report cleanup operations
/// </summary>
public class AVAERReportCleanupQuery extends QueryRun
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    /// <summary>
    /// Initializes the query with default settings
    /// </summary>
    public void init()
    {
        super();
        
        // Set default date range to last 90 days if no range is specified
        QueryBuildDataSource    qbds;
        QueryBuildRange         qbr;
        
        qbds = this.query().dataSourceTable(tableNum(CustQuotationTable));
        if (qbds)
        {
            qbr = qbds.findRange(fieldNum(CustQuotationTable, QuotationDate));
            if (qbr && qbr.value() == '')
            {
                qbr.value(strFmt('%1..%2', 
                    DateTimeUtil::date(DateTimeUtil::addDays(DateTimeUtil::utcNow(), -90)),
                    today()));
            }
        }
    }
]]></Source>
			</Method>
		</Methods>
	</SourceCode>
	<Label>AVAER Report Cleanup Query</Label>
	<HelpText>Query for selecting customer quotations for AVAER report cleanup based on quotation date range</HelpText>
