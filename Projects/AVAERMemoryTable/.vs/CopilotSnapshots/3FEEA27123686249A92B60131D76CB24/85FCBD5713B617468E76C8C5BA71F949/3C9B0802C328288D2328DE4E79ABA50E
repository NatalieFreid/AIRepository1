<?xml version="1.0" encoding="utf-8"?>
<AxQuery xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
	<Name>AVAERReportCleanupQuery</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// Query for AVAER Report Memory Cleanup batch job
/// Selects customer quotations based on date range for cleanup operations
/// </summary>
public class AVAERReportCleanupQuery extends QueryRun
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    /// <summary>
    /// Initializes the query with default settings and date range validation
    /// </summary>
    public void init()
    {
        QueryBuildDataSource    qbds;
        QueryBuildRange         qbr;
        
        super();
        
        // Get the CustQuotationTable data source
        qbds = this.query().dataSourceTable(tableNum(CustQuotationTable));
        
        if (qbds)
        {
            // Find or create the QuotationDate range
            qbr = qbds.findRange(fieldNum(CustQuotationTable, QuotationDate));
            
            if (!qbr)
            {
                qbr = qbds.addRange(fieldNum(CustQuotationTable, QuotationDate));
            }
            
            // Set default date range if not specified (last 90 days to today)
            if (qbr.value() == '')
            {
                qbr.value(strFmt('%1..%2', 
                    DateTimeUtil::date(DateTimeUtil::addDays(DateTimeUtil::utcNow(), -90)),
                    today()));
            }
        }
    }
]]></Source>
			</Method>
			<Method>
				<Name>validateQueryRun</Name>
				<Source><![CDATA[
    /// <summary>
    /// Validates the query before execution
    /// </summary>
    /// <returns>True if query is valid for execution</returns>
    public boolean validateQueryRun()
    {
        QueryBuildDataSource    qbds;
        QueryBuildRange         qbr;
        boolean                 ret = true;
        
        ret = super();
        
        if (ret)
        {
            qbds = this.query().dataSourceTable(tableNum(CustQuotationTable));
            
            if (qbds)
            {
                qbr = qbds.findRange(fieldNum(CustQuotationTable, QuotationDate));
                
                if (!qbr || qbr.value() == '')
                {
                    warning("No date range specified for quotation cleanup. This may process all quotations.");
                }
            }
        }
        
        return ret;
    }
]]></Source>
			</Method>
		</Methods>
	</SourceCode>
