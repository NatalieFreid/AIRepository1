<?xml version="1.0" encoding="utf-8"?>
<Table Name="AVATestTable" Label="@AVATestTableLabel" Type="Normal" Created="" Modified="">
  <!--
    AVATestTable
    Real AOT Table artifact (export-style .xpp).
    Fields:
      - ItemId: EDT ItemId (string-based)
      - itemName: string (Name/Description)

    NOTE: If you import this into the AOT (or your model), it will create a real table.
    Labels used should exist in the label files or be replaced with literal text.
  -->

  <Fields>
    <Field Name="ItemId">
      <Property Name="ExtendedDataType">ItemId</Property>
      <Property Name="Label">@AVATestTable_ItemId</Property>
      <Property Name="StringSize">20</Property>
      <Property Name="Mandatory">No</Property>
    </Field>

    <Field Name="itemName">
      <Property Name="ExtendedDataType">Name</Property>
      <Property Name="Label">@AVATestTable_ItemName</Property>
      <Property Name="StringSize">100</Property>
      <Property Name="Mandatory">No</Property>
    </Field>
  </Fields>

  <Indexes>
    <Index Name="Idx_Primary">
      <Property Name="Unique">Yes</Property>
      <IndexFields>
        <IndexField Name="ItemId">
          <Property Name="Ascending">Yes</Property>
        </IndexField>
      </IndexFields>
    </Index>
  </Indexes>

  <Relations />

  <Methods />
</Table>