    private void foreignKeyPropagation_DS1(DataEntityRuntimeContext _entityCtx, ForecastSales _forecastSales)
    {
        ProjFundingSource fundingSource_ = _entityCtx.getRuntimeContextByName('FundingSource').getBuffer();
        // FK propagation of references to an optional read-only PK data source will be done if
        //   1. conflict detection has been invoked against the PK data source, or
        //   2. the PK data source buffer is not null.
        if(_entityCtx.getRuntimeContextByName('FundingSource').conflictDetectionInvoked() || fundingSource_)
        {
            // do not set foreign key values if they are same to make sure validation is not fired unless value changed
            if(_forecastSales.ProjFundingSource != fundingSource_.RecId)
            {
                _forecastSales.ProjFundingSource = fundingSource_.RecId;
            }
        }
        
        InventDim inventDim_ = _entityCtx.getRuntimeContextByName('InventDim').getBuffer();
        // FK propagation of references to an optional read-only PK data source will be done if
        //   1. conflict detection has been invoked against the PK data source, or
        //   2. the PK data source buffer is not null.
        if(_entityCtx.getRuntimeContextByName('InventDim').conflictDetectionInvoked() || inventDim_)
        {
            // do not set foreign key values if they are same to make sure validation is not fired unless value changed
            if(_forecastSales.InventDimId != inventDim_.inventDimId)
            {
                _forecastSales.InventDimId = inventDim_.inventDimId;
            }
        }
        
        // foreign key value validation
        boolean validationFailed = false;
        DataEntityDatabaseOperation dataSourceDBOperation = _entityCtx.getRuntimeContextByName('ForecastSales').getDatabaseOperation();
        ProjForecastSalesEntity dataEntityRecord = _entityCtx.getEntityRecord();
        
        if(!dataEntityRecord.skipDataSourceValidateField(fieldnum(ProjForecastSalesEntity, ProjectFundingSource)))
        {
            if(!this.validateDataSourceField(dataSourceDBOperation, 'ForecastSales.ProjFundingSource', _forecastSales, fieldnum(ForecastSales, ProjFundingSource), false/*disallowEditOnCreate*/, false/*disallowEdit*/, false/*callValidateField*/, 1))
            {
                validationFailed = true;
            }
        }
        
        if(!dataEntityRecord.skipDataSourceValidateField(fieldnum(ProjForecastSalesEntity, InventDimensionId)))
        {
            if(!this.validateDataSourceField(dataSourceDBOperation, 'ForecastSales.InventDimId', _forecastSales, fieldnum(ForecastSales, InventDimId), false/*disallowEditOnCreate*/, false/*disallowEdit*/, false/*callValidateField*/, 1))
            {
                validationFailed = true;
            }
        }
        
        if(validationFailed)
        {
            throw Exception::ViewDataSourceValidation;
        }
    }
    protected boolean saveDataSources(DataEntityRuntimeContext _entityCtx)
    {
        boolean rtrn = true;
        DataEntityDataSourceRuntimeContext _dataSourceCtx = null;
        // save data sources in topological order.
        {
            // save/update data sources referenced by [ForecastSales].
            {
                // handle datasources which are part of extensions and need to be saved before [FundingSource]
                if(!this.preSaveDataSource(_entityCtx, 'FundingSource'))
                {
                    return false;
                }
                _dataSourceCtx = _entityCtx.getRuntimeContextByName('FundingSource');
                // propagates foreign key values from referenced data sources which are part of extensions.
                this.foreignKeyPropagationExtensions(_entityCtx, _dataSourceCtx);
                if(this.isAnyFieldSet_DS2(_dataSourceCtx.getBuffer(),_dataSourceCtx,_entityCtx))
                {
                    // invoke conflict detection for read-only data source.
                    ProjFundingSource resolvedRecord = this.detectConflictForDataSource(_entityCtx, _dataSourceCtx);
                    if(!resolvedRecord)
                    {
                        ProjFundingSource fundingSource_ = _dataSourceCtx.getBuffer();
                        if((fundingSource_.ContractId || fundingSource_.FundingSourceId))
                        {
                            container dataSourceKeys = ["ContractId", "FundingSourceId"];
                            container resolvedRecordValues = [resolvedRecord.ContractId, resolvedRecord.FundingSourceId];
                            container dataSourceConflictingValues = [fundingSource_.ContractId, fundingSource_.FundingSourceId];
                            str errorMessage = "";
                            for(int i = 1; i <= conLen(dataSourceKeys); i++)
                            {
                                if(conPeek(dataSourceConflictingValues, i))
                                {
                                    errorMessage += strfmt("'%1': %2, ", conPeek(dataSourceKeys, i), conPeek(resolvedRecordValues, i));
                                }
                            }
                            errorMessage = strDel(errorMessage, strLen(errorMessage) - 1, 2);
                            checkFailed(strfmt("@ApplicationPlatform:DataEntityReadonlyDataSourceNotFoundWithKey", _dataSourceCtx.name(), errorMessage));
                            throw Exception::ViewDataSourceValidation;
                        }
                    }
                    // marks the read-only data source as 'saved' and skips actual insert/update operation.
                    _dataSourceCtx.setDataSaved(true);
                }
                // in case of update marks the read-only data source as 'saved' and skips actual insert/update operation.
                else if(_dataSourceCtx.getDatabaseOperation() == DataEntityDatabaseOperation::Update)
                {
                    _dataSourceCtx.setDataSaved(true);
                }
                _dataSourceCtx.setDatabaseOperation(DataEntityDatabaseOperation::None);
                // inserts/updates data source [FundingSource].
                this.saveDataSource(_entityCtx, _dataSourceCtx);
                this.postSaveDataSource();
            }
            {
                // handle datasources which are part of extensions and need to be saved before [InventDim]
                if(!this.preSaveDataSource(_entityCtx, 'InventDim'))
                {
                    return false;
                }
                _dataSourceCtx = _entityCtx.getRuntimeContextByName('InventDim');
                // propagates foreign key values from referenced data sources which are part of extensions.
                this.foreignKeyPropagationExtensions(_entityCtx, _dataSourceCtx);
                if(this.isAnyFieldSet_DS4(_dataSourceCtx.getBuffer(),_dataSourceCtx,_entityCtx))
                {
                    // invoke conflict detection for read-only data source.
                    InventDim resolvedRecord = this.detectConflictForDataSource(_entityCtx, _dataSourceCtx);
                    if(!resolvedRecord)
                    {
                        InventDim inventDim_ = _dataSourceCtx.getBuffer();
                        if((inventDim_.inventDimId) || (inventDim_.SHA1HashHex))
                        {
                            container dataSourceKeys = ["inventDimId", "SHA1HashHex"];
                            container resolvedRecordValues = [resolvedRecord.inventDimId, resolvedRecord.SHA1HashHex];
                            container dataSourceConflictingValues = [inventDim_.inventDimId, inventDim_.SHA1HashHex];
                            str errorMessage = "";
                            for(int i = 1; i <= conLen(dataSourceKeys); i++)
                            {
                                if(conPeek(dataSourceConflictingValues, i))
                                {
                                    errorMessage += strfmt("'%1': %2, ", conPeek(dataSourceKeys, i), conPeek(resolvedRecordValues, i));
                                }
                            }
                            errorMessage = strDel(errorMessage, strLen(errorMessage) - 1, 2);
                            checkFailed(strfmt("@ApplicationPlatform:DataEntityReadonlyDataSourceNotFoundWithKey", _dataSourceCtx.name(), errorMessage));
                            throw Exception::ViewDataSourceValidation;
                        }
                    }
                    // marks the read-only data source as 'saved' and skips actual insert/update operation.
                    _dataSourceCtx.setDataSaved(true);
                }
                // in case of update marks the read-only data source as 'saved' and skips actual insert/update operation.
                else if(_dataSourceCtx.getDatabaseOperation() == DataEntityDatabaseOperation::Update)
                {
                    _dataSourceCtx.setDataSaved(true);
                }
                _dataSourceCtx.setDatabaseOperation(DataEntityDatabaseOperation::None);
                // inserts/updates data source [InventDim].
                this.saveDataSource(_entityCtx, _dataSourceCtx);
                this.postSaveDataSource();
            }
            // handle datasources which are part of extensions and need to be saved before [ForecastSales]
            if(!this.preSaveDataSource(_entityCtx, 'ForecastSales'))
            {
                return false;
            }
            _dataSourceCtx = _entityCtx.getRuntimeContextByName('ForecastSales');
            // propagates foreign key values from referenced data sources which are part of extensions.
            this.foreignKeyPropagationExtensions(_entityCtx, _dataSourceCtx);
            // propagates foreign key values from referenced data sources.
            this.foreignKeyPropagation_DS1(_entityCtx, _dataSourceCtx.getBuffer());
            // inserts/updates data source [ForecastSales].
            if(!this.saveDataSource(_entityCtx, _dataSourceCtx))
            {
                // returns from here if the root data source fails to be saved.
                return false;
            }
            this.postSaveDataSource();
        }
        // handle datasources which are part of extensions and need to be saved in last 
        this.preSaveDataSource(_entityCtx, '');
        return rtrn;
    }
    protected boolean deleteDataSources(DataEntityRuntimeContext _entityCtx)
    {
        boolean rtrn = true;
        DataEntityDataSourceRuntimeContext _dataSourceCtx = null;
        // delete data sources in reverse topological order.
        {
            // handle datasources which are part of extensions and need to be saved before [ForecastSales]
            if(!this.preSaveDataSource(_entityCtx, 'ForecastSales'))
            {
                return false;
            }
            _dataSourceCtx = _entityCtx.getRuntimeContextByName('ForecastSales');
            // deletes data source [ForecastSales].
            if(!this.saveDataSource(_entityCtx, _dataSourceCtx))
            {
                // returns from here if the root data source fails to be saved.
                return false;
            }
            this.postSaveDataSource();
            // deletes data sources referenced by [ForecastSales].
            {
                // handle datasources which are part of extensions and need to be saved before [FundingSource]
                if(!this.preSaveDataSource(_entityCtx, 'FundingSource'))
                {
                    return false;
                }
                _dataSourceCtx = _entityCtx.getRuntimeContextByName('FundingSource');
                // skips delete operation against read-only data source.
                // marks the read-only data source as 'saved' and skips actual delete operation.
                _dataSourceCtx.setDataSaved(true);
                _dataSourceCtx.setDatabaseOperation(DataEntityDatabaseOperation::None);
                // deletes data source [FundingSource].
                this.saveDataSource(_entityCtx, _dataSourceCtx);
                this.postSaveDataSource();
            }
            {
                // handle datasources which are part of extensions and need to be saved before [InventDim]
                if(!this.preSaveDataSource(_entityCtx, 'InventDim'))
                {
                    return false;
                }
                _dataSourceCtx = _entityCtx.getRuntimeContextByName('InventDim');
                // skips delete operation against read-only data source.
                // marks the read-only data source as 'saved' and skips actual delete operation.
                _dataSourceCtx.setDataSaved(true);
                _dataSourceCtx.setDatabaseOperation(DataEntityDatabaseOperation::None);
                // deletes data source [InventDim].
                this.saveDataSource(_entityCtx, _dataSourceCtx);
                this.postSaveDataSource();
            }
        }
        // handle datasources which are part of extensions and need to be saved in last 
        this.preSaveDataSource(_entityCtx, '');
        return rtrn;
    }
