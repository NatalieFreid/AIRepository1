    protected void mapEntityToDataSources(DataEntityRuntimeContext _entityCtx)
    {
        this.validateFieldFailed = false;
        this.mapEntityToDataSource(_entityCtx, _entityCtx.getRuntimeContextByName('ForecastSales'));
        this.mapEntityToDataSource(_entityCtx, _entityCtx.getRuntimeContextByName('FundingSource'));
        this.mapEntityToDataSource(_entityCtx, _entityCtx.getRuntimeContextByName('InventDim'));
        this.mapEntityToDataSourcesExtensions(_entityCtx);
        if(this.validateFieldFailed)
        {
            throw Exception::ViewDataSourceValidation;
        }
    }
    private boolean isAnyFieldSet_DS2(ProjFundingSource _fundingSource, DataEntityDataSourceRuntimeContext _dataSourceCtx, DataEntityRuntimeContext _entityCtx)
    {
        boolean rtrn = false;
        if(_fundingSource.isFieldSet(fieldnum(ProjFundingSource,FundingSourceId)))
        {
            return true;
        }
        if(_fundingSource.isFieldSet(fieldnum(ProjFundingSource,ContractId)))
        {
            return true;
        }
        rtrn = this.isAnyFieldSet_Extensions(_entityCtx, _dataSourceCtx, _fundingSource) ? true : false;
        return rtrn;
    }
