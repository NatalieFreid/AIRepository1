    private void mapToDataSource_DS2(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx, ProjFundingSource _fundingSource, ProjForecastSalesEntity _projForecastSalesEntity)
    {
        if(isConfigurationKeyEnabled(configurationKeyName2Id('Project')))
        {
            this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _projForecastSalesEntity, fieldnum(ProjForecastSalesEntity, FundingSourceID), _fundingSource, fieldnum(ProjFundingSource, FundingSourceId), 1);
            this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _projForecastSalesEntity, fieldnum(ProjForecastSalesEntity, ProjectContractID), _fundingSource, fieldnum(ProjFundingSource, ContractId), 1);
            
            this.mapToDataSourceExtensions(_dataSourceCtx, _fundingSource, _projForecastSalesEntity);
            _fundingSource.trackFieldExternallySet(false);
        }
    }
    private void mapToDataSource_DS4(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx, InventDim _inventDim, ProjForecastSalesEntity _projForecastSalesEntity)
    {
        if(isConfigurationKeyEnabled(configurationKeyName2Id('LedgerBasic')))
        {
            this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _projForecastSalesEntity, fieldnum(ProjForecastSalesEntity, ProductColorId), _inventDim, fieldnum(InventDim, InventColorId), 1);
            this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _projForecastSalesEntity, fieldnum(ProjForecastSalesEntity, ProductConfigurationId), _inventDim, fieldnum(InventDim, configId), 1);
            this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _projForecastSalesEntity, fieldnum(ProjForecastSalesEntity, ProductSizeId), _inventDim, fieldnum(InventDim, InventSizeId), 1);
            this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _projForecastSalesEntity, fieldnum(ProjForecastSalesEntity, ProductStyleId), _inventDim, fieldnum(InventDim, InventStyleId), 1);
            this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _projForecastSalesEntity, fieldnum(ProjForecastSalesEntity, ProductVersionId), _inventDim, fieldnum(InventDim, InventVersionId), 1);
            this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _projForecastSalesEntity, fieldnum(ProjForecastSalesEntity, StorageSiteId), _inventDim, fieldnum(InventDim, InventSiteId), 1);
            this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _projForecastSalesEntity, fieldnum(ProjForecastSalesEntity, StorageWarehouseId), _inventDim, fieldnum(InventDim, InventLocationId), 1);
            this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _projForecastSalesEntity, fieldnum(ProjForecastSalesEntity, StorageLocationId), _inventDim, fieldnum(InventDim, wMSLocationId), 1);
            
            this.mapToDataSourceExtensions(_dataSourceCtx, _inventDim, _projForecastSalesEntity);
            _inventDim.trackFieldExternallySet(false);
        }
    }
    protected void doMapEntityToDataSource(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        switch(_dataSourceCtx.id())
        {
            case #ForecastSales_ID:
                this.mapToDataSource_DS1(_entityCtx, _dataSourceCtx, _dataSourceCtx.getBuffer(), _entityCtx.getEntityRecord());
                break;
            case #FundingSource_ID:
