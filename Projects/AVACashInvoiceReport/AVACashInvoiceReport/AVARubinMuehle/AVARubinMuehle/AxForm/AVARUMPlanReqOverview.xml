				<Source><![CDATA[
[Form]
public class AVARUMPlanReqOverview extends FormRun
{
    ItemId                  selItemId;
    AVARUMPeriodType        selPeriodType;
    TransDate               selFromDate, selToDate;
    ParmId                  parmId;
    ForecastModelHeadId     selModelSales, selModelPurch;
    #define.AVADIALOGVALUES('AVADialogValues')

}
]]></Source>
			</Method>
			<Method>
				<Name>changeSelection</Name>
				<Source><![CDATA[
    /// <summary>
    /// show selection dialog and call calcualtion
    /// </summary>
    public void changeSelection()
    {
        Dialog dialog=new Dialog();

        DialogField dfItemID=dialog.addFieldValue(extendedTypeStr(ItemId), selItemId),
            dfPeriodType=dialog.addFieldValue(enumStr(AVARUMPeriodType), selPeriodType),
            dfFromDate=dialog.addFieldValue(extendedTypeStr(TransDate), selFromDate, "@SPS1885"),
            dfToDate=dialog.addFieldValue(extendedTypeStr(TransDate), selToDate, "@DataExpansionTool:FieldLabel_MainForm_6"),
            dfModelSales=dialog.addFieldValue(extendedTypeStr(ForecastModelHeadId), selModelSales, "@AVARUM:AVAModelSales"),
            dfModelPurch=dialog.addFieldValue(extendedTypeStr(ForecastModelHeadId), selModelPurch, "@AVARUM:AVAModelPurch");

        if (dialog.run())
        {
            selItemId=dfItemID.value();
            selPeriodType=dfPeriodType.value();
            selFromDate=dfFromDate.value();
            selToDate=dfToDate.value();
            selModelSales=dfModelSales.value();
            selModelPurch=dfModelPurch.value();


            AVARUMPlanReqRawMaterialCal obj=AVARUMPlanReqRawMaterialCal::construct(selItemId, selPeriodType, selFromDate, selToDate, selModelSales, selModelPurch);
            obj.run();

            CtrlSelItemId.text(selItemId);
            CtrlSelKummulate.selection(enum2int(selPeriodType));
            CtrlSelDateFrom.dateValue(selFromDate);
            CtrlSelDateTo.dateValue(selToDate);
            CtrlSelModelPurch.text(selModelPurch);
            CtrlSelModelSales.text(selModelSales);

            QueryBuildDataSource  qbds=AVARUMPlanReqTrans_ds.query().dataSourceTable(tableNum(AVARUMPlanReqTrans));
            SysQuery::findOrCreateRange(qbds, fieldNum(AVARUMPlanReqTrans, TransDate)).value(Sysquery::range(DatetimeUtil::getSystemDate(DatetimeUtil::getUserPreferredTimeZone()), dateNull()));

            AVARUMPlanReqTrans_ds.executeQuery();            


            this.dialogValuesPack();
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>run</Name>
				<Source><![CDATA[
    /// <summary>
    /// initiale base form settings
    /// </summary>
    public void run()
    {        
        super();

        AVARUMPlanReqRawMaterialCal::cleanup(parmId);
        // align querys/gids
        QueryBuildDataSource  qbds=AVARUMPlanReqTrans_ds.query().dataSourceTable(tableNum(AVARUMPlanReqTrans));
        SysQuery::findOrCreateRange(qbds, fieldNum(AVARUMPlanReqTrans, ParmId)).value(parmId);

        qbds=AVARUMPlanReqTransCovIssue_ds.query().dataSourceTable(tableNum(AVARUMPlanReqTransCov));
        SysQuery::findOrCreateRange(qbds, fieldNum(AVARUMPlanReqTransCov, CustAccount)).value('!""');

        qbds=AVARUMPlanReqTransCovReceipt_ds.query().dataSourceTable(tableNum(AVARUMPlanReqTransCov));
        SysQuery::findOrCreateRange(qbds, fieldNum(AVARUMPlanReqTransCov, VendAccount)).value('!""');

        AVARUMPlanReqTrans_ds.executeQuery();

    }

]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    /// <summary>
    /// initiale base form settings
    /// </summary>
    public void init()
    {
        this.form().design().showNewButton(false);
        this.form().design().showDeleteButton(false);

        parmId=curUserId();
        super();

        this.dialogValuesUnpack();        

    }

]]></Source>
			</Method>
			<Method>
				<Name>dialogValuesUnpack</Name>
				<Source><![CDATA[
    private void dialogValuesUnpack()
    {
        container lastValues = xSysLastValue::getValue(curext(), curuserid(), UtilElementType::Form, formstr(AVARUMPlanReqOverview), #AVADIALOGVALUES);
        if (lastValues)
        {
            [selItemId, selPeriodType,selFromDate, selToDate, selModelSales, selModelPurch]=lastValues;
        }
        else
        {
            selPeriodType=AVARUMPeriodType::Month;
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>dialogValuesPack</Name>
				<Source><![CDATA[
    private void dialogValuesPack()
    {
        container values=[selItemId, selPeriodType,selFromDate, selToDate, selModelSales, selModelPurch];
        xSysLastValue::putValue(values, curext(), curuserid(), UtilElementType::Form, formstr(AVARUMPlanReqOverview), #AVADIALOGVALUES);
    }

]]></Source>
