<?xml version="1.0" encoding="utf-8"?>
<AxClass xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
	<Name>AVARUMCashInvoiceContract</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// Data contract class for AVARUMCashInvoice report
/// </summary>
[
    DataContractAttribute,
    SysOperationContractProcessingAttribute(classstr(AVARUMCashInvoiceUIBuilder))
]
public class AVARUMCashInvoiceContract
{
    AVARUMCashVoucher cashVoucher;
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>parmAVARUMCashVoucher</Name>
				<Source><![CDATA[
    /// <summary>
    /// Gets or sets the cash voucher number
    /// </summary>
    /// <param name="_cashVoucher">Cash voucher number</param>
    /// <returns>Cash voucher number</returns>
    [
        DataMemberAttribute,
        SysOperationLabelAttribute(literalStr("@AVARUM:CashVoucher")),
        SysOperationHelpTextAttribute(literalStr("@AVARUM:CashVoucherHelp"))
    ]
    public AVARUMCashVoucher parmAVARUMCashVoucher(AVARUMCashVoucher _cashVoucher = cashVoucher)
    {
        cashVoucher = _cashVoucher;
        return cashVoucher;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validate</Name>
				<Source><![CDATA[
    /// <summary>
    /// Validates the contract
    /// </summary>
    /// <returns>true if valid; otherwise, false</returns>
    public boolean validate()
    {
        boolean ret = true;
        
        if (!cashVoucher)
        {
            ret = checkFailed(strFmt("@SYS84753", literalStr("@AVARUM:CashVoucher")));
        }
        
        return ret;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
</AxClass>
