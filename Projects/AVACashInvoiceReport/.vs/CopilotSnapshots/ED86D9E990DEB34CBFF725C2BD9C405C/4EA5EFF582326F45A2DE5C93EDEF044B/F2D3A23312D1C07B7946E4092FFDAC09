<?xml version="1.0" encoding="utf-8"?>
<AxClass xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
	<Name>AVARUMCashInvoiceUIBuilder</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// UI Builder class for AVARUMCashInvoice report dialog
/// </summary>
public class AVARUMCashInvoiceUIBuilder extends SrsReportDataContractUIBuilder
{
    AVARUMCashInvoiceContract contract;
    DialogField dialogCashVoucher;
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>build</Name>
				<Source><![CDATA[
    /// <summary>
    /// Builds the dialog
    /// </summary>
    public void build()
    {
        super();
        
        contract = this.dataContractObject() as AVARUMCashInvoiceContract;
        
        dialogCashVoucher = this.bindInfo().getDialogField(
            contract,
            methodStr(AVARUMCashInvoiceContract, parmAVARUMCashVoucher)
        );
    }

]]></Source>
			</Method>
			<Method>
				<Name>postBuild</Name>
				<Source><![CDATA[
    /// <summary>
    /// Post build operations - register lookup
    /// </summary>
    public void postBuild()
    {
        super();
        
        if (dialogCashVoucher && dialogCashVoucher.control())
        {
            FormStringControl voucherControl = dialogCashVoucher.control() as FormStringControl;
            if (voucherControl)
            {
                voucherControl.registerOverrideMethod(
                    methodStr(FormStringControl, lookup),
                    methodStr(AVARUMCashInvoiceUIBuilder, lookupAVARUMCashVoucher),
                    this
                );
            }
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>lookupAVARUMCashVoucher</Name>
				<Source><![CDATA[
    /// <summary>
    /// Provides lookup for cash voucher field
    /// </summary>
    /// <param name="_control">Form control</param>
    private void lookupAVARUMCashVoucher(FormStringControl _control)
    {
        SysTableLookup sysTableLookup;
        Query query;
        QueryBuildDataSource qbds;
        
        sysTableLookup = SysTableLookup::newParameters(tableNum(AVARUMCashSalesCashVoucher), _control);
        
        // Add voucher field
        sysTableLookup.addLookupField(fieldNum(AVARUMCashSalesCashVoucher, CashVoucher), true);
        
        // Add additional display fields
        sysTableLookup.addLookupField(fieldNum(AVARUMCashSalesCashVoucher, CashSalesDeskId));
        sysTableLookup.addLookupField(fieldNum(AVARUMCashSalesCashVoucher, NetAmount));
        sysTableLookup.addLookupField(fieldNum(AVARUMCashSalesCashVoucher, GrossAmount));
        
        // Create query
        query = new Query();
        qbds = query.addDataSource(tableNum(AVARUMCashSalesCashVoucher));
        qbds.addSortField(fieldNum(AVARUMCashSalesCashVoucher, CashVoucher), SortOrder::Descending);
        
        sysTableLookup.parmQuery(query);
        sysTableLookup.performFormLookup();
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
</AxClass>
