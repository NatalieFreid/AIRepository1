### Scenario 3: Conditional Pre-filling

Only pre-fill if certain conditions are met:

```xpp
protected void prePromptModifyContract()
{
    AVARUMCashInvoiceContract contract;
    
    super();
    
    contract = this.parmReportContract().parmRdpContract() 
               as AVARUMCashInvoiceContract;
    
    if (this.parmArgs() && this.parmArgs().record())
    {
        if (this.parmArgs().dataset() == tableNum(AVARUMCashSalesCashVoucher))
        {
            AVARUMCashSalesCashVoucher cashVoucher = this.parmArgs().record();
            
            // Only pre-fill if voucher is closed
            if (cashVoucher.Status == CashVoucherStatus::Closed)
            {
                contract.parmAVARUMCashVoucher(cashVoucher.CashVoucher);
            }
            else
            {
                warning("Only closed vouchers can be printed.");
            }
        }
    }
}
```

