## 🔧 Implementation Details

### 1. Controller Class Structure

**File**: `AVARubinMuehle/AxClass/AVARUMCashInvoiceController.xml`

```xpp
[SRSReportParameterAttribute(classStr(AVARUMCashInvoiceContract))]
internal final class AVARUMCashInvoiceController extends SrsReportRunController
{
    // Method 1: Pre-fill voucher from Args
    protected void prePromptModifyContract()
    {
        AVARUMCashInvoiceContract contract;
        
        super();
        
        contract = this.parmReportContract().parmRdpContract() 
                   as AVARUMCashInvoiceContract;
        
        if (this.parmArgs() && this.parmArgs().record())
        {
            if (this.parmArgs().dataset() == tableNum(AVARUMCashSalesCashVoucher))
            {
                AVARUMCashSalesCashVoucher cashVoucher = this.parmArgs().record();
                contract.parmAVARUMCashVoucher(cashVoucher.CashVoucher);
            }
        }
    }
    
    // Method 2: Entry point
    public static void main(Args _args)
    {
        AVARUMCashInvoiceController controller = new AVARUMCashInvoiceController();
        
        controller.parmReportName(ssrsReportStr(AVARUMCashInvoice, Report));
        controller.parmArgs(_args);
        controller.parmShowDialog(true);
        controller.startOperation();
    }
}
```

