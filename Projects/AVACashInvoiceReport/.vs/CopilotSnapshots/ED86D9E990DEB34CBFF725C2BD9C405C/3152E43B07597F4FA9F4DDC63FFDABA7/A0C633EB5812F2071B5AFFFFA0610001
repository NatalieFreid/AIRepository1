	<Name>AVARUMCashInvoiceController</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// Controller class for AVARUMCashInvoice report
/// Handles pre-filling the cash voucher parameter when called from a form
/// </summary>
[SRSReportParameterAttribute(classStr(AVARUMCashInvoiceContract))]
internal final class AVARUMCashInvoiceController extends SrsReportRunController
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>prePromptModifyContract</Name>
				<Source><![CDATA[
    /// <summary>
    /// Pre-prompt contract modification to pre-fill voucher from calling form
    /// Supports both AVARUMCashSalesCashVoucher and AVARUMCashSalesDesk tables
    /// </summary>
    protected void prePromptModifyContract()
    {
        AVARUMCashInvoiceContract contract;
        AVARUMCashSalesCashVoucher cashSalesVoucher;
        AVARUMCashSalesDesk cashSalesDesk;
        
        super();
        
        // Get the contract from the data provider
        contract = this.parmReportContract().parmRdpContract() as AVARUMCashInvoiceContract;
        
        // Check if Args contains a record
        if (this.parmArgs() && this.parmArgs().record())
        {
            // Check if the calling form's datasource is AVARUMCashSalesCashVoucher
            if (this.parmArgs().dataset() == tableNum(AVARUMCashSalesCashVoucher))
            {
                cashSalesVoucher = this.parmArgs().record();
                
                // Pre-fill the voucher parameter using conditional pattern
                contract.parmAVARUMCashVoucher(
                    cashSalesVoucher.RecId ? cashSalesVoucher.CashVoucher : ''
                );
            }
            // Check if the calling form's datasource is AVARUMCashSalesDesk
            else if (this.parmArgs().dataset() == tableNum(AVARUMCashSalesDesk))
            {
                cashSalesDesk = this.parmArgs().record();
                
                // Pre-fill the voucher parameter from cash desk
                contract.parmAVARUMCashVoucher(
                    cashSalesDesk.RecId ? cashSalesDesk.CashVoucher : ''
                );
            }
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>main</Name>
				<Source><![CDATA[
    /// <summary>
    /// Main entry point for the cash invoice report controller
    /// </summary>
    /// <param name="_args">Arguments passed from the calling context</param>
    public static void main(Args _args)
    {
        AVARUMCashInvoiceController controller = new AVARUMCashInvoiceController();
        
        // Set the report name and design
        controller.parmReportName(ssrsReportStr(AVARUMCashInvoice, Report));
        
        // Pass the arguments from the calling form
        controller.parmArgs(_args);
        
        // Show the dialog to allow user to modify parameters
        controller.parmShowDialog(true);
        
        // Start the report operation
        controller.startOperation();
    }

]]></Source>
