    /// <returns>
    /// The found AVARUMDSDParameters record, or null if not found.
    /// </returns>
    public static AVARUMDSDParameters findRecId(recId _recId)
    {
        AVARUMDSDParameters parameter;

        if (_recId)
        {
            parameter = AVARUMDSDParameters::find();
        }

        return parameter;
    }

]]></Source>
