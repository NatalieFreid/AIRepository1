    {
        super(_entityCtx, _dataSourceCtx);
        
        Common buffer=_dataSourceCtx.getBuffer();
        if (buffer is AVARUMPalletLabels)
        {
            AVARUMPalletLabels locAVARUMPalletLabels=buffer;
            if (!locAVARUMPalletLabels.DistinctProductVariant)
            {   // auto fill
                InventDim locInventDim;
                locInventDim.clear();
                locInventDim.configId=locAVARUMPalletLabels.ConfigId;
                InventDimCombination locInventDimCombination=InventDimCombination::findByInventDim(locAVARUMPalletLabels.ItemId, locInventDim);

                locAVARUMPalletLabels.DistinctProductVariant=locInventDimCombination.DistinctProductVariant;
            }
        }
    }

]]></Source>
