/// </summary>
public class AVARUMWeighingLetterController extends SrsReportRunController
{
}
]]></Declaration>
    <Methods>
      <Method>
        <Name>main</Name>
        <Source><![CDATA[
    /// <summary>
    /// Entry point for the report.
    /// </summary>
    /// <param name="_args">Arguments passed to the report.</param>
    public static void main(Args _args)
    {
        AVARUMWeighingLetterController controller = new AVARUMWeighingLetterController();
        
        controller.parmReportName(ssrsReportStr(AVARUMWeighingLetter, AVARUMWeighingLetterBlankPaper));
        controller.parmArgs(_args);
        controller.startOperation();
    }

]]></Source>
      </Method>
      <Method>
        <Name>preRunModifyContract</Name>
        <Source><![CDATA[
    /// <summary>
    /// Modifies the contract before running the report.
    /// </summary>
    /// <returns>True if successful.</returns>
    protected boolean preRunModifyContract()
    {
        AVARUMWeighingLetterContract    contract = this.parmReportContract().parmRdpContract() as AVARUMWeighingLetterContract;
        RUMWeighingParameters           weighingParameters;
        RUMWeighingType                 weighingType;
        Common                          callerRecord;
        
        boolean ret = super();
        
        if (!contract)
        {
            return ret;
        }
        
        weighingParameters = RUMWeighingParameters::find();
        
        // Get weighing type from args
        weighingType = this.parmArgs().parmEnum();
        if (weighingType == RUMWeighingType::None)
        {
            weighingType = RUMWeighingType::SecondWeighing;
        }
        contract.parmWeighingType(weighingType);
        
        // Get caller record
        callerRecord = this.parmArgs().record();
        if (callerRecord)
        {
            contract.parmCallerTableId(callerRecord.TableId);
            contract.parmCallerRecId(callerRecord.RecId);
        }
        
        // Select the appropriate design based on WeighingLetterBlank parameter
        if (weighingParameters.WeighingLetterBlank)
        {
            this.parmReportName(ssrsReportStr(AVARUMWeighingLetter, AVARUMWeighingLetterBlankPaper));
        }
        else
        {
            this.parmReportName(ssrsReportStr(AVARUMWeighingLetter, AVARUMWeighingLetterPrePrinted));
        }
        
        // Handle printer settings
        if (weighingParameters.PrinterSettings && weighingType != RUMWeighingType::FirstWeighing)
        {
            SRSPrintDestinationSettings printSettings = this.parmReportContract().parmPrintSettings();
            
            // Unpack and apply printer settings
            // Note: Actual implementation depends on how PrinterSettings is stored
            // This is a simplified example
            printSettings.printMediumType(SRSPrintMediumType::Printer);
            
            // Suppress dialog
            this.parmShowDialog(false);
        }
        
        return ret;
    }

]]></Source>
