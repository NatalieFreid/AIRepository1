/// <summary>
/// SysOperation controller for AVAInventoryTest.
/// Configures service, operation, contract and UI builder used by the SysOperation framework.
/// </summary>
/// <remarks>
/// This controller is a thin configuration wrapper around SysOperationServiceController.
/// It only defines which service class and operation should be executed and which
/// data contract/UIBuilder classes to use. The actual business logic is implemented
/// in the service class (AVAInventoryTestService).
/// </remarks>
class AVAInventoryTestController extends SysOperationServiceController
{
    /// <summary>
    /// Constructor. Configure the service class, operation name, contract and UI builder used by this controller.
    /// </summary>
    /// <remarks>
    /// The constructor is executed when the controller is instantiated by the caller.
    /// Use parm* methods to tell the framework which service, operation and helper
    /// classes to use for the SysOperation invocation.
    /// </remarks>
    public void new()
    {
        super();

        // Service class that contains the SysEntryPoint operation
        this.parmServiceClassName(classStr(AVAInventoryTestService));

        // Name of the static method on the service class to invoke
        this.parmOperationName('calculateOpenInventory');

        // Contract and UI builder classes for the framework
        this.parmContractClass(classStr(AVAInventoryTestContract));
        this.parmUIBuilderClass(classStr(AVAInventoryTestUIBuilder));
    }

    /// <summary>
    /// Entry point when executed from client.
    /// </summary>
    /// <param name="_args">Standard runtime arguments provided by the client (not used).</param>
    /// <remarks>
    /// Instantiates the controller and starts the SysOperation flow which will build
    /// the UI from the contract and invoke the configured service operation.
    /// </remarks>
    public static void main(Args _args)
    {
        AVAInventoryTestController controller = new AVAInventoryTestController();
        controller.startOperation();
    }
}