}]]></Declaration>
    <Methods>
      <Method>
        <Name>new</Name>
        <Source><![CDATA[
    /// <summary>
    /// Constructor — configure the service, operation, contract and UI builder used by this controller.
    /// </summary>
    public void new()
    {
        super();

        // Service class that contains the SysEntryPoint operation
        this.parmServiceClassName(classStr(AVAInventoryTestService));

        // Name of the static method on the service class to invoke
        this.parmOperationName('calculateOpenInventory');

        // Contract and UI builder classes for the framework
        this.parmContractClass(classStr(AVAInventoryTestContract));
        this.parmUIBuilderClass(classStr(AVAInventoryTestUIBuilder));
    }]]></Source>
      </Method>
      <Method>
        <Name>main</Name>
        <Source><![CDATA[
    /// <summary>
    /// Entry point when executed from client.
    /// </summary>
    public static void main(Args _args)
    {
        AVAInventoryTestController controller = new AVAInventoryTestController();
        controller.startOperation();
    }]]></Source>
