  <SourceCode>
    <Declaration><![CDATA[
[DataContractAttribute]
public final class AVAInventoryTestContract
{
    ItemId itemId;
}]]></Declaration>
    <Methods>
      <Method>
        <Name>parmItemId</Name>
        <Source><![CDATA[
    /// <summary>
    /// Data member for the ItemId to process.
    /// This method is used by the SysOperation framework UI and serialization.
    /// </summary>
    [DataMemberAttribute("ItemId")]
    public ItemId parmItemId(ItemId _itemId = itemId)
    {
        itemId = _itemId;
        return itemId;
    }]]></Source>
      </Method>
      <Method>
        <Name>validate</Name>
        <Source><![CDATA[
    /// <summary>
    /// Validate contract before processing.
    /// </summary>
    public boolean validate()
    {
        if (!itemId)
        {
            error("Please provide an ItemId.");
            return false;
        }
        return true;
    }]]></Source>
      </Method>
