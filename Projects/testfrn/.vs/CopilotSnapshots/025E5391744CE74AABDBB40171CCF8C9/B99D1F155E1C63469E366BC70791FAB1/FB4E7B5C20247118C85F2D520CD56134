﻿// Service class: contains business logic to clean up AVADAIREPORTEXPORTWORK table
class AVADAIREPORTEXPORTWORKService
{
    /// <summary>
    /// Deletes records from the AVADAIREPORTEXPORTWORK table up to and including the provided cutoff date
    /// from the data contract.
    /// </summary>
    public void cleanup(AVADAIREPORTEXPORTWORKContract _contract)
    {
        AVADAIREPORTEXPORTWORK avRecord;
        Date cutoffDate;
        DateTime cutoffDateTime;

        if (!_contract)
        {
            throw error("Contract must be provided.");
        }

        cutoffDate = _contract.parmCutoffDate();
        if (!cutoffDate)
        {
            throw error("Cutoff date must be specified in contract.");
        }

        // Convert date to DateTime at start of day
        cutoffDateTime = DateTimeUtil::newDateTime(cutoffDate, TimeOfDay::minValue());

        ttsBegin;
        // Select rows for update where CreatedDateTime is earlier than or equal to cutoff
        while select forUpdate avRecord where avRecord.CreatedDateTime <= cutoffDateTime
        {
            avRecord.delete();
        }
        ttsCommit;
    }

    /// <summary>
    /// Static entry point that can be used by controllers or the framework.
    /// </summary>
    public static void cleanupService(AVADAIREPORTEXPORTWORKContract _contract)
    {
        AVADAIREPORTEXPORTWORKService svc = new AVADAIREPORTEXPORTWORKService();
        svc.cleanup(_contract);
    }
}
