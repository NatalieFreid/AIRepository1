﻿// Service class: contains business logic to clean up AVADAIREPORTEXPORTWORK table
class AVADAIREPORTEXPORTWORKService
{
    /// <summary>
    /// Deletes records from the AVADAIREPORTEXPORTWORK table up to and including the provided cutoff date.
    /// </summary>
    /// <param name="_cutoffDate">Delete records whose CreatedDateTime is on or before this date.</param>
    public void cleanup(date _cutoffDate)
    {
        AVADAIREPORTEXPORTWORK avRecord;
        DateTime cutoffDateTime;

        if (!_cutoffDate)
        {
            throw error("Cutoff date must be specified.");
        }

        // Convert date to DateTime at start of day
        cutoffDateTime = DateTimeUtil::newDateTime(_cutoffDate, TimeOfDay::minValue());

        ttsBegin;
        // Select rows for update where CreatedDateTime is on or before cutoff
        while select forUpdate avRecord where avRecord.CreatedDateTime <= cutoffDateTime
        {
            avRecord.delete();
        }
        ttsCommit;
    }

    /// <summary>
    /// Static entry point that can be used by controllers or the framework.
    /// </summary>
    public static void cleanupService(date _cutoffDate)
    {
        AVADAIREPORTEXPORTWORKService svc = new AVADAIREPORTEXPORTWORKService();
        svc.cleanup(_cutoffDate);
    }
}
