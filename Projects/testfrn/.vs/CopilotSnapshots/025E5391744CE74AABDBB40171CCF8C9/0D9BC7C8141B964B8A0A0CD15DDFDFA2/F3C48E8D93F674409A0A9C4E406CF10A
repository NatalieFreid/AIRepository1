﻿// Controller class for SysOperation framework
class AVADAIREPORTEXPORTWORKController extends SysOperationServiceController
{
    public void run()
    {
        Date cutoffDate;

        // Prompt user to enter a cutoff date
        cutoffDate = WinAPIDateTime::dialog();
        if (!cutoffDate)
        {
            // user cancelled
            info("Cleanup cancelled by user.");
            return;
        }

        // Invoke service with provided date
        AVADAIREPORTEXPORTWORKService::cleanupService(cutoffDate);
    }
}
