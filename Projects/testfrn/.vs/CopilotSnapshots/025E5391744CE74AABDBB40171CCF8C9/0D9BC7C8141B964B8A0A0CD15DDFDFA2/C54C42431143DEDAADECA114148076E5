// Service class: contains business logic to clean up AVADAIREPORTEXPORTWORK table
class AVADAIREPORTEXPORTWORKService
{
    /// <summary>
    /// Deletes all records from the AVADAIREPORTEXPORTWORK table.
    /// This method is intended to be invoked by a controller/construct and can be exposed to SysOperation.
    /// </summary>
    public void cleanup()
    {
        AVADAIREPORTEXPORTWORK avRecord;

        ttsBegin;
        while select forUpdate avRecord
        {
            // delete each record
            avRecord.delete();
        }
        ttsCommit;
    }

    /// <summary>
    /// Static entry point that can be used by controllers or the framework.
    /// </summary>
    public static void cleanupService()
    {
        AVADAIREPORTEXPORTWORKService svc = new AVADAIREPORTEXPORTWORKService();
        svc.cleanup();
    }
}
