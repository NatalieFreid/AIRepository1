<AxClass xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
	<Name>AVAWHSLocDirCopy2BatchEventHandler</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// Event handler for Copy2Batch button on WHSLocDirTable form
/// </summary>
internal final class AVAWHSLocDirCopy2BatchEventHandler
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>onClicked</Name>
				<Source><![CDATA[
    /// <summary>
    /// Event handler for Copy2Batch button click
    /// </summary>
    /// <param name="_sender">The button control</param>
    /// <param name="_e">Event arguments</param>
    [FormControlEventHandler(formControlStr(WHSLocDirTable, AVACopy2Batch), FormControlEventType::Clicked)]
    public static void AVACopy2Batch_OnClicked(FormControl _sender, FormControlEventArgs _e)
    {
        FormRun formRun = _sender.formRun();
        FormDataSource fds = formRun.dataSource(formDataSourceStr(WHSLocDirTable, WHSLocDirAction));
        WHSLocDirAction action = fds.cursor();
        WHSLocDirAction newAction;
        
        if (!action.RecId)
        {
            error("@AVAExtension:NoRecordSelected");
            return;
        }
        
        if (action.IsBatchEnabled == NoYes::Yes)
        {
            warning("@AVAExtension:BatchAlreadyEnabled");
            return;
        }
        
        // Copy the action record with query preservation
        newAction = AVAWHSLocDirActionQueryHelper::copyActionRecord(action);
        
        if (newAction && newAction.RecId)
        {
            // Refresh the data source to show both records
            fds.research(true);
            info("@AVAExtension:CopyCompleted");
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>onInitialized</Name>
				<Source><![CDATA[
    /// <summary>
    /// Event handler for button initialization - controls visibility/enabled state
    /// </summary>
    /// <param name="_sender">The button control</param>
    /// <param name="_e">Event arguments</param>
    [FormControlEventHandler(formControlStr(WHSLocDirTable, AVACopy2Batch), FormControlEventType::Initialized)]
    public static void AVACopy2Batch_OnInitialized(FormControl _sender, FormControlEventArgs _e)
    {
        FormButtonControl buttonControl = _sender as FormButtonControl;
        
        if (buttonControl)
        {
            buttonControl.enabled(true);
            buttonControl.visible(true);
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>onActivated</Name>
				<Source><![CDATA[
    /// <summary>
    /// Event handler for data source activation - enables/disables button based on record state
    /// </summary>
    /// <param name="_sender">The data source</param>
    /// <param name="_e">Event arguments</param>
    [FormDataSourceEventHandler(formDataSourceStr(WHSLocDirTable, WHSLocDirAction), FormDataSourceEventType::Activated)]
    public static void WHSLocDirAction_OnActivated(FormDataSource _sender, FormDataSourceEventArgs _e)
    {
        FormRun formRun = _sender.formRun();
        FormButtonControl buttonControl = formRun.control(formControlStr(WHSLocDirTable, AVACopy2Batch));
        WHSLocDirAction action = _sender.cursor();
        
        if (buttonControl && action.RecId)
        {
            // Button is only enabled when batch is NOT enabled
            buttonControl.enabled(action.IsBatchEnabled == NoYes::No);
        }
    }

]]></Source>
			</Method>
		</Methods>
