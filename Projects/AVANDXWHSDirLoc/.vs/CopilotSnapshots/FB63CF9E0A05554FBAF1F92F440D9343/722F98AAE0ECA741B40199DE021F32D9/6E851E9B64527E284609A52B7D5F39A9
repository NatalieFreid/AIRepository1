<?xml version="1.0" encoding="utf-8"?>
<AxFormExtension xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
	<Name>WHSLocDirTable.AVAExtension</Name>
	<Design>
		<Controls>
			<AxFormControl xmlns="" i:type="AxFormActionPaneControl">
				<Name>ActionPaneHeader</Name>
				<FormControlExtension i:type="AxFormControlExtension">
					<Controls>
						<AxFormControl xmlns="" i:type="AxFormButtonGroupControl">
							<Name>AVAButtonGroup</Name>
							<Type>ButtonGroup</Type>
							<FormControlExtension i:nil="true" />
							<Controls>
								<AxFormControl xmlns="" i:type="AxFormButtonControl">
									<Name>AVACopy2Batch</Name>
									<Type>Button</Type>
									<FormControlExtension i:nil="true" />
									<Text>@AVAExtension:Copy2Batch</Text>
									<NormalImage>Copy</NormalImage>
								</AxFormControl>
							</Controls>
						</AxFormControl>
					</Controls>
				</FormControlExtension>
			</AxFormControl>
		</Controls>
	</Design>
	<DataSources>
		<AxFormDataSourceExtension>
			<Name>WHSLocDirAction</Name>
			<FormDataSourceExtension>
				<Fields>
					<AxFormDataSourceField>
						<DataSource>WHSLocDirAction</DataSource>
						<DataField>IsCopied</DataField>
					</AxFormDataSourceField>
				</Fields>
			</FormDataSourceExtension>
		</AxFormDataSourceExtension>
	</DataSources>
</AxFormExtension>
