/// <summary>
/// Data contract for Generate Batch Location Directives operation
/// </summary>
[DataContractAttribute]
internal final class AVAGenBatchLocDirContract
{
    QueryRun queryRun;
    str packedQuery;
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>parmQuery</Name>
				<Source><![CDATA[
    [DataMemberAttribute]
    public Query parmQuery(Query _query = null)
    {
        Query query = _query;
        
        if (!prmisDefault(_query))
        {
            queryRun = new QueryRun(_query);
            packedQuery = _query.pack();
        }
        else
        {
            if (packedQuery)
            {
                query = new Query(SysOperationHelper::base64Decode(packedQuery));
            }
        }
        
        return query;
    }

]]></Source>
			</Method>
			<Method>
				<Name>getQuery</Name>
				<Source><![CDATA[
    /// <summary>
    /// Gets the QueryRun object for execution
    /// </summary>
    /// <returns>QueryRun object</returns>
    public QueryRun getQuery()
    {
        if (!queryRun && packedQuery)
        {
            queryRun = new QueryRun(new Query(SysOperationHelper::base64Decode(packedQuery)));
        }
        
        return queryRun;
    }

]]></Source>
			</Method>
			<Method>
				<Name>setQuery</Name>
				<Source><![CDATA[
    /// <summary>
    /// Sets the query for the operation
    /// </summary>
    /// <param name="_query">The query to set</param>
    public void setQuery(Query _query)
    {
        if (_query)
        {
            queryRun = new QueryRun(_query);
            packedQuery = SysOperationHelper::base64Encode(_query.pack());
        }
    }

