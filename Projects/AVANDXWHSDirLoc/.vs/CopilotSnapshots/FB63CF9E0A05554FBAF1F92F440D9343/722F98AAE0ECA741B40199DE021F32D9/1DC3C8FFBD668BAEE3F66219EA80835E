internal final class AVAGenBatchLocDirUIBuilder extends SysOperationAutomaticUIBuilder
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>build</Name>
				<Source><![CDATA[
    /// <summary>
    /// Builds the dialog UI
    /// </summary>
    public void build()
    {
        super();
        
        AVAGenBatchLocDirContract contract = this.dataContractObject() as AVAGenBatchLocDirContract;
        
        if (contract)
        {
            // Add query prompt for WHSLocDir selection
            this.addDialogField(methodStr(AVAGenBatchLocDirContract, parmQuery), contract);
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>postBuild</Name>
				<Source><![CDATA[
    /// <summary>
    /// Post-build dialog customization
    /// </summary>
    public void postBuild()
    {
        DialogField dialogField;
        FormBuildControl formBuildControl;
        
        super();
        
        // Customize query field appearance
        dialogField = this.bindInfo().getDialogField(
            this.dataContractObject(),
            methodStr(AVAGenBatchLocDirContract, parmQuery));
        
        if (dialogField)
        {
            dialogField.label("@AVAExtension:SelectDirectives");
        }
    }

]]></Source>
			</Method>
