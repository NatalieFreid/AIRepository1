<?xml version="1.0" encoding="utf-8"?>
<AxClass xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
	<Name>AVAWHSLocDirActionQueryHelper</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// Helper class for cloning queries on WHSLocDirAction records.
/// Used to preserve custom joins and ranges when copying location directive actions.
/// </summary>
internal final class AVAWHSLocDirActionQueryHelper
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>packQuery</Name>
				<Source><![CDATA[
    /// <summary>
    /// Packs a query into a container for serialization.
    /// </summary>
    /// <param name="_query">The query to pack</param>
    /// <returns>Container with packed query</returns>
    public static container packQuery(Query _query)
    {
        container queryCon;
        
        if (_query)
        {
            queryCon = _query.pack();
        }
        
        return queryCon;
    }

]]></Source>
			</Method>
			<Method>
				<Name>unpackQuery</Name>
				<Source><![CDATA[
    /// <summary>
    /// Unpacks a query from a container.
    /// </summary>
    /// <param name="_queryCon">The packed query container</param>
    /// <returns>Unpacked Query object</returns>
    public static Query unpackQuery(container _queryCon)
    {
        Query query;
        
        if (_queryCon && conLen(_queryCon) > 0)
        {
            query = new Query();
            query.unpack(_queryCon);
        }
        
        return query;
    }

]]></Source>
			</Method>
			<Method>
				<Name>cloneQuery</Name>
				<Source><![CDATA[
    /// <summary>
    /// Clones a query by packing and unpacking it.
    /// </summary>
    /// <param name="_sourceQuery">The source query to clone</param>
    /// <returns>Cloned Query object</returns>
    public static Query cloneQuery(Query _sourceQuery)
    {
        container queryCon;
        Query clonedQuery;
        
        if (_sourceQuery)
        {
            // Pack the query
            queryCon = AVAWHSLocDirActionQueryHelper::packQuery(_sourceQuery);
            
            // Unpack into new query
            if (queryCon)
            {
                clonedQuery = AVAWHSLocDirActionQueryHelper::unpackQuery(queryCon);
            }
        }
        
        return clonedQuery;
    }

]]></Source>
			</Method>
			<Method>
				<Name>getActionQuery</Name>
				<Source><![CDATA[
    /// <summary>
    /// Gets the query associated with a WHSLocDirAction record.
    /// </summary>
    /// <param name="_action">The location directive action record</param>
    /// <returns>Query object associated with the action</returns>
    public static Query getActionQuery(WHSLocDirAction _action)
    {
        Query query;
        WHSLocDirStrategy strategy;
        
        if (_action)
        {
            // Get the strategy that holds the query
            strategy = WHSLocDirStrategy::construct(_action.LocDirStrategyId);
            
            if (strategy)
            {
                query = strategy.getQuery(_action);
            }
        }
        
        return query;
    }

]]></Source>
			</Method>
			<Method>
				<Name>setActionQuery</Name>
				<Source><![CDATA[
    /// <summary>
    /// Sets the query for a WHSLocDirAction record.
    /// </summary>
    /// <param name="_action">The location directive action record</param>
    /// <param name="_query">The query to set</param>
    public static void setActionQuery(WHSLocDirAction _action, Query _query)
    {
        WHSLocDirStrategy strategy;
        
        if (_action && _query)
        {
            // Get the strategy that holds the query
            strategy = WHSLocDirStrategy::construct(_action.LocDirStrategyId);
            
            if (strategy)
            {
                strategy.setQuery(_action, _query);
            }
        }
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
</AxClass>
