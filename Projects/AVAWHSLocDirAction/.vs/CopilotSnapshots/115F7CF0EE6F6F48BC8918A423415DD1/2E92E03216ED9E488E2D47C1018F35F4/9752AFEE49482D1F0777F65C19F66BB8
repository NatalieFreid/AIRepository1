<AxClass xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
	<Name>AVAGenBatchLocDirUIBuilder</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// UI Builder class for the Generate Batch Location Directives operation.
/// Adds query prompt to the dialog for selecting location directives.
/// </summary>
public class AVAGenBatchLocDirUIBuilder extends SysOperationAutomaticUIBuilder
{
    AVAGenBatchLocDirContract contract;
    DialogField dialogQueryField;
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>build</Name>
				<Source><![CDATA[
    /// <summary>
    /// Builds the dialog UI.
    /// </summary>
    public void build()
    {
        super();
        
        contract = this.dataContractObject();
        
        // Add query prompt group
        FormBuildGroupControl queryGroup = this.dialog().curFormGroup();
        
        dialogQueryField = this.addDialogField(methodStr(AVAGenBatchLocDirContract, parmQuery), contract);
        
        // Customize the query field
        this.bindInfo().setDialogCaption(dialogQueryField, "@AVAExtension:AVASelectLocDirectives");
    }

]]></Source>
			</Method>
			<Method>
				<Name>getFromDialog</Name>
				<Source><![CDATA[
    /// <summary>
    /// Gets values from dialog after user clicks OK.
    /// </summary>
    public void getFromDialog()
    {
        super();
        
        // Query is automatically handled by the framework
    }

]]></Source>
			</Method>
			<Method>
				<Name>postBuild</Name>
				<Source><![CDATA[
    /// <summary>
    /// Post-build customization.
    /// </summary>
    public void postBuild()
    {
        Query query;
        QueryBuildDataSource qbds;
        
        super();
        
        // Initialize default query if not already set
        if (!contract.parmQuery())
        {
            query = new Query();
            qbds = query.addDataSource(tableNum(WHSLocDir));
            qbds.addSelectionField(fieldNum(WHSLocDir, LocDirId));
            qbds.addSelectionField(fieldNum(WHSLocDir, Name));
            qbds.addSelectionField(fieldNum(WHSLocDir, WorkType));
            
            contract.parmQuery(query);
        }
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
</AxClass>
