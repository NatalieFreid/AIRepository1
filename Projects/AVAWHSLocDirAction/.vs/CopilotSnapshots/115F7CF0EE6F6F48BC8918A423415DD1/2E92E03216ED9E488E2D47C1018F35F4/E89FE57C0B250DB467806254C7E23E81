<?xml version="1.0" encoding="utf-8"?>
<AxClass xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
	<Name>AVAGenBatchLocDirContract</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// Data contract for the Generate Batch Location Directives operation.
/// Holds the user-selected query for filtering WHSLocDir records.
/// </summary>
[DataContractAttribute]
public class AVAGenBatchLocDirContract
{
    QueryRun queryRun;
    Query query;
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>parmQuery</Name>
				<Source><![CDATA[
    /// <summary>
    /// Gets or sets the query for selecting location directives.
    /// </summary>
    /// <param name="_query">Query to set (optional)</param>
    /// <returns>Current query</returns>
    [DataMemberAttribute]
    public Query parmQuery(Query _query = query)
    {
        query = _query;
        return query;
    }

]]></Source>
			</Method>
			<Method>
				<Name>getQuery</Name>
				<Source><![CDATA[
    /// <summary>
    /// Gets the query object for location directive selection.
    /// Creates a default query if none exists.
    /// </summary>
    /// <returns>Query object</returns>
    public Query getQuery()
    {
        if (!query)
        {
            query = new Query();
            QueryBuildDataSource qbds = query.addDataSource(tableNum(WHSLocDir));
            qbds.addSelectionField(fieldNum(WHSLocDir, LocDirId));
            qbds.addSelectionField(fieldNum(WHSLocDir, Name));
            qbds.addSelectionField(fieldNum(WHSLocDir, WorkType));
        }
        
        return query;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
</AxClass>
