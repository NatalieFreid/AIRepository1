<?xml version="1.0" encoding="utf-8"?>
<AxQuery xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
  <Name>AVASalesInvoiceReportQuery</Name>
  <DataSources>
    <AxQueryDataSource>
      <Name>SalesTable</Name>
      <DynamicFieldGroups>Yes</DynamicFieldGroups>
      <Fields>
        <AxQueryDataSourceField>
          <DataField>SalesId</DataField>
        </AxQueryDataSourceField>
        <AxQueryDataSourceField>
          <DataField>CustAccount</DataField>
        </AxQueryDataSourceField>
        <AxQueryDataSourceField>
          <DataField>DeliveryDate</DataField>
        </AxQueryDataSourceField>
        <AxQueryDataSourceField>
          <DataField>CurrencyCode</DataField>
        </AxQueryDataSourceField>
      </Fields>
      <HasValidTimeStateJoin>No</HasValidTimeStateJoin>
      <JoinMode>InnerJoin</JoinMode>
      <Table>SalesTable</Table>
      <Ranges>
        <AxQueryDataSourceRange>
          <Name>CustAccount</Name>
          <Field>CustAccount</Field>
          <Enabled>Yes</Enabled>
          <Status>Open</Status>
          <Value></Value>
        </AxQueryDataSourceRange>
        <AxQueryDataSourceRange>
          <Name>DeliveryDateFrom</Name>
          <Field>DeliveryDate</Field>
          <Enabled>Yes</Enabled>
          <Status>Open</Status>
          <Value></Value>
        </AxQueryDataSourceRange>
        <AxQueryDataSourceRange>
          <Name>DeliveryDateTo</Name>
          <Field>DeliveryDate</Field>
          <Enabled>Yes</Enabled>
          <Status>Open</Status>
          <Value></Value>
        </AxQueryDataSourceRange>
      </Ranges>
      <DataSources>
        <!-- CustInvoiceJour joined on SalesId -->
        <AxQueryDataSource>
          <Name>CustInvoiceJour</Name>
          <DynamicFieldGroups>Yes</DynamicFieldGroups>
          <Fields>
            <AxQueryDataSourceField>
              <DataField>InvoiceId</DataField>
            </AxQueryDataSourceField>
            <AxQueryDataSourceField>
              <DataField>InvoiceDate</DataField>
            </AxQueryDataSourceField>
            <AxQueryDataSourceField>
              <DataField>CurrencyCode</DataField>
            </AxQueryDataSourceField>
          </Fields>
          <HasValidTimeStateJoin>No</HasValidTimeStateJoin>
          <JoinMode>InnerJoin</JoinMode>
          <FetchMode>1toN</FetchMode>
          <Table>CustInvoiceJour</Table>
          <Relations>
            <AxQueryDataSourceRelation>
              <JoinDataSource>SalesTable</JoinDataSource>
              <Field>SalesId</Field>
              <RelatedField>SalesId</RelatedField>
            </AxQueryDataSourceRelation>
          </Relations>
          <DataSources>
            <!-- CustInvoiceTrans joined on InvoiceId -->
            <AxQueryDataSource>
              <Name>CustInvoiceTrans</Name>
              <DynamicFieldGroups>Yes</DynamicFieldGroups>
              <Fields>
                <AxQueryDataSourceField>
                  <DataField>ItemId</DataField>
                </AxQueryDataSourceField>
                <AxQueryDataSourceField>
                  <DataField>Name</DataField>
                </AxQueryDataSourceField>
                <AxQueryDataSourceField>
                  <DataField>Qty</DataField>
                </AxQueryDataSourceField>
                <AxQueryDataSourceField>
                  <DataField>SalesPrice</DataField>
                </AxQueryDataSourceField>
                <AxQueryDataSourceField>
                  <DataField>LineAmount</DataField>
                </AxQueryDataSourceField>
              </Fields>
              <HasValidTimeStateJoin>No</HasValidTimeStateJoin>
              <JoinMode>InnerJoin</JoinMode>
              <FetchMode>1toN</FetchMode>
              <Table>CustInvoiceTrans</Table>
              <Relations>
                <AxQueryDataSourceRelation>
                  <JoinDataSource>CustInvoiceJour</JoinDataSource>
                  <Field>InvoiceId</Field>
                  <RelatedField>InvoiceId</RelatedField>
                </AxQueryDataSourceRelation>
                <AxQueryDataSourceRelation>
                  <JoinDataSource>CustInvoiceJour</JoinDataSource>
                  <Field>InvoiceAccount</Field>
                  <RelatedField>InvoiceAccount</RelatedField>
                </AxQueryDataSourceRelation>
              </Relations>
            </AxQueryDataSource>
          </DataSources>
        </AxQueryDataSource>
        <!-- CustTable joined on CustAccount for name resolution -->
        <AxQueryDataSource>
          <Name>CustTable</Name>
          <DynamicFieldGroups>Yes</DynamicFieldGroups>
          <Fields>
            <AxQueryDataSourceField>
              <DataField>AccountNum</DataField>
            </AxQueryDataSourceField>
            <AxQueryDataSourceField>
              <DataField>DataAreaId</DataField>
            </AxQueryDataSourceField>
          </Fields>
          <HasValidTimeStateJoin>No</HasValidTimeStateJoin>
          <JoinMode>OuterJoin</JoinMode>
          <FetchMode>1to1</FetchMode>
          <Table>CustTable</Table>
          <Relations>
            <AxQueryDataSourceRelation>
              <JoinDataSource>SalesTable</JoinDataSource>
              <Field>AccountNum</Field>
              <RelatedField>CustAccount</RelatedField>
            </AxQueryDataSourceRelation>
          </Relations>
        </AxQueryDataSource>
      </DataSources>
    </AxQueryDataSource>
  </DataSources>
</AxQuery>
