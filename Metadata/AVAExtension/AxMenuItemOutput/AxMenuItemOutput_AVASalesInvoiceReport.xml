<?xml version="1.0" encoding="utf-8"?>
<AxMenuItemOutput xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
  <Name>AVASalesInvoiceReport</Name>

  <!-- Display label shown in menus, security privileges, and the SysOperationDialog title -->
  <Label>@AVA:AVASalesInvoiceReport_MenuItemLabel</Label>

  <!-- Tooltip / help text surfaced in the action pane and accessibility attributes -->
  <HelpText>@AVA:AVASalesInvoiceReport_MenuItemHelpText</HelpText>

  <!--
    ObjectType = Class: the menu item invokes a controller class (not a form or report node directly).
    The controller class (AVASalesInvoiceReportController) is responsible for instantiating
    the report run and binding the contract.
  -->
  <ObjectType>Class</ObjectType>
  <Object>AVASalesInvoiceReportController</Object>

  <!-- EnumTypeParameter / EnumParameter can be used to pass a design name; leave empty for default -->
  <EnumTypeParameter></EnumTypeParameter>
  <EnumParameter></EnumParameter>

  <!-- Parameters string – not required for controller-driven reports -->
  <Parameters></Parameters>

  <!-- Shortcut key (optional; assign via menu designer after import) -->
  <ShortCut>None</ShortCut>

  <!--
    CountryRegionCodes: leave blank to make the menu item available in all legal entities.
    Restrict here (e.g., "US,GB") if the report is region-specific.
  -->
  <CountryRegionCodes></CountryRegionCodes>

  <!-- Web menu item is not required for batch/print reports -->
  <WebMenuItemType>None</WebMenuItemType>
</AxMenuItemOutput>
